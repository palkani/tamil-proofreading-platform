# Dependencies
node_modules/
vendor/
.venv/
venv/
**/.venv/
**/__pycache__/
*.pyc
*.pyo

# Environment variables — deny everything, allow only the placeholder templates.
# .env.production was tracked here until it leaked live Google/Cloud SQL creds;
# the broad glob is the fence so a new .env.<whatever> can't slip through again.
.env
.env.*
!.env.example
!.env.*.example

# Build outputs
dist/
build/
.next/
out/

# Go (binaries - do not commit; they bloat the repo)
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work
backend/server
backend/main
backend/load-tamil-words-dir
backend/extract-tamil-from-wikipedia
backend/cmd/extract-tamil-from-wikipedia/extract-tamil
backend/cmd/import-tamil-words/import-tamil-words
backend/build_lexicon

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Database
*.db
*.sqlite
*.sqlite3

# Temporary files
tmp/
temp/
*.tmp

.vercel
backend/seed_corpus_wiki.sql

# Tesseract traineddata (large; download at build/deploy time)
*.traineddata

# data/lexicon.json: large; build locally (see docs/BUILD_LEXICON_LOCALLY.md) or use LEXICON_FILE at deploy
data/lexicon.json
data/tamil_lexicon.json

# Dev artifacts and backups (do not commit)
attached_assets/
backup.sql
backup_clean.sql
.replit

# claude-seo/ is a clone of a separate upstream repo
# (github.com/AgriciDaniel/claude-seo). `git add`ing it creates a gitlink with
# no .gitmodules entry, so clones would get an empty directory instead of the
# files. Ignore it here; add it as a real submodule if it should be tracked.
claude-seo/

# Database
# For Supabase: use pooler (Session mode port 5432 has low connection limit; Transaction mode port 6543 allows more).
# Example: postgresql://postgres.PROJECT:PASSWORD@aws-0-us-west-2.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/tamil_proofreading

# Server
PORT=8080
FRONTEND_URL=http://localhost:3000
# Backend public URL — single-instance fallback and local dev.
# In production with two Cloud Run instances, set the three regional vars below instead.
BACKEND_URL=

# Regional Cloud Run URLs (set automatically by the deploy workflow via Vercel API).
# If both are present, the Express frontend routes each request to the geographically
# nearest instance using Vercel's x-vercel-ip-continent header.
#   BACKEND_URL_ASIA   → Asia Cloud Run instance (asia-south1 / Mumbai)
#   BACKEND_URL_US     → US Cloud Run instance   (us-central1)
#   BACKEND_URL_PRIMARY→ Fixed instance for OAuth callbacks (must be pre-registered
#                        in Google Console). Set to the same value as BACKEND_URL_US.
BACKEND_URL_ASIA=
BACKEND_URL_US=
BACKEND_URL_PRIMARY=

# JWT
JWT_SECRET=your-jwt-secret-here
REFRESH_TOKEN_SECRET=your-refresh-token-secret

# AI Services
GOOGLE_GENAI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# OAuth (Google Sign-In). GOOGLE_CLIENT_ID must be the full OAuth client ID from Google Cloud Console
# (e.g. 123456-xxx.apps.googleusercontent.com). Set BACKEND_URL to your Cloud Run URL and add
# https://YOUR_BACKEND_URL/api/v1/auth/google/callback to Google Console authorized redirect URIs.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_DOMAIN=https://yourdomain.com

# Payment
STRIPE_SECRET_KEY=your-stripe-secret
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret

# IME/Transliteration
IME_ENABLED=true
IME_CACHE_ENABLED=true
TRANSLITERATOR_BASE_URL=https://prooftamil-runner.com

# Advanced Suggestion Service (NEW)
ADVANCED_SUGGEST_URL=http://suggest-service:8080
USE_ADVANCED_SUGGEST=false  # Set to true to enable advanced suggestions

# Tamil Handwriting to Text (optional). Python service at services/tamil-handwriting-ocr. Run: uvicorn api_server:app --port 8000
HANDWRITING_OCR_URL=http://localhost:8000

# Suggest Engine (Hybrid Trie + ID tables)
SUGGEST_MIN_LEN=2
SUGGEST_TOP_K=5
SUGGEST_CACHE_ENTRIES=200
SUGGEST_CACHE_TTL_MS=120000
SUGGEST_TRIE_TOP_K=25
LEXICON_REFRESH_SEC=600
SUGGEST_VOWEL_COLLAPSE=false
# Optional: leave REDIS_URL empty to use in-memory cache only (recommended for single instance). See CACHE_WITHOUT_REDIS.md.
REDIS_URL=
SUGGEST_REDIS_TIMEOUT_MS=25

# DB load tuning (reduce batch size / timeout if you see statement timeout or unexpected EOF). See TUNING.md.
SUGGEST_LOAD_BATCH_SIZE=10000
SUGGEST_LOAD_LIMIT=100000
SUGGEST_BATCH_TIMEOUT_SEC=30
TAMIL_CACHE_BATCH_SIZE=10000
TAMIL_CACHE_LOAD_LIMIT=500000
TAMIL_CACHE_BATCH_TIMEOUT_SEC=30

# Seed corpus at startup (first deploy only)
SEED_CORPUS_ON_STARTUP=false
SEED_CORPUS_FILE=/root/seed_corpus_minimal.sql
SEED_CORPUS_MIN_COUNT=1

# Preload Tamil word cache at startup (block until loaded). Like JVM preload; first requests get warm cache. Startup takes longer (e.g. 2–10 min for 227k rows).
PRELOAD_TAMIL_CACHE_AT_STARTUP=false

# Migrations: default false so backend becomes ready quickly (avoids 503 / "Backend is starting" on login). Set true only for first deploy or when schema changes are needed.
RUN_MIGRATIONS=false

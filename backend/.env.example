# Database
DATABASE_URL=postgres://user:password@localhost:5432/tamil_proofreading?sslmode=disable

# Server
PORT=8080
FRONTEND_URL=http://localhost:3000

# JWT
JWT_SECRET=your-secret-key-change-in-production

# OpenAI
OPENAI_API_KEY=your-openai-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# OTP (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Suggest Engine (Hybrid Trie + ID tables)
SUGGEST_MIN_LEN=2
SUGGEST_TOP_K=5
SUGGEST_CACHE_ENTRIES=200
SUGGEST_CACHE_TTL_MS=120000
SUGGEST_TRIE_TOP_K=25
LEXICON_REFRESH_SEC=600
SUGGEST_VOWEL_COLLAPSE=false
REDIS_URL=
SUGGEST_REDIS_TIMEOUT_MS=25

# Seed corpus at startup (first deploy only)
SEED_CORPUS_ON_STARTUP=false
SEED_CORPUS_FILE=/root/seed_corpus_minimal.sql
SEED_CORPUS_MIN_COUNT=1


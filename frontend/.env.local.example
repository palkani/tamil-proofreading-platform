# ProofTamil chatbot — copy to .env.local and fill in.
# .env.local is git-ignored. Never commit real values.
#
# CREDENTIALS ARE INHERITED FROM THE REPO ROOT.
# load-root-env.mjs pulls ../.env and ../.env.local into the process, so the
# keys the Go backend and Express app already use are reused here — you do NOT
# need to copy them. Already inherited today:
#
#   GOOGLE_GENAI_API_KEY      ../.env
#   DATABASE_URL              ../.env and ../.env.local (they differ — see below)
#   SENDGRID_SMTP_PASSWORD    ../.env   (an SG.… key; used via the v3 Web API)
#   EMAIL_FROM_ADDRESS, CONTACT_TO_EMAIL
#
# Anything set here overrides the root value — root files are only a fallback.
# On serverless (Vercel/Lambda) the root .env is NOT readable at runtime; set
# the variables in the host dashboard instead. See CHATBOT_README.md.

# ------------------------------------------------------------- set this one --

# Which database the chatbot's tables live in.
#
# Set this explicitly. The repo has TWO different DATABASE_URLs — a Supabase
# pooler in ../.env and a Cloud SQL host in ../.env.local — and .env.local wins,
# so a bare DATABASE_URL silently resolves to whichever the loader saw first.
# This variable removes that ambiguity.
#
# Supabase: Project Settings → Database → Connection string → Transaction pooler
#           (port 6543 — the pooler, not the direct 5432 connection)
# Local dev: postgresql://localhost:5432/prooftamil_chatbot
#
# No service-role key or anon key is needed — the app connects as the table
# owner over plain Postgres.
CHATBOT_DATABASE_URL=

# ---------------------------------------------------------------- optional --

# Chat model. Flash tier; -lite variants are cheaper but noticeably weaker in Tamil.
# CHAT_MODEL_ID=gemini-3.6-flash

# Embedding model. Changing this REQUIRES `npm run ingest -- --force`:
# vectors from different models are not comparable.
# EMBEDDING_MODEL_ID=gemini-embedding-001

# Embedding dimensions. MUST match the vector(N) column in lib/chatbot/schema.sql.
# EMBEDDING_DIMENSIONS=768

# Retrieval tuning.
# RAG_TOP_K=6
# RAG_MIN_SCORE=0.35
# RAG_MAX_CONTEXT_CHARS=12000

# Ingestion tuning.
# SITE_ORIGIN=https://www.prooftamil.com
# SITEMAP_URL=https://www.prooftamil.com/sitemap.xml
# CHUNK_TARGET_TOKENS=700
# CHUNK_OVERLAP_RATIO=0.15
# EMBED_BATCH_SIZE=32

# Request limits.
# MAX_MESSAGE_CHARS=2000
# MAX_HISTORY_MESSAGES=12
# MAX_OUTPUT_TOKENS=1024

# Rate limiting (in-memory; per process — see CHATBOT_README.md).
# RATE_LIMIT_IP_CAPACITY=30
# RATE_LIMIT_IP_WINDOW_MS=60000
# RATE_LIMIT_SESSION_CAPACITY=15
# RATE_LIMIT_SESSION_WINDOW_MS=60000

# Database pool. Keep small — Supabase's transaction pooler multiplexes for you,
# and a serverless deploy runs many instances.
# CHATBOT_DB_POOL_MAX=5
# Set true once your managed Postgres CA validates against the system store.
# CHATBOT_DB_SSL_STRICT=false

# ------------------------------------------------------- lead notifications --

# Where new-lead notifications are sent.
# LEAD_NOTIFY_TO=contact@prooftamil.com

# Transport, tried in order: Resend, then SendGrid. Both over HTTPS, so no SMTP
# settings and no nodemailer. SENDGRID_SMTP_PASSWORD from ../.env is used
# automatically as the SendGrid key.
#
# NOTE: the from address must be a VERIFIED SENDER on the account, or SendGrid
# returns 403. See ../SENDGRID_SENDER_SETUP.md.
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# EMAIL_FROM_ADDRESS=contact@prooftamil.com
# EMAIL_FROM_NAME=ProofTamil

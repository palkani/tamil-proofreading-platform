<%
  const baseUrl = 'https://www.prooftamil.com';
  const seoTitle = typeof seo !== 'undefined' && seo.title ? seo.title : title;
  const seoDescription = typeof seo !== 'undefined' && seo.description ? seo.description : 'Free Tamil grammar checker online — fix Tamil spelling, grammar, and verb conjugation errors in 2 seconds. Includes Tamil OCR and Tanglish typing.';
  const seoKeywords = typeof seo !== 'undefined' && seo.keywords ? seo.keywords : '';
  const canonicalUrl = typeof seo !== 'undefined' && seo.canonical ? seo.canonical : baseUrl + '/';
  const ogTitle = typeof seo !== 'undefined' && seo.ogTitle ? seo.ogTitle : seoTitle;
  const ogDescription = typeof seo !== 'undefined' && seo.ogDescription ? seo.ogDescription : seoDescription;
  const noIndex = typeof seo !== 'undefined' && seo.noIndex ? true : false;
  const pageType = typeof seo !== 'undefined' && seo.pageType ? seo.pageType : 'website';
  const ogType = pageType === 'blogPost' ? 'article' : 'website';
  const htmlLang = typeof seo !== 'undefined' && seo.htmlLang ? seo.htmlLang : 'en';
  const ogLocale = typeof seo !== 'undefined' && seo.ogLocale ? seo.ogLocale : 'ta_IN';
  const ogLocaleAlternate = pageType === 'blogPost' ? null : (ogLocale === 'ta_IN' ? 'en_US' : 'ta_IN');
  const hreflangSelf = typeof seo !== 'undefined' && seo.hreflang ? seo.hreflang : null;
%>
<!DOCTYPE html>
<html lang="<%= htmlLang %>" xml:lang="<%= htmlLang %>" itemscope itemtype="https://schema.org/WebSite">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta itemprop="name" content="ProofTamil - prooftamil.com">
  <meta itemprop="url" content="<%= canonicalUrl %>">
  
  <!-- Primary Meta Tags - Optimized for Tamil Grammar Checker & Proofreading Keywords -->
  <title><%= seoTitle %></title>
  <meta name="title" content="<%= seoTitle %>">
  <meta name="description" content="<%= seoDescription %>">
  <% if (seoKeywords) { %>
  <meta name="keywords" content="<%= seoKeywords %>">
  <% } %>
  <meta name="author" content="ProofTamil">
  <% if (noIndex) { %>
  <meta name="robots" content="noindex, nofollow">
  <% } else { %>
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <% } %>
  <meta name="language" content="Tamil, English">
  <meta name="content-language" content="ta, en">
  <meta name="revisit-after" content="3 days">
  <meta name="rating" content="General">
  <meta name="distribution" content="global">
  <meta name="geo.region" content="IN-TN">
  <meta name="geo.placename" content="Tamil Nadu, India">
  <meta name="geo.position" content="11.1271;78.6569">
  <meta name="ICBM" content="11.1271, 78.6569">
  <meta name="theme-color" content="#1A2B68">
  <!-- Global injection of Google Client ID for browser usage (must be xxx.apps.googleusercontent.com, never a domain) -->
  <script>
    (function() {
      var raw = typeof googleClientId !== 'undefined' && googleClientId ? (typeof googleClientId === 'string' ? googleClientId : '') : '';
      window.GOOGLE_CLIENT_ID = (raw && raw.indexOf('.apps.googleusercontent.com') !== -1) ? raw : '991187041222-dp582s8kvqqktpq3t0bihl43e4iv8m5i.apps.googleusercontent.com';
    })();
    // CRITICAL FIX: Disable Tamil IME to prevent reverse typing bug
    // Enable unified transliteration IME V2 across pages (Home/Free Editor/Workspace)
    window.TRANS_SUGGEST_V2 = false; // DISABLED until reverse text bug is fixed
  </script>

  <!-- PERFORMANCE: Preconnect to backend for faster API calls -->
  <link rel="preconnect" href="https://prooftamil-backend-991187041222.asia-south1.run.app" crossorigin>
  <link rel="dns-prefetch" href="https://prooftamil-backend-991187041222.asia-south1.run.app">
  
  <!-- Microsoft Clarity -->
  <script>
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "v44adxd2va");
  </script>

  <!-- Vercel Speed Insights — real-user Core Web Vitals (LCP/INP/CLS) for SEO ranking signal.
       Script is served from Vercel's edge once Speed Insights is enabled in the dashboard.
       Defer = no impact on page load; data only flows after enable in Vercel project settings. -->
  <script defer src="/_vercel/speed-insights/script.js"></script>

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="<%= ogType %>">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta property="og:title" content="<%= ogTitle %>">
  <meta property="og:description" content="<%= ogDescription %>">
  <meta property="og:site_name" content="ProofTamil - Tamil Grammar Checker & Proofreading Tool">
  <meta property="og:locale" content="<%= ogLocale %>">
  <% if (ogLocaleAlternate) { %>
  <meta property="og:locale:alternate" content="<%= ogLocaleAlternate %>">
  <% } %>
  <meta property="og:image" content="<%= baseUrl %>/images/favicon-512x512.png">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="512">
  <meta property="og:image:height" content="512">
  <meta property="og:image:alt" content="ProofTamil - Free Tamil Grammar Checker and Proofreading Tool">
  <% if (typeof seo !== 'undefined' && seo.article) { %>
  <% if (seo.article.publishedTime) { %><meta property="article:published_time" content="<%= seo.article.publishedTime %>"><% } %>
  <% if (seo.article.modifiedTime) { %><meta property="article:modified_time" content="<%= seo.article.modifiedTime %>"><% } %>
  <% if (seo.article.section) { %><meta property="article:section" content="<%= seo.article.section %>"><% } %>
  <% } %>
  
  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@prooftamil">
  <meta name="twitter:url" content="<%= canonicalUrl %>">
  <meta name="twitter:title" content="<%= ogTitle %>">
  <meta name="twitter:description" content="<%= ogDescription %>">
  <meta name="twitter:image" content="<%= baseUrl %>/images/favicon-512x512.png">
  <meta name="twitter:image:alt" content="ProofTamil - Free Tamil Grammar Checker">
  
  <!-- Canonical URL -->
  <link rel="canonical" href="<%= canonicalUrl %>">

  <% if (pageType === 'blogIndex' || pageType === 'blogPost') { %>
  <link rel="alternate" type="application/rss+xml" title="ProofTamil Blog RSS" href="<%= baseUrl %>/blog/rss.xml">
  <% } %>
  
  <!-- x-default hreflang: signals canonical URL to search engines -->
  <link rel="alternate" hreflang="x-default" href="<%= canonicalUrl %>">
  <% if (hreflangSelf) { %>
  <link rel="alternate" hreflang="<%= hreflangSelf %>" href="<%= canonicalUrl %>">
  <% } %>
  
  <!-- Favicon - Multiple formats for best compatibility -->
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="shortcut icon" href="/images/favicon.ico">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1A2B68">
  
  <!-- Preconnect for performance - Critical resources -->
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="dns-prefetch" href="https://fonts.googleapis.com">
  <link rel="dns-prefetch" href="https://www.googletagmanager.com">
  <!-- Inter font: render-blocking on purpose. ?display=swap prevents FOIT (text
       renders in a fallback font until Inter loads, then swaps). The previous
       preload+onload async pattern caused FOUC + reflow that contributed to CLS. -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap">

  <!-- Critical CSS: render-blocking on purpose. ~62KB minified (~12KB gzip),
       CDN-cached. The previous preload+onload async pattern caused CLS 1.1 in
       real-user data (Microsoft Clarity, 2026-05-22) — the page rendered with
       NO main stylesheet, painted unstyled defaults, then reflowed the entire
       layout when Tailwind applied. Render-blocking critical CSS is the
       correct pattern; the "non-render-blocking" optimization was premature
       and traded a real CLS catastrophe for a marginal first-paint gain. -->
  <link rel="stylesheet" href="/css/output.css">
  <link rel="preload" href="/images/tamil-logo.svg" as="image">

  <!-- Console logger wrapper (keeps production console clean) -->
  <script defer src="/js/logger.js"></script>
  
  <% if (pageType === 'home' || (typeof seo !== 'undefined' && seo.includeStructuredData) || typeof seo === 'undefined') { %>

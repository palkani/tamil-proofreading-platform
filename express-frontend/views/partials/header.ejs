          "billingDuration": { "@type": "QuantitativeValue", "value": 1, "unitCode": "ANN" }
        },
        "description": "Unlimited words per check, unlimited daily AI checks, unlimited OCR, all correction types, unlimited drafts — best value. Regional pricing: INR 9599/year in India."
      }
    ]
  }
  </script>
  <%#
    aggregateRating and review are intentionally omitted from the Product schema above.
    Google Search Console flags them as "non-critical" missing fields, but Google's
    structured-data spam policy penalizes fabricated ratings. Add them only when
    ProofTamil has real, verifiable customer reviews (Trustpilot / G2 / first-party).
  %>
  <% } %>

  <% if (pageType === 'article' || pageType === 'howToUse') { %>
  <!-- Structured Data - HowTo for tutorial pages -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Use ProofTamil Tamil Grammar Checker",
    "description": "Step-by-step guide to check Tamil grammar, fix spelling errors, and improve Tamil writing using ProofTamil's AI-powered proofreading tool.",
    "step": [
      {
        "@type": "HowToStep",
        "name": "Sign Up or Login",
        "text": "Create a free account or login to access ProofTamil's full features. You can sign up with email or Google account."
      },
      {
        "@type": "HowToStep",
        "name": "Open Your Workspace",
        "text": "Navigate to the workspace to start writing or paste your Tamil text for proofreading."
      },
      {
        "@type": "HowToStep",
        "name": "Type or Paste Tamil Text",
        "text": "Type in English (phonetic) like 'vanakkam' and it converts to Tamil, or paste existing Tamil text."
      },
      {
        "@type": "HowToStep",
        "name": "Get AI Suggestions",
        "text": "AI automatically analyzes your text for grammar errors, spelling mistakes, and provides correction suggestions."
      },
      {
        "@type": "HowToStep",
        "name": "Apply Corrections",
        "text": "Click on suggestions to apply them instantly. Your text is automatically saved."
      }
    ]
  }
  </script>
  <% } %>
  
  <% if (pageType === 'contact') { %>
  <!-- Structured Data - ContactPage -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contact ProofTamil",
    "description": "Contact ProofTamil support team for help with Tamil grammar checker, proofreading tool, or any questions.",
    "url": "<%= baseUrl %>/contact"
  }
  </script>
  <% } %>
  
  <!-- BreadcrumbList for better navigation in search results -->
  <% if (pageType === 'blogPost') { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "<%= baseUrl %>" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "<%= baseUrl %>/blog" },
      { "@type": "ListItem", "position": 3, "name": "<%= seoTitle.split(' | ')[0] %>", "item": "<%= canonicalUrl %>" }
    ]
  }
  </script>
  <% } else if (pageType !== 'home' && pageType !== 'error' && pageType !== 'blogIndex') { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "<%= baseUrl %>" },
      { "@type": "ListItem", "position": 2, "name": "<%= seoTitle.split(' - ')[0].split(' | ')[0] %>", "item": "<%= canonicalUrl %>" }
    ]
  }
  </script>
  <% } else if (pageType === 'blogIndex') { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "<%= baseUrl %>" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "<%= baseUrl %>/blog" }
    ]
  }
  </script>
  <% } %>
  
  <!-- Centralized Authentication Utilities -->
  <!-- Defer so it doesn't block first paint (still runs before DOMContentLoaded) -->
  <script src="/js/auth-utils.js" defer></script>
  <style>
    @font-face {
      font-family: 'Tamil';
      src: local('Noto Sans Tamil'), local('Lohit Tamil');
      font-display: swap;
    }
  </style>
</head>

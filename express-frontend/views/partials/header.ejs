  <!-- Structured Data - FAQPage (AI-optimised: specific, factual, non-promotional answers) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is ProofTamil?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "ProofTamil is an AI-powered Tamil language writing platform available at prooftamil.com. It provides three core tools: (1) an AI proofreader that checks Tamil grammar, spelling, and verb conjugation in under 2 seconds; (2) a handwriting OCR tool that converts photographs of handwritten Tamil notes into editable text; and (3) an AI content writer that generates Tamil and English articles and blog posts."
        }
      },
      {
        "@type": "Question",
        "name": "How do I check Tamil grammar online?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Visit prooftamil.com, type or paste your Tamil text in the editor, and click 'Check Grammar'. The AI analyses the text and highlights grammar errors, spelling mistakes, and verb conjugation issues with coloured underlines. Click any suggestion to apply the correction. The free plan supports up to 200 words per check and 30 checks per day."
        }
      },
      {
        "@type": "Question",
        "name": "What Tamil grammar errors does ProofTamil detect?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "ProofTamil detects: verb conjugation errors (e.g. wrong tense forms), spelling mistakes including commonly confused letters (ல vs ழ vs ள), sandhi rule violations, subject-verb agreement issues, punctuation errors, formal vs. spoken register mismatches, and redundant or unclear sentence constructions."
        }
      },
      {
        "@type": "Question",
        "name": "How do I convert handwritten Tamil notes to text?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Use ProofTamil's Tamil Handwriting OCR at prooftamil.com/tools/handwriting-ocr. Take a clear photograph of your handwritten Tamil notes, upload the image (JPG or PNG), and the AI converts it to editable Tamil text in seconds. Free users get 2 conversions per day; Pro users get unlimited conversions."
        }
      },
      {
        "@type": "Question",
        "name": "What types of Tamil documents can the OCR tool read?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "ProofTamil's OCR tools support: handwritten Tamil notes and letters (via the handwriting-ocr tool), printed Tamil books and documents, scanned PDFs, whiteboard content, and Tamil text in photographs. Accepted formats include JPG, PNG, WEBP, and PDF."
        }
      },
      {
        "@type": "Question",
        "name": "How do I type Tamil without a Tamil keyboard?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "ProofTamil supports Tanglish (phonetic Tamil typing). Type Tamil words using English letters — for example: 'vanakkam' converts to வணக்கம், 'nandri' converts to நன்றி, 'en peyar Tamil' converts to என் பெயர் தமிழ். The conversion happens in real time as you type, on any device."
        }
      },
      {
        "@type": "Question",
        "name": "What is the difference between ProofTamil Free and Pro?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "ProofTamil Free: 200 words per proofreading check, 30 AI checks per day, 2 OCR conversions per day, up to 5 saved drafts. ProofTamil Pro: unlimited words per check, unlimited daily AI checks, unlimited OCR conversions, unlimited saved drafts, all correction types including style and rewrite suggestions, and priority support."
        }
      },
      {
        "@type": "Question",
        "name": "Does ProofTamil support both formal and spoken Tamil?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. ProofTamil has two style modes: Formal Tamil (இலக்கிய தமிழ்) applies strict classical grammar rules, suitable for academic writing and journalism. Spoken Tamil (பேச்சு தமிழ்) accepts everyday conversational forms like பண்ற, போறேன், and வேணும் as correct."
        }
      }
    ]
  }
  </script>

  <!-- Structured Data - HowTo for OCR (AI systems extract step-by-step content) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "HowTo",

                class="flex-1 px-4 py-3 rounded-xl border border-gray-300 bg-white text-gray-900 focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
              />
              <button
                type="submit"
                id="newsletter-btn"
                class="px-6 py-3 bg-primary-600 text-white font-semibold rounded-xl hover:bg-primary-700 focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 transition whitespace-nowrap"
              >
                Subscribe
              </button>
            </form>
            <div id="newsletter-message" class="mt-2 text-sm hidden"></div>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title><%= title %></title>
  <link href="/styles/output.css" rel="stylesheet" />
  <style>
    /* Admin-specific tweaks that don't belong in the main Tailwind bundle */
    .admin-nav-item { transition: background-color 120ms ease; }
    .admin-nav-item.active { background-color: rgb(30 58 138); color: white; }
    .admin-nav-item:not(.active):hover { background-color: rgb(243 244 246); }
  </style>
</head>
<body class="min-h-screen bg-slate-50 text-slate-900">
  <div class="flex min-h-screen">
    <!-- Sidebar -->
    <aside class="flex w-64 flex-col border-r border-slate-200 bg-white">
      <div class="border-b border-slate-200 px-6 py-5">
        <a href="/admin" class="flex items-center gap-2">
          <span class="text-2xl">தமிழ்</span>
          <span class="text-sm font-semibold uppercase tracking-wider text-slate-500">Admin</span>
        </a>
        <p class="mt-1 text-xs text-slate-400">ProofTamil operations console</p>
      </div>

      <nav class="flex-1 space-y-1 px-3 py-4">
        <% navItems.forEach(function(item) { %>
          <a
            href="<%= item.href %>"
            class="admin-nav-item flex items-center gap-3 rounded-md px-3 py-2 text-sm font-medium text-slate-700 <%= activeTab === item.key ? 'active' : '' %>">
            <span class="inline-block h-4 w-4 flex-shrink-0">
              <% if (item.icon === 'home') { %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955a1.5 1.5 0 012.121 0L22.28 12M4.5 9.75v10.125a1.125 1.125 0 001.125 1.125H9.75v-4.875a1.125 1.125 0 011.125-1.125h2.25a1.125 1.125 0 011.125 1.125V21h4.125a1.125 1.125 0 001.125-1.125V9.75" /></svg>
              <% } else if (item.icon === 'users') { %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
              <% } else if (item.icon === 'clock') { %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <% } else if (item.icon === 'alert') { %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>
              <% } else if (item.icon === 'mail') { %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
              <% } %>
            </span>
            <%= item.label %>
          </a>
        <% }); %>
      </nav>

      <div class="border-t border-slate-200 px-6 py-4 text-xs text-slate-500">
        <div class="font-medium text-slate-700"><%= user.email %></div>
        <div class="mt-1">Admin session</div>
        <a href="/" class="mt-2 inline-block text-blue-600 hover:underline">← Back to site</a>
      </div>
    </aside>

    <!-- Main content -->
    <main class="flex-1 overflow-x-hidden">
      <header class="border-b border-slate-200 bg-white px-8 py-4">
        <div class="flex items-center justify-between">
          <h1 class="text-lg font-semibold text-slate-900"><%= title.replace('Admin · ', '') %></h1>
          <div class="text-sm text-slate-500">
            <%= new Date().toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %>
          </div>
        </div>
      </header>

      <div class="px-8 py-6">

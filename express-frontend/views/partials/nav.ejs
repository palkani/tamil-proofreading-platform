<nav class="bg-white border-b border-gray-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <!-- Logo & Main Nav -->
      <div class="flex">
        <div class="flex-shrink-0 flex items-center">
          <a href="/" class="flex items-center gap-2">
            <img src="/images/tamil-logo.svg" alt="ProofTamil Logo" class="w-10 h-10">
            <span class="text-lg font-semibold text-gray-900">ProofTamil</span>
          </a>
        </div>
        <div class="hidden sm:ml-8 sm:flex sm:space-x-4">
          <% if (user && user.email) { %>
            <a href="/dashboard" class="<%= active === 'dashboard' ? 'border-primary-600 text-primary-600' : 'border-transparent text-gray-600 hover:text-primary-600' %> inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors">
              Dashboard
            </a>
            <a href="/drafts" id="my-drafts-link" class="<%= active === 'drafts' ? 'border-primary-600 text-primary-600' : 'border-transparent text-gray-600 hover:text-primary-600' %> inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors">
              My Drafts
            </a>
            <a href="/workspace" class="<%= active === 'workspace' ? 'border-primary-600 text-primary-600' : 'border-transparent text-gray-600 hover:text-primary-600' %> inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors">
              Workspace
            </a>
            <a href="/archive" class="<%= active === 'archive' ? 'border-primary-600 text-primary-600' : 'border-transparent text-gray-600 hover:text-primary-600' %> inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors">
              Archive
            </a>
            <% if (user.role === 'admin' || user.email === 'prooftamil@gmail.com') { %>
            <a href="/analytics" class="<%= active === 'analytics' ? 'border-primary-600 text-primary-600' : 'border-transparent text-gray-600 hover:text-primary-600' %> inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors">
              📊 Analytics
            </a>
            <% } %>
          <% } %>
        </div>
      </div>

      <!-- User Menu / Auth Links -->
      <div class="flex items-center gap-4">
        <% if (user && user.email) { %>
          <!-- Authenticated User Menu -->
          <a href="/contact" class="<%= active === 'contact' ? 'text-primary-600 font-semibold' : 'text-primary-600 hover:opacity-80' %> inline-flex items-center px-3 py-2 text-sm font-medium transition-opacity">
            Contact
          </a>
          <span class="text-sm text-gray-600 hidden sm:inline"><%= user.email %></span>
          <a href="/account" class="<%= active === 'account' ? 'text-primary-600' : 'text-gray-600 hover:text-primary-600' %> p-2 rounded-full hover:bg-gray-100 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </a>
          <button id="logout-btn" class="text-gray-600 hover:text-primary-600 p-2 rounded-full hover:bg-gray-100 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
          </button>
        <% } else { %>
          <!-- Unauthenticated User - Show Login/Signup Links -->
          <a href="/contact" class="<%= active === 'contact' ? 'text-primary-600 font-semibold' : 'text-primary-600 hover:opacity-80' %> inline-flex items-center px-3 py-2 text-sm font-medium transition-opacity">
            Contact
          </a>
          <a href="/login" class="rounded-full border border-gray-300 px-4 py-2 text-sm font-semibold text-primary-600 hover:border-primary-600 hover:bg-primary-50 transition-all duration-200">
            Sign In
          </a>
          <a href="/register" class="rounded-full bg-primary-600 px-5 py-2 text-sm font-semibold text-white shadow-lg shadow-primary-600/30 hover:shadow-xl hover:scale-105 transition-all duration-200" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 50%, #1e40af 100%);">
            Sign Up
          </a>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<script>
  // Flag to prevent multiple logout confirmations
  let logoutInProgress = false;
  
  // Centralized logout function - make it globally accessible
  window.performLogout = function performLogout(skipConfirm) {
    // Prevent multiple simultaneous logout attempts
    if (logoutInProgress) {
      console.log('[NAV] Logout already in progress, ignoring duplicate call');
      return;
    }
    
    console.log('[NAV] performLogout called', { skipConfirm: skipConfirm });
    
    // Only show confirm dialog if not explicitly skipped
    // For user-initiated logouts, always show confirm
    if (!skipConfirm) {
      if (!confirm('Are you sure you want to log out?')) {
        return;
      }
    }
    
    logoutInProgress = true;
    console.log('[NAV] User confirmed logout');
    
    // Always clear tokens first (client-side)
    console.log('[NAV] Clearing client-side tokens...');
    localStorage.removeItem('access_token');
    
    // Clear all cookies
    const cookieOptions = 'path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
    document.cookie = `access_token=; ${cookieOptions}`;
    document.cookie = `refresh_token=; ${cookieOptions}`;
    document.cookie = `proof_refresh_token=; ${cookieOptions}`;
    
    // Try to call logout API (non-blocking, fire and forget)
    fetch('/auth/logout', {
      method: 'POST',
      credentials: 'include',
      headers: {
        'Content-Type': 'application/json'
      }
    }).catch(() => {
      // Ignore errors
    });
    
    // Force redirect immediately (don't wait for anything)
    console.log('[NAV] Redirecting to home page immediately');
    window.location.href = '/';
  }
  
  // Setup logout button - simplified and more reliable
  (function() {
    function attachLogoutHandler() {
      const logoutBtn = document.getElementById('logout-btn');
      if (!logoutBtn) {
        // Button not found yet, will retry
        return false;
      }
      
      // Check if handler is already attached
      if (logoutBtn.dataset.handlerAttached === 'true') {
        return true;
      }
      
      // Mark as attached
      logoutBtn.dataset.handlerAttached = 'true';
      
      // Attach handler directly to button
      logoutBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        console.log('[NAV] Logout button clicked');
        
        // Call logout function
        if (window.performLogout) {
          window.performLogout();
        } else {
          console.error('[NAV] performLogout function not found!');
        }
      });
      
      console.log('[NAV] ✅ Logout button handler attached successfully');
      return true;
    }
    
    // Try to attach immediately
    if (attachLogoutHandler()) {
      // Success - handler attached
    } else {
      // Button not found, set up retries
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          attachLogoutHandler();
        });
      }
      
      // Retry with delays
      setTimeout(() => attachLogoutHandler(), 100);
      setTimeout(() => attachLogoutHandler(), 500);
      setTimeout(() => attachLogoutHandler(), 1000);
    }
    
    // Ensure My Drafts link works
    (function() {
      function setupDraftsLink() {
        const draftsLink = document.getElementById('my-drafts-link');
        if (draftsLink && !draftsLink.dataset.handlerAttached) {
          draftsLink.dataset.handlerAttached = 'true';
          draftsLink.addEventListener('click', function(e) {
            console.log('[NAV] My Drafts link clicked, navigating to /drafts');
            // Allow default navigation
          }, false);
          console.log('[NAV] My Drafts link handler attached');
        }
      }
      
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupDraftsLink);
      } else {
        setupDraftsLink();
      }
      
      setTimeout(setupDraftsLink, 100);
    })();
  })();
</script>

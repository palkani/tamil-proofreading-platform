<style>
/* CRITICAL for the freeze: the compiled output.css sets `html{overflow-x:hidden}`,
   which turns <html> into a scroll container and SILENTLY BREAKS position:sticky on
   the header. `overflow-x: clip` still prevents horizontal scroll but does NOT create
   a scroll container, so sticky works. Shipped here because output.css lags input.css. */
html, body {
  overflow-x: clip;
}
/* Freeze the whole header (nav + promo ribbon) at the top of the viewport on scroll.
   Kept here in the partial's own <style> so it always ships — the compiled
   public/css/output.css can lag behind input.css. */
.site-nav {
  position: sticky;
  top: 0;
  z-index: 50;
}
.promo-stripe {
  background: linear-gradient(90deg, #1E1B4B 0%, #312E81 30%, #4F46E5 60%, #312E81 85%, #1E1B4B 100%);
  color: #fff;
  overflow: hidden;
  border-bottom: 1px solid rgba(99,102,241,0.25);
  box-shadow: 0 2px 10px rgba(30,27,75,0.30);
  /* Freezes directly under the nav. Offset = nav height (h-14 = 56px, h-16 = 64px ≥sm). */
  position: sticky;
  top: 56px;
  z-index: 49;
}
@media (min-width: 640px) {
  .promo-stripe { top: 64px; }
}
.promo-stripe-inner {
  padding: 0.55rem 0;
  overflow: hidden;
  position: relative;
}
.promo-stripe-track {
  display: flex;
  align-items: center;
  width: max-content;
  will-change: transform;
  /* Seamless marquee: the track holds two identical sets (A + B), so translating by
     exactly -50% scrolls one full set and loops with no visible jump. Pure CSS — no
     JS timing/measurement to get wrong. */
  animation: promo-marquee 45s linear infinite;
}
/* Pause on hover so users can read a line. */
.promo-stripe-inner:hover .promo-stripe-track {
  animation-play-state: paused;
}
@keyframes promo-marquee {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

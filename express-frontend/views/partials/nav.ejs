<nav class="bg-white border-b border-gray-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <!-- Logo & Main Nav -->
      <div class="flex">
        <div class="flex-shrink-0 flex items-center">
          <a href="/" class="flex items-center gap-2">
            <img src="/images/tamil-logo.svg" alt="ProofTamil Logo" class="w-10 h-10">
            <span class="text-lg font-semibold text-gray-900">ProofTamil</span>
          </a>
        </div>
        <div class="hidden sm:ml-8 sm:flex sm:space-x-4">
          <a href="/dashboard" class="<%= active === 'dashboard' ? 'border-primary-600 text-primary-600' : 'border-transparent text-gray-600 hover:text-primary-600' %> inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors">
            Dashboard
          </a>
          <a href="/workspace" class="<%= active === 'workspace' ? 'border-primary-600 text-primary-600' : 'border-transparent text-gray-600 hover:text-primary-600' %> inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors">
            Workspace
          </a>
          <a href="/archive" class="<%= active === 'archive' ? 'border-primary-600 text-primary-600' : 'border-transparent text-gray-600 hover:text-primary-600' %> inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors">
            Archive
          </a>
          <% if (user && (user.role === 'admin' || user.email === 'prooftamil@gmail.com')) { %>
          <a href="/analytics" class="<%= active === 'analytics' ? 'border-primary-600 text-primary-600' : 'border-transparent text-gray-600 hover:text-primary-600' %> inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors">
            📊 Analytics
          </a>
          <% } %>
        </div>
      </div>

      <!-- User Menu / Auth Links -->
      <div class="flex items-center gap-4">
        <% if (user && user.email) { %>
          <!-- Authenticated User Menu -->
          <a href="/contact" class="<%= active === 'contact' ? 'text-primary-600 font-semibold' : 'text-primary-600 hover:opacity-80' %> inline-flex items-center px-3 py-2 text-sm font-medium transition-opacity">
            Contact
          </a>
          <span class="text-sm text-gray-600 hidden sm:inline"><%= user.email %></span>
          <a href="/account" class="<%= active === 'account' ? 'text-primary-600' : 'text-gray-600 hover:text-primary-600' %> p-2 rounded-full hover:bg-gray-100 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </a>
          <button id="logout-btn" class="text-gray-600 hover:text-primary-600 p-2 rounded-full hover:bg-gray-100 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
          </button>
        <% } else { %>
          <!-- Unauthenticated User - Show Login/Signup Links -->
          <a href="/contact" class="<%= active === 'contact' ? 'text-primary-600 font-semibold' : 'text-primary-600 hover:opacity-80' %> inline-flex items-center px-3 py-2 text-sm font-medium transition-opacity">
            Contact
          </a>
          <a href="/login" class="rounded-full border border-gray-300 px-4 py-2 text-sm font-semibold text-primary-600 hover:border-primary-600 hover:bg-primary-50 transition-all duration-200">
            Sign In
          </a>
          <a href="/register" class="rounded-full bg-primary-600 px-5 py-2 text-sm font-semibold text-white shadow-lg shadow-primary-600/30 hover:shadow-xl hover:scale-105 transition-all duration-200" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 50%, #1e40af 100%);">
            Sign Up
          </a>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<script>
  document.getElementById('logout-btn')?.addEventListener('click', () => {
    if (confirm('Are you sure you want to log out?')) {
      window.location.href = '/';
    }
  });
</script>

<% if (typeof shutdownMode !== 'undefined' && shutdownMode) { %>
<div role="alert" aria-live="polite" style="width:100%;background:#fef3c7;border-bottom:1px solid #f59e0b;color:#78350f;font-size:0.9rem;">
  <div style="max-width:80rem;margin:0 auto;padding:0.65rem 1rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
    <div style="display:flex;align-items:center;gap:0.5rem;min-width:0;flex:1;">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0;" aria-hidden="true">
        <path d="M12 2L1 21h22L12 2zm0 3.83L19.53 19H4.47L12 5.83zM11 10v4h2v-4h-2zm0 6v2h2v-2h-2z"/>
      </svg>
      <span>
        <strong>ProofTamil is closing.</strong>
        AI proofreading, OCR and editing tools have been turned off.
        Please download or copy your drafts &mdash; your existing account still works for reading and export.
      </span>
    </div>
    <a href="/drafts"
       style="color:#78350f;text-decoration:underline;text-underline-offset:2px;white-space:nowrap;font-weight:600;">
      Go to My Drafts &rarr;
    </a>
  </div>
</div>
<% } %>

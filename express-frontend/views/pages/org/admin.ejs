<%- include('../../partials/header') %>

<%- include('../../partials/nav', { active: '', user: user }) %>

<div class="min-h-screen bg-gray-50 py-8 sm:py-10">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">

    <!-- Header -->
    <header class="mb-8">
      <a href="/org" class="text-sm text-primary-600 hover:underline">← All organizations</a>
      <div class="flex items-start justify-between gap-6 flex-wrap mt-3">
        <div class="min-w-0">
          <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900"><%= org.name %></h1>
          <p class="text-sm text-gray-500 mt-1">
            <%= org.member_count %> member<%= org.member_count === 1 ? '' : 's' %>
            · <%= org.seats_used %> / <%= org.seat_count %> seat<%= org.seat_count === 1 ? '' : 's' %> in use
            <% if (org.pending_invite_count > 0) { %>
              · <%= org.pending_invite_count %> pending invite<%= org.pending_invite_count === 1 ? '' : 's' %>
            <% } %>
          </p>
        </div>
        <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider <%= myRole === 'owner' ? 'bg-indigo-100 text-indigo-700' : myRole === 'editor' ? 'bg-blue-100 text-blue-700' : 'bg-gray-100 text-gray-700' %>">
          You: <%= myRole %>
        </span>
      </div>
      <% if (mockMode) { %>
        <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-2 text-xs text-amber-800">
          <b>Mock mode.</b> Backend not yet implemented — all changes are in-memory and reset on server restart.
        </div>
      <% } %>
    </header>

    <!-- Section: Members -->
    <section class="bg-white rounded-2xl border border-gray-200 shadow-sm mb-6">
      <div class="p-6 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-lg font-bold text-gray-900">Members</h2>
        <span class="text-xs text-gray-500"><%= members.length %> total</span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-100 text-left text-xs uppercase tracking-wider text-gray-500">
              <th class="px-6 py-3 font-semibold">Name</th>
              <th class="px-6 py-3 font-semibold">Email</th>
              <th class="px-6 py-3 font-semibold">Role</th>
              <th class="px-6 py-3 font-semibold text-right"><%= myRole === 'owner' ? 'Actions' : '' %></th>
            </tr>
          </thead>
          <tbody id="members-tbody">
            <% members.forEach(function (m) { %>
              <tr class="border-b border-gray-50" data-user-id="<%= m.user_id %>">
                <td class="px-6 py-4"><%= m.name || '—' %></td>
                <td class="px-6 py-4 text-gray-600"><%= m.email %></td>
                <td class="px-6 py-4">
                  <% if (myRole === 'owner' && m.email !== user.email) { %>
                    <select class="member-role-select rounded-lg border border-gray-300 px-2 py-1.5 text-sm">
                      <option value="reader" <%= m.role === 'reader' ? 'selected' : '' %>>Reader</option>
                      <option value="editor" <%= m.role === 'editor' ? 'selected' : '' %>>Editor</option>
                      <option value="owner"  <%= m.role === 'owner'  ? 'selected' : '' %>>Owner</option>
                    </select>
                  <% } else { %>
                    <span class="px-2 py-1 rounded-full text-xs font-semibold <%= m.role === 'owner' ? 'bg-indigo-100 text-indigo-700' : m.role === 'editor' ? 'bg-blue-100 text-blue-700' : 'bg-gray-100 text-gray-700' %>"><%= m.role %></span>
                  <% } %>
                </td>
                <td class="px-6 py-4 text-right">
                  <% if (myRole === 'owner' && m.email !== user.email) { %>
                    <button class="member-remove-btn text-sm text-red-600 hover:text-red-700 font-medium">Remove</button>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </section>

    <% if (myRole === 'owner') { %>
    <!-- Section: Invite (Owner only) -->
    <section class="bg-white rounded-2xl border border-gray-200 shadow-sm mb-6">
      <div class="p-6 border-b border-gray-100">
        <h2 class="text-lg font-bold text-gray-900">Invite teammates</h2>
        <p class="text-sm text-gray-500 mt-1"><%= org.seats_available %> seat<%= org.seats_available === 1 ? '' : 's' %> available. Paste one email per line.</p>
      </div>
      <div class="p-6">
        <textarea id="invite-emails" rows="3" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none" placeholder="a@example.com&#10;b@example.com"></textarea>
        <div class="flex flex-wrap items-center gap-4 mt-4">
          <label class="text-sm font-medium text-gray-700">Role:
            <select id="invite-role" class="ml-2 rounded-lg border border-gray-300 px-3 py-2 text-sm">
              <option value="editor" selected>Editor — can create + edit drafts</option>
              <option value="reader">Reader — view + comment only</option>
            </select>
          </label>
          <button id="invite-send-btn" class="ml-auto inline-flex items-center gap-2 rounded-full bg-primary-600 text-white text-sm font-semibold px-5 py-2.5 hover:bg-primary-700 transition disabled:opacity-60">
            Send invites
          </button>
        </div>
        <div id="invite-status" class="hidden mt-4 text-sm rounded-lg px-3 py-2"></div>
      </div>

      <% if (invites.length > 0) { %>
        <div class="border-t border-gray-100">
          <div class="p-6 pb-3"><h3 class="text-sm font-semibold text-gray-900">Pending invites</h3></div>
          <ul id="pending-invites">
            <% invites.forEach(function (i) { %>
              <li class="px-6 py-3 flex items-center justify-between border-t border-gray-50 text-sm" data-invite-id="<%= i.id %>">
                <div>
                  <span class="text-gray-900"><%= i.email %></span>
                  <span class="ml-2 px-2 py-0.5 rounded-full text-xs font-semibold <%= i.role === 'editor' ? 'bg-blue-100 text-blue-700' : 'bg-gray-100 text-gray-700' %>"><%= i.role %></span>
                </div>
                <button class="invite-revoke-btn text-sm text-gray-500 hover:text-red-600">Revoke</button>
              </li>
            <% }); %>
          </ul>
        </div>
      <% } %>
    </section>

    <!-- Section: Seats + Settings (Owner only) -->
    <section class="bg-white rounded-2xl border border-gray-200 shadow-sm mb-6">
      <div class="p-6 border-b border-gray-100"><h2 class="text-lg font-bold text-gray-900">Seats &amp; billing</h2></div>
      <div class="p-6">
        <p class="text-sm text-gray-700 mb-4">You have <b><%= org.seat_count %></b> seat<%= org.seat_count === 1 ? '' : 's' %> · <b><%= org.seats_used %></b> in use.</p>
        <button id="manage-seats-btn" class="inline-flex items-center gap-2 rounded-full border border-primary-200 text-primary-700 text-sm font-semibold px-5 py-2 hover:bg-blue-50 transition">Manage seats</button>
      </div>
    </section>

    <section class="bg-white rounded-2xl border border-gray-200 shadow-sm">
      <div class="p-6 border-b border-gray-100"><h2 class="text-lg font-bold text-gray-900">Organization settings</h2></div>
      <div class="p-6 space-y-4">
        <label class="block">
          <span class="text-sm font-medium text-gray-700 block mb-1.5">Name</span>
          <input id="org-name-input" type="text" value="<%= org.name %>" class="w-full max-w-md rounded-xl border border-gray-300 px-4 py-2.5 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none" />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-gray-700 block mb-1.5">Data retention (days)</span>
          <input id="org-retention-input" type="number" min="7" max="3650" value="<%= org.data_retention_days || 30 %>" class="w-40 rounded-xl border border-gray-300 px-4 py-2.5 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none" />
          <p class="text-xs text-gray-500 mt-1">Drafts, logs, and metadata are deleted this many days after your account is deleted. 7 – 3650 days.</p>
        </label>
        <button id="settings-save-btn" class="inline-flex items-center gap-2 rounded-full bg-primary-600 text-white text-sm font-semibold px-5 py-2 hover:bg-primary-700 transition disabled:opacity-60">Save settings</button>
        <span id="settings-status" class="hidden text-sm ml-3"></span>
      </div>
    </section>
    <% } %>

  </div>
</div>

<script>
(function () {
  var ORG_ID = <%- JSON.stringify(org.id) %>;
  var MY_ROLE = <%- JSON.stringify(myRole) %>;

  function jsonFetch(method, path, body) {
    return fetch(path, {
      method,
      credentials: 'include',
      headers: body ? { 'Content-Type': 'application/json' } : {},
      body: body ? JSON.stringify(body) : undefined,
    }).then(async function (r) {
      var data = null; try { data = await r.json(); } catch (_) {}
      if (!r.ok) throw new Error((data && (data.error || data.message)) || ('HTTP ' + r.status));
      return data;
    });
  }
  function toast(el, cls, msg) {
    if (!el) return;
    el.className = 'mt-4 text-sm rounded-lg px-3 py-2 ' + cls;
    el.textContent = msg;
    el.classList.remove('hidden');
  }

  // ── Member role change ────────────────────────────────────────────────
  document.querySelectorAll('.member-role-select').forEach(function (sel) {
    var originalValue = sel.value;
    sel.addEventListener('change', async function () {
      var tr = sel.closest('tr');
      var uid = tr.getAttribute('data-user-id');
      try {
        await jsonFetch('PATCH', '/org/' + ORG_ID + '/api/members/' + uid, { role: sel.value });
        originalValue = sel.value;
      } catch (err) {
        alert('Could not change role: ' + err.message);
        sel.value = originalValue;
      }
    });
  });

  // ── Member remove ─────────────────────────────────────────────────────
  document.querySelectorAll('.member-remove-btn').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var tr = btn.closest('tr');
      var uid = tr.getAttribute('data-user-id');
      if (!confirm('Remove this member? Their personal drafts stay with them; org drafts remain in the org.')) return;
      try {
        await jsonFetch('DELETE', '/org/' + ORG_ID + '/api/members/' + uid);
        tr.remove();
      } catch (err) { alert('Could not remove: ' + err.message); }
    });
  });

  // ── Invite send ───────────────────────────────────────────────────────
  var inviteBtn = document.getElementById('invite-send-btn');
  if (inviteBtn) {
    inviteBtn.addEventListener('click', async function () {
      var ta = document.getElementById('invite-emails');
      var status = document.getElementById('invite-status');
      var role = document.getElementById('invite-role').value;
      var emails = (ta.value || '').split(/[\s,;]+/).map(function (s) { return s.trim(); }).filter(Boolean);
      if (emails.length === 0) { toast(status, 'bg-red-50 text-red-700', 'Add at least one email.'); return; }
      inviteBtn.disabled = true;
      toast(status, 'bg-gray-50 text-gray-600', 'Sending invites…');
      try {
        var out = await jsonFetch('POST', '/org/' + ORG_ID + '/api/invites', { emails, role });
        var created = (out.created || []).length, skipped = (out.skipped || []).length;
        toast(status, 'bg-green-50 text-green-700', 'Sent ' + created + ' invite(s)' + (skipped ? ' · skipped ' + skipped : '') + '. Reload to see them.');
        ta.value = '';
      } catch (err) {
        toast(status, 'bg-red-50 text-red-700', err.message === 'seat_limit'
          ? 'Not enough seats for that many invites. Manage seats below.'
          : ('Send failed: ' + err.message));
      } finally { inviteBtn.disabled = false; }
    });
  }

  // ── Invite revoke ─────────────────────────────────────────────────────
  document.querySelectorAll('.invite-revoke-btn').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var li = btn.closest('li');
      var id = li.getAttribute('data-invite-id');
      if (!confirm('Revoke this invite? The link will stop working immediately.')) return;
      try {
        await jsonFetch('DELETE', '/org/' + ORG_ID + '/api/invites/' + id);
        li.remove();
      } catch (err) { alert('Could not revoke: ' + err.message); }
    });
  });

  // ── Manage seats → Dodo checkout ──────────────────────────────────────
  var seatsBtn = document.getElementById('manage-seats-btn');
  if (seatsBtn) {
    seatsBtn.addEventListener('click', async function () {
      var n = prompt('How many total seats?', String(<%- JSON.stringify(org.seat_count) %>));
      if (!n) return;
      var seat_count = parseInt(n, 10);
      if (!Number.isInteger(seat_count) || seat_count < 1) { alert('Enter a positive integer.'); return; }
      try {
        var r = await fetch('/api/v1/organizations/' + ORG_ID + '/billing/change-seats', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ seat_count }),
        });
        var data = await r.json();
        if (data.checkout_url) window.location.href = data.checkout_url;
      } catch (err) { alert('Could not open checkout: ' + err.message); }
    });
  }

  // ── Settings save ─────────────────────────────────────────────────────
  var settingsBtn = document.getElementById('settings-save-btn');
  if (settingsBtn) {
    settingsBtn.addEventListener('click', async function () {
      var status = document.getElementById('settings-status');
      var payload = {
        name: document.getElementById('org-name-input').value.trim(),
        data_retention_days: Number(document.getElementById('org-retention-input').value),
      };
      settingsBtn.disabled = true;
      try {
        await jsonFetch('PATCH', '/org/' + ORG_ID + '/api/settings', payload);
        if (status) { status.textContent = 'Saved.'; status.className = 'text-sm ml-3 text-green-700'; status.classList.remove('hidden'); }
      } catch (err) {
        if (status) { status.textContent = 'Save failed: ' + err.message; status.className = 'text-sm ml-3 text-red-700'; status.classList.remove('hidden'); }
      } finally { settingsBtn.disabled = false; }
    });
  }
})();
</script>

<%- include('../../partials/footer') %>

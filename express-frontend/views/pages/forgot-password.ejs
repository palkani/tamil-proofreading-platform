<%- include('../partials/header') %>

<div class="min-h-screen flex items-center justify-center bg-gradient-to-b from-blue-50 to-white p-4">
  <div class="max-w-md w-full">
    <div class="bg-white rounded-2xl shadow-2xl border border-gray-200 p-8">
      <div class="text-center mb-8">
        <img src="/images/tamil-logo.svg" alt="Proofதமிழ்" class="h-16 w-auto mx-auto mb-4">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Forgot Password?</h1>
        <p class="text-gray-600">Enter your email and we'll send you a reset link</p>
      </div>

      <div id="error-message" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6"></div>
      <div id="success-message" class="hidden bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6"></div>

      <form id="forgot-password-form" class="space-y-6">
        <div>
          <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"
            placeholder="you@example.com"
          >
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full bg-primary-600 text-white py-3 px-6 rounded-lg font-semibold text-lg hover:bg-primary-500 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
        >
          Send Reset Link
        </button>
      </form>

      <div class="mt-6 text-center">
        <a href="/login" class="text-sm text-primary-600 hover:text-primary-500 font-semibold">← Back to Sign In</a>
      </div>
    </div>

    <div class="mt-8 text-center text-sm text-gray-500">
      <a href="/" class="text-primary-600 hover:text-primary-500 font-semibold">← Back to home</a>
    </div>
  </div>
</div>

<script>
document.getElementById('forgot-password-form')?.addEventListener('submit', async (e) => {
  e.preventDefault();

  const submitBtn = document.getElementById('submit-btn');
  const errorDiv  = document.getElementById('error-message');
  const successDiv = document.getElementById('success-message');
  const email = document.getElementById('email').value.trim();

  submitBtn.disabled = true;
  submitBtn.textContent = 'Sending...';
  errorDiv.classList.add('hidden');
  successDiv.classList.add('hidden');

  try {
    const response = await fetch('/auth/forgot-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email })
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data?.error || data?.message || 'Failed to send reset email. Please try again.');
    }

    // Always show a generic success message to avoid revealing whether the email exists.
    document.getElementById('forgot-password-form').classList.add('hidden');
    successDiv.textContent = 'If an account exists for that email, a password reset link has been sent. Check your inbox (and spam folder).';
    successDiv.classList.remove('hidden');
  } catch (err) {
    errorDiv.textContent = err.message || 'Something went wrong. Please try again.';
    errorDiv.classList.remove('hidden');
    submitBtn.disabled = false;
    submitBtn.textContent = 'Send Reset Link';
  }
});
</script>

<%- include('../partials/footer') %>

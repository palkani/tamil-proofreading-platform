                <span class="font-semibold">Paragraph</span>
              </button>
              <button class="dropdown-item" data-format="h1">
                <span class="font-extrabold">Heading 1</span>
              </button>
              <button class="dropdown-item" data-format="h2">
                <span class="font-bold">Heading 2</span>
              </button>
              <button class="dropdown-item" data-format="h3">
                <span class="font-semibold">Heading 3</span>
              </button>
            </div>
          </div>

          <div class="toolbar-divider"></div>

          <!-- Bold / Italic / Underline / Strikethrough -->
          <div class="toolbar-pill">
            <button class="toolbar-btn" data-command="bold" title="Bold">
              <svg class="w-5 h-5" viewBox="0 0 24 24">
                <path d="M7 5h6a4 4 0 0 1 0 8H7V5z" stroke-linejoin="round"/>
                <path d="M7 13h7a4 4 0 0 1 0 8H7v-8z" stroke-linejoin="round"/>
              </svg>
            </button>
            <button class="toolbar-btn" data-command="italic" title="Italic">
              <svg class="w-5 h-5" viewBox="0 0 24 24">
                <path d="M19 4h-7" stroke-linecap="round"/>
                <path d="M12 20H5" stroke-linecap="round"/>
                <path d="M14 4l-4 16" stroke-linecap="round"/>
              </svg>
            </button>
            <button class="toolbar-btn" data-command="underline" title="Underline">
              <svg class="w-5 h-5" viewBox="0 0 24 24">
                <path d="M7 4v6a5 5 0 0 0 10 0V4" stroke-linecap="round"/>
                <path d="M5 20h14" stroke-linecap="round"/>
              </svg>
            </button>
            <button class="toolbar-btn" data-command="strikeThrough" title="Strikethrough">
              <svg class="w-5 h-5" viewBox="0 0 24 24">
                <path d="M4 12h16" stroke-linecap="round"/>
                <path d="M8 7a4 4 0 0 1 8 0" stroke-linecap="round"/>
                <path d="M9 17a4 4 0 0 0 6.5 3.1" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
          
          <div class="toolbar-divider"></div>

          <!-- Lists -->
          <div class="toolbar-pill">
            <button class="toolbar-btn" data-command="insertUnorderedList" title="Bullet list">
              <svg class="w-5 h-5" viewBox="0 0 24 24">
                <path d="M8 6h13" stroke-linecap="round"/>
                <path d="M8 12h13" stroke-linecap="round"/>
                <path d="M8 18h13" stroke-linecap="round"/>

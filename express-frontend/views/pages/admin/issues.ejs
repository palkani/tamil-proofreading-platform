<%- include('../../partials/admin/layout-header') %>

<div class="mx-auto max-w-6xl space-y-6" id="admin-issues">
  <div class="flex items-center justify-between">
    <p class="text-sm text-slate-500">Three streams of "something needs attention" from the billing pipeline. Each row links to the affected user.</p>
    <button type="button" data-refresh
            class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Refresh</button>
  </div>

  <!-- Ops panel — trigger crons on demand + fix missing schema. Rendered
       collapsed by default; expands when a table is missing or when the
       admin explicitly asks to see maintenance actions. -->
  <section class="rounded-lg border border-slate-200 bg-white p-5" data-ops-panel>
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-sm font-semibold text-slate-900">Operations</h3>
        <p class="mt-1 text-xs text-slate-500">Run background jobs on-demand and set up any missing billing tables.</p>
      </div>
      <button type="button" data-ops-toggle
              class="text-xs font-medium text-blue-600 hover:underline">Show</button>
    </div>

    <!-- Health banner: shown when a critical table is missing -->
    <div data-ops-schema-warning class="mt-3 hidden rounded-md border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-800">
      One or more billing tables are missing. Click <strong>Setup billing tables</strong> below to create them.
    </div>

    <div data-ops-body class="mt-4 hidden space-y-3">
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        <button type="button" data-op="ensure-tables"
                class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-40">
          Setup billing tables
        </button>
        <button type="button" data-op="checkout-followup"
                class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-40">
          Run checkout follow-up now
        </button>
        <button type="button" data-op="reconciliation"
                class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-40">
          Run reconciliation now
        </button>
      </div>
      <div data-op-output class="text-xs font-mono text-slate-600"></div>
    </div>
  </section>

  <!-- Failed webhooks -->
  <section class="rounded-lg border border-slate-200 bg-white p-5">
    <div class="flex items-center justify-between">
      <h3 class="text-sm font-semibold text-slate-900">Failed webhook events</h3>
      <span class="text-xs text-slate-500" data-count="failed-webhooks">—</span>
    </div>
    <p class="mt-1 text-xs text-slate-500">
      PaymentEvent rows in state <code>failed</code>. Fix root cause, then replay from Dodo dashboard.
    </p>
    <div class="mt-3 divide-y divide-slate-100" data-panel="failed-webhooks">
      <div class="py-3 text-sm text-slate-400">Loading…</div>
    </div>
  </section>

  <!-- Drift -->
  <section class="rounded-lg border border-slate-200 bg-white p-5">
    <div class="flex items-center justify-between">
      <h3 class="text-sm font-semibold text-slate-900">Reconciliation drift</h3>
      <span class="text-xs text-slate-500" data-count="drift">—</span>
    </div>
    <p class="mt-1 text-xs text-slate-500">
      Users where the DB state doesn't match Dodo. Same query the hourly cron runs — check refreshes on button click, no alert email is sent.
    </p>
    <div class="mt-3 grid grid-cols-1 gap-3 lg:grid-cols-3">
      <div class="rounded-md border border-red-200 bg-red-50 p-3">
        <div class="text-xs font-medium text-red-800">Missed activations</div>
        <div class="mt-1 text-xs text-red-700">Paid but not Pro. Critical.</div>
        <div class="mt-2 divide-y divide-red-200" data-panel="drift-missed">
          <div class="py-2 text-sm text-red-800">—</div>
        </div>
      </div>
      <div class="rounded-md border border-amber-200 bg-amber-50 p-3">
        <div class="text-xs font-medium text-amber-800">Phantom Pro</div>
        <div class="mt-1 text-xs text-amber-700">Pro without paying subscription.</div>
        <div class="mt-2 divide-y divide-amber-200" data-panel="drift-phantom">
          <div class="py-2 text-sm text-amber-800">—</div>
        </div>
      </div>
      <div class="rounded-md border border-slate-200 bg-slate-50 p-3">
        <div class="text-xs font-medium text-slate-800">Null subscription_end</div>
        <div class="mt-1 text-xs text-slate-700">Active Pro without a renewal date.</div>
        <div class="mt-2 divide-y divide-slate-200" data-panel="drift-null">
          <div class="py-2 text-sm text-slate-800">—</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Abandoned checkouts -->
  <section class="rounded-lg border border-slate-200 bg-white p-5">
    <div class="flex items-center justify-between">
      <h3 class="text-sm font-semibold text-slate-900">Abandoned checkouts (1–24h)</h3>
      <span class="text-xs text-slate-500" data-count="abandoned">—</span>
    </div>
    <p class="mt-1 text-xs text-slate-500">
      Started Dodo checkout but never completed. Follow-up cron emails these once — items marked <code>reminded</code> below have already been notified.
    </p>
    <div class="mt-3 divide-y divide-slate-100" data-panel="abandoned">
      <div class="py-3 text-sm text-slate-400">Loading…</div>
    </div>
  </section>
</div>

<script>
(function () {
  const fmtDate = (iso) => iso ? new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '—';
  const escape = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
  const badge = (text, tone) => {
    const tones = {
      green: 'bg-emerald-50 text-emerald-700 ring-emerald-200',
      slate: 'bg-slate-100 text-slate-700 ring-slate-200',
      red: 'bg-red-50 text-red-700 ring-red-200',
      amber: 'bg-amber-50 text-amber-700 ring-amber-200',
    };
    return '<span class="inline-flex items-center rounded px-1.5 py-0.5 text-xs font-medium ring-1 ring-inset ' + (tones[tone] || tones.slate) + '">' + escape(text) + '</span>';
  };

  function renderDriftGroup(sel, rows, tone) {
    const el = document.querySelector('[data-panel="' + sel + '"]');
    if (!rows || rows.length === 0) {
      el.innerHTML = '<div class="py-2 text-xs text-slate-500">✓ Clean.</div>';
      return;
    }
    el.innerHTML = rows.map(function (u) {
      return '<a href="/admin/users/' + encodeURIComponent(u.user_id) + '" class="block py-2 text-sm hover:underline">' +
        '<span class="font-medium">' + escape(u.email || 'user #' + u.user_id) + '</span>' +
        '<div class="mt-0.5 text-xs opacity-75">' + escape(u.provider_subscription_id || '—') + '</div>' +
        '</a>';
    }).join('');
  }

  function load() {
    // Reset counters + panels
    document.querySelectorAll('[data-count]').forEach((el) => (el.textContent = '…'));

    fetch('/admin/api/issues', { credentials: 'include' })
      .then((r) => r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)))
      .then((data) => {
        // Failed webhooks
        const failedEl = document.querySelector('[data-panel="failed-webhooks"]');
        const failed = data.failed_webhooks || [];
        document.querySelector('[data-count="failed-webhooks"]').textContent = failed.length + ' row(s)';
        if (failed.length === 0) {
          failedEl.innerHTML = '<div class="py-3 text-sm text-emerald-600">✓ No failed webhook events.</div>';
        } else {
          failedEl.innerHTML = failed.map(function (w) {
            const errShort = (w.error || '').slice(0, 160);
            return '<div class="flex items-baseline justify-between gap-4 py-2 text-sm">' +
              '<div class="min-w-0"><div class="font-medium">' + escape(w.event_type) + ' · ' + escape(w.provider_event_id) + '</div>' +
              '<div class="mt-0.5 truncate text-xs text-red-700">' + escape(errShort) + '</div></div>' +
              '<div class="whitespace-nowrap text-xs text-slate-500">' + fmtDate(w.received_at) + '</div></div>';
          }).join('');
        }

        // Drift
        const drift = data.drift || {};
        const totalDrift =
          (drift.MissedActivations || []).length +
          (drift.PhantomPro || []).length +
          (drift.NullSubscriptionEnd || []).length;
        document.querySelector('[data-count="drift"]').textContent = totalDrift + ' row(s)';
        renderDriftGroup('drift-missed', drift.MissedActivations, 'red');
        renderDriftGroup('drift-phantom', drift.PhantomPro, 'amber');
        renderDriftGroup('drift-null', drift.NullSubscriptionEnd, 'slate');

        // Abandoned
        const abandonedEl = document.querySelector('[data-panel="abandoned"]');
        const abandoned = data.abandoned_checkouts || [];
        document.querySelector('[data-count="abandoned"]').textContent = abandoned.length + ' row(s)';
        if (abandoned.length === 0) {
          abandonedEl.innerHTML = '<div class="py-3 text-sm text-emerald-600">✓ No abandoned checkouts in the 1–24h window.</div>';
        } else {
          abandonedEl.innerHTML = abandoned.map(function (a) {
            const status = a.follow_up_sent_at ? badge('reminded', 'amber') : badge('pending reminder', 'slate');
            return '<div class="flex items-baseline justify-between gap-4 py-2 text-sm">' +
              '<div><a href="/admin/users/' + encodeURIComponent(a.user_id) + '" class="font-medium hover:underline">' + escape(a.email || 'user #' + a.user_id) + '</a>' +
              ' · ' + escape(a.plan_code) + ' ' + status + '</div>' +
              '<div class="whitespace-nowrap text-xs text-slate-500">Started ' + fmtDate(a.started_at) + '</div></div>';
          }).join('');
        }
      })
      .catch((err) => {
        console.error('[ADMIN/ISSUES] load failed', err);
        document.querySelectorAll('[data-panel]').forEach((el) => {
          el.innerHTML = '<div class="py-3 text-sm text-red-600">Failed to load: ' + escape(err.message) + '</div>';
        });
      });
  }

  document.querySelector('[data-refresh]').addEventListener('click', load);
  load();

  // ---- Ops panel ----
  const opsToggle = document.querySelector('[data-ops-toggle]');
  const opsBody = document.querySelector('[data-ops-body]');
  const opsWarn = document.querySelector('[data-ops-schema-warning]');
  const opsOut = document.querySelector('[data-op-output]');
  let opsOpen = false;
  function setOpsOpen(v) {
    opsOpen = v;
    opsBody.classList.toggle('hidden', !v);
    opsToggle.textContent = v ? 'Hide' : 'Show';
  }
  opsToggle.addEventListener('click', function () { setOpsOpen(!opsOpen); });

  function opsFetch(path, method) {
    opsOut.textContent = 'Running…';
    return fetch('/admin/api/ops/' + path, { method: method || 'POST', credentials: 'include' })
      .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, body: b, status: r.status }; }); })
      .then(function (res) {
        opsOut.innerHTML = '<span class="' + (res.ok ? 'text-emerald-700' : 'text-red-700') + '">' +
          (res.ok ? '✓ HTTP ' + res.status : '✗ HTTP ' + res.status) + '</span> ' +
          '<pre class="mt-2 whitespace-pre-wrap break-words rounded bg-slate-50 p-2">' +
          escape(JSON.stringify(res.body, null, 2)) + '</pre>';
        // Health may have changed after an ensure-tables call — refresh
        // the warning banner state.
        checkHealth();
        // A successful cron run may have cleared some issues — reload
        // the visible feed so the page reflects the new state.
        if (res.ok && (path === 'run-checkout-followup' || path === 'run-reconciliation')) load();
      })
      .catch(function (err) {
        opsOut.innerHTML = '<span class="text-red-700">✗ ' + escape(err.message) + '</span>';
      });
  }

  document.querySelector('[data-op="ensure-tables"]').addEventListener('click', function () {
    opsFetch('ensure-billing-tables', 'POST');
  });
  document.querySelector('[data-op="checkout-followup"]').addEventListener('click', function () {
    opsFetch('run-checkout-followup', 'POST');
  });
  document.querySelector('[data-op="reconciliation"]').addEventListener('click', function () {
    opsFetch('run-reconciliation', 'POST');
  });

  function checkHealth() {
    fetch('/admin/api/ops/health', { credentials: 'include' })
      .then(function (r) { return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)); })
      .then(function (h) {
        if (!h.all_ok) {
          opsWarn.classList.remove('hidden');
          setOpsOpen(true); // auto-expand when there's a problem
        } else {
          opsWarn.classList.add('hidden');
        }
      })
      .catch(function () { /* non-fatal — panel still works via manual open */ });
  }
  checkHealth();
})();
</script>

<%- include('../../partials/admin/layout-footer') %>

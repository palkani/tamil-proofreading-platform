<%- include('../../partials/admin/layout-header') %>

<div class="mx-auto max-w-6xl space-y-6" id="admin-user-detail" data-user-id="<%= userId %>">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <a href="/admin/users" class="text-sm text-blue-600 hover:underline">← Back to users</a>
    <div class="flex flex-wrap gap-2">
      <button type="button" data-action="send-email"
              class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Send email</button>
      <button type="button" data-action="toggle-pro"
              class="rounded-md border border-blue-600 bg-blue-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-blue-700">Grant Pro</button>
      <button type="button" data-action="impersonate"
              class="rounded-md border border-amber-500 bg-amber-500 px-3 py-1.5 text-sm font-medium text-white hover:bg-amber-600">Impersonate</button>
      <button type="button" data-action="force-logout"
              class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Force logout</button>
      <button type="button" data-action="toggle-block"
              class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Block</button>
      <button type="button" data-action="delete-user"
              class="rounded-md border border-red-600 bg-red-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-700">Delete</button>
    </div>
  </div>

  <!-- Profile card -->
  <section class="rounded-lg border border-slate-200 bg-white p-6" data-panel="profile">
    <div class="text-sm text-slate-400">Loading profile…</div>
  </section>

  <!-- Panels row 1: subscriptions + invoices -->
  <section class="grid grid-cols-1 gap-4 lg:grid-cols-2">
    <div class="rounded-lg border border-slate-200 bg-white p-5">
      <h3 class="text-sm font-semibold text-slate-900">Subscriptions</h3>
      <div class="mt-3 divide-y divide-slate-100" data-panel="subscriptions">
        <div class="py-3 text-sm text-slate-400">Loading…</div>
      </div>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-5">
      <h3 class="text-sm font-semibold text-slate-900">Invoices</h3>
      <div class="mt-3 divide-y divide-slate-100" data-panel="invoices">
        <div class="py-3 text-sm text-slate-400">Loading…</div>
      </div>
    </div>
  </section>

  <!-- Panels row 2: activity + audit -->
  <section class="grid grid-cols-1 gap-4 lg:grid-cols-2">
    <div class="rounded-lg border border-slate-200 bg-white p-5">
      <h3 class="text-sm font-semibold text-slate-900">Activity <span class="ml-1 text-xs font-normal text-slate-400">last 50</span></h3>
      <div class="mt-3 space-y-2" data-panel="activity">
        <div class="text-sm text-slate-400">Loading…</div>
      </div>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-5">
      <h3 class="text-sm font-semibold text-slate-900">Audit <span class="ml-1 text-xs font-normal text-slate-400">actions on this account</span></h3>
      <div class="mt-3 space-y-2" data-panel="audit">
        <div class="text-sm text-slate-400">Loading…</div>
      </div>
    </div>
  </section>

  <!-- Feature access — computed from the user's billing state via the
       same hasFeature() semantics the app uses at runtime. Answers
       "what can this user actually do in the app right now?" One row
       per canonical feature; green ✓ / red ✕ per access. Read-only —
       the source of truth is the user's subscription / promo code. -->
  <section class="rounded-lg border border-slate-200 bg-white p-5">
    <div class="flex items-baseline justify-between">
      <h3 class="text-sm font-semibold text-slate-900">Feature access <span class="ml-1 text-xs font-normal text-slate-400">what this user can use in the app</span></h3>
      <span id="feature-access-source" class="text-xs text-slate-500"></span>
    </div>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="text-xs uppercase tracking-wide text-slate-500">
          <tr class="border-b border-slate-100">
            <th class="py-2 pr-4 text-left font-semibold">Feature</th>
            <th class="py-2 pr-4 text-left font-semibold">Access</th>
            <th class="py-2 pr-4 text-left font-semibold">Note</th>
          </tr>
        </thead>
        <tbody id="feature-access-body" class="text-slate-700">
          <tr><td colspan="3" class="py-3 text-sm text-slate-400">Loading…</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Checkouts (usually short) -->
  <section class="rounded-lg border border-slate-200 bg-white p-5">
    <h3 class="text-sm font-semibold text-slate-900">Checkout attempts</h3>
    <div class="mt-3 divide-y divide-slate-100" data-panel="checkouts">
      <div class="py-3 text-sm text-slate-400">Loading…</div>
    </div>
  </section>
</div>

<!-- Delete user modal — replaces the fragile prompt()+confirm() double-
     dialog. The email you must type is shown in the modal (not just in
     the prompt text) so it's impossible to accidentally type a typo of
     what you thought the email was. The Delete button stays disabled
     until the typed email matches exactly (trimmed + lowercased). -->
<div id="delete-user-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4">
  <div class="w-full max-w-lg rounded-lg bg-white shadow-xl">
    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
      <h2 class="text-lg font-semibold text-red-700">Delete user permanently</h2>
      <button type="button" data-close-delete-modal class="text-slate-400 hover:text-slate-600" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <div class="px-6 py-5 space-y-4 text-sm">
      <p class="text-slate-700">
        This will permanently remove <b data-delete-modal-email class="text-slate-900 select-all font-mono">—</b>
        plus every draft, AI content item, OCR event, and active subscription.
        Payment records are kept for accounting. <b class="text-red-700">This cannot be undone.</b>
      </p>
      <div>
        <label class="block text-xs font-medium text-slate-600">Type the email to confirm</label>
        <input type="text" id="delete-modal-input" autocomplete="off" spellcheck="false"
               class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 font-mono text-sm focus:border-red-500 focus:ring-2 focus:ring-red-200 outline-none"
               placeholder="Type the email above" />
        <p class="mt-1 text-xs text-slate-500">Whitespace and case are ignored.</p>
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-600">Reason (audit log)</label>
        <input type="text" id="delete-modal-reason"
               class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none"
               placeholder="e.g. Junk signup from disposable domain" />
      </div>
      <div id="delete-modal-status" class="hidden rounded px-3 py-2 text-sm"></div>
    </div>
    <div class="flex items-center justify-end gap-2 border-t border-slate-100 px-6 py-4">
      <button type="button" data-close-delete-modal
              class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancel</button>
      <button type="button" id="delete-modal-confirm" disabled
              class="rounded-md border border-red-600 bg-red-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-700 disabled:opacity-50 disabled:cursor-not-allowed">Delete permanently</button>
    </div>
  </div>
</div>

<!-- Send-email modal (hidden by default). Rendered inline so no JS bundle
     needed. Opens via [data-action="send-email"]; closes on backdrop click
     or Escape. -->
<div id="email-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 p-4">
  <div class="w-full max-w-2xl rounded-lg bg-white shadow-xl">
    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
      <h2 class="text-lg font-semibold text-slate-900">Send email</h2>
      <button type="button" data-close-modal
              class="text-slate-400 hover:text-slate-600" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <form id="email-form" class="space-y-4 px-6 py-5">
      <div>
        <label class="block text-xs font-medium text-slate-600">To</label>
        <input type="text" data-recipient readonly
               class="mt-1 w-full rounded-md border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm text-slate-700" />
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-600">Subject</label>
        <input type="text" name="subject" required maxlength="120"
               class="mt-1 w-full rounded-md border border-slate-300 px-3 py-1.5 text-sm focus:border-blue-500 focus:outline-none" />
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-600">Body (HTML supported)</label>
        <textarea name="html" required rows="8"
                  class="mt-1 w-full rounded-md border border-slate-300 px-3 py-1.5 font-mono text-xs focus:border-blue-500 focus:outline-none"
                  placeholder="<p>Hi there,</p><p>Your message…</p>"></textarea>
        <p class="mt-1 text-xs text-slate-500">The email will be sent from contact@prooftamil.com via Resend, matching the branding of transactional emails.</p>
      </div>
      <div class="flex items-center justify-end gap-2 border-t border-slate-100 pt-4">
        <button type="button" data-close-modal
                class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancel</button>
        <button type="submit" data-send
                class="rounded-md border border-blue-600 bg-blue-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-blue-700 disabled:opacity-50">Send</button>
      </div>
      <div data-status class="text-sm"></div>
    </form>
  </div>
</div>

<script>
(function () {
  const userId = document.getElementById('admin-user-detail').dataset.userId;
  const fmtDate = (iso) => iso ? new Date(iso).toLocaleString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '—';
  const fmtCents = (cents, currency) => {
    if (cents == null) return '—';
    try {
      return new Intl.NumberFormat('en-US', { style: 'currency', currency: currency || 'USD', maximumFractionDigits: 2 }).format((cents || 0) / 100);
    } catch (e) {
      return (currency || '') + ' ' + ((cents || 0) / 100).toFixed(2);
    }
  };
  const escape = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
  const badge = (text, tone) => {
    const tones = {
      green: 'bg-emerald-50 text-emerald-700 ring-emerald-200',
      slate: 'bg-slate-100 text-slate-700 ring-slate-200',
      red: 'bg-red-50 text-red-700 ring-red-200',
      blue: 'bg-blue-50 text-blue-700 ring-blue-200',
      amber: 'bg-amber-50 text-amber-700 ring-amber-200',
    };
    return '<span class="inline-flex items-center rounded px-1.5 py-0.5 text-xs font-medium ring-1 ring-inset ' + (tones[tone] || tones.slate) + '">' + escape(text) + '</span>';
  };

  function renderProfile(p, isProActive) {
    // Capture recipient email for the email-send modal
    recipientEmail = p.email || '';
    const rows = [
      ['ID', p.id],
      ['Email', p.email],
      ['Name', p.name || '—'],
      ['Role', p.role],
      ['Plan', p.subscription + (isProActive ? ' ' : ' (inactive) ') + (p.premium_override ? ' [override]' : '')],
      ['Plan ends', fmtDate(p.subscription_end)],
      ['Country', p.country_code || '—'],
      ['Dodo customer', p.dodo_customer_id || '—'],
      ['Signed up', fmtDate(p.created_at)],
      ['Last updated', fmtDate(p.updated_at)],
      ['Active', p.is_active ? 'yes' : 'no'],
      ['Email verified', p.email_verified ? 'yes' : 'no'],
    ];
    const html = '<div class="flex items-baseline justify-between"><h2 class="text-lg font-semibold text-slate-900">' + escape(p.email) + '</h2>' +
      (isProActive ? badge('Pro active', 'green') : (p.subscription === 'pro' ? badge('Pro expired', 'amber') : badge('Free', 'slate'))) +
      '</div>' +
      '<dl class="mt-4 grid grid-cols-2 gap-y-3 text-sm">' +
      rows.map(function (r) {
        return '<dt class="text-slate-500">' + escape(r[0]) + '</dt><dd class="text-slate-900">' + escape(r[1]) + '</dd>';
      }).join('') +
      '</dl>';
    document.querySelector('[data-panel="profile"]').innerHTML = html;

    // Update action button labels based on current state
    const proBtn = document.querySelector('[data-action="toggle-pro"]');
    if (isProActive) {
      proBtn.textContent = 'Revoke Pro';
      proBtn.dataset.currentState = 'pro';
    } else {
      proBtn.textContent = 'Grant Pro';
      proBtn.dataset.currentState = 'not-pro';
    }
    // Block button reflects current state (backend sends p.is_blocked, or
    // is_active=false as a legacy signal — treat both as "blocked").
    const blockBtn = document.querySelector('[data-action="toggle-block"]');
    const isBlocked = p.is_blocked === true || p.is_active === false;
    if (isBlocked) {
      blockBtn.textContent = 'Unblock';
      blockBtn.dataset.currentState = 'blocked';
      blockBtn.classList.add('border-emerald-600', 'bg-emerald-600', 'text-white', 'hover:bg-emerald-700');
      blockBtn.classList.remove('border-slate-300', 'bg-white', 'text-slate-700', 'hover:bg-slate-50');
    } else {
      blockBtn.textContent = 'Block';
      blockBtn.dataset.currentState = 'active';
    }
  }

  // Client-side mirror of lib/entitlements.js (same BC rules). Kept
  // inline so the admin table shows accurate per-feature access with
  // zero extra fetches. Source-of-truth remains the backend billing
  // record; when backend eventually populates `entitlements` on the
  // user profile, this table reflects it automatically.
  const ADMIN_FEATURES = [
    { key: 'proofreading', label: 'Proofreading (unlimited)', note: 'AI grammar/spell checks with no word cap or daily cap' },
    { key: 'ocr',          label: 'Handwriting OCR',          note: '20 conversions per month + document mode' },
    { key: 'export',       label: 'Export (DOCX / PDF / TXT)',note: 'Download drafts as formatted documents' },
    { key: 'ai_writer',    label: 'AI content writer',        note: 'Premium quota for the blog/article generator' },
  ];
  function clientHasFeature(billing, feature) {
    if (!billing || billing.is_premium !== true) return false;
    if (!Array.isArray(billing.entitlements))    return true;   // BC path
    return billing.entitlements.includes(feature);
  }
  function renderFeatureAccess(profile, subscriptions, isProActive) {
    const tbody = document.getElementById('feature-access-body');
    const sourceEl = document.getElementById('feature-access-source');
    if (!tbody) return;
    // Build a synthetic billing object from what the profile endpoint
    // returns today. When backend adds entitlements to this endpoint
    // (or a dedicated /admin/api/users/:id/entitlements), we swap
    // this construction in one place.
    const isPremium = !!(isProActive || profile.premium_override);
    const billing = {
      is_premium:   isPremium,
      plan_code:    profile.subscription && profile.subscription !== 'free' ? String(profile.subscription).toUpperCase() : null,
      entitlements: Array.isArray(profile.entitlements) ? profile.entitlements : undefined,
    };
    // Header line — where the data came from
    if (!isPremium) {
      sourceEl.textContent = 'Free tier';
    } else if (Array.isArray(profile.entitlements)) {
      sourceEl.textContent = 'From subscription — entitlements: [' + profile.entitlements.join(', ') + ']';
    } else if (profile.premium_override) {
      sourceEl.textContent = 'Granted via admin override (Pro Full)';
    } else {
      // Existing Pro subscriber, no entitlements field yet — BC path
      sourceEl.textContent = 'Existing Pro subscriber — all features via backward-compat (backend has not populated entitlements yet)';
    }
    // Rows
    const dot = (on) => on
      ? '<span class="inline-flex items-center gap-1.5 rounded px-1.5 py-0.5 text-xs font-medium bg-emerald-50 text-emerald-800 ring-1 ring-inset ring-emerald-200">✓ Yes</span>'
      : '<span class="inline-flex items-center gap-1.5 rounded px-1.5 py-0.5 text-xs font-medium bg-slate-100 text-slate-600 ring-1 ring-inset ring-slate-200">✕ No</span>';
    tbody.innerHTML = ADMIN_FEATURES.map((f) => (
      '<tr class="border-b border-slate-50">' +
        '<td class="py-2 pr-4 font-medium text-slate-900">' + escape(f.label) + '</td>' +
        '<td class="py-2 pr-4">' + dot(clientHasFeature(billing, f.key)) + '</td>' +
        '<td class="py-2 pr-4 text-xs text-slate-500">' + escape(f.note) + '</td>' +
      '</tr>'
    )).join('');
  }

  function renderList(sel, rows, fmt, emptyText) {
    const el = document.querySelector('[data-panel="' + sel + '"]');
    if (!rows || rows.length === 0) {
      el.innerHTML = '<div class="py-3 text-sm text-slate-400">' + emptyText + '</div>';
      return;
    }
    el.innerHTML = rows.map(fmt).join('');
  }

  fetch('/admin/api/users/' + encodeURIComponent(userId), { credentials: 'include' })
    .then((r) => r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)))
    .then((data) => {
      renderProfile(data.profile, data.is_pro_active);
      renderFeatureAccess(data.profile, data.subscriptions, data.is_pro_active);
      renderList('subscriptions', data.subscriptions,
        (s) => '<div class="py-2 text-sm"><div class="flex items-baseline justify-between"><span class="font-medium">' + escape(s.plan_code) + '</span>' + badge(s.status, s.status === 'active' ? 'green' : 'slate') + '</div>' +
               '<div class="mt-1 text-xs text-slate-500">' + escape(s.provider) + ' · ' + escape(s.provider_subscription_id || '—') + '</div>' +
               '<div class="text-xs text-slate-500">Period: ' + fmtDate(s.current_period_start) + ' → ' + fmtDate(s.current_period_end) + '</div></div>',
        'No subscriptions on record.');
      renderList('invoices', data.invoices,
        (i) => '<div class="py-2 text-sm"><div class="flex items-baseline justify-between"><span class="font-medium">' + fmtCents(i.amount_cents, i.currency) + '</span>' + badge(i.status, i.status === 'paid' ? 'green' : 'amber') + '</div>' +
               '<div class="mt-1 text-xs text-slate-500">' + escape(i.provider) + ' · ' + escape(i.provider_invoice_id || '—') + '</div>' +
               '<div class="text-xs text-slate-500">Paid: ' + fmtDate(i.paid_at) + '</div></div>',
        'No invoices on record.');
      renderList('activity', data.activity,
        (a) => '<div class="flex items-baseline justify-between text-sm"><span class="text-slate-700">' + escape(a.event_type) + '</span><span class="text-xs text-slate-400">' + fmtDate(a.occurred_at) + '</span></div>',
        'No activity recorded.');
      renderList('audit', data.audit,
        (a) => '<div class="text-sm"><div class="flex items-baseline justify-between"><span class="text-slate-700">' + escape(a.action) + '</span><span class="text-xs text-slate-400">' + fmtDate(a.created_at) + '</span></div>' +
               '<div class="text-xs text-slate-500">by user #' + escape(a.actor_user_id) + ' on ' + escape(a.resource_type || '—') + '</div></div>',
        'No admin actions taken on this account.');
      renderList('checkouts', data.checkouts,
        (c) => '<div class="py-2 text-sm"><div class="flex items-baseline justify-between"><span class="font-medium">' + escape(c.plan_code) + '</span>' +
               (c.completed_at ? badge('completed', 'green') : (c.follow_up_sent_at ? badge('reminded', 'amber') : badge('abandoned', 'slate'))) + '</div>' +
               '<div class="text-xs text-slate-500">' + escape(c.provider_subscription_id || '—') + '</div>' +
               '<div class="text-xs text-slate-500">Started ' + fmtDate(c.started_at) + '</div></div>',
        'No checkout attempts recorded.');
    })
    .catch((err) => {
      document.querySelector('[data-panel="profile"]').innerHTML =
        '<div class="text-sm text-red-600">Failed to load user: ' + escape(err.message) + '</div>';
      const fab = document.getElementById('feature-access-body');
      if (fab) fab.innerHTML = '<tr><td colspan="3" class="py-3 text-sm text-red-600">Failed to load — see profile card above.</td></tr>';
    });

  // ---- Send-email modal ----
  const modal = document.getElementById('email-modal');
  const emailForm = document.getElementById('email-form');
  let recipientEmail = '';
  function openModal() {
    document.querySelector('[data-recipient]').value = recipientEmail || 'user #' + userId;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    emailForm.querySelector('[name="subject"]').focus();
  }
  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    emailForm.reset();
    emailForm.querySelector('[data-status]').innerHTML = '';
  }
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
  });
  modal.querySelectorAll('[data-close-modal]').forEach((btn) => btn.addEventListener('click', closeModal));

  document.querySelector('[data-action="send-email"]').addEventListener('click', openModal);

  emailForm.addEventListener('submit', function (e) {
    e.preventDefault();
    const btn = emailForm.querySelector('[data-send]');
    const status = emailForm.querySelector('[data-status]');
    const subject = emailForm.querySelector('[name="subject"]').value.trim();
    const html = emailForm.querySelector('[name="html"]').value;
    if (!subject || !html.trim()) {
      status.innerHTML = '<span class="text-amber-700">Subject and body are required.</span>';
      return;
    }
    btn.disabled = true;
    status.innerHTML = '<span class="text-slate-500">Sending…</span>';
    fetch('/admin/api/users/' + encodeURIComponent(userId) + '/email', {
      method: 'POST',
      credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ subject: subject, html: html }),
    })
      .then((r) => r.ok ? r.json() : r.json().then((j) => Promise.reject(new Error(j.error || 'HTTP ' + r.status))))
      .then(() => {
        status.innerHTML = '<span class="text-emerald-700">✓ Sent. Modal will close in 2 seconds.</span>';
        setTimeout(closeModal, 2000);
      })
      .catch((err) => {
        status.innerHTML = '<span class="text-red-700">Failed: ' + escape(err.message) + '</span>';
      })
      .finally(() => {
        btn.disabled = false;
      });
  });
  document.querySelector('[data-action="toggle-pro"]').addEventListener('click', function () {
    const enable = this.dataset.currentState !== 'pro';
    const reason = prompt(enable ? 'Reason for granting Pro (visible in audit log):' : 'Reason for revoking Pro (visible in audit log):');
    if (reason == null) return;
    fetch('/admin/api/users/' + encodeURIComponent(userId) + '/premium_override', {
      method: 'PATCH',
      credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ enabled: enable, reason: reason }),
    })
      .then((r) => r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)))
      .then(() => location.reload())
      .catch((err) => alert('Failed: ' + err.message));
  });
  // ── Force logout — invalidate every active session for this user.
  //    Doesn't lock the account; the user just has to sign in again.
  document.querySelector('[data-action="force-logout"]').addEventListener('click', function () {
    if (!confirm('Force logout ' + (recipientEmail || 'user #' + userId) + '?\n\n' +
                 'All of their active sessions will be invalidated immediately. ' +
                 'They can sign back in normally — this is not a block.')) return;
    fetch('/admin/api/users/' + encodeURIComponent(userId) + '/sessions/revoke', {
      method: 'POST', credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
    })
      .then((r) => r.ok ? r.json() : r.json().then((j) => Promise.reject(new Error(j.error || 'HTTP ' + r.status))))
      .then((d) => alert('Force logout complete. ' + (d && d.revoked_count != null ? d.revoked_count + ' session(s) invalidated.' : '')))
      .catch((err) => alert('Force logout failed: ' + err.message));
  });

  // ── Block / Unblock — soft. Account + data remain; login is refused
  //    with a clear "account suspended" message until unblocked. Reason
  //    is captured for the audit log.
  document.querySelector('[data-action="toggle-block"]').addEventListener('click', function () {
    const currentlyBlocked = this.dataset.currentState === 'blocked';
    const action = currentlyBlocked ? 'unblock' : 'block';
    const reason = prompt('Reason for ' + action + ' (shown to the user, saved to audit log):',
      currentlyBlocked ? 'Access restored.' : 'Account suspended for policy violation.');
    if (reason == null) return;
    fetch('/admin/api/users/' + encodeURIComponent(userId) + '/blocked', {
      method: 'PATCH', credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ blocked: !currentlyBlocked, reason: reason }),
    })
      .then((r) => r.ok ? r.json() : r.json().then((j) => Promise.reject(new Error(j.error || 'HTTP ' + r.status))))
      .then(() => location.reload())
      .catch((err) => alert(action + ' failed: ' + err.message));
  });

  // ── Delete user — permanent. Uses a proper modal (replaces the
  //    fragile prompt()+confirm() double-dialog which was easy to
  //    mistype because the email lived in the prompt text). The
  //    modal SHOWS the email; the operator just re-types it to
  //    confirm, and the confirm button stays disabled until the
  //    typed value matches. Whitespace / NBSP / case are normalised.
  const delModal   = document.getElementById('delete-user-modal');
  const delInput   = document.getElementById('delete-modal-input');
  const delReason  = document.getElementById('delete-modal-reason');
  const delStatus  = document.getElementById('delete-modal-status');
  const delConfirm = document.getElementById('delete-modal-confirm');
  const delEmailEl = document.querySelector('[data-delete-modal-email]');
  // Robust normaliser: strips regular + non-breaking whitespace, then lowercases.
  const norm = (s) => String(s || '').replace(/[\s ​‌‍﻿]+/g, '').toLowerCase();

  function openDeleteModal() {
    const email = recipientEmail || '';
    if (!email) {
      alert('User email not loaded yet. Wait for the profile to appear and try again.');
      return;
    }
    delEmailEl.textContent = email;
    delInput.value = '';
    delReason.value = '';
    delConfirm.disabled = true;
    delStatus.classList.add('hidden');
    delStatus.innerHTML = '';
    delModal.classList.remove('hidden');
    delModal.classList.add('flex');
    setTimeout(() => delInput.focus(), 50);
  }
  function closeDeleteModal() {
    delModal.classList.add('hidden');
    delModal.classList.remove('flex');
  }
  delModal.addEventListener('click', (e) => { if (e.target === delModal) closeDeleteModal(); });
  delModal.querySelectorAll('[data-close-delete-modal]').forEach((b) => b.addEventListener('click', closeDeleteModal));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !delModal.classList.contains('hidden')) closeDeleteModal();
  });

  // Live enable/disable the confirm button as the user types.
  delInput.addEventListener('input', function () {
    const email = recipientEmail || '';
    delConfirm.disabled = !email || norm(delInput.value) !== norm(email);
  });

  document.querySelector('[data-action="delete-user"]').addEventListener('click', openDeleteModal);

  delConfirm.addEventListener('click', async function () {
    delConfirm.disabled = true;
    delStatus.className = 'rounded px-3 py-2 text-sm bg-slate-100 text-slate-700';
    delStatus.textContent = 'Deleting…';
    delStatus.classList.remove('hidden');
    try {
      const r = await fetch('/admin/api/users/' + encodeURIComponent(userId) + '?reason=' + encodeURIComponent(delReason.value.trim()), {
        method: 'DELETE', credentials: 'include',
      });
      if (!r.ok) {
        let msg = 'HTTP ' + r.status;
        try { const j = await r.json(); if (j.error || j.message) msg = j.error || j.message; } catch (_) {}
        throw new Error(msg);
      }
      delStatus.className = 'rounded px-3 py-2 text-sm bg-emerald-100 text-emerald-800';
      delStatus.textContent = '✓ User deleted. Returning to users list…';
      setTimeout(() => { window.location.href = '/admin/users'; }, 1200);
    } catch (err) {
      delStatus.className = 'rounded px-3 py-2 text-sm bg-red-100 text-red-800';
      delStatus.textContent = 'Delete failed: ' + err.message;
      delConfirm.disabled = false;
    }
  });

  document.querySelector('[data-action="impersonate"]').addEventListener('click', function () {
    if (!confirm('Start impersonation session as ' + (recipientEmail || 'user #' + userId) + '?\n\n' +
                 'You will browse the site AS this user for 30 minutes. Every action is audit-logged.\n' +
                 'End the session with the banner shown at the top of every page.')) return;
    fetch('/admin/api/users/' + encodeURIComponent(userId) + '/impersonate', {
      method: 'POST', credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
    })
      .then((r) => r.ok ? r.json() : r.json().then((j) => Promise.reject(new Error(j.error || 'HTTP ' + r.status))))
      .then((data) => {
        // Preserve the admin's original token so "End impersonation" can
        // restore it. We stash it in a cookie; it's marked path=/ so any
        // page in the app can read it and inject the banner.
        const cookies = document.cookie.split(';').reduce((a, c) => { const [k, v] = c.trim().split('='); a[k] = v; return a; }, {});
        const originalToken = cookies['access_token'];
        if (originalToken) {
          document.cookie = 'admin_original_token=' + originalToken + '; path=/; max-age=1800; SameSite=Lax';
        }
        // Swap access_token to the impersonation token.
        document.cookie = 'access_token=' + data.access_token + '; path=/; max-age=1800; SameSite=Lax';
        // Redirect to homepage as the impersonated user.
        window.location.href = '/';
      })
      .catch((err) => alert('Impersonation failed: ' + err.message));
  });
})();
</script>


<%- include('../../partials/admin/layout-header', { title, user, activeTab, navItems }) %>

<div class="mx-auto max-w-6xl">
  <div class="mb-6 flex items-start justify-between gap-4">
    <div>
      <h2 class="text-xl font-semibold text-slate-900">Blog generator</h2>
      <p class="mt-1 text-sm text-slate-500">
        Queue lives in <code class="rounded bg-slate-100 px-1 py-0.5 text-xs">data/blog-queue.yaml</code>.
        Clicking <strong>Generate &amp; Publish</strong> runs the AI writer, validates SEO quality,
        and publishes the post live. Nothing goes to the queue itself — this is one-off, per-topic.
      </p>
    </div>
    <div class="text-right text-xs text-slate-500">
      <div id="summary-counts">Loading queue…</div>
    </div>
  </div>

  <!-- Top-line status area -->
  <div id="status-banner" class="mb-4 hidden rounded-md border p-3 text-sm"></div>

  <!-- Filter chips -->
  <div class="mb-4 flex flex-wrap gap-2 text-xs">
    <button type="button" data-filter="pending" class="filter-chip rounded-full bg-blue-100 px-3 py-1 font-medium text-blue-900 hover:bg-blue-200">
      Ready to generate
    </button>
    <button type="button" data-filter="generated" class="filter-chip rounded-full bg-emerald-100 px-3 py-1 font-medium text-emerald-900 hover:bg-emerald-200">
      Already generated
    </button>
    <button type="button" data-filter="all" class="filter-chip rounded-full bg-slate-200 px-3 py-1 font-medium text-slate-800 hover:bg-slate-300">
      Show all
    </button>
  </div>

  <!-- Queue table -->
  <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
        <tr>
          <th class="px-4 py-3 text-left">#</th>
          <th class="px-4 py-3 text-left">Topic</th>
          <th class="px-4 py-3 text-left">Keyword</th>
          <th class="px-4 py-3 text-left">Lang</th>
          <th class="px-4 py-3 text-left">Tier</th>
          <th class="px-4 py-3 text-left">Status</th>
          <th class="px-4 py-3 text-right">Action</th>
        </tr>
      </thead>
      <tbody id="queue-tbody" class="divide-y divide-slate-100 bg-white">
        <tr><td colspan="7" class="px-4 py-8 text-center text-slate-400">Loading topics…</td></tr>
      </tbody>
    </table>
  </div>

  <p class="mt-4 text-xs text-slate-400">
    Each generation call takes 60–90 seconds (AI content + quality gate + publish + sitemap ping).
    The button stays disabled with a spinner until it finishes — leave the tab open.
  </p>
</div>

<script>
(function() {
  const tbody = document.getElementById('queue-tbody');
  const summary = document.getElementById('summary-counts');
  const banner = document.getElementById('status-banner');
  let allTopics = [];
  let activeFilter = 'pending';

  function fmtStatus(t) {
    if (t.already_generated) {
      const url = t.state?.view_url || (t.state?.slug ? `/blog/${t.state.slug}` : null);
      const label = t.state?.status === 'draft' ? 'draft' : 'published';
      const badge = `<span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-800">${label}</span>`;
      if (url) return `${badge} <a href="${url}" target="_blank" class="ml-2 text-xs text-blue-600 hover:underline">view</a>`;
      return badge;
    }
    if (t.status === 'queued') {
      return '<span class="rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-800">queued</span>';
    }
    return `<span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">${escapeHtml(t.status)}</span>`;
  }

  function escapeHtml(s) {
    return String(s || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function actionCell(t) {
    if (t.already_generated) {
      const reviewURL = t.state?.review_url || '/my-blogs';
      return `<a href="${reviewURL}" class="text-xs text-slate-500 hover:text-slate-700 hover:underline">manage</a>`;
    }
    return `
      <div class="flex items-center justify-end gap-2">
        <button
          type="button"
          data-action="generate"
          data-index="${t.index}"
          data-publish="true"
          class="rounded-md bg-blue-900 px-3 py-1.5 text-xs font-semibold text-white shadow-sm hover:bg-blue-800 disabled:cursor-not-allowed disabled:bg-slate-300">
          Generate &amp; Publish
        </button>
        <button
          type="button"
          data-action="generate"
          data-index="${t.index}"
          data-publish="false"
          class="rounded-md border border-slate-300 bg-white px-2 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50 disabled:cursor-not-allowed disabled:bg-slate-100"
          title="Post as draft only — review at /my-blogs before publishing">
          draft only
        </button>
      </div>
    `;
  }

  function langBadge(l) {
    const cls = l === 'tamil' ? 'bg-orange-100 text-orange-800' : 'bg-slate-100 text-slate-700';
    return `<span class="rounded-full ${cls} px-2 py-0.5 text-xs font-medium">${escapeHtml(l)}</span>`;
  }

  function tierBadge(t) {
    if (t == null) return '<span class="text-xs text-slate-400">—</span>';
    const colors = { 1: 'bg-red-100 text-red-800', 2: 'bg-purple-100 text-purple-800', 3: 'bg-slate-100 text-slate-700' };
    const label = { 1: 'T1 · commercial', 2: 'T2 · authority', 3: 'T3 · tutorial' };
    return `<span class="rounded-full ${colors[t] || colors[3]} px-2 py-0.5 text-xs font-medium">${label[t] || `T${t}`}</span>`;
  }

  function render() {
    const shown = allTopics.filter((t) => {
      if (activeFilter === 'all') return true;
      if (activeFilter === 'pending') return !t.already_generated;
      if (activeFilter === 'generated') return t.already_generated;
      return true;
    });

    if (!shown.length) {
      tbody.innerHTML = `<tr><td colspan="7" class="px-4 py-8 text-center text-slate-400">No topics match this filter.</td></tr>`;
      return;
    }

    tbody.innerHTML = shown.map((t) => `
      <tr data-row-index="${t.index}" class="${t.already_generated ? 'bg-emerald-50/30' : ''}">
        <td class="px-4 py-3 text-xs text-slate-500">${t.index}</td>
        <td class="px-4 py-3 text-slate-900">
          <div class="font-medium">${escapeHtml(t.topic)}</div>
          <div class="mt-0.5 text-xs text-slate-500">${t.min_words} words min · ${t.suggested_internal_links.length} internal link${t.suggested_internal_links.length === 1 ? '' : 's'}</div>
        </td>
        <td class="px-4 py-3 text-xs text-slate-700">${escapeHtml(t.keyword)}</td>
        <td class="px-4 py-3">${langBadge(t.language)}</td>
        <td class="px-4 py-3">${tierBadge(t.tier)}</td>
        <td class="px-4 py-3">${fmtStatus(t)}</td>
        <td class="px-4 py-3 text-right">${actionCell(t)}</td>
      </tr>
    `).join('');
  }

  function setBanner(kind, html) {
    if (!kind) { banner.classList.add('hidden'); banner.innerHTML = ''; return; }
    const classes = {
      info:    'border-blue-200 bg-blue-50 text-blue-900',
      success: 'border-emerald-200 bg-emerald-50 text-emerald-900',
      error:   'border-red-200 bg-red-50 text-red-900',
    }[kind] || 'border-slate-200 bg-slate-50 text-slate-800';
    banner.className = `mb-4 rounded-md border p-3 text-sm ${classes}`;
    banner.innerHTML = html;
    banner.classList.remove('hidden');
  }

  async function loadQueue() {
    try {
      const r = await fetch('/api/blog-generator/queue', { credentials: 'include' });
      if (r.status === 403) {
        setBanner('error', 'You are not authorized to use the blog generator. Only allowlisted admin emails can publish.');
        tbody.innerHTML = '';
        summary.textContent = '';
        return;
      }
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      const data = await r.json();
      allTopics = data.topics || [];
      summary.innerHTML = `
        <div><strong>${data.total}</strong> total · <strong>${data.queued}</strong> ready · <strong>${data.already_generated}</strong> generated</div>
      `;
      render();
    } catch (err) {
      setBanner('error', `Failed to load queue: ${escapeHtml(err.message)}`);
    }
  }

  async function generate(index, publish) {
    const row = document.querySelector(`tr[data-row-index="${index}"]`);
    const buttons = row.querySelectorAll('button[data-action="generate"]');
    buttons.forEach((b) => { b.disabled = true; });

    const primary = row.querySelector('button[data-publish="true"]');
    const originalLabel = primary.innerHTML;
    const spinner = '<svg class="mr-2 inline h-3 w-3 animate-spin" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" opacity="0.25"/><path fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"/></svg>';
    primary.innerHTML = `${spinner}${publish ? 'Publishing…' : 'Generating draft…'}`;

    setBanner('info', `<strong>Generating…</strong> AI writing content, quality-gating, ${publish ? 'publishing' : 'saving as draft'}. This takes 60–90 seconds — please leave the tab open.`);

    try {
      const r = await fetch('/api/blog-generator/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ topic_index: index, publish }),
      });
      const data = await r.json();

      if (!r.ok || data.ok === false) {
        const qualityDetail = data.quality?.failures?.length
          ? `<div class="mt-1 text-xs">Quality gate: ${escapeHtml(data.quality.failures.join('; '))}</div>`
          : '';
        setBanner('error', `<strong>Generation failed.</strong> ${escapeHtml(data.error || `HTTP ${r.status}`)}${qualityDetail}`);
        buttons.forEach((b) => { b.disabled = false; });
        primary.innerHTML = originalLabel;
        return;
      }

      // Success
      const viewLink = data.view_url ? `<a href="${data.view_url}" target="_blank" class="font-semibold underline">View post</a>` : '';
      const reviewLink = data.review_url ? `<a href="${data.review_url}" target="_blank" class="ml-3 underline">Manage at /my-blogs</a>` : '';
      const statusWord = data.status === 'published' ? 'Published' : 'Saved as draft';
      setBanner('success', `<strong>${statusWord}:</strong> ${escapeHtml(data.title || data.slug)} — ${viewLink}${reviewLink}`);

      // Refresh the queue so the row updates its status/action UI
      await loadQueue();
    } catch (err) {
      setBanner('error', `<strong>Network error.</strong> ${escapeHtml(err.message)}`);
      buttons.forEach((b) => { b.disabled = false; });
      primary.innerHTML = originalLabel;
    }
  }

  // ─── Event wiring ─────────────────────────────────────────────────
  tbody.addEventListener('click', (e) => {
    const btn = e.target.closest('button[data-action="generate"]');
    if (!btn) return;
    const index = parseInt(btn.dataset.index, 10);
    const publish = btn.dataset.publish === 'true';
    if (publish) {
      if (!confirm('Generate + publish this post LIVE now?\n\nThis uses AI to write ~1500 words and pushes it to /blog immediately without a review step. Continue?')) {
        return;
      }
    }
    generate(index, publish);
  });

  document.querySelectorAll('.filter-chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      activeFilter = chip.dataset.filter;
      document.querySelectorAll('.filter-chip').forEach((c) => c.classList.remove('ring-2', 'ring-offset-1'));
      chip.classList.add('ring-2', 'ring-offset-1');
      render();
    });
  });
  // Set initial active chip
  document.querySelector('.filter-chip[data-filter="pending"]').classList.add('ring-2', 'ring-offset-1');

  loadQueue();
})();
</script>

<%- include('../../partials/admin/layout-footer') %>

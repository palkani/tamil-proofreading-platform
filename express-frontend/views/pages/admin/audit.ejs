<%- include('../../partials/admin/layout-header') %>

<div class="mx-auto max-w-6xl space-y-6">
  <header>
    <h1 class="text-2xl font-bold text-slate-900">Audit log</h1>
    <p class="mt-1 text-sm text-slate-600">Every admin page view and every admin API call, as emitted by <code class="bg-slate-100 px-1 rounded">middleware/adminAudit.js</code>.</p>
  </header>

  <section class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
    <b>Read this before treating this page as complete.</b>
    Serverless functions on Vercel have per-instance memory. What you see below
    is the ring buffer (last 500 events) from <i>this</i> function instance
    only — other instances have their own buffers, and everything resets on
    cold start. For an authoritative history across all instances and all
    time, view Vercel logs and filter by <code class="bg-amber-100 px-1 rounded">kind:admin_audit</code>.
  </section>

  <!-- Filter bar -->
  <section class="rounded-lg border border-slate-200 bg-white p-4">
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-4">
      <div>
        <label class="block text-xs font-medium text-slate-600">Actor email</label>
        <input type="text" id="filter-actor" placeholder="you@example.com" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-1.5 text-sm focus:border-blue-500 focus:outline-none" />
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-600">Event</label>
        <select id="filter-event" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-1.5 text-sm">
          <option value="">All</option>
          <option value="api">API call</option>
          <option value="page">Page view</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-600">Path contains</label>
        <input type="text" id="filter-path" placeholder="/users/42" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-1.5 text-sm focus:border-blue-500 focus:outline-none" />
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-600">Method</label>
        <select id="filter-method" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-1.5 text-sm">
          <option value="">Any</option>
          <option>GET</option><option>POST</option><option>PATCH</option><option>DELETE</option>
        </select>
      </div>
    </div>
    <div class="mt-3 flex items-center justify-between text-xs text-slate-500">
      <div id="count">Loading…</div>
      <button type="button" id="refresh-btn" class="text-blue-600 hover:underline">Refresh</button>
    </div>
  </section>

  <!-- Results table -->
  <section class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
        <tr>
          <th class="px-4 py-2 text-left">Time</th>
          <th class="px-4 py-2 text-left">Actor</th>
          <th class="px-4 py-2 text-left">Event</th>
          <th class="px-4 py-2 text-left">Method</th>
          <th class="px-4 py-2 text-left">Path</th>
          <th class="px-4 py-2 text-left">Status</th>
          <th class="px-4 py-2 text-left">IP</th>
        </tr>
      </thead>
      <tbody id="audit-tbody" class="divide-y divide-slate-100">
        <tr><td colspan="7" class="px-4 py-6 text-center text-slate-400">Loading…</td></tr>
      </tbody>
    </table>
  </section>
</div>

<script>
(function () {
  const fmtTime = (iso) => {
    try {
      return new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' });
    } catch (_) { return iso; }
  };
  const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const statusBadge = (status) => {
    if (status == null) return '<span class="text-slate-400">—</span>';
    let cls = 'bg-emerald-50 text-emerald-700 ring-emerald-200';
    if (status >= 400 && status < 500) cls = 'bg-amber-50 text-amber-700 ring-amber-200';
    if (status >= 500) cls = 'bg-red-50 text-red-700 ring-red-200';
    return '<span class="inline-flex items-center rounded px-1.5 py-0.5 text-xs font-medium ring-1 ring-inset ' + cls + '">' + status + '</span>';
  };

  let allEntries = [];

  function render() {
    const actor  = document.getElementById('filter-actor').value.trim().toLowerCase();
    const event  = document.getElementById('filter-event').value;
    const path   = document.getElementById('filter-path').value.trim().toLowerCase();
    const method = document.getElementById('filter-method').value;

    const filtered = allEntries.filter((e) => {
      if (actor && !(e.actor || '').toLowerCase().includes(actor)) return false;
      if (event && e.event !== event) return false;
      if (method && (e.method || '') !== method) return false;
      if (path && !(e.path || '').toLowerCase().includes(path)) return false;
      return true;
    });

    document.getElementById('count').textContent =
      filtered.length + ' of ' + allEntries.length + ' events shown';

    const tbody = document.getElementById('audit-tbody');
    if (filtered.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" class="px-4 py-6 text-center text-slate-400">No matching audit entries in the current ring buffer.</td></tr>';
      return;
    }
    tbody.innerHTML = filtered.map((e) =>
      '<tr class="hover:bg-slate-50">' +
        '<td class="px-4 py-2 text-slate-500">' + esc(fmtTime(e.ts)) + '</td>' +
        '<td class="px-4 py-2 text-slate-900">' + esc(e.actor || '—') + '</td>' +
        '<td class="px-4 py-2 text-slate-700">' + esc(e.event) + '</td>' +
        '<td class="px-4 py-2 text-slate-700 font-mono text-xs">' + esc(e.method || '—') + '</td>' +
        '<td class="px-4 py-2 text-slate-700 font-mono text-xs break-all">' + esc(e.path || '—') + '</td>' +
        '<td class="px-4 py-2">' + statusBadge(e.status) + (e.ms ? ' <span class="text-xs text-slate-400 ml-1">' + e.ms + 'ms</span>' : '') + '</td>' +
        '<td class="px-4 py-2 text-slate-500 text-xs">' + esc(e.ip || '—') + '</td>' +
      '</tr>'
    ).join('');
  }

  function load() {
    fetch('/admin/api/audit/snapshot', { credentials: 'include' })
      .then((r) => r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)))
      .then((d) => { allEntries = d.entries || []; render(); })
      .catch((err) => {
        document.getElementById('audit-tbody').innerHTML =
          '<tr><td colspan="7" class="px-4 py-6 text-center text-red-600">Failed to load: ' + err.message + '</td></tr>';
      });
  }

  document.getElementById('refresh-btn').addEventListener('click', load);
  ['filter-actor', 'filter-event', 'filter-path', 'filter-method'].forEach((id) =>
    document.getElementById(id).addEventListener('input', render));

  load();
  // Poll every 15 seconds while the page is open — cheap since it's a
  // pure in-memory snapshot with no upstream call.
  setInterval(load, 15000);
})();
</script>

<%- include('../../partials/admin/layout-footer') %>

<%- include('../../partials/admin/layout-header') %>

<div class="mx-auto max-w-5xl space-y-6">
  <header class="flex items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">OCR launch campaign</h1>
      <p class="mt-1 text-sm text-slate-600">One-shot announcement email for the handwriting-OCR launch. Target: Free-plan users on the newsletter list.</p>
    </div>
    <a href="/admin" class="text-sm text-blue-600 hover:underline">← Back to admin</a>
  </header>

  <!-- Meta -->
  <section class="rounded-lg border border-slate-200 bg-white p-5">
    <dl class="grid grid-cols-1 gap-3 text-sm sm:grid-cols-3">
      <div><dt class="text-xs font-semibold uppercase text-slate-500">Subject</dt><dd class="mt-1 text-slate-900"><%= subject %></dd></div>
      <div><dt class="text-xs font-semibold uppercase text-slate-500">Audience</dt><dd class="mt-1 text-slate-900">Newsletter subscribers · Free plan only</dd></div>
      <div><dt class="text-xs font-semibold uppercase text-slate-500">Recommended send window</dt><dd class="mt-1 text-slate-900">Tue or Thu, 10:00 AM IST</dd></div>
    </dl>
  </section>

  <!-- Test send -->
  <section class="rounded-lg border border-slate-200 bg-white p-5">
    <h2 class="text-lg font-semibold text-slate-900">1 · Send yourself a test</h2>
    <p class="mt-1 mb-4 text-sm text-slate-600">Sends the exact rendered email to one address so you can preview it in Gmail / Outlook / your phone. Uses the live email transport (Resend → SendGrid → SMTP).</p>
    <form id="test-send-form" class="flex flex-wrap items-end gap-3">
      <label class="flex-1 min-w-[260px]">
        <span class="block text-xs font-semibold uppercase text-slate-500 mb-1">To</span>
        <input id="test-to" type="email" required value="<%= user?.email || '' %>" class="w-full rounded border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none" />
      </label>
      <label class="w-40">
        <span class="block text-xs font-semibold uppercase text-slate-500 mb-1">Name</span>
        <input id="test-name" type="text" value="<%= user?.name || '' %>" class="w-full rounded border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none" />
      </label>
      <button id="test-send-btn" type="submit" class="rounded bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 disabled:opacity-60">Send test</button>
    </form>
    <p id="test-status" class="hidden mt-3 rounded px-3 py-2 text-sm"></p>
  </section>

  <!-- Bulk send -->
  <section class="rounded-lg border border-amber-200 bg-amber-50 p-5">
    <h2 class="text-lg font-semibold text-amber-900">2 · Send to the newsletter list</h2>
    <p class="mt-1 mb-2 text-sm text-amber-800">The <b>recommended</b> way to blast this out is through your ESP's bulk-send feature — not an in-house loop.</p>
    <p class="mt-3 mb-2 text-xs font-semibold uppercase text-amber-900">Resend Broadcasts (easiest)</p>
    <ol class="ml-5 list-decimal text-sm text-amber-900 space-y-1">
      <li>Log in to Resend → Broadcasts → New broadcast.</li>
      <li>Paste the HTML from the preview below (copy button on the right).</li>
      <li>Import your newsletter list as a CSV filtered to <code class="bg-amber-100 px-1 rounded">plan = 'free'</code>.</li>
      <li>Schedule for <b>Tue or Thu at 10:00 AM IST</b>, save.</li>
    </ol>
    <p class="mt-3 text-xs text-amber-800">Why not blast from here? Sending 1000+ from a fresh Vercel function trips spam filters. ESPs handle rate-limit warmup, unsubscribe management, and open/click tracking for free.</p>
  </section>

  <!-- Live preview -->
  <section class="rounded-lg border border-slate-200 bg-white overflow-hidden">
    <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-5 py-3">
      <h2 class="text-lg font-semibold text-slate-900">Live preview</h2>
      <div class="flex gap-2">
        <button id="copy-html-btn" class="rounded border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50">Copy HTML</button>
        <button id="copy-text-btn" class="rounded border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50">Copy plain text</button>
      </div>
    </div>
    <iframe id="email-preview" title="Email preview" srcdoc="<%- previewHtml.replace(/&/g,'&amp;').replace(/"/g,'&quot;') %>" class="w-full" style="height:900px;border:0;"></iframe>
  </section>

  <!-- Plain text fallback for accessibility + reference -->
  <details class="rounded-lg border border-slate-200 bg-white">
    <summary class="cursor-pointer px-5 py-3 text-sm font-semibold text-slate-900">Plain-text version (for CSV upload / reference)</summary>
    <pre id="plain-text-body" class="whitespace-pre-wrap border-t border-slate-200 p-5 text-xs leading-relaxed text-slate-700"><%= previewText %></pre>
  </details>
</div>

<script>
(function () {
  // ── Test send ──
  const form = document.getElementById('test-send-form');
  const btn  = document.getElementById('test-send-btn');
  const status = document.getElementById('test-status');
  function show(cls, msg) {
    status.className = 'mt-3 rounded px-3 py-2 text-sm ' + cls;
    status.textContent = msg;
    status.classList.remove('hidden');
  }
  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    const to = document.getElementById('test-to').value.trim();
    const name = document.getElementById('test-name').value.trim();
    if (!to) { show('bg-red-100 text-red-800', 'Email required.'); return; }
    btn.disabled = true; show('bg-slate-100 text-slate-700', 'Sending…');
    try {
      const r = await fetch('/admin/api/campaigns/ocr-launch/test-send', {
        method: 'POST', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ to, name }),
      });
      const d = await r.json();
      if (!r.ok || !d.ok) {
        show('bg-red-100 text-red-800', 'Send failed: ' + (d.error || ('HTTP ' + r.status)) + (d.transport ? ' [' + d.transport + ']' : ''));
      } else {
        show('bg-green-100 text-green-800', 'Sent to ' + to + ' via ' + d.transport + '. Check the inbox in a minute.');
      }
    } catch (err) {
      show('bg-red-100 text-red-800', 'Send failed: ' + err.message);
    } finally { btn.disabled = false; }
  });

  // ── Copy buttons ──
  async function copyText(text, btn) {
    try {
      await navigator.clipboard.writeText(text);
      const orig = btn.textContent;
      btn.textContent = 'Copied ✓';
      setTimeout(() => { btn.textContent = orig; }, 1500);
    } catch (_) { alert('Copy failed — select manually.'); }
  }
  document.getElementById('copy-html-btn').addEventListener('click', function () {
    const iframe = document.getElementById('email-preview');
    copyText(iframe.getAttribute('srcdoc') || '', this);
  });
  document.getElementById('copy-text-btn').addEventListener('click', function () {
    copyText(document.getElementById('plain-text-body').textContent || '', this);
  });
})();
</script>

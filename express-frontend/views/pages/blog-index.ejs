<%- include('../partials/header') %>

<%- include('../partials/nav', { active: 'blog', user: user || null }) %>

<main class="max-w-6xl mx-auto px-6 py-12">
  <div class="mb-10">
    <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight">Blog</h1>
    <p class="mt-2 text-gray-600">
      Tamil writing tips, proofreading examples, and AI-assisted workflows.
    </p>
  </div>

  <% if (error) { %>
    <div class="border border-red-200 bg-red-50 rounded-xl p-4 text-red-700">
      <div class="font-semibold">Failed to load blog posts</div>
      <div class="text-sm mt-1"><%= error %></div>
    </div>
  <% } %>

  <% if (!error && (!posts || posts.length === 0)) { %>
    <div class="border border-gray-200 bg-white rounded-2xl p-8 text-center">
      <div class="text-gray-900 font-semibold">No posts yet</div>
      <div class="text-gray-600 text-sm mt-2">Check back soon.</div>
    </div>
  <% } %>

  <% if (posts && posts.length > 0) { %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% posts.forEach((p) => { %>
        <a href="/blog/<%= p.slug %>" class="block bg-white rounded-2xl border border-gray-200 hover:border-primary-500 hover:shadow-md transition-all p-6">
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-xl font-bold text-gray-900 line-clamp-2"><%= p.title %></h2>
            <span class="text-xs px-2 py-1 rounded-full bg-primary-50 text-primary-700 whitespace-nowrap">Published</span>
          </div>

          <% if (p.excerpt) { %>
            <p class="mt-3 text-gray-600 line-clamp-3"><%= p.excerpt %></p>
          <% } else { %>
            <p class="mt-3 text-gray-600 line-clamp-3"><%= (p.content_text || '').slice(0, 180) %><%= (p.content_text || '').length > 180 ? '…' : '' %></p>
          <% } %>

          <div class="mt-4 flex items-center justify-between text-sm text-gray-500">
            <span class="inline-flex items-center gap-2">
              <span class="px-2 py-0.5 rounded bg-gray-100 text-gray-700"><%= (p.language || 'tamil') %></span>
            </span>
            <span>
              <% if (p.published_at) { %>
                <%= new Date(p.published_at).toLocaleDateString() %>
              <% } else { %>
                <%= new Date(p.created_at).toLocaleDateString() %>
              <% } %>
            </span>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>



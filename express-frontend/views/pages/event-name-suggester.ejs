<%- include('../partials/header', { title, seo, user }) %>
<link rel="stylesheet" href="/css/AIContentWriter.css" />

<div class="ai-content-writer">
  <div class="writer-container">
    <header class="writer-header">
      <div class="header-icon">🎟️</div>
      <h1 class="header-title">Event Name Suggester</h1>
      <p class="header-subtitle">Give event details and get catchy, realistic Tamil/English event name ideas.</p>
    </header>

    <div class="writer-card">
      <div class="form-section">
        <div class="form-group">
          <label class="form-label">
            <span class="label-icon">🧩</span>
            Event Type
          </label>
          <input id="ens-event-type" class="form-input" placeholder="e.g., Tamil Workshop, Product Launch, Cultural Meetup" value="Community event" />
        </div>

        <div class="settings-grid">
          <div class="form-group">
            <label class="form-label">
              <span class="label-icon">🌐</span>
              Language
            </label>
            <select id="ens-language" class="form-select">
              <option value="tamil" selected>Tamil</option>
              <option value="english">English</option>
              <option value="bilingual">Bilingual (Tamil + English)</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">
              <span class="label-icon">🎭</span>
              Tone
            </label>
            <select id="ens-tone" class="form-select">
              <option value="professional" selected>Professional</option>
              <option value="casual">Casual</option>
              <option value="academic">Academic</option>
              <option value="creative">Creative</option>
              <option value="persuasive">Persuasive</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">
              <span class="label-icon">👥</span>
              Audience
            </label>
            <input id="ens-audience" class="form-input" placeholder="e.g., Students, Writers, Founders, Families" />
          </div>

          <div class="form-group">
            <label class="form-label">
              <span class="label-icon">📍</span>
              Location
            </label>
            <input id="ens-location" class="form-input" placeholder="e.g., Chennai, Online, Coimbatore" />
          </div>

          <div class="form-group">
            <label class="form-label">
              <span class="label-icon">🗓️</span>
              Date
            </label>
            <input id="ens-date" class="form-input" placeholder="e.g., Jan 25, 2026 (optional)" />
          </div>

          <div class="form-group">
            <label class="form-label">
              <span class="label-icon">✨</span>
              Theme
            </label>
            <input id="ens-theme" class="form-input" placeholder="e.g., Tamil typing, Proofreading, Productivity" />
          </div>

          <div class="form-group">
            <label class="form-label">
              <span class="label-icon">🏷️</span>
              Keywords
            </label>
            <input id="ens-keywords" class="form-input" placeholder="comma-separated (optional)" />
          </div>

          <div class="form-group">
            <label class="form-label">
              <span class="label-icon">🔢</span>
              How many names?
            </label>
            <input id="ens-count" class="form-input" type="number" min="3" max="20" step="1" value="10" />
          </div>
        </div>

        <button id="ens-generate-btn" class="btn btn-generate">
          <span class="btn-icon">✨</span>
          Suggest Names
        </button>
      </div>

      <div id="ens-error" class="error-box" style="display:none;"></div>

      <div id="ens-result" class="result-section" style="display:none;">
        <div class="result-header">
          <h2 class="result-title">Suggestions</h2>
          <div class="result-actions">
            <button id="ens-copy-all" class="btn btn-secondary">
              <span class="btn-icon">📋</span>
              Copy All
            </button>
          </div>
        </div>
        <div id="ens-suggestions" class="space-y-3"></div>
      </div>
    </div>
  </div>
</div>

<script src="/js/event-name-suggester.js"></script>
<%- include('../partials/footer', { user }) %>



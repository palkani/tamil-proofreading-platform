<%- include('../partials/header') %>

<!-- Navigation -->
<%- include('../partials/nav', { active: 'tools', user: user || null }) %>

<div class="min-h-screen bg-gradient-to-b from-blue-50 via-white to-white py-12">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-12">
      <div class="inline-block px-4 py-2 bg-primary-100 text-primary-700 rounded-full text-sm font-semibold mb-4">
        Font Converter
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4">
        Convert Tamil Font Encodings to Unicode (and back)
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Paste Tamil text from legacy fonts like <span class="font-semibold text-gray-900">Bamini</span> or <span class="font-semibold text-gray-900">TSCII</span> and convert it to clean Unicode.
        You can also convert Unicode back to legacy encoding for compatibility.
      </p>
    </div>

    <div class="bg-white rounded-2xl shadow-xl border border-gray-200 p-6 md:p-8">
      <!-- Controls -->
      <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] gap-4 items-end">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">From</label>
          <select id="fc-from" class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-white text-gray-900 cursor-pointer focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
            <option value="auto" selected>Auto-detect</option>
            <option value="unicode">Unicode (தமிழ்)</option>
            <option value="bamini">Bamini (legacy)</option>
            <option value="tscii">TSCII v1.7 (legacy)</option>
          </select>
          <div id="fc-detected" class="mt-2 text-xs text-gray-500"></div>
        </div>

        <div class="flex items-center justify-center">
          <button id="fc-swap" type="button" class="px-4 py-3 rounded-xl border border-gray-200 bg-white text-gray-700 font-semibold hover:bg-gray-50">
            ⇄ Swap
          </button>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">To</label>
          <select id="fc-to" class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-white text-gray-900 cursor-pointer focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
            <option value="unicode" selected>Unicode (recommended)</option>
            <option value="bamini">Bamini (legacy)</option>
            <option value="tscii">TSCII v1.7 (legacy)</option>
          </select>
          <div class="mt-2 text-xs text-gray-500">
            Tip: Unicode works everywhere (WhatsApp, Google Docs). Legacy encodings require matching fonts installed.
          </div>
        </div>
      </div>

      <!-- Editors -->
      <div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div>
          <div class="flex items-center justify-between mb-2">
            <label class="text-sm font-semibold text-gray-700">Input</label>
            <button id="fc-clear" type="button" class="text-sm font-semibold text-gray-600 hover:text-gray-900">
              Clear
            </button>
          </div>
          <textarea
            id="fc-input"
            class="w-full min-h-[320px] rounded-2xl border border-gray-300 bg-white p-4 text-gray-900 tamil-text focus:outline-none focus:ring-2 focus:ring-primary-500"
            placeholder="Paste your Tamil text here…"
          ></textarea>
          <div class="mt-2 text-xs text-gray-500">
            Your text stays in your browser. No saving, no drafts.
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <label class="text-sm font-semibold text-gray-700">Output</label>
            <div class="flex items-center gap-2">
              <button id="fc-copy" type="button" class="px-3 py-2 rounded-xl bg-primary-600 text-white text-sm font-semibold hover:bg-primary-700">
                Copy
              </button>
              <button id="fc-download" type="button" class="px-3 py-2 rounded-xl border border-gray-200 bg-white text-gray-700 text-sm font-semibold hover:bg-gray-50">
                Download .txt
              </button>
            </div>
          </div>
          <textarea
            id="fc-output"
            readonly
            class="w-full min-h-[320px] rounded-2xl border border-gray-200 bg-gray-50 p-4 text-gray-900 tamil-text focus:outline-none"
            placeholder="Converted text will appear here…"
          ></textarea>
          <div id="fc-status" class="mt-2 text-xs text-gray-600"></div>

          <!-- Preview (helps users understand legacy outputs) -->
          <div class="mt-4 rounded-2xl border border-gray-200 bg-white p-4">
            <div class="text-xs font-semibold text-gray-700 mb-2">Preview</div>
            <div id="fc-preview" class="whitespace-pre-wrap break-words text-gray-900 tamil-text"></div>
            <div id="fc-preview-hint" class="mt-2 text-xs text-gray-500"></div>
          </div>
        </div>
      </div>

      <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="rounded-2xl border border-gray-200 bg-white p-5">
          <div class="text-sm font-extrabold text-gray-900">Best practice</div>
          <div class="mt-1 text-sm text-gray-600">
            Convert legacy fonts to <span class="font-semibold text-gray-900">Unicode</span> before proofreading or publishing.
          </div>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-5">
          <div class="text-sm font-extrabold text-gray-900">Auto-detect</div>
          <div class="mt-1 text-sm text-gray-600">
            Auto mode looks for Tamil Unicode letters and high-byte legacy patterns.
          </div>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-5">
          <div class="text-sm font-extrabold text-gray-900">Compatibility</div>
          <div class="mt-1 text-sm text-gray-600">
            Legacy outputs (Bamini/TSCII) require the matching font installed to look correct.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/font-converter.js"></script>
<%- include('../partials/footer') %>



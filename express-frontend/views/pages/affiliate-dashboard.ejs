<%- include('../partials/header', { seo: seo, title: title, googleClientId: typeof googleClientId !== 'undefined' ? googleClientId : '' }) %>
<%- include('../partials/nav', { user: user, active: '' }) %>

<div class="min-h-screen bg-gray-50 py-12 px-4">
  <div class="max-w-4xl mx-auto">

    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">Affiliate Dashboard</h1>
      <p class="text-gray-600 mt-1">Track your referrals, earnings, and payout status.</p>
    </div>

    <!-- Loading state -->
    <div id="aff-loading" class="text-center py-16 text-gray-400">
      <svg class="animate-spin mx-auto mb-3 w-8 h-8" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
      </svg>
      Loading affiliate data…
    </div>

    <!-- Not an affiliate state -->
    <div id="aff-not-found" class="hidden text-center py-16">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-100 mb-5">
        <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      </div>
      <h2 class="text-xl font-semibold text-gray-900 mb-2">You're not an affiliate yet</h2>
      <p class="text-gray-600 max-w-md mx-auto mb-6">
        Interested in earning commissions by referring writers to ProofTamil? Reach out to us and we'll set you up.
      </p>
      <a href="/contact" class="inline-flex items-center px-6 py-3 rounded-full bg-primary-600 text-white font-semibold hover:bg-primary-700 transition">
        Apply to join
      </a>
    </div>

    <!-- Error state -->
    <div id="aff-error" class="hidden text-center py-10 text-red-500">
      <p>Failed to load affiliate data. <button onclick="loadAffiliateData()" class="underline">Retry</button></p>
    </div>

    <!-- Affiliate dashboard -->
    <div id="aff-dashboard" class="hidden space-y-8">

      <!-- Referral link -->
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
        <h2 class="font-semibold text-gray-900 mb-3">Your Referral Link</h2>
        <div class="flex gap-3 items-center flex-wrap">
          <input
            id="referral-link-input"
            type="text"
            readonly
            class="flex-1 min-w-0 px-4 py-2 rounded-lg border border-gray-300 bg-gray-50 text-gray-800 text-sm font-mono"
            value=""
          />
          <button
            id="copy-link-btn"
            onclick="copyReferralLink()"
            class="px-4 py-2 rounded-lg bg-primary-600 text-white text-sm font-semibold hover:bg-primary-700 transition whitespace-nowrap"
          >
            Copy link
          </button>
        </div>
        <p class="mt-2 text-xs text-gray-500">Share this link. When someone signs up and subscribes, you earn a commission.</p>
        <div id="copy-feedback" class="hidden mt-2 text-xs text-green-600 font-medium">Link copied to clipboard!</div>
        <div class="mt-3 flex items-center gap-2">
          <span class="text-xs text-gray-500">Your code:</span>
          <span id="affiliate-code-badge" class="px-2 py-0.5 bg-primary-100 text-primary-800 text-xs font-bold rounded-full font-mono"></span>
          <span id="commission-badge" class="px-2 py-0.5 bg-green-100 text-green-800 text-xs font-semibold rounded-full"></span>
        </div>
      </div>

      <!-- Stats row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl border border-gray-200 p-4 text-center">
          <div id="stat-referrals" class="text-2xl font-bold text-gray-900">—</div>
          <div class="text-xs text-gray-500 mt-1">Total Referrals</div>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 p-4 text-center">
          <div id="stat-active" class="text-2xl font-bold text-gray-900">—</div>
          <div class="text-xs text-gray-500 mt-1">Active Subscribers</div>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 p-4 text-center">
          <div id="stat-total-earnings" class="text-2xl font-bold text-gray-900">—</div>
          <div class="text-xs text-gray-500 mt-1">Total Earned</div>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 p-4 text-center">
          <div id="stat-pending" class="text-2xl font-bold text-gray-900">—</div>
          <div class="text-xs text-gray-500 mt-1">Pending Payout</div>
        </div>
      </div>

      <!-- Monthly earnings table -->
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
        <h2 class="font-semibold text-gray-900 mb-4">Monthly Earnings</h2>
        <div id="earnings-loading" class="text-center text-sm text-gray-400 py-4">Loading earnings…</div>
        <div id="earnings-empty" class="hidden text-center text-sm text-gray-400 py-4">No earnings yet. Start sharing your referral link!</div>
        <div id="earnings-table-wrapper" class="hidden overflow-x-auto">
          <table class="w-full text-sm text-left">
            <thead>
              <tr class="text-xs font-semibold text-gray-500 uppercase border-b border-gray-100">
                <th class="pb-2 pr-4">Month</th>
                <th class="pb-2 pr-4 text-right">Amount</th>
                <th class="pb-2 text-right">Status</th>
              </tr>
            </thead>
            <tbody id="earnings-tbody" class="divide-y divide-gray-50">
            </tbody>
          </table>
        </div>
      </div>

      <!-- How it works -->
      <div class="bg-primary-50 rounded-2xl p-6">
        <h2 class="font-semibold text-gray-900 mb-4">How it works</h2>
        <ol class="space-y-3 text-sm text-gray-700 list-decimal list-inside">
          <li>Share your referral link with Tamil writers and content creators.</li>
          <li>When someone signs up using your link and becomes a paying subscriber, you earn a commission.</li>
          <li>Commissions are calculated monthly and paid out after a 30-day hold period.</li>
          <li>Contact us at <a href="mailto:prooftamil@gmail.com" class="text-primary-600 underline">prooftamil@gmail.com</a> to request your payout.</li>
        </ol>
      </div>

    </div><!-- /aff-dashboard -->

  </div>
</div>

<script>
(function() {
  var BASE = window.location.origin;

  function loadAffiliateData() {
    document.getElementById('aff-loading').classList.remove('hidden');
    document.getElementById('aff-not-found').classList.add('hidden');
    document.getElementById('aff-error').classList.add('hidden');
    document.getElementById('aff-dashboard').classList.add('hidden');

    fetch('/api/v1/affiliate/me', { credentials: 'include' })
      .then(function(res) {
        if (res.status === 404) { showNotFound(); return null; }
        if (!res.ok) { showError(); return null; }
        return res.json();
      })
      .then(function(data) {
        if (!data) return;
        showDashboard(data);
        loadStats();
        loadEarnings();
      })
      .catch(function() { showError(); });
  }

  function showNotFound() {
    document.getElementById('aff-loading').classList.add('hidden');
    document.getElementById('aff-not-found').classList.remove('hidden');
  }

  function showError() {
    document.getElementById('aff-loading').classList.add('hidden');
    document.getElementById('aff-error').classList.remove('hidden');
  }

  function showDashboard(data) {
    document.getElementById('aff-loading').classList.add('hidden');
    document.getElementById('aff-dashboard').classList.remove('hidden');

    // Backend returns { affiliate: {...}, referral_link: "..." }
    var aff = data.affiliate || data;
    var code = aff.affiliate_code || aff.AffiliateCode || '';
    var rate = aff.commission_rate != null ? (aff.commission_rate * 100).toFixed(0) : 25;
    // Use backend-provided referral_link if available, else build it
    var link = data.referral_link || (BASE + '/?ref=' + encodeURIComponent(code));

    document.getElementById('referral-link-input').value = link;
    document.getElementById('affiliate-code-badge').textContent = code;
    document.getElementById('commission-badge').textContent = rate + '% commission';
  }

  function loadStats() {
    fetch('/api/v1/affiliate/stats', { credentials: 'include' })
      .then(function(res) { return res.ok ? res.json() : null; })
      .then(function(data) {
        if (!data) return;
        // Backend returns { affiliate, stats: { total_signups, active_referrals, paid_users, total_commission }, referral_link }
        var stats = data.stats || data;
        document.getElementById('stat-referrals').textContent = stats.total_signups || stats.total_referrals || 0;
        document.getElementById('stat-active').textContent = stats.active_referrals || stats.paid_users || 0;
        // Total earnings from affiliate object
        var aff = data.affiliate || {};
        var total = aff.total_earnings || 0;
        var paid = aff.paid_earnings || 0;
        document.getElementById('stat-total-earnings').textContent = formatCurrency(total, 'INR');
        document.getElementById('stat-pending').textContent = formatCurrency(total - paid, 'INR');
      })
      .catch(function() {});
  }

  function loadEarnings() {
    document.getElementById('earnings-loading').classList.remove('hidden');
    fetch('/api/v1/affiliate/earnings?months=12', { credentials: 'include' })
      .then(function(res) { return res.ok ? res.json() : null; })
      .then(function(data) {
        document.getElementById('earnings-loading').classList.add('hidden');
        // Backend returns { total_earnings, paid_earnings, monthly_breakdown: [...] }
        var rows = (data && (data.monthly_breakdown || data.earnings || data.Earnings)) || [];
        if (!rows.length) {
          document.getElementById('earnings-empty').classList.remove('hidden');
          return;
        }
        var tbody = document.getElementById('earnings-tbody');
        tbody.innerHTML = '';
        rows.forEach(function(row) {
          var month = row.earning_month || row.EarningMonth || '';
          var amount = row.amount || row.Amount || 0;
          var currency = row.currency || row.Currency || 'INR';
          var status = row.status || row.Status || 'pending';
          var tr = document.createElement('tr');
          tr.className = 'text-gray-700';
          tr.innerHTML =
            '<td class="py-2 pr-4">' + escHtml(month) + '</td>' +
            '<td class="py-2 pr-4 text-right font-medium">' + formatCurrency(amount, currency) + '</td>' +
            '<td class="py-2 text-right"><span class="px-2 py-0.5 rounded-full text-xs font-semibold ' + statusClass(status) + '">' + escHtml(status) + '</span></td>';
          tbody.appendChild(tr);
        });
        document.getElementById('earnings-table-wrapper').classList.remove('hidden');
      })
      .catch(function() {
        document.getElementById('earnings-loading').classList.add('hidden');
      });
  }

  function formatCurrency(amount, currency) {
    var sym = currency === 'INR' ? '₹' : '$';
    return sym + Number(amount).toFixed(2);
  }

  function statusClass(s) {
    if (s === 'paid') return 'bg-green-100 text-green-800';
    if (s === 'locked') return 'bg-blue-100 text-blue-800';
    if (s === 'voided') return 'bg-red-100 text-red-800';
    return 'bg-yellow-100 text-yellow-800'; // pending
  }

  function escHtml(str) {
    var d = document.createElement('div');
    d.textContent = String(str);
    return d.innerHTML;
  }

  window.copyReferralLink = function() {
    var input = document.getElementById('referral-link-input');
    navigator.clipboard.writeText(input.value).then(function() {
      var fb = document.getElementById('copy-feedback');
      fb.classList.remove('hidden');
      setTimeout(function() { fb.classList.add('hidden'); }, 2500);
      document.getElementById('copy-link-btn').textContent = 'Copied!';
      setTimeout(function() { document.getElementById('copy-link-btn').textContent = 'Copy link'; }, 2500);
    }).catch(function() {
      input.select();
      document.execCommand('copy');
    });
  };

  window.loadAffiliateData = loadAffiliateData;
  loadAffiliateData();
})();
</script>

<%- include('../partials/footer') %>

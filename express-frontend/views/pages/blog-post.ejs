<%- include('../partials/header') %>

<%- include('../partials/nav', { active: 'blog', user: user || null }) %>

<!-- Blog content styling - ensure text is visible -->
<style>
  .blog-content-wrapper .prooftamil-blog,
  .blog-content-wrapper .prooftamil-blog * {
    color: #1f2937 !important;
  }
  .blog-content-wrapper .prooftamil-blog header .kicker {
    font-size: 0.75rem !important;
    font-weight: 600 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
    color: #1A2B68 !important;
    margin-bottom: 0.5rem !important;
    background: #e0e7ff !important;
    display: inline-block !important;
    padding: 0.25rem 0.75rem !important;
    border-radius: 0.25rem !important;
  }
  .blog-content-wrapper .prooftamil-blog header h1 {
    font-size: 1.5rem !important;
    font-weight: 700 !important;
    color: #111827 !important;
    line-height: 1.3 !important;
    margin: 0.5rem 0 !important;
  }
  .blog-content-wrapper .prooftamil-blog header .subhead {
    font-size: 0.875rem !important;
    color: #6b7280 !important;
    margin-bottom: 1rem !important;
  }
  .blog-content-wrapper .prooftamil-blog header .excerpt {
    font-size: 1rem !important;
    color: #374151 !important;
    line-height: 1.7 !important;
    margin-bottom: 1.5rem !important;
    padding-bottom: 1rem !important;
    border-bottom: 1px solid #e5e7eb !important;
  }
  .blog-content-wrapper .prooftamil-blog .content {
    color: #1f2937 !important;
  }
  .blog-content-wrapper .prooftamil-blog .content p {
    margin-bottom: 1rem !important;
    line-height: 1.8 !important;
    color: #1f2937 !important;
    font-size: 1.0625rem !important;
  }
  .blog-content-wrapper p {
    color: #1f2937 !important;
    margin-bottom: 1rem !important;
    line-height: 1.8 !important;
  }
</style>

<main class="max-w-4xl mx-auto px-6 py-12">
  <%
    // Localise the "Back to Blog" link based on the current post's language so
    // a Tamil reader sees a Tamil link and an English reader sees English.
    const isTamilPost = (post && post.language === 'tamil');
    const backLabel = isTamilPost ? '← வலைப்பதிவுக்குத் திரும்பு' : '← Back to Blog';
  %>
  <% if (error) { %>
    <div class="border border-red-200 bg-red-50 rounded-xl p-4 text-red-700">
      <div class="font-semibold">Failed to load blog post</div>
      <div class="text-sm mt-1"><%= error %></div>
      <div class="mt-4">
        <a href="/blog" class="text-primary-600 hover:text-primary-700 font-medium"><%= backLabel %></a>
      </div>
    </div>
  <% } else { %>
    <div class="mb-6">
      <a href="/blog" class="text-sm text-primary-600 hover:text-primary-700 font-medium"><%= backLabel %></a>
    </div>

    <article class="bg-white border border-gray-200 rounded-3xl p-8 md:p-10 shadow-sm">
      <header class="mb-8">
        <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight"><%= post.title %></h1>
        <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-gray-600">
          <span class="px-2 py-0.5 rounded bg-gray-100 text-gray-700"><%= (post.language || 'tamil') %></span>
          <span>•</span>
          <span>
            <% if (post.published_at) { %>
              <%= new Date(post.published_at).toLocaleDateString() %>
            <% } else { %>
              <%= new Date(post.created_at).toLocaleDateString() %>
            <% } %>
          </span>
        </div>

        <% if (post.meta_description) { %>
          <p class="mt-5 text-gray-700 leading-relaxed"><%= post.meta_description %></p>
        <% } %>
      </header>

      <!-- Render sanitized HTML when available (better SEO: headings/lists), fallback to text paragraphs -->
      <section class="prose prose-lg max-w-none tamil-text blog-content-wrapper">
        <% 
          const hasHtml = post.content_html && String(post.content_html).trim().length > 0;
          const hasText = post.content_text && String(post.content_text).trim().length > 0;
          console.log('[BLOG-RENDER] content_html length:', post.content_html?.length || 0, 'content_text length:', post.content_text?.length || 0);
        %>
        <% if (hasHtml) { %>
          <%- post.content_html %>
        <% } else if (hasText) { %>
          <% 
            // Split on actual newlines (double newline = paragraph break)
            const paragraphs = String(post.content_text).split(/\n\n+/);
            paragraphs.forEach((para) => { 
              const trimmed = para.trim();
              if (trimmed) { 
          %>
              <p><%= trimmed %></p>
          <%    } 
            }); 
          %>
        <% } else { %>
          <p class="text-gray-500 italic">No content available.</p>
        <% } %>
      </section>

      <!-- Keywords moved to meta tags for SEO - not displayed on page -->
    </article>

    <!-- Newsletter signup: shown to readers who reached the bottom of the article.
         Unique IDs avoid collision with the footer's form (same endpoint, separate
         binding). source="blog-inline:<slug>" lets analytics attribute signups to
         the specific post that drove them. -->
    <section class="mt-10 rounded-2xl border border-indigo-200 bg-indigo-50 p-6 sm:p-8" aria-label="Newsletter signup">
      <div class="max-w-2xl mx-auto text-center">
        <div style="font-size:0.75rem;font-weight:700;color:#4F46E5;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.625rem;">
          தமிழ் செய்திமடல் · Tamil Writing Newsletter
        </div>
        <h2 style="font-size:clamp(1.25rem,2.5vw,1.625rem);font-weight:800;color:#1E1B4B;line-height:1.3;margin:0 0 0.625rem;">
          Get one Tamil writing tip a week
        </h2>
        <p style="color:#4B5563;font-size:0.9375rem;line-height:1.55;margin:0 0 1.25rem;">
          Practical Tamil grammar, OCR, and writing-tool guides — direct to your inbox. No spam, unsubscribe anytime.
        </p>
        <form id="nl-inline-form" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
          <input
            id="nl-inline-email"
            type="email"
            required
            placeholder="your@email.com"
            class="flex-1 px-4 py-3 rounded-lg border border-gray-300 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
            autocomplete="email"
          />
          <button
            id="nl-inline-btn"
            type="submit"
            class="px-5 py-3 rounded-lg font-semibold text-white"
            style="background:linear-gradient(135deg,#4F46E5 0%,#7C3AED 100%);"
          >
            Subscribe
          </button>
        </form>
        <div id="nl-inline-message" class="mt-3 text-sm hidden"></div>
      </div>
    </section>

    <script>
    (function() {
      var form = document.getElementById('nl-inline-form');
      if (!form) return;
      var emailInput = document.getElementById('nl-inline-email');
      var btn = document.getElementById('nl-inline-btn');
      var msgEl = document.getElementById('nl-inline-message');
      var slug = <%- JSON.stringify(post && post.slug ? String(post.slug) : 'unknown') %>;

      function showMessage(msg, type) {
        msgEl.textContent = msg;
        msgEl.classList.remove('hidden', 'text-green-700', 'text-red-700');
        msgEl.classList.add(type === 'success' ? 'text-green-700' : 'text-red-700');
      }

      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var email = (emailInput.value || '').trim();
        if (!email) { showMessage('Please enter your email address.', 'error'); return; }

        btn.disabled = true;
        btn.textContent = 'Subscribing…';

        fetch('/api/newsletter/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, source: 'blog-inline:' + slug })
        })
        .then(function(res) { return res.json().catch(function() { return {}; }); })
        .then(function(data) {
          if (data && data.error) {
            showMessage(data.error, 'error');
          } else {
            showMessage((data && data.message) || 'Thanks for subscribing — check your inbox to confirm.', 'success');
            emailInput.value = '';
          }
        })
        .catch(function() { showMessage('Something went wrong. Please try again.', 'error'); })
        .finally(function() { btn.disabled = false; btn.textContent = 'Subscribe'; });
      });
    })();
    </script>
  <% } %>

  <% if (typeof relatedPosts !== 'undefined' && relatedPosts && relatedPosts.length) { %>
  <!-- Related posts: 4 sibling posts ranked by language match + keyword overlap.
       Each blog page now contributes 4 inbound links to other posts, which
       multiplies internal link graph density and unblocks "Discovered - not
       indexed" pages in Search Console. -->
  <section class="py-16 sm:py-20 bg-gray-50 border-t border-gray-200" aria-label="Related posts">
    <div class="max-w-6xl mx-auto px-6 sm:px-8">
      <div class="mb-10">
        <h2 style="font-size:clamp(1.5rem,3vw,2rem);font-weight:800;color:#111827;letter-spacing:-0.02em;margin:0 0 0.5rem;">Related posts</h2>
        <p style="color:#4B5563;font-size:1rem;margin:0;">More from the ProofTamil blog you might find useful.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <% relatedPosts.forEach(function(rp) { %>
        <a href="/blog/<%= rp.slug %>" class="block p-5 rounded-xl bg-white border border-gray-200 hover:border-indigo-300 hover:shadow-md transition" style="text-decoration:none;">
          <div style="font-size:0.7rem;font-weight:600;color:#6366F1;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.5rem;">
            <%= (rp.language || 'tamil') === 'tamil' ? 'தமிழில்' : 'In English' %>
          </div>
          <h3 style="font-size:1rem;font-weight:700;color:#111827;line-height:1.4;margin:0 0 0.625rem;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;">
            <%= rp.title %>
          </h3>
          <% if (rp.excerpt) { %>
          <p style="color:#6B7280;font-size:0.875rem;line-height:1.55;margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
            <%= rp.excerpt %>
          </p>
          <% } %>
        </a>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>
</main>

<%- include('../partials/footer') %>



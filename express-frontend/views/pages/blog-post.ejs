<%- include('../partials/header') %>

<%- include('../partials/nav', { active: 'blog', user: user || null }) %>

<!-- Blog content styling - ensure text is visible -->
<style>
  .blog-content-wrapper .prooftamil-blog,
  .blog-content-wrapper .prooftamil-blog * {
    color: #1f2937 !important;
  }
  .blog-content-wrapper .prooftamil-blog header .kicker {
    font-size: 0.75rem !important;
    font-weight: 600 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
    color: #1e3a8a !important;
    margin-bottom: 0.5rem !important;
    background: #e0e7ff !important;
    display: inline-block !important;
    padding: 0.25rem 0.75rem !important;
    border-radius: 0.25rem !important;
  }
  .blog-content-wrapper .prooftamil-blog header h1 {
    font-size: 1.5rem !important;
    font-weight: 700 !important;
    color: #111827 !important;
    line-height: 1.3 !important;
    margin: 0.5rem 0 !important;
  }
  .blog-content-wrapper .prooftamil-blog header .subhead {
    font-size: 0.875rem !important;
    color: #6b7280 !important;
    margin-bottom: 1rem !important;
  }
  .blog-content-wrapper .prooftamil-blog header .excerpt {
    font-size: 1rem !important;
    color: #374151 !important;
    line-height: 1.7 !important;
    margin-bottom: 1.5rem !important;
    padding-bottom: 1rem !important;
    border-bottom: 1px solid #e5e7eb !important;
  }
  .blog-content-wrapper .prooftamil-blog .content {
    color: #1f2937 !important;
  }
  .blog-content-wrapper .prooftamil-blog .content p {
    margin-bottom: 1rem !important;
    line-height: 1.8 !important;
    color: #1f2937 !important;
    font-size: 1.0625rem !important;
  }
  .blog-content-wrapper p {
    color: #1f2937 !important;
    margin-bottom: 1rem !important;
    line-height: 1.8 !important;
  }
</style>

<main class="max-w-4xl mx-auto px-6 py-12">
  <% if (error) { %>
    <div class="border border-red-200 bg-red-50 rounded-xl p-4 text-red-700">
      <div class="font-semibold">Failed to load blog post</div>
      <div class="text-sm mt-1"><%= error %></div>
      <div class="mt-4">
        <a href="/blog" class="text-primary-600 hover:text-primary-700 font-medium">Back to Blog</a>
      </div>
    </div>
  <% } else { %>
    <div class="mb-6">
      <a href="/blog" class="text-sm text-primary-600 hover:text-primary-700 font-medium">← Back to Blog</a>
    </div>

    <article class="bg-white border border-gray-200 rounded-3xl p-8 md:p-10 shadow-sm">
      <header class="mb-8">
        <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight"><%= post.title %></h1>
        <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-gray-600">
          <span class="px-2 py-0.5 rounded bg-gray-100 text-gray-700"><%= (post.language || 'tamil') %></span>
          <span>•</span>
          <span>
            <% if (post.published_at) { %>
              <%= new Date(post.published_at).toLocaleDateString() %>
            <% } else { %>
              <%= new Date(post.created_at).toLocaleDateString() %>
            <% } %>
          </span>
        </div>

        <% if (post.meta_description) { %>
          <p class="mt-5 text-gray-700 leading-relaxed"><%= post.meta_description %></p>
        <% } %>
      </header>

      <!-- Render sanitized HTML when available (better SEO: headings/lists), fallback to text paragraphs -->
      <section class="prose prose-lg max-w-none tamil-text blog-content-wrapper">
        <% 
          const hasHtml = post.content_html && String(post.content_html).trim().length > 0;
          const hasText = post.content_text && String(post.content_text).trim().length > 0;
          console.log('[BLOG-RENDER] content_html length:', post.content_html?.length || 0, 'content_text length:', post.content_text?.length || 0);
        %>
        <% if (hasHtml) { %>
          <%- post.content_html %>
        <% } else if (hasText) { %>
          <% 
            // Split on actual newlines (double newline = paragraph break)
            const paragraphs = String(post.content_text).split(/\n\n+/);
            paragraphs.forEach((para) => { 
              const trimmed = para.trim();
              if (trimmed) { 
          %>
              <p><%= trimmed %></p>
          <%    } 
            }); 
          %>
        <% } else { %>
          <p class="text-gray-500 italic">No content available.</p>
        <% } %>
      </section>

      <!-- Keywords moved to meta tags for SEO - not displayed on page -->
    </article>
  <% } %>
</main>

<%- include('../partials/footer') %>



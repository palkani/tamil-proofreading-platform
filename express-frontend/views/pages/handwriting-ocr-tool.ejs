<%- include('../partials/header') %>
<%- include('../partials/nav', { active: 'tools', user: user || null }) %>

<div class="min-h-screen bg-gradient-to-b from-amber-50 via-white to-white py-12">
  <div class="max-w-4xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-12">
      <div class="inline-block px-4 py-2 bg-amber-100 text-amber-800 rounded-full text-sm font-semibold mb-4">
        Tamil Handwriting to Text
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4">
        Handwritten Tamil Notes to Text
      </h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Upload an image of handwritten Tamil (notes, whiteboard, letters) and get editable text. Optimized for handwritten Tamil script.
      </p>
    </div>

    <!-- Upload Area -->
    <div class="bg-white rounded-2xl shadow-xl border border-gray-200 p-8 mb-6">
      <div 
        id="uploadArea" 
        class="border-3 border-dashed border-amber-300 rounded-xl p-12 text-center bg-amber-50 cursor-pointer transition-all hover:bg-amber-100 hover:border-amber-400"
      >
        <div class="text-6xl mb-4">✍️</div>
        <div class="text-xl font-semibold text-amber-800 mb-2">Click to upload or drag and drop</div>
        <div class="text-sm text-gray-600">Supports: JPG, PNG, BMP, TIFF (Max 10MB). Handwritten Tamil only.</div>
        <input type="file" id="fileInput" accept=".jpg,.jpeg,.png,.bmp,.tiff,image/*" class="hidden">
      </div>

      <div id="fileInfo" class="hidden mt-4 p-4 bg-amber-50 rounded-lg border border-amber-200">
        <div class="flex items-center gap-2 text-amber-800">
          <span class="text-xl">📎</span>
          <span id="fileName" class="font-semibold"></span>
          <span id="fileSize" class="text-sm text-gray-600"></span>
        </div>
      </div>

      <div class="mt-6 text-center">
        <button 
          id="processBtn" 
          disabled
          class="px-8 py-4 bg-amber-600 text-white rounded-full font-semibold text-lg transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none"
          style="background: linear-gradient(135deg, #b45309 0%, #d97706 50%, #ea580c 100%);"
        >
          ✨ Extract Handwritten Text
        </button>
      </div>
    </div>

    <div id="loading" class="hidden bg-white rounded-2xl shadow-xl border border-gray-200 p-12 text-center mb-6">
      <div class="inline-block animate-spin rounded-full h-16 w-16 border-b-4 border-amber-600 mb-4"></div>
      <div id="loadingTitle" class="text-xl font-semibold text-amber-700">Extracting handwritten text...</div>
      <div id="loadingHint" class="text-sm text-gray-600 mt-2">This may take a few moments</div>
    </div>

    <div id="error" class="hidden bg-red-50 border border-red-200 rounded-xl p-4 mb-6">
      <div class="flex items-center gap-2 text-red-700">
        <span class="text-xl">❌</span>
        <span id="errorText" class="font-semibold"></span>
      </div>
    </div>

    <div id="resultArea" class="hidden bg-white rounded-2xl shadow-xl border border-gray-200 p-8 mb-6">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-gray-900">✨ Extracted Text</h2>
        <div id="stats" class="text-sm text-gray-600"></div>
      </div>
      <div id="resultText" class="bg-gray-50 rounded-lg p-6 max-h-96 overflow-y-auto mb-6 border border-gray-200 whitespace-pre-wrap text-gray-900 leading-relaxed font-tamil"></div>
      <div class="flex flex-wrap gap-3 justify-center">
        <button id="copyBtn" class="px-6 py-3 bg-amber-600 text-white rounded-lg font-semibold hover:bg-amber-700 transition-colors shadow-lg">
          📋 Copy Text
        </button>
        <a id="downloadTxt" href="#" download="handwriting-extracted.txt" class="hidden px-6 py-3 bg-gray-200 text-gray-700 rounded-lg font-semibold hover:bg-gray-300 transition-colors inline-block">
          📥 Download TXT
        </a>
      </div>
      <div id="wordChips" class="mt-6 flex flex-wrap gap-2"></div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-6">
      <h3 class="text-lg font-bold text-gray-900 mb-4">💡 Tips for Handwritten Tamil</h3>
      <ul class="space-y-2 text-gray-600">
        <li class="flex items-start gap-2">
          <span class="text-amber-600">•</span>
          <span>Use a clear, well-lit photo of your handwritten notes</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-amber-600">•</span>
          <span>Write on plain paper or whiteboard for best results</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-amber-600">•</span>
          <span>Avoid heavy shadows or blur; keep the image straight</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-amber-600">•</span>
          <span>For printed Tamil documents, use the main <a href="/tools/ocr" class="text-primary-600 hover:underline">Tamil OCR</a> tool instead</span>
        </li>
      </ul>
    </div>
  </div>
</div>

<script>
(function () {
  const uploadArea = document.getElementById('uploadArea');
  const fileInput = document.getElementById('fileInput');
  const processBtn = document.getElementById('processBtn');
  const loading = document.getElementById('loading');
  const loadingTitle = document.getElementById('loadingTitle');
  const loadingHint = document.getElementById('loadingHint');
  const error = document.getElementById('error');
  const errorText = document.getElementById('errorText');
  const resultArea = document.getElementById('resultArea');
  const resultText = document.getElementById('resultText');
  const stats = document.getElementById('stats');
  const copyBtn = document.getElementById('copyBtn');
  const downloadTxt = document.getElementById('downloadTxt');
  const wordChips = document.getElementById('wordChips');
  const fileInfo = document.getElementById('fileInfo');
  const fileName = document.getElementById('fileName');
  const fileSize = document.getElementById('fileSize');

  let selectedFile = null;
  let extractedText = '';

  uploadArea.addEventListener('click', function () { fileInput.click(); });
  fileInput.addEventListener('change', function (e) {
    if (e.target.files.length > 0) handleFileSelect(e.target.files[0]);
  });
  uploadArea.addEventListener('dragover', function (e) {
    e.preventDefault();
    uploadArea.classList.add('border-amber-500', 'bg-amber-100');
  });
  uploadArea.addEventListener('dragleave', function () {
    uploadArea.classList.remove('border-amber-500', 'bg-amber-100');
  });
  uploadArea.addEventListener('drop', function (e) {
    e.preventDefault();
    uploadArea.classList.remove('border-amber-500', 'bg-amber-100');
    if (e.dataTransfer.files.length > 0) handleFileSelect(e.dataTransfer.files[0]);
  });

  function handleFileSelect(file) {
    if (!file || !file.type.startsWith('image/')) return;
    selectedFile = file;
    processBtn.disabled = false;
    error.classList.add('hidden');
    resultArea.classList.add('hidden');
    fileName.textContent = file.name;
    fileSize.textContent = '(' + (file.size / 1024 / 1024).toFixed(2) + ' MB)';
    fileInfo.classList.remove('hidden');
  }

  processBtn.addEventListener('click', async function () {
    if (!selectedFile) return;
    loading.classList.remove('hidden');
    processBtn.disabled = true;
    error.classList.add('hidden');
    resultArea.classList.add('hidden');
    loadingTitle.textContent = 'Extracting handwritten text...';
    loadingHint.textContent = 'This may take a few moments';

    try {
      const formData = new FormData();
      formData.append('file', selectedFile);
      const res = await fetch('/api/handwriting-ocr/extract-words', {
        method: 'POST',
        body: formData,
        credentials: 'include'
      });
      const data = await res.json().catch(function () { return { error: 'Invalid response' }; });

      loading.classList.add('hidden');
      processBtn.disabled = false;

      if (!res.ok || data.error) {
        errorText.textContent = data.error || data.details || 'Failed to process image';
        error.classList.remove('hidden');
        return;
      }

      extractedText = data.full_text || '';
      resultText.textContent = extractedText || '(No text detected)';
      stats.textContent = (data.lines_count != null ? data.lines_count + ' lines · ' : '') + (data.words_count != null ? data.words_count + ' words' : '') + (data.processing_time_ms != null ? ' · ' + data.processing_time_ms + ' ms' : '');
      resultArea.classList.remove('hidden');

      if (data.words && data.words.length > 0) {
        wordChips.innerHTML = data.words.map(function (w) {
          const conf = (w.confidence != null ? (w.confidence * 100).toFixed(0) : '—') + '%';
          const cls = (w.confidence != null && w.confidence > 0.8) ? 'bg-green-100 border-green-300' : (w.confidence != null && w.confidence > 0.5) ? 'bg-amber-100 border-amber-300' : 'bg-gray-100 border-gray-300';
          return '<span class="inline-block px-2 py-1 rounded border text-sm ' + cls + '" title="Confidence: ' + conf + '">' + (w.text || '—') + ' <span class="text-gray-500 text-xs">' + conf + '</span></span>';
        }).join('');
      } else {
        wordChips.innerHTML = '';
      }

      downloadTxt.classList.add('hidden');
      if (extractedText) {
        downloadTxt.href = 'data:text/plain;charset=utf-8,' + encodeURIComponent(extractedText);
        downloadTxt.download = (selectedFile.name || 'handwriting').replace(/\.[^/.]+$/, '') + '-extracted.txt';
        downloadTxt.classList.remove('hidden');
      }
    } catch (err) {
      loading.classList.add('hidden');
      processBtn.disabled = false;
      errorText.textContent = err.message || 'Failed to process image';
      error.classList.remove('hidden');
    }
  });

  copyBtn.addEventListener('click', function () {
    if (!extractedText) return;
    navigator.clipboard.writeText(extractedText).then(function () {
      copyBtn.textContent = '✓ Copied!';
      setTimeout(function () { copyBtn.textContent = '📋 Copy Text'; }, 2000);
    });
  });
})();
</script>

<%- include('../partials/footer') %>

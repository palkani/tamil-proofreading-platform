<%- include('../partials/header') %>
<%- include('../partials/nav', { active: 'tools', user: user || null }) %>

<style>
  .font-tamil { font-family: 'Noto Sans Tamil', 'Latha', 'Vijaya', system-ui, sans-serif; }
  #dropZone.drag-over { border-color: #b45309; background: #fef3c7; }
  #imagePreview img { max-height: 320px; object-fit: contain; }
  .step-dot { width: 12px; height: 12px; border-radius: 50%; background: #e5e7eb; transition: all 0.3s; }
  .step-dot.active  { background: #b45309; animation: stepPulse 1.4s ease-in-out infinite; }
  .step-dot.done    { background: #16a34a; box-shadow: none; animation: none; }
  @keyframes stepPulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(180,83,9,0.18); }
    50%      { box-shadow: 0 0 0 7px rgba(180,83,9,0.04); }
  }
  .step-bar { height: 3px; width: 36px; border-radius: 999px; background: #e5e7eb; transition: background 0.4s; }
  .step-bar.fill { background: #16a34a; }
  #resultText { font-family: 'Noto Sans Tamil', 'Latha', system-ui, sans-serif; font-size: 16px; line-height: 1.9; }
  #resultText[contenteditable="true"] { outline: none; cursor: text; }
  #resultText[contenteditable="true"]:focus { box-shadow: 0 0 0 2px #f59e0b inset; border-radius: 8px; }
  /* Low-confidence words the model wasn't sure about — click to fix inline. */
  .ocr-flagged { background: #fef08a; border-bottom: 2px dashed #d97706; border-radius: 3px; padding: 0 2px; cursor: text; }
</style>

<div class="min-h-screen bg-gradient-to-b from-amber-50 via-white to-white py-12">
  <div class="max-w-4xl mx-auto px-6">

    <!-- Header -->
    <div class="text-center mb-10">
      <div class="inline-block px-4 py-2 bg-amber-100 text-amber-800 rounded-full text-sm font-semibold mb-4">
        ✍️ Powered by ProofReading AI
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4">
        Handwritten Notes into Text
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Upload a photo of handwritten Tamil (notes, whiteboard, letters) — ProofReading AI reads and converts it to editable text instantly.
      </p>
      <!-- Usage badge — remaining conversions. Hidden until JS fills it from /usage. -->
      <div id="ocrUsageBadge" class="hidden mt-5 items-center gap-2 px-3.5 py-1.5 rounded-full text-sm font-semibold align-middle"
           style="background:#F5F3FF;color:#6D28D9;border:1px solid #DDD6FE;">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/>
        </svg>
        <span id="ocrUsageText">…</span>
      </div>
    </div>

    <!-- Upload Card -->
    <div class="bg-white rounded-2xl shadow-xl border border-gray-200 p-8 mb-6">

      <!-- Drop Zone -->
      <div
        id="dropZone"
        class="border-2 border-dashed border-amber-300 rounded-xl p-10 text-center bg-amber-50 cursor-pointer transition-all hover:bg-amber-100 hover:border-amber-400"
      >
        <div class="text-5xl mb-3">✍️</div>
        <div class="text-lg font-semibold text-amber-800 mb-1">Click to upload or drag &amp; drop</div>
        <div class="text-sm text-gray-500">JPG, PNG, WEBP · Max 10 MB</div>
        <input type="file" id="fileInput" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" class="hidden">
      </div>

      <!-- Paste from clipboard -->
      <div class="mt-3 text-center">
        <button id="pasteBtn" class="text-sm text-amber-700 underline hover:text-amber-900">
          📋 Paste image from clipboard (Ctrl+V)
        </button>
      </div>

      <!-- Image Preview -->
      <div id="imagePreview" class="hidden mt-5 rounded-xl overflow-hidden border border-gray-200 bg-gray-50 text-center p-3">
        <img id="previewImg" src="" alt="Preview" class="mx-auto rounded-lg shadow">
        <div id="fileInfoLine" class="mt-2 text-sm text-gray-500"></div>
      </div>

      <!-- Language Selector -->
      <div class="mt-5 flex items-center gap-3 justify-center flex-wrap">
        <span class="text-sm font-medium text-gray-600">Image language:</span>
        <label class="flex items-center gap-1.5 cursor-pointer text-sm text-gray-700">
          <input type="radio" name="ocrLang" value="tamil" checked class="accent-amber-600"> Tamil only
        </label>
        <label class="flex items-center gap-1.5 cursor-pointer text-sm text-gray-700">
          <input type="radio" name="ocrLang" value="mixed" class="accent-amber-600"> Tamil + English
        </label>
      </div>

      <!-- Context / topic hint (optional) — boosts accuracy on ambiguous handwriting -->
      <div class="mt-5">
        <label for="ocrContext" class="block text-sm font-medium text-gray-600 mb-1.5 text-center">
          What are these notes about? <span class="text-gray-400 font-normal">(optional — helps accuracy)</span>
        </label>
        <input
          id="ocrContext"
          type="text"
          maxlength="200"
          placeholder="e.g. history lecture notes, a recipe, a poem…"
          class="w-full max-w-xl mx-auto block px-4 py-2.5 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400"
        >
      </div>

      <!-- Extract Button -->
      <div class="mt-6 text-center">
        <button
          id="processBtn"
          disabled
          class="px-10 py-4 rounded-full font-bold text-lg text-white shadow-lg transition-all disabled:opacity-40 disabled:cursor-not-allowed"
          style="background: linear-gradient(135deg, #92400e 0%, #d97706 60%, #ea580c 100%);"
        >
          ✨ Extract Handwritten Text
        </button>
      </div>
    </div>

    <!-- Loading State -->
    <div id="loading" class="hidden bg-white rounded-2xl shadow-xl border border-gray-200 p-8 sm:p-10 text-center mb-6">
      <!-- Stepper: Upload → Analyse → Extract (each turns green as it completes) -->
      <div class="flex items-center justify-center gap-2 sm:gap-3 mb-6">
        <div class="flex flex-col items-center gap-1.5">
          <div id="step1dot" class="step-dot"></div>
          <span class="text-xs font-medium text-gray-500">Upload</span>
        </div>
        <div id="step1bar" class="step-bar"></div>
        <div class="flex flex-col items-center gap-1.5">
          <div id="step2dot" class="step-dot"></div>
          <span class="text-xs font-medium text-gray-500">Analyse</span>
        </div>
        <div id="step2bar" class="step-bar"></div>
        <div class="flex flex-col items-center gap-1.5">
          <div id="step3dot" class="step-dot"></div>
          <span class="text-xs font-medium text-gray-500">Extract</span>
        </div>
      </div>

      <!-- Progress bar — eases forward so a long extraction never looks frozen -->
      <div class="max-w-md mx-auto">
        <div class="h-2 rounded-full bg-amber-100 overflow-hidden">
          <div id="ocrProgressBar" class="h-full rounded-full bg-gradient-to-r from-amber-500 to-amber-600" style="width:0%; transition: width 0.5s ease-out;"></div>
        </div>
        <div class="flex items-center justify-between mt-2 text-xs text-gray-400">
          <span><span id="ocrElapsed">0s</span> elapsed</span>
          <span id="ocrPercent">0%</span>
        </div>
      </div>

      <!-- Rotating status tied to the real pipeline phases -->
      <div class="flex items-center justify-center gap-2 text-base font-semibold text-amber-700 mt-5">
        <span class="inline-block animate-spin rounded-full h-4 w-4 border-2 border-amber-200 border-t-amber-600"></span>
        <span id="loadingMsg">Uploading image…</span>
      </div>
      <div class="text-sm text-gray-400 mt-1.5">Usually 20–40s for a full page. Keep this tab open — we won't lose your text.</div>
    </div>

    <!-- Error -->
    <div id="error" class="hidden bg-red-50 border border-red-200 rounded-xl p-4 mb-6">
      <div class="flex items-start gap-2 text-red-700">
        <span class="text-xl mt-0.5">❌</span>
        <div>
          <div class="font-semibold">Extraction failed</div>
          <div id="errorText" class="text-sm mt-1"></div>
        </div>
      </div>
    </div>

    <!-- Daily Limit / Upgrade Card (shown when free quota is exhausted) -->
    <div id="upgradeCard" class="hidden mb-6 rounded-2xl overflow-hidden shadow-xl border border-indigo-200">
      <!-- Gradient header -->
      <div class="px-6 py-5 text-white" style="background: linear-gradient(135deg, #1e3a8a 0%, #4f46e5 60%, #7c3aed 100%);">
        <div class="flex items-center gap-3">
          <span class="text-3xl">✍️</span>
          <div>
            <p class="text-lg font-bold leading-tight">You've used all 3 free conversions</p>
            <p class="text-sm text-white/80 mt-0.5">Free includes 3 conversions — upgrade for more</p>
          </div>
        </div>
      </div>
      <!-- Body -->
      <div class="bg-white px-6 py-5">
        <p class="text-sm text-gray-600 mb-4">Upgrade to <strong>Pro</strong> to turn photos of handwritten Tamil into editable text — <strong>20 conversions every month</strong>.</p>
        <!-- Feature list -->
        <ul class="text-sm text-gray-600 space-y-2 mb-5">
          <li class="flex items-center gap-2"><span class="text-green-500 font-bold">✓</span> 20 handwritten-notes conversions per month</li>
          <li class="flex items-center gap-2"><span class="text-green-500 font-bold">✓</span> Unlimited Tamil proofreading checks</li>
          <li class="flex items-center gap-2"><span class="text-green-500 font-bold">✓</span> All correction types (grammar, style, rewrite)</li>
          <li class="flex items-center gap-2"><span class="text-green-500 font-bold">✓</span> Save unlimited drafts</li>
        </ul>
        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/pricing"
             class="flex-1 flex items-center justify-center gap-2 px-5 py-3 rounded-full font-bold text-white shadow-lg hover:shadow-xl hover:scale-105 transition-all text-sm"
             style="background: linear-gradient(135deg, #1e3a8a 0%, #4f46e5 100%);">
            ⚡ Upgrade to Pro
          </a>
          <a href="/register"
             class="flex-1 flex items-center justify-center gap-2 px-5 py-3 rounded-full font-semibold text-indigo-700 bg-indigo-50 border border-indigo-200 hover:bg-indigo-100 transition-all text-sm">
            Create free account
          </a>
        </div>
        <p class="text-xs text-gray-400 mt-3 text-center">✍️ Free: 3 conversions total · Pro: 20/month · Pro plans start from ₹199/month</p>
      </div>
    </div>

    <!-- Results -->
    <div id="resultArea" class="hidden bg-white rounded-2xl shadow-xl border border-gray-200 mb-6 overflow-hidden">
      <!-- Result Header -->
      <div class="flex flex-wrap items-center justify-between gap-3 px-7 py-5 border-b border-gray-100 bg-gradient-to-r from-amber-50 to-white">
        <div>
          <h2 class="text-xl font-bold text-gray-900">✨ Extracted Text</h2>
          <div id="stats" class="text-sm text-gray-500 mt-0.5"></div>
        </div>
        <div class="flex flex-wrap gap-2">
          <button id="copyBtn" class="px-4 py-2 bg-amber-600 text-white rounded-lg text-sm font-semibold hover:bg-amber-700 transition-colors shadow">
            📋 Copy
          </button>
          <a id="downloadTxt" href="#" class="hidden px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-semibold hover:bg-gray-200 transition-colors inline-block">
            📥 Download .txt
          </a>
          <button id="openEditorBtn" class="hidden px-4 py-2 rounded-lg text-sm font-semibold text-white transition-colors shadow"
            style="background: #7c3aed;"
            onmouseover="this.style.background='#6d28d9'" onmouseout="this.style.background='#7c3aed'">
            ✏️ Open in Editor
          </button>
        </div>
      </div>

      <!-- Side-by-side: image + text -->
      <div class="flex flex-col md:flex-row">
        <!-- Uploaded image thumbnail -->
        <div id="resultImageWrap" class="hidden md:flex flex-col items-center justify-start p-5 border-r border-gray-100 bg-gray-50 min-w-0 md:w-48 lg:w-64">
          <img id="resultImg" src="" alt="Uploaded" class="rounded-lg shadow max-w-full max-h-64 object-contain">
          <div class="text-xs text-gray-400 mt-2 text-center" id="resultImgName"></div>
        </div>
        <!-- Extracted text -->
        <div class="flex-1 p-6">
          <div id="resultText" class="bg-gray-50 rounded-xl p-5 min-h-32 max-h-80 overflow-y-auto border border-gray-200 whitespace-pre-wrap text-gray-900 leading-relaxed font-tamil"></div>
        </div>
      </div>
    </div>

    <!-- Tips -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6">
      <h3 class="text-base font-bold text-gray-900 mb-3">💡 Tips for best results</h3>
      <ul class="space-y-2 text-sm text-gray-600">
        <li class="flex items-start gap-2"><span class="text-amber-600 mt-0.5">•</span><span>Use a clear, well-lit photo — avoid heavy shadows or blurry images</span></li>
        <li class="flex items-start gap-2"><span class="text-amber-600 mt-0.5">•</span><span>Write on plain white paper or whiteboard for cleanest recognition</span></li>
        <li class="flex items-start gap-2"><span class="text-amber-600 mt-0.5">•</span><span>Keep the image straight; rotate before uploading if text is sideways</span></li>
        <li class="flex items-start gap-2"><span class="text-amber-600 mt-0.5">•</span><span>Works with notebooks, letters, exam sheets, whiteboard photos, and printed Tamil documents</span></li>
      </ul>
    </div>

  </div>
</div>

<!-- Related reading -->
<section class="py-16 bg-gray-50">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Related reading</h2>
    <div class="grid sm:grid-cols-2 gap-4">
      <a href="/blog/handwritten-tamil-to-text" class="block p-5 rounded-xl bg-white border border-gray-200 hover:border-indigo-300 hover:shadow-md transition" style="text-decoration:none;">
        <div style="font-size:0.75rem;font-weight:600;color:#6366F1;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Guide</div>
        <h3 class="text-base font-semibold text-gray-900 leading-snug">Handwritten Tamil to Text — Convert Tamil Notes Online Free</h3>
      </a>
      <a href="/blog/tamil-ocr-online-free" class="block p-5 rounded-xl bg-white border border-gray-200 hover:border-indigo-300 hover:shadow-md transition" style="text-decoration:none;">
        <div style="font-size:0.75rem;font-weight:600;color:#6366F1;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Guide</div>
        <h3 class="text-base font-semibold text-gray-900 leading-snug">Tamil OCR Online Free — Extract Tamil Text From Any Image or PDF</h3>
      </a>
    </div>
  </div>
</section>

<script>
(function () {
  'use strict';

  // ── DOM refs ─────────────────────────────────────────────────────────────
  const dropZone     = document.getElementById('dropZone');
  const fileInput    = document.getElementById('fileInput');
  const processBtn   = document.getElementById('processBtn');
  const pasteBtn     = document.getElementById('pasteBtn');
  const imagePreview = document.getElementById('imagePreview');
  const previewImg   = document.getElementById('previewImg');
  const fileInfoLine = document.getElementById('fileInfoLine');
  const loading      = document.getElementById('loading');
  const loadingMsg   = document.getElementById('loadingMsg');
  const errorEl      = document.getElementById('error');
  const errorText    = document.getElementById('errorText');
  const resultArea   = document.getElementById('resultArea');
  const resultText   = document.getElementById('resultText');
  const stats        = document.getElementById('stats');
  const copyBtn      = document.getElementById('copyBtn');
  const downloadTxt  = document.getElementById('downloadTxt');
  const openEditorBtn= document.getElementById('openEditorBtn');
  const resultImageWrap = document.getElementById('resultImageWrap');
  const resultImg    = document.getElementById('resultImg');
  const resultImgName= document.getElementById('resultImgName');

  // Step dots + connectors + progress readouts
  const step1 = document.getElementById('step1dot');
  const step2 = document.getElementById('step2dot');
  const step3 = document.getElementById('step3dot');
  const step1bar = document.getElementById('step1bar');
  const step2bar = document.getElementById('step2bar');
  const ocrProgressBar = document.getElementById('ocrProgressBar');
  const ocrPercent = document.getElementById('ocrPercent');
  const ocrElapsed = document.getElementById('ocrElapsed');

  let selectedFile = null;
  let extractedText = '';

  // ── Usage badge ("N/3 uploads left") ───────────────────────────────────────
  const usageBadge = document.getElementById('ocrUsageBadge');
  const usageText  = document.getElementById('ocrUsageText');
  let _usage = null; // { tier, used, limit, remaining, unlimited }

  function renderUsage() {
    if (!usageBadge || !usageText || !_usage) return;
    if (_usage.unlimited) {
      // Admin / internal role — no limit to communicate, so don't show a badge at all
      // ("Unlimited uploads" reads as a misleading public claim).
      usageBadge.classList.add('hidden');
      usageBadge.style.display = 'none';
      return;
    }
    if (_usage.tier === 'pro') {
      usageText.textContent = _usage.remaining + '/' + _usage.limit + ' left this month';
      _styleUsage('#F5F3FF', '#6D28D9', '#DDD6FE');
    } else {
      // Free tier — lifetime allowance.
      if (_usage.remaining > 0) {
        usageText.textContent = _usage.remaining + '/' + _usage.limit + ' free uploads left';
        _styleUsage('#F5F3FF', '#6D28D9', '#DDD6FE');
      } else {
        usageText.textContent = '0/' + _usage.limit + ' left — upgrade for more';
        _styleUsage('#FEF3C7', '#B45309', '#FDE68A'); // amber = out of free uploads
      }
    }
    usageBadge.classList.remove('hidden');
    usageBadge.style.display = 'inline-flex';
  }

  function _styleUsage(bg, fg, border) {
    usageBadge.style.background = bg;
    usageBadge.style.color = fg;
    usageBadge.style.borderColor = border;
  }

  async function loadUsage() {
    try {
      const r = await fetch('/api/handwriting-ocr/usage', { credentials: 'include' });
      const d = await r.json().catch(() => ({}));
      if (d && d.success && d.loggedIn) {
        _usage = d;
        renderUsage();
      }
    } catch (_e) { /* badge just stays hidden on failure */ }
  }

  // Locally reflect a consumed credit after a successful extraction (avoids a
  // second round-trip); the server is still the source of truth on next load.
  function decrementUsage() {
    if (!_usage || _usage.unlimited) return;
    _usage.used = (_usage.used || 0) + 1;
    _usage.remaining = Math.max(0, _usage.limit - _usage.used);
    renderUsage();
  }

  // ── Progress simulation ────────────────────────────────────────────────────
  // We get no streaming progress from the server, so we model it: the bar EASES
  // toward ~92% (fast at first, slowing down) and never fake-completes — only a real
  // success snaps it to 100%. Messages + the stepper are keyed to progress, so the
  // whole thing keeps moving for the full 20–90s instead of freezing after 5s.
  const OCR_PHASES = [
    { at: 0,  step: 0, msg: 'Uploading your image…' },
    { at: 10, step: 1, msg: 'Cleaning up the image…' },
    { at: 25, step: 1, msg: 'Reading your handwriting, line by line…' },
    { at: 55, step: 2, msg: 'Checking Tamil spelling…' },
    { at: 78, step: 2, msg: 'Polishing the result…' },
    { at: 88, step: 2, msg: 'Almost there…' },
  ];
  let _ocrTimer = null, _ocrStart = 0, _ocrProgress = 0;

  function _setStep(activeIndex) {
    const dots = [step1, step2, step3];
    dots.forEach((d, i) => {
      d.className = 'step-dot' + (i < activeIndex ? ' done' : i === activeIndex ? ' active' : '');
    });
    step1bar.className = 'step-bar' + (activeIndex >= 1 ? ' fill' : '');
    step2bar.className = 'step-bar' + (activeIndex >= 2 ? ' fill' : '');
  }
  function _setProgress(p) {
    ocrProgressBar.style.width = p.toFixed(0) + '%';
    ocrPercent.textContent = Math.round(p) + '%';
  }
  function _tickOcr() {
    const elapsed = (Date.now() - _ocrStart) / 1000;
    // Ease toward 92% with a ~22s time constant; monotonic (never goes backwards).
    const target = 92 * (1 - Math.exp(-elapsed / 22));
    _ocrProgress = Math.max(_ocrProgress, Math.min(92, target));
    _setProgress(_ocrProgress);
    ocrElapsed.textContent = Math.floor(elapsed) + 's';
    let phase = OCR_PHASES[0];
    for (const x of OCR_PHASES) { if (_ocrProgress >= x.at) phase = x; }
    loadingMsg.textContent = phase.msg;
    _setStep(phase.step);
  }
  function runSteps() {
    clearInterval(_ocrTimer);
    _ocrStart = Date.now();
    _ocrProgress = 0;
    _setStep(0);
    _setProgress(0);
    _tickOcr();
    _ocrTimer = setInterval(_tickOcr, 250);
  }
  function finishSteps() {
    clearInterval(_ocrTimer);
    _setProgress(100);
    [step1, step2, step3].forEach(d => { d.className = 'step-dot done'; });
    step1bar.className = 'step-bar fill';
    step2bar.className = 'step-bar fill';
    loadingMsg.textContent = 'Done!';
  }

  // ── File select helpers ───────────────────────────────────────────────────
  function getLanguageHint() {
    const v = document.querySelector('input[name="ocrLang"]:checked')?.value;
    return v === 'mixed' ? ' (Tamil + English)' : ' (Tamil)';
  }

  function setFile(file) {
    if (!file || !file.type.startsWith('image/')) {
      showError('Please select an image file (JPG, PNG, WEBP, BMP, TIFF).');
      return;
    }
    if (file.size > 10 * 1024 * 1024) {
      showError('File is too large. Maximum size is 10 MB.');
      return;
    }
    selectedFile = file;
    processBtn.disabled = false;
    errorEl.classList.add('hidden');
    document.getElementById('upgradeCard').classList.add('hidden');
    resultArea.classList.add('hidden');

    // Show preview
    const reader = new FileReader();
    reader.onload = e => {
      previewImg.src = e.target.result;
      imagePreview.classList.remove('hidden');
    };
    reader.readAsDataURL(file);
    fileInfoLine.textContent = file.name + ' · ' + (file.size / 1024 / 1024).toFixed(2) + ' MB';
  }

  // ── Drag & drop ──────────────────────────────────────────────────────────
  dropZone.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', e => { if (e.target.files[0]) setFile(e.target.files[0]); });

  dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('drag-over'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
  dropZone.addEventListener('drop', e => {
    e.preventDefault();
    dropZone.classList.remove('drag-over');
    const f = e.dataTransfer?.files?.[0];
    if (f) setFile(f);
  });

  // ── Paste from clipboard ─────────────────────────────────────────────────
  pasteBtn.addEventListener('click', async () => {
    try {
      const items = await navigator.clipboard.read();
      for (const item of items) {
        for (const type of item.types) {
          if (type.startsWith('image/')) {
            const blob = await item.getType(type);
            setFile(new File([blob], 'pasted-image.' + type.split('/')[1], { type }));
            return;
          }
        }
      }
      showError('No image found in clipboard. Copy an image first then paste.');
    } catch (_) {
      showError('Could not access clipboard. Try dragging the image directly into the upload area.');
    }
  });

  // Keyboard Ctrl+V paste
  document.addEventListener('paste', e => {
    const items = e.clipboardData?.items || [];
    for (const item of items) {
      if (item.type.startsWith('image/')) {
        setFile(item.getAsFile());
        e.preventDefault();
        return;
      }
    }
  });

  // ── Error display ─────────────────────────────────────────────────────────
  function showError(msg) {
    loading.classList.add('hidden');
    processBtn.disabled = !selectedFile;
    errorText.textContent = msg;
    errorEl.classList.remove('hidden');
  }

  // ── Result rendering (flagged-word highlight + inline editing) ─────────────
  function escapeHtml(s) {
    return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function renderResult(text, flaggedSet) {
    if (!text) {
      resultText.textContent = '(No text detected in the image)';
      resultText.removeAttribute('contenteditable');
      return;
    }
    let html = escapeHtml(text);
    // Wrap each flagged word (longest first, so shorter substrings don't split them).
    Array.from(flaggedSet || []).sort((a, b) => b.length - a.length).forEach(w => {
      const esc = escapeHtml(w);
      if (esc) html = html.split(esc).join(`<mark class="ocr-flagged">${esc}</mark>`);
    });
    resultText.innerHTML = html;
    resultText.setAttribute('contenteditable', 'true');
    resultText.setAttribute('spellcheck', 'false');
  }

  // Keep copy/download/open-editor in sync with any inline corrections.
  resultText.addEventListener('input', () => { extractedText = resultText.innerText; });

  // ── Main extract ──────────────────────────────────────────────────────────
  processBtn.addEventListener('click', async () => {
    if (!selectedFile) return;

    // Show loading
    loading.classList.remove('hidden');
    processBtn.disabled = true;
    errorEl.classList.remove('hidden', 'hidden');
    errorEl.classList.add('hidden');
    resultArea.classList.add('hidden');
    runSteps();

    try {
      const formData = new FormData();
      formData.append('file', selectedFile);
      formData.append('lang', document.querySelector('input[name="ocrLang"]:checked')?.value || 'tamil');
      formData.append('context', (document.getElementById('ocrContext')?.value || '').trim());

      const res = await fetch('/api/handwriting-ocr/extract-words', {
        method: 'POST',
        body: formData,
        credentials: 'include'
      });
      const data = await res.json().catch(() => ({ error: 'Invalid response from server' }));

      finishSteps();
      loading.classList.add('hidden');
      processBtn.disabled = false;

      if (!res.ok || data.error) {
        if (data.error === 'login_required' || res.status === 401) {
          // Session gone (page is login-gated, but the token can expire mid-session).
          window.location.href = (data.login_url || '/login') + '?redirect=' + encodeURIComponent('/tools/handwriting-ocr');
          return;
        }
        if (data.upgrade_required) {
          // Free weekly limit reached → show the upgrade card instead of a raw error.
          errorEl.classList.add('hidden');
          document.getElementById('upgradeCard').classList.remove('hidden');
        } else {
          showError(data.error || data.details || 'Failed to process image. Please try again.');
        }
        return;
      }

      // ── Render results ───────────────────────────────────────────────────
      extractedText = data.full_text || '';

      // Flagged (low-confidence) words the model was unsure about — highlight them
      // and make the whole result editable so a human can fix them inline.
      const flagged = new Set(
        (Array.isArray(data.flagged_words) ? data.flagged_words : [])
          .map(f => (typeof f === 'string' ? f : (f && f.word) || '')).filter(Boolean)
      );
      renderResult(extractedText, flagged);

      // Stats line (+ overall confidence, + how many words to review)
      const parts = [];
      if (data.confidence_pct != null) parts.push('~' + Math.round(data.confidence_pct * 100) + '% confident');
      if (flagged.size) parts.push(flagged.size + ' to review');
      if (data.lines_count) parts.push(data.lines_count + ' lines');
      if (data.words_count) parts.push(data.words_count + ' words');
      if (data.processing_time_ms) parts.push(((data.processing_time_ms) / 1000).toFixed(1) + 's');
      if (data.model_used) parts.push(data.model_used);
      stats.textContent = parts.join(' · ');

      // Image in results
      resultImg.src = previewImg.src;
      resultImgName.textContent = selectedFile.name;
      resultImageWrap.classList.remove('hidden');

      // Download link
      if (extractedText) {
        downloadTxt.href = 'data:text/plain;charset=utf-8,' + encodeURIComponent(extractedText);
        downloadTxt.download = (selectedFile.name.replace(/\.[^/.]+$/, '') || 'handwriting') + '-extracted.txt';
        downloadTxt.classList.remove('hidden');
        openEditorBtn.classList.remove('hidden');
      } else {
        downloadTxt.classList.add('hidden');
        openEditorBtn.classList.add('hidden');
      }

      decrementUsage(); // one conversion consumed → update the "N/3 uploads left" badge

      resultArea.classList.remove('hidden');
      resultArea.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    } catch (err) {
      finishSteps();
      showError(err.message || 'Network error. Please check your connection and try again.');
    }
  });

  // ── Copy ──────────────────────────────────────────────────────────────────
  copyBtn.addEventListener('click', () => {
    if (!extractedText) return;
    navigator.clipboard.writeText(extractedText).then(() => {
      copyBtn.textContent = '✓ Copied!';
      setTimeout(() => { copyBtn.textContent = '📋 Copy'; }, 2200);
    }).catch(() => {
      // Fallback
      const ta = document.createElement('textarea');
      ta.value = extractedText;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
      copyBtn.textContent = '✓ Copied!';
      setTimeout(() => { copyBtn.textContent = '📋 Copy'; }, 2200);
    });
  });

  // ── Open in Editor ────────────────────────────────────────────────────────
  openEditorBtn.addEventListener('click', () => {
    if (!extractedText) return;
    // Store text in sessionStorage and open workspace
    try {
      sessionStorage.setItem('ocr_import_text', extractedText);
      sessionStorage.setItem('ocr_import_filename', selectedFile ? selectedFile.name.replace(/\.[^/.]+$/, '') : 'Handwriting');
    } catch (_) {}
    window.open('/workspace', '_blank');
  });

  // Show the "N/3 uploads left" badge as soon as the page loads.
  loadUsage();

})();
</script>


<%- include('../partials/header') %>

<div class="min-h-screen bg-gray-50">
  <%- include('../partials/nav', { active: 'affiliates', user: user }) %>

  <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
      <!-- Header -->
      <div class="flex justify-between items-center mb-6">
        <div>
          <h2 class="text-3xl font-bold text-gray-900">Affiliate Management</h2>
          <p class="mt-1 text-sm text-gray-600">Manage affiliates and view referral statistics</p>
        </div>
        <button onclick="openCreateModal()" class="btn-primary flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Create Affiliate
        </button>
      </div>

      <!-- Stats Cards -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
          <div class="text-sm font-medium text-gray-500">Total Affiliates</div>
          <div class="mt-2 text-3xl font-bold text-gray-900" id="stat-total">-</div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
          <div class="text-sm font-medium text-gray-500">Active Affiliates</div>
          <div class="mt-2 text-3xl font-bold text-green-600" id="stat-active">-</div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
          <div class="text-sm font-medium text-gray-500">Total Referrals</div>
          <div class="mt-2 text-3xl font-bold text-blue-600" id="stat-referrals">-</div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
          <div class="text-sm font-medium text-gray-500">Total Commission</div>
          <div class="mt-2 text-3xl font-bold text-primary-600" id="stat-commission">-</div>
        </div>
      </div>

      <!-- Affiliates Table -->
      <div class="bg-white shadow-lg rounded-xl border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900">All Affiliates</h3>
        </div>
        
        <div id="loading" class="text-center py-12">
          <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary-600 mx-auto"></div>
          <p class="mt-4 text-gray-600">Loading affiliates...</p>
        </div>

        <div id="affiliates-table" class="overflow-x-auto hidden">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">User</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Affiliate Code</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Commission Rate</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Total Signups</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Paid Users</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Total Earned</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-700 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody id="affiliates-body" class="bg-white divide-y divide-gray-100">
            </tbody>
          </table>
        </div>

        <div id="empty-state" class="hidden text-center py-12 text-gray-500">
          <svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
          <p class="text-lg font-medium">No affiliates yet</p>
          <p class="text-sm mt-2">Create your first affiliate to get started</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Create Affiliate Modal -->
<div id="create-modal" class="fixed inset-0 z-50 hidden overflow-y-auto">
  <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" onclick="closeCreateModal()"></div>
    <span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>
    <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
      <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Create New Affiliate</h3>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">User ID</label>
            <input type="number" id="create-user-id" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Enter user ID">
            <p class="mt-1 text-xs text-gray-500">The ProofTamil user ID to make an affiliate</p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Commission Rate (%)</label>
            <input type="number" id="create-commission-rate" value="25" min="1" max="100" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500">
            <p class="mt-1 text-xs text-gray-500">Default is 25%</p>
          </div>
        </div>
      </div>
      <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
        <button type="button" onclick="createAffiliate()" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-primary-600 text-base font-medium text-white hover:bg-primary-700 sm:ml-3 sm:w-auto sm:text-sm">
          Create Affiliate
        </button>
        <button type="button" onclick="closeCreateModal()" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
          Cancel
        </button>
      </div>
    </div>
  </div>
</div>

<script>
let affiliatesData = [];

async function loadAffiliates() {
  const loadingEl = document.getElementById('loading');
  const tableEl = document.getElementById('affiliates-table');
  const bodyEl = document.getElementById('affiliates-body');
  const emptyEl = document.getElementById('empty-state');

  try {
    const token = localStorage.getItem('access_token');
    const headers = { 'Accept': 'application/json' };
    if (token) headers['Authorization'] = `Bearer ${token}`;

    const response = await fetch('/api/v1/admin/affiliates', {
      credentials: 'include',
      headers: headers
    });

    if (!response.ok) {
      throw new Error(`HTTP ${response.status}`);
    }

    const data = await response.json();
    affiliatesData = data.affiliates || [];

    loadingEl.classList.add('hidden');

    // Update stats
    let totalReferrals = 0;
    let totalCommission = 0;
    let activeCount = 0;

    affiliatesData.forEach(a => {
      if (a.stats) {
        totalReferrals += a.stats.total_signups || 0;
        totalCommission += a.stats.total_commission || 0;
      }
      if (a.status === 'active') activeCount++;
    });

    document.getElementById('stat-total').textContent = affiliatesData.length;
    document.getElementById('stat-active').textContent = activeCount;
    document.getElementById('stat-referrals').textContent = totalReferrals;
    document.getElementById('stat-commission').textContent = `$${totalCommission.toFixed(2)}`;

    if (affiliatesData.length === 0) {
      emptyEl.classList.remove('hidden');
      return;
    }

    tableEl.classList.remove('hidden');
    bodyEl.innerHTML = '';

    affiliatesData.forEach(aff => {
      const row = document.createElement('tr');
      const statusClass = aff.status === 'active' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800';
      const stats = aff.stats || {};
      
      row.innerHTML = `
        <td class="px-6 py-4 whitespace-nowrap">
          <div class="text-sm font-medium text-gray-900">${aff.user?.name || aff.user?.email || 'User #' + aff.user_id}</div>
          <div class="text-sm text-gray-500">${aff.user?.email || ''}</div>
        </td>
        <td class="px-6 py-4 whitespace-nowrap">
          <div class="flex items-center gap-2">
            <code class="px-2 py-1 bg-gray-100 rounded text-sm font-mono">${aff.affiliate_code}</code>
            <button onclick="copyCode('${aff.affiliate_code}')" class="text-gray-400 hover:text-gray-600" title="Copy code">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
            </button>
          </div>
          <div class="text-xs text-gray-400 mt-1">${aff.referral_link || ''}</div>
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
          ${(aff.commission_rate * 100).toFixed(0)}%
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
          ${stats.total_signups || 0}
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
          ${stats.paid_users || 0} / ${stats.free_users || 0}
          <span class="text-xs text-gray-400">(paid/free)</span>
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
          $${(aff.total_earnings || 0).toFixed(2)}
        </td>
        <td class="px-6 py-4 whitespace-nowrap">
          <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full ${statusClass}">
            ${aff.status}
          </span>
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
          <button onclick="toggleStatus(${aff.id}, '${aff.status}')" class="text-indigo-600 hover:text-indigo-900 mr-3">
            ${aff.status === 'active' ? 'Pause' : 'Activate'}
          </button>
          <button onclick="regenerateCode(${aff.id})" class="text-gray-600 hover:text-gray-900">
            Regenerate Code
          </button>
        </td>
      `;
      bodyEl.appendChild(row);
    });
  } catch (error) {
    console.error('[AFFILIATES] Error loading:', error);
    loadingEl.classList.add('hidden');
    emptyEl.classList.remove('hidden');
    emptyEl.innerHTML = `
      <svg class="w-16 h-16 mx-auto mb-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <p class="text-lg font-medium text-red-600">Failed to load affiliates</p>
      <p class="text-sm mt-2">${error.message}</p>
    `;
  }
}

function openCreateModal() {
  document.getElementById('create-modal').classList.remove('hidden');
}

function closeCreateModal() {
  document.getElementById('create-modal').classList.add('hidden');
}

async function createAffiliate() {
  const userId = document.getElementById('create-user-id').value;
  const commissionRate = document.getElementById('create-commission-rate').value;

  if (!userId) {
    alert('Please enter a user ID');
    return;
  }

  try {
    const token = localStorage.getItem('access_token');
    const headers = { 
      'Accept': 'application/json',
      'Content-Type': 'application/json'
    };
    if (token) headers['Authorization'] = `Bearer ${token}`;

    const response = await fetch('/api/v1/admin/affiliates', {
      method: 'POST',
      credentials: 'include',
      headers: headers,
      body: JSON.stringify({
        user_id: parseInt(userId),
        commission_rate: parseFloat(commissionRate) / 100
      })
    });

    const data = await response.json();

    if (response.ok) {
      closeCreateModal();
      showNotification('Affiliate created successfully!', 'success');
      loadAffiliates();
    } else {
      alert(data.error || 'Failed to create affiliate');
    }
  } catch (error) {
    console.error('[AFFILIATES] Create error:', error);
    alert('Failed to create affiliate');
  }
}

async function toggleStatus(affiliateId, currentStatus) {
  const newStatus = currentStatus === 'active' ? 'paused' : 'active';
  
  try {
    const token = localStorage.getItem('access_token');
    const headers = { 
      'Accept': 'application/json',
      'Content-Type': 'application/json'
    };
    if (token) headers['Authorization'] = `Bearer ${token}`;

    const response = await fetch(`/api/v1/admin/affiliates/${affiliateId}/status`, {
      method: 'PATCH',
      credentials: 'include',
      headers: headers,
      body: JSON.stringify({ status: newStatus })
    });

    if (response.ok) {
      showNotification(`Affiliate ${newStatus === 'active' ? 'activated' : 'paused'}`, 'success');
      loadAffiliates();
    } else {
      const data = await response.json();
      alert(data.error || 'Failed to update status');
    }
  } catch (error) {
    console.error('[AFFILIATES] Toggle status error:', error);
    alert('Failed to update status');
  }
}

async function regenerateCode(affiliateId) {
  if (!confirm('Are you sure you want to regenerate this affiliate code? The old code will stop working.')) {
    return;
  }

  try {
    const token = localStorage.getItem('access_token');
    const headers = { 
      'Accept': 'application/json',
      'Content-Type': 'application/json'
    };
    if (token) headers['Authorization'] = `Bearer ${token}`;

    const response = await fetch(`/api/v1/admin/affiliates/${affiliateId}/regenerate-code`, {
      method: 'POST',
      credentials: 'include',
      headers: headers
    });

    const data = await response.json();

    if (response.ok) {
      showNotification(`New code: ${data.new_code}`, 'success');
      loadAffiliates();
    } else {
      alert(data.error || 'Failed to regenerate code');
    }
  } catch (error) {
    console.error('[AFFILIATES] Regenerate code error:', error);
    alert('Failed to regenerate code');
  }
}

function copyCode(code) {
  const link = `https://prooftamil.com/signup?ref=${code}`;
  navigator.clipboard.writeText(link).then(() => {
    showNotification('Referral link copied!', 'success');
  }).catch(() => {
    showNotification('Failed to copy', 'error');
  });
}

function showNotification(message, type) {
  const notification = document.createElement('div');
  notification.className = `fixed top-4 right-4 z-50 px-6 py-3 rounded-lg shadow-lg transform transition-all duration-300 ${
    type === 'success' ? 'bg-green-500 text-white' : 'bg-red-500 text-white'
  }`;
  notification.textContent = message;
  document.body.appendChild(notification);
  
  setTimeout(() => {
    notification.style.opacity = '0';
    setTimeout(() => notification.remove(), 300);
  }, 3000);
}

// Load affiliates on page load
document.addEventListener('DOMContentLoaded', loadAffiliates);

// Close modal with Escape key
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') closeCreateModal();
});
</script>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<div class="min-h-screen bg-gray-50">
  <%- include('../partials/nav', { active: 'affiliates', user: user }) %>

  <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
      <!-- Header -->
      <div class="flex justify-between items-center mb-6">
        <div>
          <h2 class="text-3xl font-bold text-gray-900">Affiliate Management</h2>
          <p class="mt-1 text-sm text-gray-600">Manage affiliates and view referral statistics</p>
        </div>
        <button onclick="openCreateModal()" class="btn-primary flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Create Affiliate
        </button>
      </div>

      <!-- Stats Cards -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
          <div class="text-sm font-medium text-gray-500">Total Affiliates</div>
          <div class="mt-2 text-3xl font-bold text-gray-900" id="stat-total">-</div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
          <div class="text-sm font-medium text-gray-500">Active Affiliates</div>
          <div class="mt-2 text-3xl font-bold text-green-600" id="stat-active">-</div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
          <div class="text-sm font-medium text-gray-500">Total Referrals</div>
          <div class="mt-2 text-3xl font-bold text-blue-600" id="stat-referrals">-</div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
          <div class="text-sm font-medium text-gray-500">Total Commission</div>
          <div class="mt-2 text-3xl font-bold text-primary-600" id="stat-commission">-</div>
        </div>
      </div>

      <!-- Affiliates Table -->
      <div class="bg-white shadow-lg rounded-xl border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900">All Affiliates</h3>
        </div>
        
        <div id="loading" class="text-center py-12">
          <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary-600 mx-auto"></div>
          <p class="mt-4 text-gray-600">Loading affiliates...</p>
        </div>

        <div id="affiliates-table" class="overflow-x-auto hidden">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">User</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Affiliate Code</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Commission Rate</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Total Signups</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Paid Users</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Total Earned</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-700 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody id="affiliates-body" class="bg-white divide-y divide-gray-100">
            </tbody>
          </table>
        </div>

        <div id="empty-state" class="hidden text-center py-12 text-gray-500">
          <svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
          <p class="text-lg font-medium">No affiliates yet</p>
          <p class="text-sm mt-2">Create your first affiliate to get started</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Create Affiliate Modal -->
<div id="create-modal" class="fixed inset-0 z-50 hidden overflow-y-auto">
  <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" onclick="closeCreateModal()"></div>
    <span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>
    <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
      <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Create New Affiliate</h3>
        <div class="space-y-4">

          <!-- Step 1: email search -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Find user by email</label>
            <div class="flex gap-2">
              <input
                type="email"
                id="create-email-search"
                class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500 text-sm"
                placeholder="user@example.com"
                onkeydown="if(event.key==='Enter'){event.preventDefault();lookupUser();}"
              >
              <button
                type="button"
                onclick="lookupUser()"
                id="lookup-btn"
                class="px-4 py-2 bg-gray-800 text-white text-sm font-semibold rounded-lg hover:bg-gray-700 whitespace-nowrap"
              >
                Find
              </button>
            </div>
            <p class="mt-1 text-xs text-gray-500">Search by the user's registered email address</p>
          </div>

          <!-- Step 2: user confirmation card (hidden until found) -->
          <div id="user-found-card" class="hidden rounded-xl border border-green-200 bg-green-50 px-4 py-3">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-green-200 flex items-center justify-center text-green-800 font-bold text-sm" id="user-avatar">?</div>
              <div>
                <div id="user-found-name" class="font-semibold text-gray-900 text-sm"></div>
                <div id="user-found-email" class="text-xs text-gray-500"></div>
              </div>
              <span class="ml-auto text-xs text-green-700 font-medium">Found ✓</span>
            </div>
            <!-- hidden field carries user ID -->
            <input type="hidden" id="create-user-id" value="">
          </div>

          <!-- Not found error -->
          <div id="user-not-found" class="hidden rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
            No user found with that email. Ask them to sign up first.
          </div>

          <!-- Step 3: commission rate (shown after user found) -->
          <div id="commission-row" class="hidden">
            <label class="block text-sm font-medium text-gray-700 mb-1">Commission Rate (%)</label>
            <input type="number" id="create-commission-rate" value="25" min="1" max="100"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500 text-sm">
            <p class="mt-1 text-xs text-gray-500">Default is 25%. The affiliate earns this % on each successful referral payment.</p>
          </div>

        </div>
      </div>
      <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
        <button type="button" onclick="createAffiliate()" id="create-btn"
          class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-primary-600 text-base font-medium text-white hover:bg-primary-700 sm:ml-3 sm:w-auto sm:text-sm disabled:opacity-40 disabled:cursor-not-allowed"
          disabled>
          Create Affiliate &amp; Generate Link
        </button>
        <button type="button" onclick="closeCreateModal()"
          class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
          Cancel
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Referral Link Result Modal (shown after successful create) -->
<div id="link-modal" class="fixed inset-0 z-50 hidden overflow-y-auto">
  <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75" onclick="closeLinkModal()"></div>
    <span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>
    <div class="inline-block align-bottom bg-white rounded-xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full p-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center">
          <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-gray-900">Affiliate Created!</h3>
          <p class="text-xs text-gray-500">Share this referral link with the affiliate</p>
        </div>
      </div>
      <div class="mb-4">
        <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Referral Link</label>
        <div class="flex gap-2">
          <input id="link-modal-url" type="text" readonly
            class="flex-1 min-w-0 px-3 py-2 border border-gray-300 rounded-lg bg-gray-50 text-sm font-mono text-gray-800">
          <button onclick="copyModalLink()" class="px-3 py-2 bg-primary-600 text-white text-sm rounded-lg hover:bg-primary-700 whitespace-nowrap">
            Copy
          </button>
        </div>
      </div>
      <div class="mb-4 bg-blue-50 rounded-lg px-4 py-3 text-sm text-blue-800">
        Anyone who visits this link and signs up will be tracked as a referral for this affiliate. They don't need to sign up immediately — the link is valid for 30 days via cookie.
      </div>
      <button onclick="closeLinkModal()" class="w-full py-2 rounded-lg bg-gray-800 text-white font-semibold hover:bg-gray-700">
        Done
      </button>
    </div>
  </div>
</div>

<script>
let affiliatesData = [];

async function loadAffiliates() {
  const loadingEl = document.getElementById('loading');
  const tableEl = document.getElementById('affiliates-table');
  const bodyEl = document.getElementById('affiliates-body');
  const emptyEl = document.getElementById('empty-state');

  try {
    const token = localStorage.getItem('access_token');
    const headers = { 'Accept': 'application/json' };
    if (token) headers['Authorization'] = `Bearer ${token}`;

    const response = await fetch('/api/v1/admin/affiliates', {
      credentials: 'include',
      headers: headers
    });

    if (!response.ok) {
      throw new Error(`HTTP ${response.status}`);
    }

    const data = await response.json();
    affiliatesData = data.affiliates || [];

    loadingEl.classList.add('hidden');

    // Update stats
    let totalReferrals = 0;
    let totalCommission = 0;
    let activeCount = 0;

    affiliatesData.forEach(a => {
      if (a.stats) {
        totalReferrals += a.stats.total_signups || 0;
        totalCommission += a.stats.total_commission || 0;
      }
      if (a.status === 'active') activeCount++;
    });

    document.getElementById('stat-total').textContent = affiliatesData.length;
    document.getElementById('stat-active').textContent = activeCount;
    document.getElementById('stat-referrals').textContent = totalReferrals;
    document.getElementById('stat-commission').textContent = `$${totalCommission.toFixed(2)}`;

    if (affiliatesData.length === 0) {
      emptyEl.classList.remove('hidden');
      return;
    }

    tableEl.classList.remove('hidden');
    bodyEl.innerHTML = '';

    affiliatesData.forEach(aff => {
      const row = document.createElement('tr');
      const statusClass = aff.status === 'active' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800';
      const stats = aff.stats || {};
      
      row.innerHTML = `
        <td class="px-6 py-4 whitespace-nowrap">
          <div class="text-sm font-medium text-gray-900">${aff.user?.name || aff.user?.email || 'User #' + aff.user_id}</div>
          <div class="text-sm text-gray-500">${aff.user?.email || ''}</div>
        </td>
        <td class="px-6 py-4 whitespace-nowrap">
          <div class="flex items-center gap-2">
            <code class="px-2 py-1 bg-gray-100 rounded text-sm font-mono">${aff.affiliate_code}</code>
            <button onclick="copyCode('${aff.affiliate_code}')" class="text-gray-400 hover:text-gray-600" title="Copy code">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
            </button>
          </div>
          <div class="text-xs text-gray-400 mt-1">${aff.referral_link || ''}</div>
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
          ${(aff.commission_rate * 100).toFixed(0)}%
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
          ${stats.total_signups || 0}
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
          ${stats.paid_users || 0} / ${stats.free_users || 0}
          <span class="text-xs text-gray-400">(paid/free)</span>
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
          $${(aff.total_earnings || 0).toFixed(2)}
        </td>
        <td class="px-6 py-4 whitespace-nowrap">
          <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full ${statusClass}">
            ${aff.status}
          </span>
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
          <button onclick="toggleStatus(${aff.id}, '${aff.status}')" class="text-indigo-600 hover:text-indigo-900 mr-3">
            ${aff.status === 'active' ? 'Pause' : 'Activate'}
          </button>
          <button onclick="regenerateCode(${aff.id})" class="text-gray-600 hover:text-gray-900">
            Regenerate Code
          </button>
        </td>
      `;
      bodyEl.appendChild(row);
    });
  } catch (error) {
    console.error('[AFFILIATES] Error loading:', error);
    loadingEl.classList.add('hidden');
    emptyEl.classList.remove('hidden');
    emptyEl.innerHTML = `
      <svg class="w-16 h-16 mx-auto mb-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <p class="text-lg font-medium text-red-600">Failed to load affiliates</p>
      <p class="text-sm mt-2">${error.message}</p>
    `;
  }
}

function openCreateModal() {
  // Reset form state
  document.getElementById('create-email-search').value = '';
  document.getElementById('create-user-id').value = '';
  document.getElementById('create-commission-rate').value = '25';
  document.getElementById('user-found-card').classList.add('hidden');
  document.getElementById('user-not-found').classList.add('hidden');
  document.getElementById('commission-row').classList.add('hidden');
  document.getElementById('create-btn').disabled = true;
  document.getElementById('create-modal').classList.remove('hidden');
  setTimeout(() => document.getElementById('create-email-search').focus(), 100);
}

function closeCreateModal() {
  document.getElementById('create-modal').classList.add('hidden');
}

function closeLinkModal() {
  document.getElementById('link-modal').classList.add('hidden');
}

function copyModalLink() {
  const input = document.getElementById('link-modal-url');
  navigator.clipboard.writeText(input.value).then(() => {
    showNotification('Referral link copied!', 'success');
  }).catch(() => {
    input.select();
    document.execCommand('copy');
    showNotification('Link copied!', 'success');
  });
}

async function lookupUser() {
  const email = document.getElementById('create-email-search').value.trim();
  if (!email) return;

  const btn = document.getElementById('lookup-btn');
  btn.textContent = 'Searching…';
  btn.disabled = true;

  // Reset previous results
  document.getElementById('user-found-card').classList.add('hidden');
  document.getElementById('user-not-found').classList.add('hidden');
  document.getElementById('commission-row').classList.add('hidden');
  document.getElementById('create-btn').disabled = true;
  document.getElementById('create-user-id').value = '';

  try {
    const token = localStorage.getItem('access_token');
    const headers = { 'Accept': 'application/json' };
    if (token) headers['Authorization'] = `Bearer ${token}`;

    const res = await fetch(`/api/v1/admin/users?email=${encodeURIComponent(email)}&limit=5`, {
      credentials: 'include',
      headers
    });
    const data = await res.json();
    const users = data.users || [];

    if (users.length === 0) {
      document.getElementById('user-not-found').classList.remove('hidden');
    } else {
      const u = users[0]; // take first (best) match
      document.getElementById('create-user-id').value = u.id;
      document.getElementById('user-found-name').textContent = u.name || u.email;
      document.getElementById('user-found-email').textContent = u.email;
      document.getElementById('user-avatar').textContent = (u.name || u.email || '?')[0].toUpperCase();
      document.getElementById('user-found-card').classList.remove('hidden');
      document.getElementById('commission-row').classList.remove('hidden');
      document.getElementById('create-btn').disabled = false;
    }
  } catch (err) {
    console.error('[AFFILIATES] Lookup error:', err);
    document.getElementById('user-not-found').textContent = 'Lookup failed. Please try again.';
    document.getElementById('user-not-found').classList.remove('hidden');
  } finally {
    btn.textContent = 'Find';
    btn.disabled = false;
  }
}

async function createAffiliate() {
  const userId = document.getElementById('create-user-id').value;
  const commissionRate = document.getElementById('create-commission-rate').value;

  if (!userId) {
    alert('Please find a user first using the email search above.');
    return;
  }

  const btn = document.getElementById('create-btn');
  btn.disabled = true;
  btn.textContent = 'Creating…';

  try {
    const token = localStorage.getItem('access_token');
    const headers = {
      'Accept': 'application/json',
      'Content-Type': 'application/json'
    };
    if (token) headers['Authorization'] = `Bearer ${token}`;

    const response = await fetch('/api/v1/admin/affiliates', {
      method: 'POST',
      credentials: 'include',
      headers: headers,
      body: JSON.stringify({
        user_id: parseInt(userId),
        commission_rate: parseFloat(commissionRate) / 100
      })
    });

    const data = await response.json();

    if (response.ok) {
      closeCreateModal();
      // Show the referral link in a result modal
      const link = data.referral_link || `https://prooftamil.com/?ref=${data.affiliate?.affiliate_code || ''}`;
      document.getElementById('link-modal-url').value = link;
      document.getElementById('link-modal').classList.remove('hidden');
      loadAffiliates();
    } else {
      alert(data.error || 'Failed to create affiliate');
      btn.disabled = false;
      btn.textContent = 'Create Affiliate & Generate Link';
    }
  } catch (error) {
    console.error('[AFFILIATES] Create error:', error);
    alert('Failed to create affiliate');
    btn.disabled = false;
    btn.textContent = 'Create Affiliate & Generate Link';
  }
}

async function toggleStatus(affiliateId, currentStatus) {
  const newStatus = currentStatus === 'active' ? 'paused' : 'active';
  
  try {
    const token = localStorage.getItem('access_token');
    const headers = { 
      'Accept': 'application/json',
      'Content-Type': 'application/json'
    };
    if (token) headers['Authorization'] = `Bearer ${token}`;

    const response = await fetch(`/api/v1/admin/affiliates/${affiliateId}/status`, {
      method: 'PATCH',
      credentials: 'include',
      headers: headers,
      body: JSON.stringify({ status: newStatus })
    });

    if (response.ok) {
      showNotification(`Affiliate ${newStatus === 'active' ? 'activated' : 'paused'}`, 'success');
      loadAffiliates();
    } else {
      const data = await response.json();
      alert(data.error || 'Failed to update status');
    }
  } catch (error) {
    console.error('[AFFILIATES] Toggle status error:', error);
    alert('Failed to update status');
  }
}

async function regenerateCode(affiliateId) {
  if (!confirm('Are you sure you want to regenerate this affiliate code? The old code will stop working.')) {
    return;
  }

  try {
    const token = localStorage.getItem('access_token');
    const headers = { 
      'Accept': 'application/json',
      'Content-Type': 'application/json'
    };
    if (token) headers['Authorization'] = `Bearer ${token}`;

    const response = await fetch(`/api/v1/admin/affiliates/${affiliateId}/regenerate-code`, {
      method: 'POST',
      credentials: 'include',
      headers: headers
    });

    const data = await response.json();

    if (response.ok) {
      showNotification(`New code: ${data.new_code}`, 'success');
      loadAffiliates();
    } else {
      alert(data.error || 'Failed to regenerate code');
    }
  } catch (error) {
    console.error('[AFFILIATES] Regenerate code error:', error);
    alert('Failed to regenerate code');
  }
}

function copyCode(code) {
  const link = `https://prooftamil.com/?ref=${code}`;
  navigator.clipboard.writeText(link).then(() => {
    showNotification('Referral link copied!', 'success');
  }).catch(() => {
    showNotification('Failed to copy', 'error');
  });
}

function showNotification(message, type) {
  const notification = document.createElement('div');
  notification.className = `fixed top-4 right-4 z-50 px-6 py-3 rounded-lg shadow-lg transform transition-all duration-300 ${
    type === 'success' ? 'bg-green-500 text-white' : 'bg-red-500 text-white'
  }`;
  notification.textContent = message;
  document.body.appendChild(notification);
  
  setTimeout(() => {
    notification.style.opacity = '0';
    setTimeout(() => notification.remove(), 300);
  }, 3000);
}

// Load affiliates on page load
document.addEventListener('DOMContentLoaded', loadAffiliates);

// Close modals with Escape key
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    closeCreateModal();
    closeLinkModal();
  }
});
</script>

<%- include('../partials/footer') %>

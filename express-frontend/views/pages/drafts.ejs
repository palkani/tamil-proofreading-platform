<%- include('../partials/header') %>

<!-- Delete Confirmation Modal -->
<div id="delete-modal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
  <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
    <!-- Background overlay -->
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true" onclick="closeDeleteModal()"></div>
    
    <!-- Modal panel -->
    <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
    <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
      <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
        <div class="sm:flex sm:items-start">
          <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
            <svg class="h-6 w-6 text-red-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
            <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">
              Delete Draft
            </h3>
            <div class="mt-2">
              <p class="text-sm text-gray-500">
                Are you sure you want to delete "<span id="delete-draft-title" class="font-medium"></span>"? 
                This action cannot be undone and the draft will be permanently removed.
              </p>
            </div>
          </div>
        </div>
      </div>
      <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
        <button type="button" id="confirm-delete-btn" onclick="executeDraftDelete()"
                class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-red-600 text-base font-medium text-white hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 sm:ml-3 sm:w-auto sm:text-sm">
          Delete
        </button>
        <button type="button" onclick="closeDeleteModal()"
                class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
          Cancel
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Duplicate Draft Modal -->
<div id="duplicate-modal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="duplicate-modal-title" role="dialog" aria-modal="true">
  <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20">
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" onclick="closeDuplicateModal()"></div>
    <div class="relative bg-white rounded-xl shadow-xl max-w-md w-full p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4" id="duplicate-modal-title">Duplicate Draft</h3>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Name of duplicate</label>
          <input type="text" id="duplicate-name-input" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary-500 focus:border-primary-500" placeholder="e.g. Copy of My Draft" maxlength="255">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Put in group</label>
          <select id="duplicate-group-select" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
            <option value="">Ungrouped</option>
          </select>
        </div>
      </div>
      <div class="mt-6 flex justify-end gap-3">
        <button type="button" onclick="closeDuplicateModal()" class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200">Cancel</button>
        <button type="button" id="duplicate-confirm-btn" onclick="executeDuplicate()" class="px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700">Duplicate</button>
      </div>
    </div>
  </div>
</div>

<!-- Move to group popover (shown after clicking "Move to group" in context menu) -->
<div id="move-group-popover" class="fixed z-[60] hidden bg-white border border-gray-200 rounded-lg shadow-xl py-2 min-w-[180px] text-sm" role="menu">
  <div class="px-3 py-1.5 text-xs font-semibold text-gray-500 uppercase">Choose group</div>
  <button type="button" data-move-group-id="0" class="move-group-option w-full text-left px-4 py-2 hover:bg-gray-50 text-gray-700">Ungrouped</button>
  <div id="move-group-list"></div>
</div>

<!-- Draft Context Menu -->
<div id="draft-context-menu" class="fixed z-50 hidden bg-white border border-gray-200 rounded-xl shadow-2xl py-1.5 min-w-[192px] text-sm" role="menu">
  <button id="menu-edit-btn" onclick="menuEdit()" class="w-full text-left px-4 py-2.5 text-gray-700 hover:bg-gray-50 flex items-center gap-3 transition-colors" role="menuitem">
    <svg class="w-4 h-4 text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
    Edit
  </button>
  <button id="menu-rename-btn" onclick="menuRename()" class="w-full text-left px-4 py-2.5 text-gray-700 hover:bg-gray-50 flex items-center gap-3 transition-colors" role="menuitem">
    <svg class="w-4 h-4 text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
    Rename
  </button>
  <button id="menu-duplicate-btn" onclick="menuDuplicate()" class="w-full text-left px-4 py-2.5 text-gray-700 hover:bg-gray-50 flex items-center gap-3 transition-colors" role="menuitem">
    <svg class="w-4 h-4 text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
    Duplicate
  </button>
  <button id="menu-pin-btn" onclick="menuTogglePin()" class="w-full text-left px-4 py-2.5 text-gray-700 hover:bg-gray-50 flex items-center gap-3 transition-colors" role="menuitem">
    <svg class="w-4 h-4 text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
    <span id="menu-pin-label">Pin</span>
  </button>
  <button id="menu-move-group-btn" onclick="menuMoveToGroup()" class="w-full text-left px-4 py-2.5 text-gray-700 hover:bg-gray-50 flex items-center gap-3 transition-colors" role="menuitem">
    <svg class="w-4 h-4 text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
    Move to group
  </button>
  <div class="border-t border-gray-100 my-1"></div>
  <button id="menu-trash-btn" onclick="menuTrash()" class="w-full text-left px-4 py-2.5 text-red-600 hover:bg-red-50 flex items-center gap-3 transition-colors" role="menuitem">
    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
    Move to trash
  </button>
</div>

<div class="min-h-screen bg-gray-50">
  <!-- Header Navigation -->
  <%- include('../partials/nav', { active: 'drafts', user: user }) %>

  <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-3xl font-bold text-gray-900 uppercase tracking-wide">
          My Drafts
        </h2>
        <a href="/workspace" class="btn-primary flex items-center gap-2" id="create-new-draft-btn">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Create New Draft
        </a>
      </div>

      <div class="flex flex-col lg:flex-row gap-6">
        <!-- Groups sidebar -->
        <div id="groups-sidebar" class="lg:w-56 flex-shrink-0 hidden">
          <div class="bg-white shadow rounded-xl border border-gray-200 p-4 sticky top-4">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wider">Groups</h3>
              <button type="button" id="new-group-btn" class="text-primary-600 hover:text-primary-700 text-sm font-medium" title="New group">+ New</button>
            </div>
            <div id="new-group-form" class="hidden mb-2">
              <input type="text" id="new-group-name-input" class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm mb-1" placeholder="Group name" maxlength="255">
              <div class="flex gap-1">
                <button type="button" id="new-group-save" class="text-xs px-2 py-1 bg-primary-600 text-white rounded">Save</button>
                <button type="button" id="new-group-cancel" class="text-xs px-2 py-1 text-gray-600 hover:bg-gray-100 rounded">Cancel</button>
              </div>
            </div>
            <ul id="groups-list" class="space-y-0.5 text-sm">
              <li><button type="button" data-group-id="all" class="group-filter w-full text-left px-2 py-1.5 rounded hover:bg-gray-100 font-medium text-primary-600">All drafts</button></li>
              <li><button type="button" data-group-id="0" class="group-filter w-full text-left px-2 py-1.5 rounded hover:bg-gray-100 text-gray-700">Ungrouped</button></li>
            </ul>
          </div>
        </div>

        <div class="flex-1 min-w-0 bg-white shadow-lg rounded-xl border border-gray-200 p-6">
        <h3 class="text-lg font-semibold mb-4 text-gray-900">Saved Drafts</h3>
        
        <div id="loading" class="text-center py-12">
          <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary-600 mx-auto"></div>
          <p class="mt-4 text-gray-600">Loading drafts...</p>
        </div>

        <div id="drafts-table" class="overflow-x-auto hidden">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Title</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Preview</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Words</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Created At</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-700 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody id="drafts-body" class="bg-white divide-y divide-gray-100">
            </tbody>
          </table>
        </div>

        <div id="empty-state" class="hidden text-center py-12 text-gray-500">
          <svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          <p class="text-lg font-medium">No drafts found</p>
          <p class="text-sm mt-2">Start writing in the workspace to see your drafts here</p>
          <a href="/workspace" class="mt-4 inline-block btn-primary">
            Create First Draft
          </a>
        </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// CRITICAL: Only run drafts page code if we're actually on the drafts page
// This prevents the code from running on homepage and causing redirect loops
(function() {
  'use strict';
  
  // Early exit if not on drafts page - check BEFORE any code execution
  // This must be the FIRST thing that runs to prevent any syntax errors from affecting other pages
  if (typeof window === 'undefined' || !window.location) {
    return;
  }
  
  try {
    const currentPath = window.location.pathname;
    if (currentPath !== '/drafts') {
      console.log('[DRAFTS] Not on drafts page (' + currentPath + '), skipping drafts page initialization');
      return;
    }
  } catch (e) {
    console.error('[DRAFTS] Error checking pathname, skipping:', e);
    return;
  }
  
  // Now run the async function - properly structured
  (async function() {
    // BFCache safety: if user presses back after logout, force a reload so server-side auth check runs.
    window.addEventListener('pageshow', (event) => {
      if (event && event.persisted) {
        try { window.location.reload(); } catch (_e) {}
      }
    });

    // First, check if we have a token in URL (from OAuth redirect)
    const urlParams = new URLSearchParams(window.location.search);
    const tokenFromUrl = urlParams.get('access_token');
    if (tokenFromUrl) {
      console.log('[DRAFTS] Token found in URL, storing it');
      console.log('[DRAFTS] Token length:', tokenFromUrl.length);
      console.log('[DRAFTS] Token preview:', tokenFromUrl.substring(0, 50) + '...');
      
      // Decode and check token expiration BEFORE storing
      let shouldStoreToken = true;
      try {
        const parts = tokenFromUrl.split('.');
        if (parts.length === 3) {
          let base64 = parts[1].replace(/-/g, '+').replace(/_/g, '/');
          while (base64.length % 4) base64 += '=';
          const payload = JSON.parse(atob(base64));
          const now = Math.floor(Date.now() / 1000);
          const isExpired = payload.exp < now;
          console.log('[DRAFTS] Token from URL expiration check:', {
            exp: payload.exp,
            now: now,
            expiresAt: new Date(payload.exp * 1000).toISOString(),
            timeUntilExpiry: payload.exp - now,
            valid: payload.exp > now,
            isExpired: isExpired
          });
          
          // If token is already expired, don't store it - refresh instead
          if (isExpired) {
            console.warn('[DRAFTS] Token from URL is already expired, will refresh instead');
            shouldStoreToken = false;
          }
        }
      } catch (e) {
        console.error('[DRAFTS] Error checking token from URL:', e);
      }
      
      // Only store token if it's not expired
      if (shouldStoreToken) {
        // Use centralized auth utility if available
        if (window.authUtils && window.authUtils.storeAccessToken) {
          window.authUtils.storeAccessToken(tokenFromUrl);
        } else {
          // Fallback
          localStorage.removeItem('access_token');
          document.cookie = 'access_token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
          localStorage.setItem('access_token', tokenFromUrl);
          document.cookie = `access_token=${tokenFromUrl}; path=/; SameSite=Lax; Max-Age=900`;
        }
        console.log('[DRAFTS] Token stored in localStorage and cookie');
      } else {
        // Token is expired, clear any old tokens and try to refresh immediately
        console.log('[DRAFTS] Token from URL is expired, clearing old tokens and refreshing immediately');
        if (window.authUtils && window.authUtils.clearAuthTokens) {
          window.authUtils.clearAuthTokens();
        }
        // Try to refresh immediately if authUtils is available
        if (window.authUtils && window.authUtils.refreshAccessToken) {
          console.log('[DRAFTS] Attempting immediate token refresh...');
          const newToken = await window.authUtils.refreshAccessToken();
          if (newToken) {
            console.log('[DRAFTS] ✅ Successfully refreshed token from expired URL token');
            // Store the new token
            if (window.authUtils && window.authUtils.storeAccessToken) {
              window.authUtils.storeAccessToken(newToken);
            }
          } else {
            console.warn('[DRAFTS] ❌ Failed to refresh expired token from URL - refresh token may be missing or invalid');
            // CRITICAL: If refresh fails, we have no valid token
            console.warn('[DRAFTS] No valid token available');
            window.history.replaceState({}, document.title, window.location.pathname);
            
            // Only redirect if not on homepage
            const isHomepage = window.location.pathname === '/' || window.location.pathname === '/home';
            if (!isHomepage) {
              setTimeout(() => {
                window.location.href = '/login?error=token_expired';
              }, 100);
            } else {
              console.log('[DRAFTS] On homepage, not redirecting to prevent loops');
            }
            return; // Exit early, don't proceed with API calls
          }
        } else {
          console.warn('[DRAFTS] ⚠️ authUtils not available, cannot refresh expired token');
          // No way to refresh
          window.history.replaceState({}, document.title, window.location.pathname);
          
          // Only redirect if not on homepage
          const isHomepage = window.location.pathname === '/' || window.location.pathname === '/home';
          if (!isHomepage) {
            setTimeout(() => {
              window.location.href = '/login?error=token_expired';
            }, 100);
          } else {
            console.log('[DRAFTS] On homepage, not redirecting to prevent loops');
          }
          return; // Exit early
        }
      }
      // Remove token from URL
      window.history.replaceState({}, document.title, window.location.pathname);
      
      // Small delay to ensure token is stored before making API calls
      await new Promise(resolve => setTimeout(resolve, 100));
    }

    const loadingEl = document.getElementById('loading');
    const tableEl = document.getElementById('drafts-table');
    const bodyEl = document.getElementById('drafts-body');
    const emptyEl = document.getElementById('empty-state');

    // Helper function to clear invalid tokens and redirect to login
    // IMPORTANT: Only redirect if we're actually on the drafts page, not homepage
    function clearTokensAndRedirect() {
      console.log('[DRAFTS] Clearing invalid tokens');
      // Use centralized auth utility if available
      if (window.authUtils && window.authUtils.clearAuthTokens) {
        window.authUtils.clearAuthTokens();
      } else {
        // Fallback
        localStorage.removeItem('access_token');
        document.cookie = 'access_token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
        document.cookie = 'refresh_token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
        document.cookie = 'proof_refresh_token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
      }

      // Clear any rendered drafts immediately (avoid showing stale drafts while redirecting)
      try {
        if (bodyEl) bodyEl.innerHTML = '';
        if (tableEl) tableEl.classList.add('hidden');
        if (emptyEl) emptyEl.classList.add('hidden');
        if (loadingEl) loadingEl.classList.remove('hidden');
      } catch (_e) {}
      
      // Only redirect if we're on the drafts page, not homepage
      const isHomepage = window.location.pathname === '/' || window.location.pathname === '/home';
      if (!isHomepage) {
        console.log('[DRAFTS] Redirecting to login (not on homepage)');
        const redirectParam = encodeURIComponent('/drafts');
        window.location.replace(`/login?redirect=${redirectParam}`);
      } else {
        console.log('[DRAFTS] On homepage, not redirecting to prevent loops');
      }
    }

    // Helper function to check if token is expired (with 1 minute buffer)
    function isTokenExpired(token) {
      if (!token) return true;
      try {
        // Decode JWT payload (base64url)
        const parts = token.split('.');
        if (parts.length !== 3) return true;
        
        // Base64URL decode: replace - with +, _ with /, add padding if needed
        let base64 = parts[1].replace(/-/g, '+').replace(/_/g, '/');
        // Add padding if needed
        while (base64.length % 4) {
          base64 += '=';
        }
        
        const payload = JSON.parse(atob(base64));
        const exp = payload.exp;
        if (!exp) return true;
        
        // Check if expired
        const now = Math.floor(Date.now() / 1000);
        // Token is expired if exp < now
        // We add a small buffer (60 seconds) to refresh proactively before expiration
        const refreshBuffer = 60; // Refresh 1 minute before expiration
        // Token is expired if: exp < now (already expired) OR exp < (now + buffer) (expires soon)
        const isExp = exp < now || exp < (now + refreshBuffer);
        console.log('[DRAFTS] Token expiration check:', {
          exp: exp,
          now: now,
          expiresAt: new Date(exp * 1000).toISOString(),
          isExpired: isExp,
          timeUntilExpiry: exp - now,
          refreshBuffer: refreshBuffer,
          alreadyExpired: exp < now,
          expiresSoon: exp < (now + refreshBuffer)
        });
        return isExp;
      } catch (e) {
        console.error('[DRAFTS] Error checking token expiration:', e);
        // If we can't decode, don't assume expired - let the server decide
        return false;
      }
    }

    // Helper function to refresh access token - use centralized authUtils
    let refreshInProgress = false; // Prevent multiple simultaneous refresh attempts
    async function refreshAccessToken() {
      // Prevent infinite loops - if refresh is already in progress, wait
      if (refreshInProgress) {
        console.log('[DRAFTS] Refresh already in progress, waiting...');
        return null;
      }
      
      refreshInProgress = true;
    try {
      // Use centralized auth utility if available
      if (window.authUtils && window.authUtils.refreshAccessToken) {
        const newToken = await window.authUtils.refreshAccessToken();
        refreshInProgress = false;
        return newToken;
      } else {
        // Fallback to direct fetch (shouldn't happen if auth-utils is loaded)
        console.warn('[DRAFTS] authUtils not available, using fallback refresh');
        const response = await fetch('/auth/refresh', {
          method: 'POST',
          credentials: 'include',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
          }
        });
        
        if (!response.ok) {
          console.error('[DRAFTS] Token refresh failed:', response.status);
          refreshInProgress = false;
          // Don't redirect here - let the caller handle it to prevent loops
          return null;
        }
        
        const data = await response.json();
        if (data.access_token) {
          localStorage.setItem('access_token', data.access_token);
          document.cookie = `access_token=${data.access_token}; path=/; SameSite=Lax; Max-Age=900`;
          refreshInProgress = false;
          return data.access_token;
        }
        refreshInProgress = false;
        return null;
      }
    } catch (error) {
      console.error('[DRAFTS] Error refreshing token:', error);
      refreshInProgress = false;
      return null;
    }
    }

    // Helper function to fetch submissions with retry on 401

<%- include('../partials/header') %>

<div class="min-h-screen bg-gray-50">
  <!-- Header Navigation -->
  <%- include('../partials/nav', { active: 'drafts', user: user }) %>

  <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-3xl font-bold text-gray-900 uppercase tracking-wide">
          My Drafts
        </h2>
        <a href="/workspace" class="btn-primary flex items-center gap-2" id="create-new-draft-btn">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Create New Draft
        </a>
      </div>

      <div class="bg-white shadow-lg rounded-xl border border-gray-200 p-6">
        <h3 class="text-lg font-semibold mb-4 text-gray-900">Saved Drafts</h3>
        
        <div id="loading" class="text-center py-12">
          <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary-600 mx-auto"></div>
          <p class="mt-4 text-gray-600">Loading drafts...</p>
        </div>

        <div id="drafts-table" class="overflow-x-auto hidden">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Title</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Preview</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Words</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Created At</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-700 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody id="drafts-body" class="bg-white divide-y divide-gray-100">
            </tbody>
          </table>
        </div>

        <div id="empty-state" class="hidden text-center py-12 text-gray-500">
          <svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          <p class="text-lg font-medium">No drafts found</p>
          <p class="text-sm mt-2">Start writing in the workspace to see your drafts here</p>
          <a href="/workspace" class="mt-4 inline-block btn-primary">
            Create First Draft
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// CRITICAL: Only run drafts page code if we're actually on the drafts page
// This prevents the code from running on homepage and causing redirect loops
(function() {
  'use strict';
  
  // Early exit if not on drafts page - check BEFORE any code execution
  // This must be the FIRST thing that runs to prevent any syntax errors from affecting other pages
  if (typeof window === 'undefined' || !window.location) {
    return;
  }
  
  try {
    const currentPath = window.location.pathname;
    if (currentPath !== '/drafts') {
      console.log('[DRAFTS] Not on drafts page (' + currentPath + '), skipping drafts page initialization');
      return;
    }
  } catch (e) {
    console.error('[DRAFTS] Error checking pathname, skipping:', e);
    return;
  }
  
  // Now run the async function - properly structured
  (async function() {
    // BFCache safety: if user presses back after logout, force a reload so server-side auth check runs.
    window.addEventListener('pageshow', (event) => {
      if (event && event.persisted) {
        try { window.location.reload(); } catch (_e) {}
      }
    });

    // First, check if we have a token in URL (from OAuth redirect)
    const urlParams = new URLSearchParams(window.location.search);
    const tokenFromUrl = urlParams.get('access_token');
    if (tokenFromUrl) {
      console.log('[DRAFTS] Token found in URL, storing it');
      console.log('[DRAFTS] Token length:', tokenFromUrl.length);
      console.log('[DRAFTS] Token preview:', tokenFromUrl.substring(0, 50) + '...');
      
      // Decode and check token expiration BEFORE storing
      let shouldStoreToken = true;
      try {
        const parts = tokenFromUrl.split('.');
        if (parts.length === 3) {
          let base64 = parts[1].replace(/-/g, '+').replace(/_/g, '/');
          while (base64.length % 4) base64 += '=';
          const payload = JSON.parse(atob(base64));
          const now = Math.floor(Date.now() / 1000);
          const isExpired = payload.exp < now;
          console.log('[DRAFTS] Token from URL expiration check:', {
            exp: payload.exp,
            now: now,
            expiresAt: new Date(payload.exp * 1000).toISOString(),
            timeUntilExpiry: payload.exp - now,
            valid: payload.exp > now,
            isExpired: isExpired
          });
          
          // If token is already expired, don't store it - refresh instead
          if (isExpired) {
            console.warn('[DRAFTS] Token from URL is already expired, will refresh instead');
            shouldStoreToken = false;
          }
        }
      } catch (e) {
        console.error('[DRAFTS] Error checking token from URL:', e);
      }
      
      // Only store token if it's not expired
      if (shouldStoreToken) {
        // Use centralized auth utility if available
        if (window.authUtils && window.authUtils.storeAccessToken) {
          window.authUtils.storeAccessToken(tokenFromUrl);
        } else {
          // Fallback
          localStorage.removeItem('access_token');
          document.cookie = 'access_token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
          localStorage.setItem('access_token', tokenFromUrl);
          document.cookie = `access_token=${tokenFromUrl}; path=/; SameSite=Lax; Max-Age=900`;
        }
        console.log('[DRAFTS] Token stored in localStorage and cookie');
      } else {
        // Token is expired, clear any old tokens and try to refresh immediately
        console.log('[DRAFTS] Token from URL is expired, clearing old tokens and refreshing immediately');
        if (window.authUtils && window.authUtils.clearAuthTokens) {
          window.authUtils.clearAuthTokens();
        }
        // Try to refresh immediately if authUtils is available
        if (window.authUtils && window.authUtils.refreshAccessToken) {
          console.log('[DRAFTS] Attempting immediate token refresh...');
          const newToken = await window.authUtils.refreshAccessToken();
          if (newToken) {
            console.log('[DRAFTS] ✅ Successfully refreshed token from expired URL token');
            // Store the new token
            if (window.authUtils && window.authUtils.storeAccessToken) {
              window.authUtils.storeAccessToken(newToken);
            }
          } else {
            console.warn('[DRAFTS] ❌ Failed to refresh expired token from URL - refresh token may be missing or invalid');
            // CRITICAL: If refresh fails, we have no valid token
            console.warn('[DRAFTS] No valid token available');
            window.history.replaceState({}, document.title, window.location.pathname);
            
            // Only redirect if not on homepage
            const isHomepage = window.location.pathname === '/' || window.location.pathname === '/home';
            if (!isHomepage) {
              setTimeout(() => {
                window.location.href = '/login?error=token_expired';
              }, 100);
            } else {
              console.log('[DRAFTS] On homepage, not redirecting to prevent loops');
            }
            return; // Exit early, don't proceed with API calls
          }
        } else {
          console.warn('[DRAFTS] ⚠️ authUtils not available, cannot refresh expired token');
          // No way to refresh
          window.history.replaceState({}, document.title, window.location.pathname);
          
          // Only redirect if not on homepage
          const isHomepage = window.location.pathname === '/' || window.location.pathname === '/home';
          if (!isHomepage) {
            setTimeout(() => {
              window.location.href = '/login?error=token_expired';
            }, 100);
          } else {
            console.log('[DRAFTS] On homepage, not redirecting to prevent loops');
          }
          return; // Exit early
        }
      }
      // Remove token from URL
      window.history.replaceState({}, document.title, window.location.pathname);
      
      // Small delay to ensure token is stored before making API calls
      await new Promise(resolve => setTimeout(resolve, 100));
    }

    const loadingEl = document.getElementById('loading');
    const tableEl = document.getElementById('drafts-table');
    const bodyEl = document.getElementById('drafts-body');
    const emptyEl = document.getElementById('empty-state');

    // Helper function to clear invalid tokens and redirect to login
    // IMPORTANT: Only redirect if we're actually on the drafts page, not homepage
    function clearTokensAndRedirect() {
      console.log('[DRAFTS] Clearing invalid tokens');
      // Use centralized auth utility if available
      if (window.authUtils && window.authUtils.clearAuthTokens) {
        window.authUtils.clearAuthTokens();
      } else {
        // Fallback
        localStorage.removeItem('access_token');
        document.cookie = 'access_token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
        document.cookie = 'refresh_token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
        document.cookie = 'proof_refresh_token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
      }

      // Clear any rendered drafts immediately (avoid showing stale drafts while redirecting)
      try {
        if (bodyEl) bodyEl.innerHTML = '';
        if (tableEl) tableEl.classList.add('hidden');
        if (emptyEl) emptyEl.classList.add('hidden');
        if (loadingEl) loadingEl.classList.remove('hidden');
      } catch (_e) {}
      
      // Only redirect if we're on the drafts page, not homepage
      const isHomepage = window.location.pathname === '/' || window.location.pathname === '/home';
      if (!isHomepage) {
        console.log('[DRAFTS] Redirecting to login (not on homepage)');
        const redirectParam = encodeURIComponent('/drafts');
        window.location.replace(`/login?redirect=${redirectParam}`);
      } else {
        console.log('[DRAFTS] On homepage, not redirecting to prevent loops');
      }
    }

    // Helper function to check if token is expired (with 1 minute buffer)
    function isTokenExpired(token) {
      if (!token) return true;
      try {
        // Decode JWT payload (base64url)
        const parts = token.split('.');
        if (parts.length !== 3) return true;
        
        // Base64URL decode: replace - with +, _ with /, add padding if needed
        let base64 = parts[1].replace(/-/g, '+').replace(/_/g, '/');
        // Add padding if needed
        while (base64.length % 4) {
          base64 += '=';
        }
        
        const payload = JSON.parse(atob(base64));
        const exp = payload.exp;
        if (!exp) return true;
        
        // Check if expired
        const now = Math.floor(Date.now() / 1000);
        // Token is expired if exp < now
        // We add a small buffer (60 seconds) to refresh proactively before expiration
        const refreshBuffer = 60; // Refresh 1 minute before expiration
        // Token is expired if: exp < now (already expired) OR exp < (now + buffer) (expires soon)
        const isExp = exp < now || exp < (now + refreshBuffer);
        console.log('[DRAFTS] Token expiration check:', {
          exp: exp,
          now: now,
          expiresAt: new Date(exp * 1000).toISOString(),
          isExpired: isExp,
          timeUntilExpiry: exp - now,
          refreshBuffer: refreshBuffer,
          alreadyExpired: exp < now,
          expiresSoon: exp < (now + refreshBuffer)
        });
        return isExp;
      } catch (e) {
        console.error('[DRAFTS] Error checking token expiration:', e);
        // If we can't decode, don't assume expired - let the server decide
        return false;
      }
    }

    // Helper function to refresh access token - use centralized authUtils
    let refreshInProgress = false; // Prevent multiple simultaneous refresh attempts
    async function refreshAccessToken() {
      // Prevent infinite loops - if refresh is already in progress, wait
      if (refreshInProgress) {
        console.log('[DRAFTS] Refresh already in progress, waiting...');
        return null;
      }
      
      refreshInProgress = true;
    try {
      // Use centralized auth utility if available
      if (window.authUtils && window.authUtils.refreshAccessToken) {
        const newToken = await window.authUtils.refreshAccessToken();
        refreshInProgress = false;
        return newToken;
      } else {
        // Fallback to direct fetch (shouldn't happen if auth-utils is loaded)
        console.warn('[DRAFTS] authUtils not available, using fallback refresh');
        const response = await fetch('/auth/refresh', {
          method: 'POST',
          credentials: 'include',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
          }
        });
        
        if (!response.ok) {
          console.error('[DRAFTS] Token refresh failed:', response.status);
          refreshInProgress = false;
          // Don't redirect here - let the caller handle it to prevent loops
          return null;
        }
        
        const data = await response.json();
        if (data.access_token) {
          localStorage.setItem('access_token', data.access_token);
          document.cookie = `access_token=${data.access_token}; path=/; SameSite=Lax; Max-Age=900`;
          refreshInProgress = false;
          return data.access_token;
        }
        refreshInProgress = false;
        return null;
      }
    } catch (error) {
      console.error('[DRAFTS] Error refreshing token:', error);
      refreshInProgress = false;
      return null;
    }
    }

    // Helper function to fetch submissions with retry on 401
    async function fetchSubmissionsWithRetry() {
      // Get access token from localStorage
      let token = localStorage.getItem('access_token');
    console.log('[DRAFTS] Token in localStorage:', token ? 'Present' : 'Missing', token ? token.substring(0, 20) + '...' : '');
    
    // Also check cookies as fallback
    const cookies = document.cookie.split(';').reduce((acc, cookie) => {
      const [key, value] = cookie.trim().split('=');
      acc[key] = value;
      return acc;
    }, {});
    const cookieToken = cookies.access_token;
    console.log('[DRAFTS] Token in cookie:', cookieToken ? 'Present' : 'Missing');
    
    // Use localStorage token first, fallback to cookie
    let accessToken = token || cookieToken;
    
    // ALWAYS check if token is expired and refresh proactively BEFORE making the request
    // This prevents 401 errors when we have a valid refresh token
    // Force refresh if token is missing, expired, or about to expire
    let needsRefresh = false;
    
    if (!accessToken) {
      console.warn('[DRAFTS] ⚠️ No access token found, will refresh...');
      needsRefresh = true;
    } else {
      const expired = isTokenExpired(accessToken);
      console.log('[DRAFTS] Token expiration check result:', expired);
      if (expired) {
        console.log('[DRAFTS] ⚠️ Token is expired or expires soon, will refresh...');
        const tokenExp = (() => {
          try {
            const parts = accessToken.split('.');
            if (parts.length === 3) {
              let base64 = parts[1].replace(/-/g, '+').replace(/_/g, '/');
              while (base64.length % 4) base64 += '=';
              const payload = JSON.parse(atob(base64));
              return payload.exp;
            }
          } catch (e) {}
          return null;
        })();
        const now = Math.floor(Date.now() / 1000);
        console.log('[DRAFTS] Token details:', {
          exp: tokenExp,
          now: now,
          expired: tokenExp ? tokenExp < now : 'unknown',
          timeUntilExpiry: tokenExp ? tokenExp - now : 'unknown'
        });
        needsRefresh = true;
      } else {
        console.log('[DRAFTS] ✅ Token is valid, proceeding with request');
      }
    }
    
    // If refresh is needed, do it NOW and wait for it to complete
    if (needsRefresh) {
      console.log('[DRAFTS] 🔄 Refreshing token before request...');
      const newToken = await refreshAccessToken();
      if (newToken) {
        accessToken = newToken;
        console.log('[DRAFTS] ✅ Token refreshed successfully before request');
        const newTokenExp = (() => {
          try {
            const parts = newToken.split('.');
            if (parts.length === 3) {
              let base64 = parts[1].replace(/-/g, '+').replace(/_/g, '/');
              while (base64.length % 4) base64 += '=';
              const payload = JSON.parse(atob(base64));
              return payload.exp;
            }
          } catch (e) {}
          return null;
        })();
        const now = Math.floor(Date.now() / 1000);
        console.log('[DRAFTS] New token details:', {
          exp: newTokenExp,
          now: now,
          timeUntilExpiry: newTokenExp ? newTokenExp - now : 'unknown',
          isValid: newTokenExp ? newTokenExp > now : false
        });
        
        // CRITICAL: Verify the new token is actually valid before using it
        if (newTokenExp && newTokenExp <= now) {
          console.error('[DRAFTS] ❌ CRITICAL: Refreshed token is STILL expired!', {
            exp: newTokenExp,
            now: now,
            diff: newTokenExp - now
          });
          // This shouldn't happen, but if it does, redirect to login
          // Only redirect if still on drafts page
          setTimeout(() => {
            if (window.location.pathname === '/drafts') {
              clearTokensAndRedirect();
            } else {
              console.log('[DRAFTS] Already redirected, not calling clearTokensAndRedirect');
            }
          }, 100);
          return null;
        }
        
        // Update localStorage with new token IMMEDIATELY
        localStorage.setItem('access_token', newToken);
        console.log('[DRAFTS] ✅ New token stored in localStorage and verified as valid');
      } else {
        // Refresh failed, no valid refresh token - redirect to login
        console.warn('[DRAFTS] ❌ Token refresh failed before request');
        console.warn('[DRAFTS] This usually means the refresh token cookie is missing or invalid');
        // Only redirect if still on drafts page
        setTimeout(() => {
          if (window.location.pathname === '/drafts') {
            clearTokensAndRedirect();
          } else {
            console.log('[DRAFTS] Already redirected, not calling clearTokensAndRedirect');
          }
        }, 100);
        return null;
      }
    }
    
    // Build headers with Authorization - accessToken should be valid at this point
    // (either from localStorage/cookie or from refresh above)
    const headers = {
      'Accept': 'application/json'
    };
    
    if (!accessToken) {
      // This should never happen if refresh logic above worked correctly
      console.error('[DRAFTS] ❌ CRITICAL: No access token after refresh attempt!');
      // Only redirect if still on drafts page
      setTimeout(() => {
        if (window.location.pathname === '/drafts') {
          clearTokensAndRedirect();
        } else {
          console.log('[DRAFTS] Already redirected, not calling clearTokensAndRedirect');
        }
      }, 100);
      return null;
    }
    
    // Double-check token is still valid before using it
    const stillExpired = isTokenExpired(accessToken);
    if (stillExpired) {
      console.error('[DRAFTS] ❌ CRITICAL: Token is still expired after refresh!');
      try {
        const tokenPreview = accessToken && typeof accessToken === 'string' 
          ? accessToken.substring(0, 50) + '...' 
          : 'null or invalid';
        const tokenLength = accessToken && typeof accessToken === 'string' 
          ? accessToken.length 
          : 0;
        console.error('[DRAFTS] Token details:', {
          token: tokenPreview,
          length: tokenLength,
          type: typeof accessToken
        });
      } catch (e) {
        console.error('[DRAFTS] Error logging token details:', e);
      }
      
      // Try one more refresh (maybe refresh token cookie just became available)
      console.log('[DRAFTS] Attempting second refresh...');
      const finalToken = await refreshAccessToken();
      if (finalToken) {
        // Verify this token is actually valid
        const finalExpired = isTokenExpired(finalToken);
        if (finalExpired) {
          console.error('[DRAFTS] ❌ Second refresh also returned expired token!');
          // Only redirect if still on drafts page
          setTimeout(() => {
            if (window.location.pathname === '/drafts') {
              clearTokensAndRedirect();
            } else {
              console.log('[DRAFTS] Already redirected, not calling clearTokensAndRedirect');
            }
          }, 100);
          return null;
        }
        accessToken = finalToken;
        localStorage.setItem('access_token', finalToken);
        console.log('[DRAFTS] ✅ Got valid token on second refresh attempt');
      } else {
        console.error('[DRAFTS] ❌ Second refresh also failed');
        console.error('[DRAFTS] This indicates the refresh token cookie is not available or invalid');
        // Only redirect if still on drafts page
        setTimeout(() => {
          if (window.location.pathname === '/drafts') {
            clearTokensAndRedirect();
          } else {
            console.log('[DRAFTS] Already redirected, not calling clearTokensAndRedirect');
          }
        }, 100);
        return null;
      }
    }
    
    // CRITICAL: Validate accessToken before using it
    if (!accessToken || typeof accessToken !== 'string') {
      console.error('[DRAFTS] ❌ CRITICAL: accessToken is invalid:', typeof accessToken, accessToken);
      throw new Error('Invalid access token - token is not a string');
    }
    
    headers['Authorization'] = `Bearer ${accessToken}`;
    console.log('[DRAFTS] ✅ Adding Authorization header with valid token');
    try {
      console.log('[DRAFTS] Token length:', accessToken.length);
      console.log('[DRAFTS] Token preview (first 50 chars):', accessToken.substring(0, 50));
      console.log('[DRAFTS] Token preview (last 20 chars):', accessToken.substring(accessToken.length - 20));
    } catch (e) {
      console.error('[DRAFTS] Error logging token details:', e);
      // Don't throw - just log the error
    }

    console.log('[DRAFTS] Fetching submissions from /api/v1/submissions');
    
    // Use centralized apiFetch if available (handles token refresh automatically)
    let response;
    if (window.authUtils && window.authUtils.apiFetch) {
      console.log('[DRAFTS] Using centralized apiFetch for automatic token refresh');
      try {
        // Convert headers object to plain object for apiFetch
        const headersObj = {
          'Accept': 'application/json',
          'Authorization': headers['Authorization']
        };
        console.log('[DRAFTS] Headers being sent:', headersObj);
        
        response = await window.authUtils.apiFetch('/api/v1/submissions?limit=1000&offset=0', {
          method: 'GET',
          credentials: 'include',
          headers: headersObj
        });
        console.log('[DRAFTS] apiFetch response status:', response.status);
      } catch (error) {
        console.error('[DRAFTS] apiFetch error:', error);
        // If apiFetch redirects to login, return null (but only if we're on drafts page)
        // Also check if we've been redirected away from drafts page
        const currentPath = window.location.pathname;
        if (currentPath !== '/drafts') {
          // We've been redirected (possibly by apiFetch), don't throw error
          console.log('[DRAFTS] Already redirected to', currentPath, ', not throwing error');
          return null;
        }
        if (error.message === 'Unauthorized' || error.message === 'Unauthorized' || error.message === 'login_required') {
          // Still on drafts page, return null to indicate auth failure
          console.log('[DRAFTS] Unauthorized, returning null');
          return null;
        }
        // Re-throw other errors
        console.error('[DRAFTS] Re-throwing error:', error);
        throw error;
      }
    } else {
      // Fallback to manual fetch
      response = await fetch('/api/v1/submissions?limit=1000&offset=0', {
        credentials: 'include',
        headers: headers
      });
      
      console.log('[DRAFTS] Response status:', response.status, response.statusText);
      
      // If 401, try to refresh token and retry once (only if we haven't already tried)
      if (response.status === 401) {
        if (refreshInProgress) {
          // Already tried to refresh, don't try again
          console.warn('[DRAFTS] Got 401 but refresh already attempted');
          // Only redirect if still on drafts page
          setTimeout(() => {
            if (window.location.pathname === '/drafts') {
              clearTokensAndRedirect();
            } else {
              console.log('[DRAFTS] Already redirected, not calling clearTokensAndRedirect');
            }
          }, 100);
          return null;
        }
        
        console.log('[DRAFTS] Got 401, attempting token refresh...');
        const newToken = await refreshAccessToken();
        if (newToken) {
          // CRITICAL: Get the token FRESH from localStorage after refresh
          // Don't use the closure variable as it might be stale
          const freshToken = localStorage.getItem('access_token') || newToken;
          
          // Retry with new token - create fresh headers object
          const retryHeaders = new Headers();
          retryHeaders.set('Accept', 'application/json');
          retryHeaders.set('Authorization', `Bearer ${freshToken}`);
          
          console.log('[DRAFTS] Retrying request with refreshed token');
          console.log('[DRAFTS] Retry token preview:', freshToken.substring(0, 50) + '...');
          
          // Verify token expiration before retry
          const tokenExp = (() => {
            try {
              const parts = freshToken.split('.');
              if (parts.length === 3) {
                let base64 = parts[1].replace(/-/g, '+').replace(/_/g, '/');
                while (base64.length % 4) base64 += '=';
                const payload = JSON.parse(atob(base64));
                return payload.exp;
              }
            } catch (e) {}
            return null;
          })();
          const now = Math.floor(Date.now() / 1000);
          console.log('[DRAFTS] Retry token validation:', {
            exp: tokenExp,
            now: now,
            isValid: tokenExp ? tokenExp > now : false,
            timeUntilExpiry: tokenExp ? tokenExp - now : 'unknown'
          });
          
          response = await fetch('/api/v1/submissions?limit=1000&offset=0', {
            credentials: 'include',
            headers: retryHeaders
          });
          console.log('[DRAFTS] Retry response status:', response.status, response.statusText);
          
          // If retry also fails with 401, refresh token is invalid - redirect once
          if (response.status === 401) {
            console.warn('[DRAFTS] Still getting 401 after token refresh, refresh token is invalid');
            // Use setTimeout to prevent immediate redirect loops
            // Only redirect if still on drafts page
            setTimeout(() => {
              if (window.location.pathname === '/drafts') {
                clearTokensAndRedirect();
              } else {
                console.log('[DRAFTS] Already redirected, not calling clearTokensAndRedirect');
              }
            }, 100);
            return null;
          }
        } else {
          // Refresh failed, token is invalid - redirect once
          console.warn('[DRAFTS] Token refresh failed, refresh token is invalid');
          // Use setTimeout to prevent immediate redirect loops
          // Only redirect if still on drafts page
          setTimeout(() => {
            if (window.location.pathname === '/drafts') {
              clearTokensAndRedirect();
            } else {
              console.log('[DRAFTS] Already redirected, not calling clearTokensAndRedirect');
            }
          }, 100);
          return null;
        }
      }
    }
    
    if (!response.ok) {
      // Try to get error message from response
      let errorMessage = `HTTP ${response.status}`;
      try {
        const errorData = await response.clone().json();
        if (errorData.error) {
          errorMessage = errorData.error;
        }
        console.error('[DRAFTS] Error response data:', errorData);
      } catch (e) {
        // If JSON parsing fails, use status text
        errorMessage = response.statusText || `HTTP ${response.status}`;
      }
      throw new Error(errorMessage);
    }
    
    return response;
  }

    try {
      console.log('[DRAFTS] Starting to load drafts...');
      const response = await fetchSubmissionsWithRetry();
      
      if (!response) {
      // fetchSubmissionsWithRetry returned null (no token or redirect happened)
      console.warn('[DRAFTS] fetchSubmissionsWithRetry returned null');
      loadingEl.classList.add('hidden');
      emptyEl.classList.remove('hidden');
      emptyEl.innerHTML = `
        <svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
        <p class="text-lg font-medium">Authentication Required</p>
        <p class="text-sm mt-2">Please log in to view your drafts.</p>
        <a href="/login" class="mt-4 inline-block btn-primary">
          Log In
        </a>
      `;
      return;
    }

    console.log('[DRAFTS] Response received, status:', response.status);
    
    // Check if response is 204 (No Content)
    if (response.status === 204) {
      console.warn('[DRAFTS] Response is 204 (No Content), showing empty state');
      loadingEl.classList.add('hidden');
      emptyEl.classList.remove('hidden');
      return;
    }
    
    // Check content-type for non-204 responses
    const contentType = response.headers.get('content-type');
    console.log('[DRAFTS] Response content-type:', contentType);
    
    if (!contentType || !contentType.includes('application/json')) {
      console.warn('[DRAFTS] Response is not JSON, showing empty state');
      loadingEl.classList.add('hidden');
      emptyEl.classList.remove('hidden');
      return;
    }
    
    // Parse JSON response
    let data;
    try {
      const text = await response.text();
      console.log('[DRAFTS] Response text (first 200 chars):', text ? text.substring(0, 200) : 'null');
      if (!text || text.trim().length === 0) {
        console.warn('[DRAFTS] Response body is empty');
        loadingEl.classList.add('hidden');
        emptyEl.classList.remove('hidden');
        return;
      }
      data = JSON.parse(text);
    } catch (e) {
      console.error('[DRAFTS] Error parsing JSON response:', e);
      loadingEl.classList.add('hidden');
      emptyEl.classList.remove('hidden');
      emptyEl.innerHTML = `
        <svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <p class="text-lg font-medium">Error loading drafts</p>
        <p class="text-sm mt-2">Invalid response from server</p>
        <a href="/workspace" class="mt-4 inline-block btn-primary">
          Create New Draft
        </a>
      `;
      return;
    }
    
    console.log('[DRAFTS] Response data:', data);
    const drafts = data.submissions || data.data || [];
    console.log('[DRAFTS] Found', drafts.length, 'drafts');

    loadingEl.classList.add('hidden');

    if (drafts.length === 0) {
      emptyEl.classList.remove('hidden');
      return;
    }

    // Sort by created_at descending (newest first)
    drafts.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));

    tableEl.classList.remove('hidden');
    
    drafts.forEach(draft => {
      const row = document.createElement('tr');
      const preview = draft.original_text ? draft.original_text.substring(0, 100) + '...' : 'No preview';
      const statusClass = draft.status === 'completed' ? 'bg-green-200 text-green-900' :
                         draft.status === 'processing' ? 'bg-yellow-200 text-yellow-900' :
                         draft.status === 'failed' ? 'bg-red-200 text-red-900' :
                         'bg-gray-200 text-gray-900';
      
      row.innerHTML = `
        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
          ${draft.title || `Draft ${draft.id}`}
        </td>
        <td class="px-6 py-4 text-sm text-gray-600 max-w-xs truncate">
          ${preview}
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
          ${draft.word_count || 0}
        </td>
        <td class="px-6 py-4 whitespace-nowrap">
          <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${statusClass}">
            ${draft.status || 'pending'}
          </span>
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
          ${new Date(draft.created_at).toLocaleDateString()}
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
          <a href="/workspace?draftId=${draft.id}&mode=view" class="text-indigo-600 hover:text-indigo-900 mr-4">View</a>
          <a href="/workspace?draftId=${draft.id}" class="text-indigo-600 hover:text-indigo-900">Edit</a>
        </td>
      `;
      bodyEl.appendChild(row);
      });
    } catch (error) {
    // CRITICAL: Check if we've been redirected away from drafts page
    // If so, don't try to show error UI (we're on a different page now)
    if (window.location.pathname !== '/drafts') {
      console.log('[DRAFTS] Error occurred but we\'ve been redirected to', window.location.pathname, '- not showing error UI');
      return;
    }
    
    console.error('[DRAFTS] Error loading drafts:', error);
    loadingEl.classList.add('hidden');
    emptyEl.classList.remove('hidden');
    
    // Check if it's an authentication error
    const errorMessage = error.message || String(error);
    const isAuthError = errorMessage.includes('401') || 
                       errorMessage.includes('unauthorized') || 
                       errorMessage.includes('Unauthorized') ||
                       errorMessage.includes('Invalid or expired token');
    
    if (isAuthError) {
      emptyEl.innerHTML = '<svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg><p class="text-lg font-medium">Authentication Required</p><p class="text-sm mt-2">Please log in to view your drafts.</p><a href="/login" class="mt-4 inline-block btn-primary">Log In</a>';
    } else {
      const safeErrorMessage = errorMessage.replace(/</g, '&lt;').replace(/>/g, '&gt;');
      emptyEl.innerHTML = '<svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><p class="text-lg font-medium">Error loading drafts</p><p class="text-sm mt-2">' + safeErrorMessage + '</p><a href="/workspace" class="mt-4 inline-block btn-primary">Create New Draft</a>';
    }
  }
})().catch(error => {
    // CRITICAL: Catch any uncaught errors in the async function
    // This prevents uncaught promise rejections from causing redirect loops
    console.error('[DRAFTS] Uncaught error in drafts page initialization:', error);
    console.error('[DRAFTS] Error stack:', error.stack);
    
    // Only show error if we're still on drafts page
    if (window.location.pathname === '/drafts') {
      try {
        const emptyEl = document.getElementById('empty-state');
        const loadingEl = document.getElementById('loading');
        if (loadingEl) loadingEl.classList.add('hidden');
        if (emptyEl) {
          emptyEl.classList.remove('hidden');
          emptyEl.innerHTML = '<svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><p class="text-lg font-medium">Error loading drafts</p><p class="text-sm mt-2">An unexpected error occurred. Please refresh the page.</p><a href="/workspace" class="mt-4 inline-block btn-primary">Create New Draft</a>';
        }
      } catch (uiError) {
        console.error('[DRAFTS] Error showing error UI:', uiError);
      }
    } else {
      console.log('[DRAFTS] Error occurred but we\'ve been redirected to', window.location.pathname, '- not showing error UI');
    }
  });
})(); // End of drafts page script - semicolon prevents ASI issues

// Ensure Create New Draft button works - add click handler after DOM is ready
(function() {
  function setupCreateButton() {
    const createBtn = document.getElementById('create-new-draft-btn');
    if (createBtn) {
      // Remove any existing handlers
      createBtn.onclick = null;
      createBtn.addEventListener('click', function(e) {
        e.preventDefault();
        console.log('[DRAFTS] Create New Draft button clicked, navigating to /workspace');
        window.location.href = '/workspace';
        return false;
      }, false);
      console.log('[DRAFTS] Create New Draft button handler attached');
    }
    
    // Also handle any other workspace links on the page
    const workspaceLinks = document.querySelectorAll('a[href="/workspace"]');
    workspaceLinks.forEach(link => {
      if (link.id !== 'create-new-draft-btn') {
        link.addEventListener('click', function(e) {
          e.preventDefault();
          console.log('[DRAFTS] Workspace link clicked, navigating to /workspace');
          window.location.href = '/workspace';
          return false;
        }, false);
      }
    });
  }
  
  // Run immediately if DOM is ready, otherwise wait
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCreateButton);
  } else {
    setupCreateButton();
  }
})();
</script>


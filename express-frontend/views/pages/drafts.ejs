                  else { emptyEl.classList.add('hidden'); tableEl.classList.remove('hidden'); renderDraftsTable(filtered); }
                  document.querySelectorAll('.group-filter').forEach(b => {
                    if (String(b.getAttribute('data-group-id')) === String(data.group.id)) { b.classList.add('bg-primary-50', 'text-primary-700'); b.classList.remove('text-gray-700'); }
                    else { b.classList.remove('bg-primary-50', 'text-primary-700'); if (b.getAttribute('data-group-id') !== 'all') b.classList.add('text-gray-700'); }
                  });
                });
              }
            }
            newGroupForm.classList.add('hidden');
            showNotification('Group created', 'success');
          } else {
            const err = await res.json().catch(() => ({}));
            showNotification(err.error || 'Failed to create group', 'error');
          }
        } catch (_) {
          showNotification('Failed to create group', 'error');
        }
      });
    }
    } catch (error) {
    // CRITICAL: Check if we've been redirected away from drafts page
    // If so, don't try to show error UI (we're on a different page now)
    if (window.location.pathname !== '/drafts') {
      console.log('[DRAFTS] Error occurred but we\'ve been redirected to', window.location.pathname, '- not showing error UI');
      return;
    }
    
    console.error('[DRAFTS] Error loading drafts:', error);
    loadingEl.classList.add('hidden');
    emptyEl.classList.remove('hidden');
    
    // Check if it's an authentication error
    const errorMessage = error.message || String(error);
    const isAuthError = errorMessage.includes('401') || 
                       errorMessage.includes('unauthorized') || 
                       errorMessage.includes('Unauthorized') ||
                       errorMessage.includes('Invalid or expired token');
    
    if (isAuthError) {
      emptyEl.innerHTML = '<svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg><p class="text-lg font-medium">Authentication Required</p><p class="text-sm mt-2">Please log in to view your drafts.</p><a href="/login" class="mt-4 inline-block btn-primary">Log In</a>';
    } else {
      const safeErrorMessage = errorMessage.replace(/</g, '&lt;').replace(/>/g, '&gt;');
      emptyEl.innerHTML = '<svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><p class="text-lg font-medium">Error loading drafts</p><p class="text-sm mt-2">' + safeErrorMessage + '</p><a href="/workspace" class="mt-4 inline-block btn-primary">Create New Draft</a>';
    }
  }
})().catch(error => {
    // CRITICAL: Catch any uncaught errors in the async function
    // This prevents uncaught promise rejections from causing redirect loops
    console.error('[DRAFTS] Uncaught error in drafts page initialization:', error);
    console.error('[DRAFTS] Error stack:', error.stack);
    
    // Only show error if we're still on drafts page
    if (window.location.pathname === '/drafts') {
      try {
        const emptyEl = document.getElementById('empty-state');
        const loadingEl = document.getElementById('loading');
        if (loadingEl) loadingEl.classList.add('hidden');
        if (emptyEl) {
          emptyEl.classList.remove('hidden');
          emptyEl.innerHTML = '<svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><p class="text-lg font-medium">Error loading drafts</p><p class="text-sm mt-2">An unexpected error occurred. Please refresh the page.</p><a href="/workspace" class="mt-4 inline-block btn-primary">Create New Draft</a>';
        }
      } catch (uiError) {
        console.error('[DRAFTS] Error showing error UI:', uiError);
      }
    } else {
      console.log('[DRAFTS] Error occurred but we\'ve been redirected to', window.location.pathname, '- not showing error UI');
    }
  });
})(); // End of drafts page script - semicolon prevents ASI issues

// Ensure Create New Draft button works - add click handler after DOM is ready
(function() {
  function setupCreateButton() {
    const createBtn = document.getElementById('create-new-draft-btn');
    if (createBtn) {
      // Remove any existing handlers
      createBtn.onclick = null;
      createBtn.addEventListener('click', function(e) {
        e.preventDefault();
        console.log('[DRAFTS] Create New Draft button clicked, navigating to /workspace');
        window.location.href = '/workspace';
        return false;
      }, false);
      console.log('[DRAFTS] Create New Draft button handler attached');
    }
    
    // Also handle any other workspace links on the page
    const workspaceLinks = document.querySelectorAll('a[href="/workspace"]');
    workspaceLinks.forEach(link => {
      if (link.id !== 'create-new-draft-btn') {
        link.addEventListener('click', function(e) {
          e.preventDefault();
          console.log('[DRAFTS] Workspace link clicked, navigating to /workspace');
          window.location.href = '/workspace';
          return false;
        }, false);
      }
    });
  }
  
  // Run immediately if DOM is ready, otherwise wait
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCreateButton);
  } else {
    setupCreateButton();
  }
})();

// Delete Draft functions
let pendingDeleteId = null;

function confirmDeleteDraft(draftId, draftTitle) {
  console.log('[DRAFTS] Showing delete confirmation for draft:', draftId, draftTitle);
  pendingDeleteId = draftId;
  document.getElementById('delete-draft-title').textContent = draftTitle;
  document.getElementById('delete-modal').classList.remove('hidden');
}

function closeDeleteModal() {
  document.getElementById('delete-modal').classList.add('hidden');
  pendingDeleteId = null;
}

async function executeDraftDelete() {
  if (!pendingDeleteId) {
    console.error('[DRAFTS] No draft ID to delete');
    closeDeleteModal();
    return;
  }
  
  const draftId = pendingDeleteId;
  const deleteBtn = document.getElementById('confirm-delete-btn');
  const originalText = deleteBtn.textContent;
  
  // Show loading state
  deleteBtn.textContent = 'Deleting...';
  deleteBtn.disabled = true;
  
  try {
    // Get access token
    const token = localStorage.getItem('access_token');
    const headers = {
      'Accept': 'application/json',
      'Content-Type': 'application/json'
    };
    if (token) {
      headers['Authorization'] = `Bearer ${token}`;
    }
    
    console.log('[DRAFTS] Deleting draft:', draftId);
    
    const response = await fetch(`/api/v1/submissions/${draftId}`, {
      method: 'DELETE',
      credentials: 'include',
      headers: headers
    });
    
    console.log('[DRAFTS] Delete response status:', response.status);
    
    if (response.ok) {
      // Remove the row from the table
      const row = document.getElementById(`draft-row-${draftId}`);
      if (row) {
        row.remove();
      }
      
      // Check if table is now empty
      const bodyEl = document.getElementById('drafts-body');
      if (bodyEl && bodyEl.children.length === 0) {
        document.getElementById('drafts-table').classList.add('hidden');
        document.getElementById('empty-state').classList.remove('hidden');
      }
      
      // Show success notification
      showNotification('Draft deleted successfully', 'success');
      
      console.log('[DRAFTS] Draft deleted successfully:', draftId);
    } else {
      const errorData = await response.json().catch(() => ({}));
      console.error('[DRAFTS] Delete failed:', response.status, errorData);
      showNotification(errorData.error || 'Failed to delete draft', 'error');
    }
  } catch (error) {
    console.error('[DRAFTS] Delete error:', error);
    showNotification('Failed to delete draft. Please try again.', 'error');
  } finally {
    // Reset button state
    deleteBtn.textContent = originalText;
    deleteBtn.disabled = false;
    closeDeleteModal();
  }
}

function showNotification(message, type) {
  // Create notification element
  const notification = document.createElement('div');
  notification.className = `fixed top-4 right-4 z-50 px-6 py-3 rounded-lg shadow-lg transform transition-all duration-300 ${
    type === 'success' ? 'bg-green-500 text-white' : 'bg-red-500 text-white'
  }`;
  notification.textContent = message;
  
  document.body.appendChild(notification);
  
  // Animate in
  setTimeout(() => {
    notification.style.opacity = '1';
    notification.style.transform = 'translateY(0)';
  }, 10);
  
  // Remove after 3 seconds
  setTimeout(() => {
    notification.style.opacity = '0';
    notification.style.transform = 'translateY(-10px)';
    setTimeout(() => notification.remove(), 300);
  }, 3000);
}

// Close modal with Escape key
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    if (document.getElementById('duplicate-modal') && !document.getElementById('duplicate-modal').classList.contains('hidden')) {
      closeDuplicateModal();
    } else {
      closeDeleteModal();
    }
    closeDraftMenu();
  }
});

// ─── Pin state (localStorage) ────────────────────────────────────────────────
function getPinnedIds() {
  try { return JSON.parse(localStorage.getItem('pinnedDrafts') || '[]'); }
  catch (_) { return []; }
}
function setPinnedIds(ids) {
  localStorage.setItem('pinnedDrafts', JSON.stringify(ids));
}

// ─── Auth helper ─────────────────────────────────────────────────────────────
function getAuthHeaders() {
  const h = { 'Content-Type': 'application/json', 'Accept': 'application/json' };
  const token = localStorage.getItem('access_token');
  if (token) h['Authorization'] = `Bearer ${token}`;
  return h;
}

// ─── Context menu ─────────────────────────────────────────────────────────────
let _menuDraftId   = null;
let _menuDraftTitle = '';

function toggleDraftMenu(event, id) {
  event.stopPropagation();
  const menu = document.getElementById('draft-context-menu');
  const row  = document.getElementById(`draft-row-${id}`);
  _menuDraftId    = id;
  _menuDraftTitle = row ? (row.getAttribute('data-title') || `Draft ${id}`) : `Draft ${id}`;

  // Update pin label to reflect current state
  const ids = getPinnedIds();
  const pinLabel = document.getElementById('menu-pin-label');
  if (pinLabel) pinLabel.textContent = ids.includes(id) ? 'Unpin' : 'Pin';

  // Position below the button, aligned to its right edge
  const rect = event.currentTarget.getBoundingClientRect();
  const menuW = 192;
  let top  = rect.bottom + 4;
  let left = rect.right - menuW;
  if (left < 8) left = 8;
  if (left + menuW > window.innerWidth - 8) left = window.innerWidth - menuW - 8;
  // Flip upward if too close to the bottom
  if (top + 240 > window.innerHeight) top = rect.top - 244;
  if (top < 8) top = 8;

  menu.style.top  = top  + 'px';
  menu.style.left = left + 'px';
  menu.classList.toggle('hidden');
}

function closeDraftMenu() {
  document.getElementById('draft-context-menu')?.classList.add('hidden');
}
document.addEventListener('click', closeDraftMenu);

// ─── Menu: Edit ───────────────────────────────────────────────────────────────
function menuEdit() {
  closeDraftMenu();
  if (_menuDraftId) window.location.href = `/workspace?draftId=${_menuDraftId}`;
}

// ─── Menu: Rename (inline) ────────────────────────────────────────────────────
function menuRename() {
  closeDraftMenu();
  if (!_menuDraftId) return;
  const id      = _menuDraftId;
  const titleEl = document.getElementById(`draft-title-${id}`);
  if (!titleEl) return;
  const current = titleEl.textContent.trim();

  const input = document.createElement('input');
  input.type      = 'text';
  input.value     = current;
  input.className = 'border border-primary-400 rounded px-2 py-0.5 text-sm w-52 focus:outline-none focus:ring-2 focus:ring-primary-500';
  input.setAttribute('data-original', current);

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter')  { e.preventDefault(); saveRename(id, input); }
    if (e.key === 'Escape') { input._cancelled = true; cancelRename(id, input); }
  });
  input.addEventListener('blur', () => { if (!input._cancelled) saveRename(id, input); });

  titleEl.parentNode.replaceChild(input, titleEl);
  input.focus();
  input.select();
}

async function saveRename(id, input) {
  if (input._saving) return;
  input._saving = true;

  const newTitle = input.value.trim();
  if (!newTitle || newTitle === input.getAttribute('data-original')) {
    cancelRename(id, input);
    return;
  }
  input.disabled = true;

  try {
    const res = await fetch(`/api/v1/submissions/${id}`, {
      method: 'PATCH',
      credentials: 'include',
      headers: getAuthHeaders(),
      body: JSON.stringify({ title: newTitle })
    });

    if (res.ok) {
      const span = document.createElement('span');
      span.id        = `draft-title-${id}`;
      span.className = 'truncate max-w-[220px] block';
      span.title     = newTitle;
      span.textContent = newTitle;
      if (input.parentNode) input.parentNode.replaceChild(span, input);
      const row = document.getElementById(`draft-row-${id}`);
      if (row) row.setAttribute('data-title', newTitle);
      showNotification('Draft renamed successfully', 'success');
    } else {
      const err = await res.json().catch(() => ({}));
      showNotification(err.error || 'Failed to rename draft', 'error');
      cancelRename(id, input);
    }
  } catch (_) {
    showNotification('Failed to rename draft', 'error');
    cancelRename(id, input);
  }
}

function cancelRename(id, input) {
  const original = input.getAttribute('data-original');
  const span = document.createElement('span');
  span.id          = `draft-title-${id}`;
  span.className   = 'truncate max-w-[220px] block';
  span.title       = original;
  span.textContent = original;
  if (input.parentNode) input.parentNode.replaceChild(span, input);
}

// ─── Menu: Duplicate (modal with name + group) ──────────────────────────────────
let _duplicateDraftId = null;
let _duplicateDraftTitle = '';

function menuDuplicate() {
  closeDraftMenu();
  if (!_menuDraftId) return;
  _duplicateDraftId = _menuDraftId;
  _duplicateDraftTitle = _menuDraftTitle || ('Draft ' + _menuDraftId);

  var nameInput = document.getElementById('duplicate-name-input');
  var groupSelect = document.getElementById('duplicate-group-select');
  if (nameInput) nameInput.value = 'Copy of ' + _duplicateDraftTitle;
  if (groupSelect) {
    groupSelect.innerHTML = '<option value="">Ungrouped</option>';
    if (window.__draftsData && window.__draftsData.groups) {
      window.__draftsData.groups.forEach(function(g) {
        var opt = document.createElement('option');
        opt.value = g.id;
        opt.textContent = g.name || '';
        groupSelect.appendChild(opt);
      });
    }
  }
  document.getElementById('duplicate-modal').classList.remove('hidden');
}

function closeDuplicateModal() {
  document.getElementById('duplicate-modal').classList.add('hidden');
  _duplicateDraftId = null;
}

async function executeDuplicate() {
  if (!_duplicateDraftId) return;
  var nameInput = document.getElementById('duplicate-name-input');
  var groupSelect = document.getElementById('duplicate-group-select');
  var btn = document.getElementById('duplicate-confirm-btn');
  var name = nameInput ? nameInput.value.trim() : '';
  if (!name) name = 'Copy of ' + _duplicateDraftTitle;
  var groupId = groupSelect && groupSelect.value ? parseInt(groupSelect.value, 10) : null;
  if (isNaN(groupId)) groupId = null;

  btn.disabled = true;
  btn.textContent = 'Duplicating...';
  try {
    var body = { name: name };
    if (groupId) body.group_id = groupId;
    var res = await fetch('/api/v1/submissions/' + _duplicateDraftId + '/duplicate', {
      method: 'POST',
      credentials: 'include',
      headers: getAuthHeaders(),
      body: JSON.stringify(body)
    });

    if (res.ok) {
      showNotification('Draft duplicated successfully!', 'success');
      closeDuplicateModal();
      setTimeout(function() { window.location.reload(); }, 800);
    } else {
      var err = await res.json().catch(function() { return {}; });
      showNotification(err.error || 'Failed to duplicate draft', 'error');
    }
  } catch (_) {
    showNotification('Failed to duplicate draft', 'error');
  }
  btn.disabled = false;
  btn.textContent = 'Duplicate';
}

function filterDrafts() {
  var d = window.__draftsData;
  if (!d) return [];
  var id = d.selectedGroupId;
  if (id === 'all') return d.allDrafts;
  if (id === '0') return d.allDrafts.filter(function(x) { return !x.group_id; });
  return d.allDrafts.filter(function(x) { return x.group_id == id; });
}

// ─── Menu: Move to group ─────────────────────────────────────────────────────
function menuMoveToGroup() {
  closeDraftMenu();
  if (!_menuDraftId) return;
  var popover = document.getElementById('move-group-popover');
  var listEl = document.getElementById('move-group-list');
  if (!popover || !listEl) return;
  listEl.innerHTML = '';
  if (window.__draftsData && window.__draftsData.groups) {
    window.__draftsData.groups.forEach(function(g) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'move-group-option w-full text-left px-4 py-2 hover:bg-gray-50 text-gray-700';
      btn.setAttribute('data-move-group-id', g.id);
      btn.textContent = g.name || '';
      listEl.appendChild(btn);
    });
  }
  var menuEl = document.getElementById('draft-context-menu');
  if (menuEl) {
    var rect = menuEl.getBoundingClientRect();
    popover.style.left = rect.left + 'px';
    popover.style.top = (rect.bottom + 4) + 'px';
  }
  popover.classList.remove('hidden');

  function closePopover() {
    popover.classList.add('hidden');
    document.removeEventListener('click', closePopover);
  }
  setTimeout(function() { document.addEventListener('click', closePopover); }, 0);

  popover.querySelectorAll('.move-group-option').forEach(function(btn) {
    btn.addEventListener('click', async function(e) {
      e.stopPropagation();
      var gid = this.getAttribute('data-move-group-id');
      var groupId = gid === '0' ? null : parseInt(gid, 10);
      if (isNaN(groupId)) groupId = null;
      try {
        var body = { title: _menuDraftTitle || ('Draft ' + _menuDraftId) };
        if (groupId !== null) body.group_id = groupId; else body.group_id = 0;
        var res = await fetch('/api/v1/submissions/' + _menuDraftId, {
          method: 'PATCH',
          credentials: 'include',
          headers: getAuthHeaders(),
          body: JSON.stringify(body)
        });
        if (res.ok) {
          closePopover();
          showNotification('Draft moved to group', 'success');
          setTimeout(function() { window.location.reload(); }, 600);
        } else {
          var err = await res.json().catch(function() { return {}; });
          showNotification(err.error || 'Failed to move', 'error');
        }
      } catch (_) {
        showNotification('Failed to move draft', 'error');
      }
    });
  });
}

// ─── Menu: Pin / Unpin ───────────────────────────────────────────────────────
function menuTogglePin() {
  closeDraftMenu();
  if (!_menuDraftId) return;
  const id  = _menuDraftId;
  const ids = getPinnedIds();
  const idx = ids.indexOf(id);

  if (idx === -1) {
    ids.push(id);
    setPinnedIds(ids);
    document.getElementById(`pin-icon-${id}`)?.classList.remove('hidden');
    document.getElementById(`draft-row-${id}`)?.classList.add('bg-amber-50');
    showNotification('Draft pinned', 'success');
  } else {
    ids.splice(idx, 1);
    setPinnedIds(ids);
    document.getElementById(`pin-icon-${id}`)?.classList.add('hidden');
    document.getElementById(`draft-row-${id}`)?.classList.remove('bg-amber-50');
    showNotification('Draft unpinned', 'success');
  }
}

// ─── Menu: Move to trash (archive) ───────────────────────────────────────────
async function menuTrash() {
  closeDraftMenu();
  if (!_menuDraftId) return;
  const id    = _menuDraftId;
  const title = _menuDraftTitle;

  if (!confirm(`Move "${title}" to trash?\n\nIt will be kept for 45 days before permanent deletion.`)) return;

  try {
    const res = await fetch(`/api/v1/submissions/${id}/archive`, {
      method: 'PUT',
      credentials: 'include',
      headers: getAuthHeaders()
    });

    if (res.ok) {
      const row = document.getElementById(`draft-row-${id}`);
      if (row) {
        row.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
        row.style.opacity    = '0';
        row.style.transform  = 'translateX(16px)';
        setTimeout(() => {
          row.remove();
          const bodyEl = document.getElementById('drafts-body');
          if (bodyEl && bodyEl.children.length === 0) {
            document.getElementById('drafts-table')?.classList.add('hidden');
            document.getElementById('empty-state')?.classList.remove('hidden');
          }
        }, 320);
      }
      showNotification('Draft moved to trash', 'success');
    } else {
      const err = await res.json().catch(() => ({}));
      showNotification(err.error || 'Failed to move draft to trash', 'error');
    }
  } catch (_) {
    showNotification('Failed to move draft to trash', 'error');
  }
}
</script>


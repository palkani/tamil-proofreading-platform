<%- include('../partials/header') %>
<div class="min-h-screen flex items-center justify-center bg-gradient-to-b from-blue-50 to-white p-4">
  <div class="max-w-md w-full text-center">
    <p id="status" class="text-gray-600">Signing you in…</p>
    <p id="error" class="hidden text-red-600 mt-2"></p>
    <a id="back-link" href="/login" class="hidden mt-4 inline-block text-primary-600 font-semibold hover:underline">Back to login</a>
  </div>
</div>
<script>
(function () {
  var redirectTo = <%- JSON.stringify(redirectTo || '/drafts') %>;
  if (typeof redirectTo !== 'string' || !redirectTo.startsWith('/') || redirectTo.startsWith('//')) redirectTo = '/drafts';

  var statusEl = document.getElementById('status');
  var errorEl = document.getElementById('error');
  var backLink = document.getElementById('back-link');

  function showError(msg) {
    statusEl.textContent = '';
    errorEl.textContent = msg || 'Sign-in failed. Try again.';
    errorEl.classList.remove('hidden');
    backLink.classList.remove('hidden');
  }

  // Supabase OAuth redirect puts tokens in hash: #access_token=...&refresh_token=...&expires_in=...
  var hash = window.location.hash || '';
  var params = new URLSearchParams(hash.replace(/^#/, ''));
  var accessToken = params.get('access_token');
  var errorParam = params.get('error_description') || params.get('error');

  if (errorParam) {
    showError(errorParam);
    return;
  }

  if (!accessToken) {
    showError('No session. Try signing in again.');
    return;
  }

  // Show "taking longer" hint after 5 s (Cloud Run cold start)
  var slowTimer = setTimeout(function () {
    statusEl.textContent = 'Signing you in… (backend is warming up, please wait)';
  }, 5000);

  var controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
  var fetchTimeout = setTimeout(function () {
    if (controller) controller.abort();
  }, 30000);

  fetch('/auth/supabase-token', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    credentials: 'include',
    signal: controller ? controller.signal : undefined,
    body: JSON.stringify({ access_token: accessToken })
  })
    .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
    .then(function (result) {
      clearTimeout(slowTimer);
      clearTimeout(fetchTimeout);
      if (!result.ok) {
        var msg = (result.data && result.data.error) ? result.data.error : 'Sign-in failed.';
        if (result.data && result.data.status === 'starting') {
          msg = 'Backend is starting. Please wait a moment and try again.';
        }
        showError(msg);
        return;
      }
      var token = result.data && result.data.access_token;
      if (token && typeof localStorage !== 'undefined') {
        localStorage.setItem('access_token', token);
      }
      if (window.authUtils && window.authUtils.handleAuthSuccess) {
        window.authUtils.handleAuthSuccess(token, redirectTo);
      } else {
        document.cookie = 'access_token=' + encodeURIComponent(token) + '; path=/; SameSite=Lax; Max-Age=900';
        window.location.replace(redirectTo);
      }
    })
    .catch(function (err) {
      clearTimeout(slowTimer);
      clearTimeout(fetchTimeout);
      if (err && err.name === 'AbortError') {
        showError('Sign-in is taking too long. Please try again.');
      } else {
        showError('Network error. Try again.');
      }
    });
})();
</script>
<%- include('../partials/footer') %>

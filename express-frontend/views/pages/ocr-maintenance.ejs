<%- include('../partials/header') %>
<%- include('../partials/nav', { active: 'tools', user: user || null }) %>

<div class="min-h-screen bg-gradient-to-b from-amber-50 via-white to-white py-16">
  <div class="max-w-2xl mx-auto px-6">

    <div class="bg-white rounded-2xl border border-amber-100 shadow-sm overflow-hidden">
      <!-- Header band -->
      <div class="bg-gradient-to-r from-amber-500 to-orange-500 px-8 py-10 text-center text-white">
        <div class="text-5xl mb-3" aria-hidden="true">🛠️</div>
        <h1 class="text-3xl md:text-4xl font-extrabold">OCR is under maintenance</h1>
        <p class="mt-3 text-amber-50">We're upgrading the Tamil OCR engine to improve accuracy.</p>
      </div>

      <!-- Body -->
      <div class="px-8 py-8 space-y-6">
        <p class="text-gray-700 leading-relaxed">
          Both <strong>Tamil OCR</strong> (printed text) and <strong>Handwriting OCR</strong>
          are temporarily unavailable while we roll out improvements.
          Everything else on ProofTamil is working normally.
        </p>

        <div class="rounded-lg bg-amber-50 border border-amber-200 px-4 py-3">
          <h2 class="text-sm font-semibold text-amber-900 mb-1">What's still available</h2>
          <ul class="text-sm text-amber-900/90 space-y-1 ml-5 list-disc">
            <li><a href="/" class="underline hover:no-underline font-medium">Tamil Proofreading</a> — spelling, grammar, sandhi, style</li>
            <li><a href="/tools/ai-content-writer" class="underline hover:no-underline font-medium">AI Content Writer</a> — blogs, essays, articles in Tamil &amp; English</li>
            <li><a href="/tools/free-tamil-editor" class="underline hover:no-underline font-medium">Free Tamil Editor</a> — type Tamil in your browser</li>
          </ul>
        </div>

        <p class="text-sm text-gray-500">
          Sorry for the interruption. We'll have OCR back online shortly with better accuracy for both printed and handwritten Tamil text.
          Need help in the meantime? <a href="/contact" class="text-amber-700 hover:underline font-medium">Contact us</a>.
        </p>

        <div class="pt-2">
          <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-gray-900 text-white font-semibold text-sm hover:bg-gray-800 transition">
            ← Back to ProofTamil
          </a>
        </div>
      </div>
    </div>

  </div>
</div>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<div class="min-h-screen bg-gray-50">
  <!-- Header Navigation -->
  <%- include('../partials/nav', { active: 'account', user: user }) %>

  <main class="mx-auto w-full max-w-4xl px-6 pb-20 pt-8 sm:px-12">
    <header class="mb-10 space-y-3">
      <p class="text-sm font-semibold text-primary-600 uppercase tracking-wider">Account Center</p>
      <h1 class="text-4xl font-bold tracking-tight text-gray-900">Manage your profile</h1>
      <p class="text-base text-gray-600">
        Update your personal details and keep your Proof Tamil account secure.
      </p>
    </header>

    <section class="rounded-3xl border border-gray-200 bg-white shadow-xl p-8 space-y-8">
      <form id="account-form" class="space-y-6">
        <div>
          <label for="name" class="text-sm font-semibold text-gray-700 block mb-2">
            Display name
          </label>
          <input id="name" name="name" type="text" value="<%= user.name || 'Test User' %>" class="input-field" placeholder="Your name" />
        </div>

        <div>
          <label for="email" class="text-sm font-semibold text-gray-700 block mb-2">
            Email
          </label>
          <input id="email" type="email" value="<%= user.email %>" disabled class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm bg-gray-50 text-gray-500 cursor-not-allowed" />
        </div>

        <div class="flex flex-wrap gap-3">
          <button type="submit" id="save-btn" class="inline-flex items-center justify-center rounded-full bg-gradient-to-r from-primary-600 to-primary-500 px-6 py-3 text-sm font-semibold text-white shadow-lg hover:shadow-xl hover:scale-105 transition-all disabled:opacity-60 disabled:hover:scale-100">
            Save changes
          </button>
          <button type="button" id="change-password-btn" class="inline-flex items-center justify-center rounded-full border border-gray-200 px-6 py-3 text-sm font-semibold text-primary-600 hover:border-primary-500 hover:bg-blue-50 transition-all">
            Change password
          </button>
        </div>
      </form>

      <!-- Change password inline form (hidden by default) -->
      <div id="change-password-form" class="hidden border-t border-gray-100 pt-6 space-y-4">
        <h3 class="text-sm font-semibold text-gray-700">Change your password</h3>
        <div>
          <label for="current-password" class="text-sm font-medium text-gray-600 block mb-1.5">Current password</label>
          <input id="current-password" type="password" autocomplete="current-password" class="input-field" placeholder="Enter your current password" />
        </div>
        <div>
          <label for="new-password" class="text-sm font-medium text-gray-600 block mb-1.5">New password</label>
          <input id="new-password" type="password" autocomplete="new-password" class="input-field" placeholder="At least 8 characters" />
        </div>
        <div>
          <label for="confirm-password" class="text-sm font-medium text-gray-600 block mb-1.5">Confirm new password</label>
          <input id="confirm-password" type="password" autocomplete="new-password" class="input-field" placeholder="Repeat new password" />
        </div>
        <div class="flex flex-wrap gap-3">
          <button id="save-password-btn" class="inline-flex items-center justify-center rounded-full bg-gradient-to-r from-primary-600 to-primary-500 px-6 py-3 text-sm font-semibold text-white shadow-lg hover:shadow-xl hover:scale-105 transition-all disabled:opacity-60 disabled:hover:scale-100">
            Update password
          </button>
          <button id="cancel-password-btn" type="button" class="inline-flex items-center justify-center rounded-full border border-gray-200 px-6 py-3 text-sm font-semibold text-gray-500 hover:border-gray-300 transition-all">
            Cancel
          </button>
        </div>
        <div id="pw-message" class="hidden rounded-2xl px-4 py-3 text-sm"></div>
      </div>

      <div id="success-message" class="hidden rounded-2xl border border-primary-500/20 bg-blue-50 px-4 py-3 text-sm text-primary-700"></div>
    </section>

    <% if (locals.paymentsEnabled) { %>
    <section id="plan-section" class="mt-8 rounded-3xl border border-gray-200 bg-white shadow-xl p-8">
      <h2 class="text-lg font-bold text-gray-900 mb-4">Your Plan</h2>
      <div id="plan-loading" class="text-sm text-gray-400">Loading plan info…</div>
      <div id="plan-info" class="hidden">
        <div class="flex items-center gap-3 mb-4">
          <span id="plan-badge" class="px-3 py-1 rounded-full text-sm font-semibold"></span>
          <span id="plan-expires" class="text-xs text-gray-400"></span>
        </div>
        <div id="plan-free-cta" class="hidden">
          <p class="text-sm text-gray-600 mb-3">Upgrade to Pro for unlimited Tamil AI proofreading — no word limits, no daily caps.</p>
          <a href="/pricing" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700 transition">
            Upgrade to Pro
          </a>
        </div>
        <div id="plan-pro-features" class="hidden text-sm text-gray-600 space-y-1">
          <p>✓ Unlimited words per analysis</p>
          <p>✓ Unlimited AI checks per day</p>
          <p>✓ All correction types (grammar, style, rewrite)</p>
          <p>✓ Save unlimited drafts</p>
        </div>
      </div>
    </section>

    <script>
    (function() {
      fetch('/api/v1/me', { credentials: 'include' })
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(data) {
          var user = data && data.user;
          var plan = (user && user.subscription) || 'free';
          document.getElementById('plan-loading').classList.add('hidden');
          document.getElementById('plan-info').classList.remove('hidden');
          var badge = document.getElementById('plan-badge');
          if (plan === 'free' || !plan) {
            badge.textContent = 'Free Plan';
            badge.className = 'px-3 py-1 rounded-full text-sm font-semibold bg-gray-100 text-gray-700';
            document.getElementById('plan-free-cta').classList.remove('hidden');
          } else {
            badge.textContent = plan.charAt(0).toUpperCase() + plan.slice(1) + ' Plan';
            badge.className = 'px-3 py-1 rounded-full text-sm font-semibold bg-indigo-100 text-indigo-700';
            document.getElementById('plan-pro-features').classList.remove('hidden');
            if (user.subscription_end) {
              var d = new Date(user.subscription_end);
              document.getElementById('plan-expires').textContent = 'Renews ' + d.toLocaleDateString();
            }
          }
        })
        .catch(function() {
          document.getElementById('plan-loading').textContent = 'Could not load plan info.';
        });
    })();
    </script>
    <% } %>
  </main>
</div>

<script src="/js/account.js"></script>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<div class="min-h-screen bg-gray-50">
  <!-- Header Navigation -->
  <%- include('../partials/nav', { active: 'account', user: user }) %>

  <main class="mx-auto w-full max-w-4xl px-6 pb-20 pt-8 sm:px-12">
    <header class="mb-10 space-y-3">
      <p class="text-sm font-semibold text-primary-600 uppercase tracking-wider">Account Center</p>
      <h1 class="text-4xl font-bold tracking-tight text-gray-900">Manage your profile</h1>
      <p class="text-base text-gray-600">
        Update your personal details and keep your Proof Tamil account secure.
      </p>
    </header>

    <section class="rounded-3xl border border-gray-200 bg-white shadow-xl p-8 space-y-8">
      <form id="account-form" class="space-y-6">
        <div>
          <label for="name" class="text-sm font-semibold text-gray-700 block mb-2">
            Display name
          </label>
          <input id="name" name="name" type="text" value="<%= user.name || 'Test User' %>" class="input-field" placeholder="Your name" />
        </div>

        <div>
          <label for="email" class="text-sm font-semibold text-gray-700 block mb-2">
            Email
          </label>
          <input id="email" type="email" value="<%= user.email %>" disabled class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm bg-gray-50 text-gray-500 cursor-not-allowed" />
        </div>

        <div class="flex flex-wrap gap-3">
          <button type="submit" id="save-btn" class="inline-flex items-center justify-center rounded-full bg-gradient-to-r from-primary-600 to-primary-500 px-6 py-3 text-sm font-semibold text-white shadow-lg hover:shadow-xl hover:scale-105 transition-all disabled:opacity-60 disabled:hover:scale-100">
            Save changes
          </button>
          <button type="button" id="change-password-btn" class="inline-flex items-center justify-center rounded-full border border-gray-200 px-6 py-3 text-sm font-semibold text-primary-600 hover:border-primary-500 hover:bg-blue-50 transition-all">
            Change password
          </button>
        </div>
      </form>

      <!-- Change password inline form (hidden by default) -->
      <div id="change-password-form" class="hidden border-t border-gray-100 pt-6 space-y-4">
        <h3 class="text-sm font-semibold text-gray-700">Change your password</h3>
        <div>
          <label for="current-password" class="text-sm font-medium text-gray-600 block mb-1.5">Current password</label>
          <input id="current-password" type="password" autocomplete="current-password" class="input-field" placeholder="Enter your current password" />
        </div>
        <div>
          <label for="new-password" class="text-sm font-medium text-gray-600 block mb-1.5">New password</label>
          <input id="new-password" type="password" autocomplete="new-password" class="input-field" placeholder="At least 8 characters" />
        </div>
        <div>
          <label for="confirm-password" class="text-sm font-medium text-gray-600 block mb-1.5">Confirm new password</label>
          <input id="confirm-password" type="password" autocomplete="new-password" class="input-field" placeholder="Repeat new password" />
        </div>
        <div class="flex flex-wrap gap-3">
          <button id="save-password-btn" class="inline-flex items-center justify-center rounded-full bg-gradient-to-r from-primary-600 to-primary-500 px-6 py-3 text-sm font-semibold text-white shadow-lg hover:shadow-xl hover:scale-105 transition-all disabled:opacity-60 disabled:hover:scale-100">
            Update password
          </button>
          <button id="cancel-password-btn" type="button" class="inline-flex items-center justify-center rounded-full border border-gray-200 px-6 py-3 text-sm font-semibold text-gray-500 hover:border-gray-300 transition-all">
            Cancel
          </button>
        </div>
        <div id="pw-message" class="hidden rounded-2xl px-4 py-3 text-sm"></div>
      </div>

      <div id="success-message" class="hidden rounded-2xl border border-primary-500/20 bg-blue-50 px-4 py-3 text-sm text-primary-700"></div>
    </section>

    <section class="mt-8 rounded-3xl border border-gray-200 bg-white shadow-xl p-6 md:p-8">
      <h2 class="text-lg font-bold text-gray-900 mb-2">Data &amp; privacy</h2>
      <p class="text-sm text-gray-600 mb-4">Export a copy of your data or permanently delete your account.</p>
      <a href="/account/data" class="inline-flex items-center gap-2 rounded-full border border-gray-200 px-5 py-2.5 text-sm font-semibold text-primary-600 hover:border-primary-500 hover:bg-blue-50 transition-all">
        Manage your data →
      </a>
    </section>

    <% if (locals.paymentsEnabled) { %>
    <%
      // Server-rendered subscription card. Reads from `subscription`
      // (from /account route → findFullSubscriptionByEmail), which is
      // the post-webhook Express-side source of truth. Fully replaces
      // the older client-fetch-then-render section.
      const featureLabels = {
        proofreading: 'Unlimited proofreading',
        ocr:          'Handwriting OCR',
        export:       'DOCX / PDF export',
        ai_writer:    'AI content writer',
      };
      const sub = locals.subscription || null;
      const nowMs = Date.now();
      const isActive = sub && sub.is_premium && (!sub.expires_at || new Date(sub.expires_at).getTime() > nowMs);
      const isExpired = sub && sub.expires_at && new Date(sub.expires_at).getTime() <= nowMs;
      const isCancelledButActive = isActive && !!sub.cancelled_at;
      const renewalDate = sub && (sub.next_renewal_at || sub.expires_at);
      const daysUntilRenewal = renewalDate ? Math.ceil((new Date(renewalDate).getTime() - nowMs) / 86400000) : null;
      const showRenewalReminder = isActive && !isCancelledButActive && sub && sub.auto_renew !== false && daysUntilRenewal !== null && daysUntilRenewal <= 3 && daysUntilRenewal >= 0;
      const displayAmount = sub && sub.amount_cents
        ? (sub.currency === 'INR' ? '₹' + Math.round(sub.amount_cents / 100) : '$' + (sub.amount_cents / 100).toFixed(2))
        : '';
      const fmtDate = (d) => d ? new Date(d).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : '';
    %>
    <section id="subscription-section" class="mt-8 rounded-3xl border border-gray-200 bg-white shadow-xl p-8">
      <h2 class="text-lg font-bold text-gray-900 mb-6">Your Subscription</h2>

      <% if (isActive) { %>
        <div class="space-y-5">
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
              <div class="text-xs font-semibold text-emerald-600 uppercase tracking-wider">Active</div>
              <div class="mt-1 text-2xl font-bold text-gray-900 truncate"><%= sub.plan_label || 'Pro' %></div>
            </div>
            <% if (displayAmount) { %>
            <div class="text-right shrink-0">
              <div class="text-xl font-bold text-gray-900"><%= displayAmount %></div>
              <div class="text-xs text-gray-500">/ month</div>
            </div>
            <% } %>
          </div>

          <% if (isCancelledButActive) { %>
          <div class="rounded-lg bg-amber-50 border border-amber-200 p-4">
            <div class="font-semibold text-amber-900">Subscription cancelled</div>
            <div class="text-sm text-amber-800 mt-1">
              You'll keep <%= sub.plan_label || 'Pro' %> access until <span class="font-semibold"><%= fmtDate(sub.expires_at) %></span>. No further charges will be made.
            </div>
            <a href="/contact" class="inline-block mt-2 text-sm font-semibold text-amber-900 underline">Contact us to reactivate</a>
          </div>
          <% } else if (sub.auto_renew !== false && renewalDate) { %>
          <div class="text-sm text-gray-700">
            Auto-renews on <span class="font-semibold text-gray-900"><%= fmtDate(renewalDate) %></span><% if (displayAmount) { %> · <span class="text-gray-600">next charge <%= displayAmount %></span><% } %>
          </div>
          <% if (showRenewalReminder) { %>
          <div class="rounded-lg bg-blue-50 border border-blue-200 p-3 text-sm text-blue-900">
            <span class="font-semibold">Renewing in <%= daysUntilRenewal %> day<%= daysUntilRenewal === 1 ? '' : 's' %>.</span>
            Your payment method on file will be charged <%= displayAmount || 'the subscription amount' %> on <%= fmtDate(renewalDate) %>.
          </div>
          <% } %>
          <% } else if (sub.expires_at) { %>
          <div class="text-sm text-gray-700">
            Access valid until <span class="font-semibold text-gray-900"><%= fmtDate(sub.expires_at) %></span>
            <span class="text-gray-500">(no auto-renewal)</span>
          </div>
          <% } %>

          <% if (Array.isArray(sub.entitlements) && sub.entitlements.length) { %>
          <div class="border-t border-gray-100 pt-4">
            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Included in your plan</div>
            <div class="flex flex-wrap gap-2">
              <% sub.entitlements.forEach(function(f) { %>
                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-xs font-medium">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                  <%= featureLabels[f] || f %>
                </span>
              <% }); %>
            </div>
          </div>
          <% } %>

          <div class="border-t border-gray-100 pt-4 flex flex-wrap gap-4">
            <a href="/contact" class="text-sm font-medium text-indigo-600 hover:text-indigo-700">Manage or cancel</a>
            <a href="/pricing" class="text-sm font-medium text-gray-600 hover:text-gray-800">View all plans</a>
          </div>
        </div>

      <% } else if (isExpired) { %>
        <div class="rounded-lg bg-gray-50 border border-gray-200 p-6 text-center space-y-4">
          <div class="text-sm text-gray-700">
            Your <span class="font-semibold"><%= sub.plan_label || 'Pro' %></span> subscription expired on <span class="font-semibold"><%= fmtDate(sub.expires_at) %></span>.
          </div>
          <a href="/pricing" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700 transition">
            Renew subscription
          </a>
        </div>

      <% } else { %>
        <div class="space-y-4">
          <div class="flex items-center gap-3">
            <span class="px-3 py-1 rounded-full text-sm font-semibold bg-gray-100 text-gray-700">Free Plan</span>
          </div>
          <p class="text-sm text-gray-600">Upgrade to Pro for unlimited Tamil AI proofreading — no word limits, no daily caps.</p>
          <a href="/pricing" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700 transition">
            Upgrade to Pro
          </a>
        </div>
      <% } %>
    </section>
    <% } %>

  </main>
</div>

<script src="/js/account.js"></script>

<%- include('../partials/footer') %>

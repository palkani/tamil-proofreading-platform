<%- include('../partials/header') %>

<!-- Google Client ID for OAuth (injected for runtime use on the browser) -->
<script>
  // Injected from server env (NEXT_PUBLIC_GOOGLE_CLIENT_ID preferred)
  window.GOOGLE_CLIENT_ID = "<%= googleClientId || '' %>";

  // Early token capture + safe redirect handling:
  // - supports backend OAuth redirect to /drafts?access_token=...
  // - supports /login?redirect=/workspace (or other internal paths)
  (function consumeRedirectTokenEarly() {
    const params = new URLSearchParams(window.location.search);
    const rawRedirect = params.get('redirect') || '';

    function isSafeInternalPath(path) {
      if (!path) return false;
      if (path.startsWith('//')) return false;
      if (!path.startsWith('/')) return false;
      return true;
    }

    function stripTokenFromUrl(u) {
      try {
        const url = new URL(u, window.location.origin);
        url.searchParams.delete('access_token');
        return url.pathname + (url.search ? url.search : '');
      } catch (_e) {
        return '/drafts';
      }
    }

    // Try to extract access_token from the redirect param.
    // Handles cases where redirect contains multiple comma-separated URLs.
    function extractToken(str) {
      if (!str) return null;
      // Split on comma to tolerate malformed multi-URL redirects
      const parts = str.split(',');
      for (const p of parts) {
        // Fast regex extraction from any fragment containing access_token
        const match = p.match(/access_token=([^&]+)/);
        if (match && match[1]) return decodeURIComponent(match[1]);
        try {
          const url = new URL(p, window.location.origin);
          const t = url.searchParams.get('access_token');
          if (t) return t;
        } catch (_) {
          // ignore parse errors
        }
      }
      return null;
    }

    const token = extractToken(rawRedirect);

    if (token) {
      // Use centralized auth utility if available
      if (window.authUtils && window.authUtils.storeAccessToken) {
        window.authUtils.storeAccessToken(token);
      } else {
        // Fallback
        localStorage.removeItem('access_token');
        document.cookie = 'access_token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
        localStorage.setItem('access_token', token);
        document.cookie = `access_token=${token}; path=/; SameSite=Lax; Max-Age=900`;
      }
      // Redirect to target (if provided), but never leak token in URL.
      const dest = stripTokenFromUrl(rawRedirect) || '/drafts';
      window.location.replace(isSafeInternalPath(dest) ? dest : '/drafts');
    }
  })();
</script>
<input type="hidden" id="google-client-id" value="<%= googleClientId || '' %>">

<div class="min-h-screen flex items-center justify-center bg-gradient-to-b from-blue-50 to-white p-4">
  <div class="max-w-md w-full">
    <div class="bg-white rounded-2xl shadow-2xl border border-gray-200 p-8">
      <div class="text-center mb-8">
        <img src="/images/tamil-logo.svg" alt="ProofTamil Logo" class="w-16 h-16 mx-auto mb-4">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Welcome Back</h1>
        <p class="text-gray-600">Sign in to your Tamil writing workspace</p>
      </div>

      <% if (error) { %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
          <%= error %>
        </div>
      <% } %>

      <div id="error-message" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6"></div>

      <div class="space-y-4 mb-6">
        <button id="google-signin-btn" type="button" class="w-full flex items-center justify-center gap-3 rounded-lg border-2 border-gray-300 bg-white px-4 py-3 font-semibold text-gray-900 shadow-sm transition hover:bg-gray-50 hover:border-primary-500">
          <svg class="h-5 w-5" viewBox="0 0 24 24">
            <path fill="#EA4335" d="M12.545,10.239v3.821h5.445c-0.712,2.315-2.647,3.972-5.445,3.972c-3.332,0-6.033-2.701-6.033-6.032s2.701-6.032,6.033-6.032c1.498,0,2.866,0.549,3.921,1.453l2.814-2.814C17.503,2.988,15.139,2,12.545,2C7.021,2,2.543,6.477,2.543,12s4.478,10,10.002,10c8.396,0,10.249-7.85,9.426-11.748L12.545,10.239z"/>
          </svg>
          Sign in with Google
        </button>
        <div class="flex items-center gap-3 text-xs uppercase tracking-wider text-gray-500">
          <span class="h-px flex-1 bg-gray-300"></span>
          Or use email
          <span class="h-px flex-1 bg-gray-300"></span>
        </div>
      </div>

      <form id="login-form" method="POST" action="/api/auth/login" class="space-y-6">
        <div>
          <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">Email Address</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required 
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"
            placeholder="you@example.com"
          >
        </div>

        <div>
          <label for="password" class="block text-sm font-semibold text-gray-700 mb-2">Password</label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            required 
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"
            placeholder="Enter your password"
          >
        </div>

        <div class="flex items-center justify-between">
          <label class="flex items-center">
            <input type="checkbox" name="remember" class="w-4 h-4 text-primary-600 border-gray-300 rounded focus:ring-primary-500">
            <span class="ml-2 text-sm text-gray-600">Remember me</span>
          </label>
          <a href="#" class="text-sm text-primary-600 hover:text-primary-500 font-semibold">Forgot password?</a>
        </div>

        <button 
          type="submit" 
          class="w-full bg-primary-600 text-white py-3 px-6 rounded-lg font-semibold text-lg hover:bg-primary-500 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
        >
          Sign In
        </button>
      </form>

      <div class="mt-6 text-center">
        <p class="text-sm text-gray-600">
          Don't have an account? 
          <a href="/register" class="text-primary-600 hover:text-primary-500 font-semibold">Sign up for free</a>
        </p>
      </div>

      <div class="mt-8 pt-6 border-t border-gray-200">
        <p class="text-xs text-center text-gray-500">
          ℹ️ <strong>Demo Mode:</strong> Any email and password will work for testing
        </p>
      </div>
    </div>

    <div class="mt-8 text-center text-sm text-gray-500">
      <p>Powered by AI • Tamil Language Processing</p>
      <a href="/" class="text-primary-600 hover:text-primary-500 mt-2 inline-block font-semibold">← Back to home</a>
    </div>
  </div>
</div>

<script src="/js/google-auth.js?v=20251215b"></script>
<script>
document.getElementById('google-signin-btn')?.addEventListener('click', () => {
  if (window.triggerGoogleSignIn) {
    window.triggerGoogleSignIn();
  } else {
    const errorDiv = document.getElementById('error-message');
    errorDiv.textContent = 'Google Sign-In is loading. Please wait a moment and try again.';
    errorDiv.classList.remove('hidden');
  }
});

// Handle login form submission
document.getElementById('login-form')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  
  const submitBtn = e.target.querySelector('button[type="submit"]');
  const errorDiv = document.getElementById('error-message');
  const email = document.getElementById('email').value;
  const password = document.getElementById('password').value;
  
  submitBtn.disabled = true;
  submitBtn.textContent = 'Signing in...';
  errorDiv.classList.add('hidden');
  
  try {
    const response = await fetch('/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password })
    });
    
    const data = await response.json();
    
    if (!response.ok) {
      const errorMessage = data?.error || data?.message || 'Login failed';
      throw new Error(String(errorMessage));
    }
    
    // Determine redirect target (default: /drafts)
    const params = new URLSearchParams(window.location.search);
    const rawRedirect = params.get('redirect') || '/drafts';
    const redirectTarget = (function () {
      // Only allow internal redirects
      if (!rawRedirect || rawRedirect.startsWith('//') || !rawRedirect.startsWith('/')) return '/drafts';
      // If redirect contains access_token, strip it
      try {
        const u = new URL(rawRedirect, window.location.origin);
        u.searchParams.delete('access_token');
        return u.pathname + (u.search ? u.search : '');
      } catch (_e) {
        return '/drafts';
      }
    })();

    // Login successful - use centralized auth utility if available
    if (window.authUtils && window.authUtils.handleAuthSuccess) {
      window.authUtils.handleAuthSuccess(data.access_token, redirectTarget || '/drafts');
    } else {
      // Fallback if auth-utils not loaded
      localStorage.removeItem('access_token');
      document.cookie = 'access_token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
      
      if (data.access_token) {
        localStorage.setItem('access_token', data.access_token);
        document.cookie = `access_token=${data.access_token}; path=/; SameSite=Lax; Max-Age=900`;
        console.log('[LOGIN] Token stored in localStorage and cookie');
      } else {
        console.warn('[LOGIN] No access_token in response:', data);
      }
      
      // Redirect to target page
      window.location.href = redirectTarget || '/drafts';
    }
  } catch (error) {
    const errorMessage = error?.message || 'An unexpected error occurred';
    errorDiv.textContent = errorMessage;
    errorDiv.classList.remove('hidden');
    submitBtn.disabled = false;
    submitBtn.textContent = 'Sign In';
  }
});
</script>

<%- include('../partials/footer') %>


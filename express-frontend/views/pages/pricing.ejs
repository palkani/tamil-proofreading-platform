<% if (paymentsEnabled) { %>

<script>
  window.USER_LOGGED_IN = <%= user && user.email ? 'true' : 'false' %>;
  window.USER_EMAIL     = '<%= user && user.email ? user.email.replace(/'/g, "\\'") : "" %>';
</script>
<script src="/js/payment.js"></script>
<script>
  // Auto-trigger checkout when the user arrives after login/signup from a "Go Pro" click.
  // payment.js redirects unauthenticated users to /login?redirect=/pricing?auto_checkout=PLAN_CODE
  // After auth, the user lands here with ?auto_checkout=PRO_MONTHLY (or PRO_YEARLY).
  (function () {
    var params = new URLSearchParams(window.location.search);
    var planCode = params.get('auto_checkout');
    if (!planCode || !window.USER_LOGGED_IN) return;
    // Clean the URL so a page refresh doesn't re-trigger checkout
    var cleanUrl = window.location.pathname;
    if (window.history && window.history.replaceState) {
      window.history.replaceState(null, '', cleanUrl);
    }
    // Slight delay to let payment.js fully initialise before calling startCheckout
    setTimeout(function () {
      if (typeof startCheckout === 'function') {
        startCheckout(planCode, '<%= countryCode %>');
      }
    }, 200);
  })();
</script>

<!-- Promo-code redemption on /pricing. Client-side validate call:
     POST /api/promo-code/validate { code } → { valid, plan: {...} }.
     Backend contract lives in PROMO_CODES_BACKEND_CONTRACT.md.
     Until the backend endpoint ships, the client gets a 501/400 and
     shows a friendly "codes aren't active yet — contact us" nudge. -->
<script>
(function () {
  var COUNTRY = '<%= countryCode %>';
  var USER_LOGGED_IN = window.USER_LOGGED_IN;
  var input   = document.getElementById('promo-code-input');
  var applyBtn = document.getElementById('promo-code-btn');
  var status  = document.getElementById('promo-code-status');
  var defaultBlock = document.getElementById('custom-plan-default');
  var revealBlock  = document.getElementById('custom-plan-reveal');
  if (!input || !applyBtn) return;

  var lastValidatedPlan = null;

  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]); }); }
  function show(cls, msg) {
    status.className = 'mt-2 text-xs rounded px-2 py-1.5 ' + cls;
    status.textContent = msg;
    status.classList.remove('hidden');
  }
  function hideStatus() { status.classList.add('hidden'); }

  function labelFeature(f) {
    return ({
      proofreading: 'Unlimited proofreading (grammar, spelling, style)',
      ocr:          'Handwriting + document OCR',
      export:       'Export as PDF, DOCX, TXT',
      ai_writer:    'AI content writer premium quota'
    })[f] || f;
  }

  function reveal(plan) {
    lastValidatedPlan = plan;
    document.getElementById('promo-plan-label').textContent    = plan.label || 'Custom plan';
    var currencySym = (plan.currency === 'INR') ? '₹' : '$';
    document.getElementById('promo-plan-price').textContent    = currencySym + (plan.display_price || (plan.price_cents ? (plan.price_cents / 100).toFixed(2) : '—'));
    document.getElementById('promo-plan-interval').textContent = '/ ' + (plan.billing_interval || 'month');
    document.getElementById('promo-plan-recurring').textContent = plan.recurring_terms ||
      (plan.billing_interval === 'one_time'
        ? 'One-time charge. No auto-renewal.'
        : 'This is a recurring charge, billed every ' + (plan.billing_interval || 'month') + '. Cancel any time from your account page — access continues until the end of your current period.');
    var featuresEl = document.getElementById('promo-plan-features');
    featuresEl.innerHTML = (plan.entitlements || []).map(function (f) {
      return '<li class="flex items-start gap-2"><span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-emerald-600 text-white flex-shrink-0 mt-0.5"><svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>' + esc(labelFeature(f)) + '</li>';
    }).join('');
    defaultBlock.classList.add('hidden');
    revealBlock.classList.remove('hidden');
    revealBlock.classList.add('flex');
  }

  function resetToDefault() {
    lastValidatedPlan = null;
    revealBlock.classList.add('hidden');
    revealBlock.classList.remove('flex');
    defaultBlock.classList.remove('hidden');
    input.value = '';
    input.focus();
    hideStatus();
  }

  applyBtn.addEventListener('click', validate);
  input.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); validate(); } });
  document.getElementById('promo-reset-btn').addEventListener('click', resetToDefault);

  async function validate() {
    var code = (input.value || '').trim();
    if (!code) { show('bg-red-50 text-red-700', 'Enter your activation code.'); return; }
    applyBtn.disabled = true;
    show('bg-gray-50 text-gray-600', 'Checking code…');
    try {
      var r = await fetch('/api/promo-code/validate', {
        method: 'POST', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code: code, country_code: COUNTRY })
      });
      var d = await r.json().catch(function () { return {}; });
      if (r.status === 501 || r.status === 404) {
        show('bg-amber-50 text-amber-800', 'Activation codes are not yet active. Please use "Request a custom quote" above and we\'ll set you up.');
        return;
      }
      if (!r.ok || !d.valid) {
        show('bg-red-50 text-red-700', (d && (d.message || d.error)) || 'That code is not valid or has expired. Please double-check with us.');
        return;
      }
      hideStatus();
      reveal(d.plan || d);
    } catch (err) {
      show('bg-red-50 text-red-700', 'Could not validate the code: ' + err.message);
    } finally {
      applyBtn.disabled = false;
    }
  }

  document.getElementById('promo-checkout-btn').addEventListener('click', function () {
    if (!lastValidatedPlan) return;
    if (!USER_LOGGED_IN) {
      // Route through login → post-auth auto-checkout, same pattern as
      // the old plan-card CTAs.
      var target = encodeURIComponent('/pricing?activate=' + encodeURIComponent(input.value.trim()));
      window.location.href = '/login?redirect=' + target;
      return;
    }
    // Signed-in: hand off to payment.js with the promo code so backend
    // creates the Dodo checkout at the code-specific plan + price.
    if (typeof startCheckout === 'function') {
      startCheckout(lastValidatedPlan.plan_code || 'PROMO', COUNTRY, { promo_code: input.value.trim() });
    } else {
      // payment.js not loaded — very unlikely on this page; degrade gracefully.
      window.location.href = '/api/v1/billing/checkout?plan_code=' + encodeURIComponent(lastValidatedPlan.plan_code || 'PROMO') +
        '&promo_code=' + encodeURIComponent(input.value.trim()) +
        '&country_code=' + COUNTRY;
    }
  });

  // Auto-validate when landing from /login?redirect=/pricing?activate=CODE
  (function () {
    var params = new URLSearchParams(window.location.search);
    var activate = params.get('activate');
    if (activate) {
      input.value = activate;
      validate();
      // Clean the URL so a refresh doesn't re-trigger.
      if (window.history && window.history.replaceState) {
        window.history.replaceState(null, '', window.location.pathname);
      }
    }
  })();
})();
</script>
<% } %>


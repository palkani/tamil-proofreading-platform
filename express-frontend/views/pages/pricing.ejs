<%- include('../partials/header', { seo: seo, title: title, googleClientId: typeof googleClientId !== 'undefined' ? googleClientId : '' }) %>
<%- include('../partials/nav', { user: user, active: 'pricing' }) %>

<% if (paymentsEnabled && countryCode === 'IN') { %>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<% } %>

<div class="min-h-screen bg-gray-50 py-16 px-4">
  <div class="max-w-5xl mx-auto">

    <% if (!paymentsEnabled) { %>
    <!-- Coming Soon state -->
    <div class="text-center py-24">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-primary-100 mb-6">
        <svg class="w-10 h-10 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Pricing Coming Soon</h1>
      <p class="text-lg text-gray-600 max-w-xl mx-auto mb-8">
        We're putting the finishing touches on our Pro plans. Join our mailing list to be notified when they launch.
      </p>
      <a href="/contact" class="inline-flex items-center px-6 py-3 rounded-full bg-primary-600 text-white font-semibold hover:bg-primary-700 transition">
        Get notified
      </a>
      <p class="mt-6 text-sm text-gray-500">
        In the meantime, ProofTamil is <strong>completely free</strong> to use.
        <a href="/" class="text-primary-600 underline ml-1">Try it now →</a>
      </p>
    </div>

    <% } else { %>
    <!-- Pricing header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">One plan. Everything you need to write Tamil perfectly.</h1>
      <p class="text-lg text-gray-600 max-w-xl mx-auto">
        Start free. Go Pro when your Tamil writing gets serious.
      </p>
    </div>


    <!-- Plan cards - Clean layout highlighting ProofTamil features -->
    <div class="grid md:grid-cols-2 gap-8 items-stretch max-w-4xl mx-auto">

      <!-- Free Plan -->
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-8 flex flex-col">
        <div class="mb-6">
          <div class="flex items-center gap-3 mb-3">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-gray-900 text-white flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 00-2-2 2 2 0 00-2 2v2m0 13V6a2 2 0 012-2 2 2 0 012 2v2m0 13V6a2 2 0 00-2-2 2 2 0 00-2 2v2"/></svg>
            </span>
            <span class="text-xl font-bold text-gray-900">Free</span>
          </div>
          <div class="flex items-end gap-1">
            <span class="text-4xl font-bold text-gray-900"><%= countryCode === 'IN' ? '₹' : '$' %>0</span>
            <span class="text-gray-500 mb-1">/ month</span>
          </div>
          <p class="mt-2 text-sm text-gray-500">Try ProofTamil — no credit card needed.</p>
        </div>
        <ul class="space-y-3 text-sm text-gray-600 flex-1 mb-8">
          <li class="flex items-start gap-2">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-gray-900 text-white flex-shrink-0 mt-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></span>
            Proofread up to 200 Tamil words at a time
          </li>
          <li class="flex items-start gap-2">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-gray-900 text-white flex-shrink-0 mt-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></span>
            30 AI checks per day after signing in
          </li>
          <li class="flex items-start gap-2">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-gray-900 text-white flex-shrink-0 mt-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></span>
            Spot basic இலக்கணப் பிழைகள் (grammar mistakes)
          </li>
          <li class="flex items-start gap-2">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-gray-900 text-white flex-shrink-0 mt-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></span>
            Type Tamil using English letters (Tanglish)
          </li>
          <li class="flex items-start gap-2">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-gray-900 text-white flex-shrink-0 mt-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></span>
            Smart Tamil word suggestions as you type
          </li>
        </ul>
        <a href="<%= user && user.email ? '/' : '/register' %>" class="block w-full text-center px-5 py-3.5 rounded-xl bg-gray-900 text-white font-semibold hover:bg-gray-800 transition">
          <%= user && user.email ? 'Try Free Editor' : 'Create Account' %>
        </a>
      </div>

      <!-- Pro Monthly -->
      <div class="bg-white rounded-2xl border-2 border-primary-600 shadow-xl p-8 flex flex-col relative">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2">
          <span class="bg-primary-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">Most Popular</span>
        </div>
        <div class="mb-6">
          <div class="flex items-center gap-3 mb-3">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-gray-900 text-white flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </span>
            <span class="text-xl font-bold text-gray-900">Monthly</span>
          </div>
          <div class="flex items-end gap-1">
            <% if (monthly && monthly.display_price) { %>
            <span class="text-4xl font-bold text-gray-900"><%= monthly.currency === 'INR' ? '₹' : '$' %><%= monthly.display_price %></span>
            <% } else { %>
            <span class="text-4xl font-bold text-gray-900">—</span>
            <% } %>
            <span class="text-gray-500 mb-1">/ month</span>
          </div>
          <p class="mt-2 text-sm text-gray-500">For Tamil writers, bloggers and content creators.</p>
        </div>
        <ul class="space-y-3 text-sm text-gray-600 flex-1 mb-8">
          <li class="flex items-start gap-2">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-gray-900 text-white flex-shrink-0 mt-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></span>
            Proofread entire articles — no word cap, ever
          </li>
          <li class="flex items-start gap-2">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-gray-900 text-white flex-shrink-0 mt-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></span>
            Unlimited AI checks — no daily cap
          </li>
          <li class="flex items-start gap-2">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-gray-900 text-white flex-shrink-0 mt-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></span>
            Deep இலக்கணம், நடை &amp; எழுத்துப்பிழை fixes
          </li>
          <li class="flex items-start gap-2">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-gray-900 text-white flex-shrink-0 mt-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></span>
            AI rewrites weak sentences in natural Tamil
          </li>
          <li class="flex items-start gap-2">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-gray-900 text-white flex-shrink-0 mt-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></span>
            Speak Tamil aloud — AI types it for you
          </li>
          <li class="flex items-start gap-2">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-gray-900 text-white flex-shrink-0 mt-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></span>
            Scan handwritten Tamil &amp; digitise it (OCR)
          </li>
          <li class="flex items-start gap-2">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-gray-900 text-white flex-shrink-0 mt-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></span>
            Import .docx, .txt, .pdf — edit in Tamil
          </li>
          <li class="flex items-start gap-2">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-gray-900 text-white flex-shrink-0 mt-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></span>
            Export finished work as TXT, DOCX or PDF
          </li>
          <li class="flex items-start gap-2">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-gray-900 text-white flex-shrink-0 mt-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></span>
            Tone switch — formal, conversational or literary
          </li>
          <li class="flex items-start gap-2">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-gray-900 text-white flex-shrink-0 mt-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></span>
            All drafts saved &amp; synced across your devices
          </li>
        </ul>
        <button
          id="checkout-btn-PRO_MONTHLY"
          onclick="startCheckout('PRO_MONTHLY', '<%= countryCode %>')"
          class="block w-full text-center px-5 py-3.5 rounded-xl bg-gray-900 text-white font-semibold hover:bg-gray-800 transition disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Go Pro
        </button>
      </div>

    </div><!-- /plan cards -->

    <!-- FAQ -->
    <div class="mt-16 max-w-2xl mx-auto">
      <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">Frequently asked questions</h2>
      <div class="space-y-6">
        <div>
          <h3 class="font-semibold text-gray-900">Can I cancel anytime?</h3>
          <p class="mt-1 text-sm text-gray-600">Yes. Cancel from your account page at any time. You'll keep Pro access until the end of your billing period.</p>
        </div>
        <div>
          <h3 class="font-semibold text-gray-900">Which payment methods are accepted?</h3>
          <% if (countryCode === 'IN') { %>
          <p class="mt-1 text-sm text-gray-600">UPI, Credit/Debit cards, Netbanking, and Wallets via Razorpay.</p>
          <% } else { %>
          <p class="mt-1 text-sm text-gray-600">Credit / Debit cards, Apple Pay, and Google Pay via Stripe.</p>
          <% } %>
        </div>
        <div>
          <h3 class="font-semibold text-gray-900">Is my data secure?</h3>
          <p class="mt-1 text-sm text-gray-600">Yes. Payments are processed by <%= countryCode === 'IN' ? 'Razorpay' : 'Stripe' %>, a PCI-DSS Level 1 certified payment processor. We never store your card details.</p>
        </div>
        <div>
          <h3 class="font-semibold text-gray-900">What happens to my drafts if I downgrade?</h3>
          <p class="mt-1 text-sm text-gray-600">Your drafts are always saved. If you downgrade to Free, you keep access to all your existing drafts but daily AI checks revert to the free limit.</p>
        </div>
      </div>
    </div>

    <% } %> <!-- end paymentsEnabled -->

  </div>
</div>

<% if (paymentsEnabled) { %>

<!-- Stripe Embedded Checkout modal -->
<div id="stripe-checkout-modal" class="fixed inset-0 z-[300] hidden items-center justify-center">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id="stripe-checkout-backdrop"></div>
  <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden">
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
      <p class="font-semibold text-gray-900 text-sm">Secure Checkout</p>
      <button id="stripe-checkout-close"
              class="text-gray-400 hover:text-gray-600 text-xl leading-none"
              aria-label="Close checkout">✕</button>
    </div>
    <div id="stripe-checkout-loading" class="p-8 text-center text-sm text-gray-400">
      Loading checkout…
    </div>
    <div id="stripe-checkout-container" class="px-2 pb-2"></div>
    <div id="stripe-checkout-error" class="hidden p-5 text-center text-sm text-red-500">
      Failed to load checkout. <a href="/contact" class="underline">Contact support</a>.
    </div>
  </div>
</div>

<script>
  window.RAZORPAY_KEY_ID = '<%= razorpayKeyId %>';
  window.USER_LOGGED_IN  = <%= user && user.email ? 'true' : 'false' %>;
  window.USER_EMAIL = '<%= user && user.email ? user.email.replace(/'/g, "\\'") : "" %>';
  window.STRIPE_PAYMENT_LINK_PRO_MONTHLY = '<%= stripePaymentLinkMonthly || "" %>';
  window.STRIPE_PAYMENT_LINK_PRO_YEARLY  = '<%= stripePaymentLinkYearly  || "" %>';
  window.STRIPE_PK = '<%= stripePublishableKey || "" %>';
</script>
<% if (stripePublishableKey) { %>
<script src="https://js.stripe.com/v3/"></script>
<% } %>
<script src="/js/payment.js"></script>
<script>
  // Auto-trigger checkout when the user arrives after login/signup from a "Go Pro" click.
  // payment.js redirects unauthenticated users to /login?redirect=/pricing?auto_checkout=PLAN_CODE
  // After auth, the user lands here with ?auto_checkout=PRO_MONTHLY (or PRO_YEARLY).
  (function () {
    var params = new URLSearchParams(window.location.search);
    var planCode = params.get('auto_checkout');
    if (!planCode || !window.USER_LOGGED_IN) return;
    // Clean the URL so a page refresh doesn't re-trigger checkout
    var cleanUrl = window.location.pathname;
    if (window.history && window.history.replaceState) {
      window.history.replaceState(null, '', cleanUrl);
    }
    // Slight delay to let payment.js fully initialise before calling startCheckout
    setTimeout(function () {
      if (typeof startCheckout === 'function') {
        startCheckout(planCode, '<%= countryCode %>');
      }
    }, 200);
  })();
</script>
<% } %>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<!-- Navigation -->
<%- include('../partials/nav', { active: 'tools', user: user || null }) %>

<style>
  /* Force select text visibility across browsers (some global styles can make it look blank) */
  #langSelect {
    background-color: #ffffff !important;
    color: #111827 !important; /* gray-900 */
    -webkit-text-fill-color: #111827 !important;
    appearance: auto !important;
  }
  #langSelect option {
    color: #111827 !important;
    background-color: #ffffff !important;
  }
</style>

<div class="min-h-screen bg-gradient-to-b from-blue-50 via-white to-white py-12">
  <div class="max-w-4xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-12">
      <div class="inline-block px-4 py-2 bg-primary-100 text-primary-700 rounded-full text-sm font-semibold mb-4">
        Tamil OCR Tool
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4">
        Extract Tamil Text from Images & PDFs
      </h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Upload images or PDFs containing Tamil text and get editable text instantly. Powered by Tesseract OCR with Tamil language support.
      </p>
    </div>

    <!-- Upload Area -->
    <div class="bg-white rounded-2xl shadow-xl border border-gray-200 p-8 mb-6">
      <div 
        id="uploadArea" 
        class="border-3 border-dashed border-primary-300 rounded-xl p-12 text-center bg-blue-50 cursor-pointer transition-all hover:bg-blue-100 hover:border-primary-400"
      >
        <div class="text-6xl mb-4">📄</div>
        <div class="text-xl font-semibold text-primary-700 mb-2">Click to upload or drag and drop</div>
        <div class="text-sm text-gray-600">Supports: JPG, PNG, PDF, TIFF, BMP, GIF (Max 16MB)</div>
        <input type="file" id="fileInput" accept=".jpg,.jpeg,.png,.pdf,.tiff,.bmp,.gif" class="hidden">
      </div>

      <!-- Language Selection -->
      <div class="mt-6">
        <label class="block text-sm font-semibold text-gray-700 mb-2">OCR Language:</label>
        <select id="langSelect" class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-white text-gray-900 cursor-pointer focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          <option value="eng+tam">English + Tamil (Recommended)</option>
          <option value="tam">Tamil Only</option>
          <option value="eng">English Only</option>
        </select>
      </div>

      <!-- File Info -->
      <div id="fileInfo" class="hidden mt-4 p-4 bg-blue-50 rounded-lg border border-primary-200">
        <div class="flex items-center gap-2 text-primary-700">
          <span class="text-xl">📎</span>
          <span id="fileName" class="font-semibold"></span>
          <span id="fileSize" class="text-sm text-gray-600"></span>
        </div>
      </div>

      <!-- Process Button -->
      <div class="mt-6 text-center">
        <button 
          id="processBtn" 
          disabled
          class="px-8 py-4 bg-primary-600 text-white rounded-full font-semibold text-lg transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none"
          style="background: linear-gradient(135deg, #1A2B68 0%, #2979FF 100%);"
        >
          🚀 Extract Text
        </button>
      </div>
    </div>

    <!-- Loading -->
    <div id="loading" class="hidden bg-white rounded-2xl shadow-xl border border-gray-200 p-12 text-center mb-6">
      <div class="inline-block animate-spin rounded-full h-16 w-16 border-b-4 border-primary-600 mb-4"></div>
      <div id="loadingTitle" class="text-xl font-semibold text-primary-700">Extracting text... Please wait</div>
      <div id="loadingHint" class="text-sm text-gray-600 mt-2">This may take a few moments depending on file size</div>
    </div>

    <!-- Error -->
    <div id="error" class="hidden bg-red-50 border border-red-200 rounded-xl p-4 mb-6">
      <div class="flex items-center gap-2 text-red-700">
        <span class="text-xl">❌</span>
        <span id="errorText" class="font-semibold"></span>
      </div>
    </div>

    <!-- Results -->
    <div id="resultArea" class="hidden bg-white rounded-2xl shadow-xl border border-gray-200 p-8 mb-6">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-gray-900">✨ Extracted Text</h2>
        <div id="stats" class="text-sm text-gray-600"></div>
      </div>
      
      <div id="resultText" class="bg-gray-50 rounded-lg p-6 max-h-96 overflow-y-auto mb-6 border border-gray-200 whitespace-pre-wrap text-gray-900 leading-relaxed"></div>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <div class="flex items-center gap-3">
          <label for="downloadFormat" class="text-sm font-semibold text-gray-700">Download as:</label>
          <select id="downloadFormat" class="px-3 py-2 border border-gray-300 rounded-lg bg-white text-gray-900 cursor-pointer focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
            <option value="docx">DOCX (Word)</option>
            <option value="txt">TXT</option>
            <option value="html">HTML</option>
          </select>
        </div>
        <button 
          id="downloadBtn" 
          class="px-6 py-3 bg-primary-600 text-white rounded-lg font-semibold hover:bg-primary-700 transition-colors shadow-lg"
        >
          📥 Download
        </button>
        <button 
          id="copyBtn" 
          class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg font-semibold hover:bg-gray-300 transition-colors"
        >
          📋 Copy Text
        </button>
      </div>
    </div>

    <!-- Info Section -->
    <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-6">
      <h3 class="text-lg font-bold text-gray-900 mb-4">💡 Tips for Best Results</h3>
      <ul class="space-y-2 text-gray-600">
        <li class="flex items-start gap-2">
          <span class="text-primary-600">•</span>
          <span>Use high-resolution images (300+ DPI) for better accuracy</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-primary-600">•</span>
          <span>Ensure text is clear and not rotated</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-primary-600">•</span>
          <span>Black text on white background works best</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-primary-600">•</span>
          <span>For Tamil text, select "English + Tamil" or "Tamil Only" language option</span>
        </li>
      </ul>
    </div>
  </div>
</div>

<script>
  const uploadArea = document.getElementById('uploadArea');
  const fileInput = document.getElementById('fileInput');
  const processBtn = document.getElementById('processBtn');
  const loading = document.getElementById('loading');
  const error = document.getElementById('error');
  const errorText = document.getElementById('errorText');
  const resultArea = document.getElementById('resultArea');
  const resultText = document.getElementById('resultText');
  const stats = document.getElementById('stats');
  const downloadBtn = document.getElementById('downloadBtn');
  const copyBtn = document.getElementById('copyBtn');
  const downloadFormat = document.getElementById('downloadFormat');
  const fileInfo = document.getElementById('fileInfo');
  const fileName = document.getElementById('fileName');
  const fileSize = document.getElementById('fileSize');
  const langSelect = document.getElementById('langSelect');
  const loadingTitle = document.getElementById('loadingTitle');
  const loadingHint = document.getElementById('loadingHint');
  // Ensure a visible default selection (some browsers can render empty if value isn't set explicitly)
  if (langSelect && !langSelect.value) {
    langSelect.value = 'eng+tam';
  }
  
  let selectedFile = null;
  let downloadFilename = null;
  let extractedText = '';
  let sourceFilename = null;
  let activeClientOcr = null;

  function setLoading(title, hint) {
    if (loadingTitle) loadingTitle.textContent = title || 'Working...';
    if (loadingHint) loadingHint.textContent = hint || '';
  }

  function isImageFile(file) {
    return !!file && typeof file.type === 'string' && file.type.startsWith('image/');
  }

  function isPdfFile(file) {
    return !!file && file.type === 'application/pdf';
  }

  function shouldFallbackToClientOcr(resp, data) {
    const status = resp?.status;
    const msg = (data?.error || '') + ' ' + (data?.details || '') + ' ' + (data?.message || '');
    // Backend now returns 200 with success: false when OCR is not configured (no more 503)
    if (status === 200 && data?.success === false && (data?.error === 'ocr_not_configured' || /not configured/i.test(msg))) return true;
    return status === 503 && /OCR_SERVICE_URL|not configured for production|On Vercel/i.test(msg);
  }

  function loadScriptOnce(src) {
    return new Promise((resolve, reject) => {
      const existing = document.querySelector(`script[data-src="${src}"]`);
      if (existing) return resolve();
      const s = document.createElement('script');
      s.src = src;
      s.async = true;
      s.defer = true;
      s.setAttribute('data-src', src);
      s.onload = () => resolve();
      s.onerror = () => reject(new Error(`Failed to load ${src}`));
      document.head.appendChild(s);
    });
  }

  async function runClientSideOcr(file, lang) {
    // We only support browser OCR for images. PDFs should use an external OCR service.
    if (isPdfFile(file)) {
      throw new Error('For PDF OCR in production, please set OCR_SERVICE_URL (Cloud Run). For now, convert the PDF page to an image (JPG/PNG) and upload.');
    }
    if (!isImageFile(file)) {
      throw new Error('Client-side OCR supports images only. Please upload JPG/PNG/TIFF/BMP/GIF, or configure OCR_SERVICE_URL for PDFs.');
    }

    // Load Tesseract.js in the browser on-demand (keeps other pages fast)
    if (!window.Tesseract) {
      await loadScriptOnce('https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js');
    }
    if (!window.Tesseract || typeof window.Tesseract.recognize !== 'function') {
      throw new Error('OCR engine failed to load in the browser. Please try again, or configure OCR_SERVICE_URL.');
    }

    // Show progress
    setLoading('Extracting text in your browser…', 'Downloading OCR language data…');
    const tessdataFast = 'https://tessdata.projectnaptha.com/4.0.0_fast';

    activeClientOcr = { cancelled: false };
    const localRef = activeClientOcr;

    const result = await window.Tesseract.recognize(file, lang || 'eng+tam', {
      langPath: tessdataFast,
      logger: (m) => {
        if (!localRef || localRef.cancelled) return;
        try {
          const pct = typeof m.progress === 'number' ? Math.round(m.progress * 100) : null;
          const status = m.status ? String(m.status) : 'processing';
          if (pct !== null) {
            setLoading('Extracting text in your browser…', `${status} — ${pct}%`);
          } else {
            setLoading('Extracting text in your browser…', status);
          }
        } catch {
          // ignore
        }
      }
    });

    if (!localRef || localRef.cancelled) {
      throw new Error('OCR was cancelled.');
    }

    const text = result?.data?.text || '';
    return { text };
  }
  
  // Click to upload
  uploadArea.addEventListener('click', () => fileInput.click());
  
  // Drag and drop
  uploadArea.addEventListener('dragover', (e) => {
    e.preventDefault();
    uploadArea.classList.add('border-primary-500', 'bg-blue-100');
  });
  
  uploadArea.addEventListener('dragleave', () => {
    uploadArea.classList.remove('border-primary-500', 'bg-blue-100');
  });
  
  uploadArea.addEventListener('drop', (e) => {
    e.preventDefault();
    uploadArea.classList.remove('border-primary-500', 'bg-blue-100');
    const files = e.dataTransfer.files;
    if (files.length > 0) {
      handleFileSelect(files[0]);
    }
  });
  
  // File selection
  fileInput.addEventListener('change', (e) => {
    if (e.target.files.length > 0) {
      handleFileSelect(e.target.files[0]);
    }
  });
  
  function handleFileSelect(file) {
    selectedFile = file;
    sourceFilename = file.name;
    processBtn.disabled = false;
    error.classList.add('hidden');
    resultArea.classList.add('hidden');
    
    const sizeMB = (file.size / 1024 / 1024).toFixed(2);
    fileName.textContent = file.name;
    fileSize.textContent = `(${sizeMB} MB)`;
    fileInfo.classList.remove('hidden');
  }
  
  // Process file
  processBtn.addEventListener('click', async () => {
    if (!selectedFile) return;

    // Cancel any in-flight client OCR
    if (activeClientOcr) {
      activeClientOcr.cancelled = true;
      activeClientOcr = null;
    }
    
    const formData = new FormData();
    formData.append('file', selectedFile);
    formData.append('lang', langSelect.value);
    
    loading.classList.remove('hidden');
    processBtn.disabled = true;
    error.classList.add('hidden');
    resultArea.classList.add('hidden');
    setLoading('Extracting text... Please wait', 'This may take a few moments depending on file size');
    
    try {
      const controller = new AbortController();
      const timeoutMs = 95_000;
      const timeoutId = setTimeout(() => controller.abort(), timeoutMs);

      let response;
      try {
        response = await fetch('/api/ocr/upload', {
          method: 'POST',
          body: formData,
          credentials: 'include',
          signal: controller.signal
        });
      } finally {
        clearTimeout(timeoutId);
      }

      const raw = await response.text();
      const data = (() => {
        try { return JSON.parse(raw); } catch { return { error: 'OCR failed', details: raw?.slice(0, 300) || 'Invalid response' }; }
      })();
      
      // If server OCR is not configured on Vercel, fall back to client-side OCR (images only)
      if (shouldFallbackToClientOcr(response, data)) {
        try {
          const lang = (langSelect && langSelect.value) ? langSelect.value : 'eng+tam';
          const out = await runClientSideOcr(selectedFile, lang);
          extractedText = out.text || '';
          loading.classList.add('hidden');
          processBtn.disabled = false;
          resultText.textContent = extractedText;
          stats.textContent = `${extractedText.length} characters extracted`;
          downloadFilename = null; // no server docx in client OCR
          resultArea.classList.remove('hidden');
          return;
        } catch (clientErr) {
          // fall through to show the real error below
          console.warn('[OCR] Client-side OCR fallback failed:', clientErr?.message);
          data.error = 'OCR failed';
          data.details = clientErr?.message || data.details;
        }
      }

      loading.classList.add('hidden');
      
      if (data.error) {
        // Show both high-level error and details (if provided)
        errorText.textContent = data.details ? `${data.error} — ${data.details}` : data.error;
        error.classList.remove('hidden');
        processBtn.disabled = false;
      } else {
        // Use full_text if available, otherwise use text
        extractedText = data.full_text || data.text || '';
        resultText.textContent = extractedText;
        stats.textContent = `${data.char_count || extractedText.length} characters extracted`;
        downloadFilename = data.download_filename;
        resultArea.classList.remove('hidden');
        processBtn.disabled = false;
      }
    } catch (err) {
      loading.classList.add('hidden');
      
      // Try to extract error message from response
      let errorMessage = 'Failed to process file. Please try again.';
      if (err.message) {
        errorMessage = err.message;
      }

      if (err.name === 'AbortError') {
        errorMessage = 'OCR is taking too long and was stopped. Please try a smaller/clearer image, or try again later.';
      }
      
      // Check if it's a JSON parse error (service returned HTML)
      if (err.message && err.message.includes('JSON')) {
        errorMessage = 'OCR service is not available. Please contact support or try again later.';
      }
      
      errorText.textContent = errorMessage;
      error.classList.remove('hidden');
      processBtn.disabled = false;
      
      console.error('[OCR] Upload error:', err);
    }
  });
  
  // Download
  downloadBtn.addEventListener('click', () => {
    const fmt = (downloadFormat && downloadFormat.value) ? downloadFormat.value : 'docx';
    const baseName = (sourceFilename || 'ocr-extracted')
      .replace(/\.[^/.]+$/, '')
      .replace(/[^\w\-]+/g, '_')
      .slice(0, 60) || 'ocr-extracted';

    if (fmt === 'docx') {
      if (downloadFilename) {
        window.location.href = `/api/ocr/download/${encodeURIComponent(downloadFilename)}`;
      } else {
        // If backend didn't provide a docx, fallback to TXT so user can still download.
        const blob = new Blob([extractedText || ''], { type: 'text/plain;charset=utf-8' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `${baseName}.txt`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(a.href), 1000);
      }
      return;
    }

    if (fmt === 'txt') {
      const blob = new Blob([extractedText || ''], { type: 'text/plain;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `${baseName}.txt`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
      return;
    }

    if (fmt === 'html') {
      const safe = (extractedText || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
      const html = `<!doctype html><html><head><meta charset="utf-8"><title>${baseName}</title></head><body><pre style="white-space:pre-wrap;font-family:ui-sans-serif,system-ui;">${safe}</pre></body></html>`;
      const blob = new Blob([html], { type: 'text/html;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `${baseName}.html`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    }
  });
  
  // Copy text
  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(extractedText);
      copyBtn.textContent = '✓ Copied!';
      setTimeout(() => {
        copyBtn.textContent = '📋 Copy Text';
      }, 2000);
    } catch (err) {
      // Fallback for older browsers
      const textArea = document.createElement('textarea');
      textArea.value = extractedText;
      document.body.appendChild(textArea);
      textArea.select();
      document.execCommand('copy');
      document.body.removeChild(textArea);
      copyBtn.textContent = '✓ Copied!';
      setTimeout(() => {
        copyBtn.textContent = '📋 Copy Text';
      }, 2000);
    }
  });
</script>

<%- include('../partials/footer') %>


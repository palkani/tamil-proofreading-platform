<%- include('../partials/header') %>

<!-- Navigation -->
<%- include('../partials/nav', { active: 'tools', user: user || null }) %>

<div class="min-h-screen bg-gradient-to-b from-blue-50 via-white to-white py-12">
  <div class="max-w-4xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-12">
      <div class="inline-block px-4 py-2 bg-primary-100 text-primary-700 rounded-full text-sm font-semibold mb-4">
        Tamil OCR Tool
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4">
        Extract Tamil Text from Images & PDFs
      </h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Upload images or PDFs containing Tamil text and get editable text instantly. Powered by Tesseract OCR with Tamil language support.
      </p>
    </div>

    <!-- Upload Area -->
    <div class="bg-white rounded-2xl shadow-xl border border-gray-200 p-8 mb-6">
      <div 
        id="uploadArea" 
        class="border-3 border-dashed border-primary-300 rounded-xl p-12 text-center bg-blue-50 cursor-pointer transition-all hover:bg-blue-100 hover:border-primary-400"
      >
        <div class="text-6xl mb-4">📄</div>
        <div class="text-xl font-semibold text-primary-700 mb-2">Click to upload or drag and drop</div>
        <div class="text-sm text-gray-600">Supports: JPG, PNG, PDF, TIFF, BMP, GIF (Max 16MB)</div>
        <input type="file" id="fileInput" accept=".jpg,.jpeg,.png,.pdf,.tiff,.bmp,.gif" class="hidden">
      </div>

      <!-- Language Selection -->
      <div class="mt-6">
        <label class="block text-sm font-semibold text-gray-700 mb-2">OCR Language:</label>
        <select id="langSelect" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
          <option value="eng+tam">English + Tamil (Recommended)</option>
          <option value="tam">Tamil Only</option>
          <option value="eng">English Only</option>
        </select>
      </div>

      <!-- File Info -->
      <div id="fileInfo" class="hidden mt-4 p-4 bg-blue-50 rounded-lg border border-primary-200">
        <div class="flex items-center gap-2 text-primary-700">
          <span class="text-xl">📎</span>
          <span id="fileName" class="font-semibold"></span>
          <span id="fileSize" class="text-sm text-gray-600"></span>
        </div>
      </div>

      <!-- Process Button -->
      <div class="mt-6 text-center">
        <button 
          id="processBtn" 
          disabled
          class="px-8 py-4 bg-primary-600 text-white rounded-full font-semibold text-lg transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none"
          style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 50%, #1e40af 100%);"
        >
          🚀 Extract Text
        </button>
      </div>
    </div>

    <!-- Loading -->
    <div id="loading" class="hidden bg-white rounded-2xl shadow-xl border border-gray-200 p-12 text-center mb-6">
      <div class="inline-block animate-spin rounded-full h-16 w-16 border-b-4 border-primary-600 mb-4"></div>
      <div class="text-xl font-semibold text-primary-700">Extracting text... Please wait</div>
      <div class="text-sm text-gray-600 mt-2">This may take a few moments depending on file size</div>
    </div>

    <!-- Error -->
    <div id="error" class="hidden bg-red-50 border border-red-200 rounded-xl p-4 mb-6">
      <div class="flex items-center gap-2 text-red-700">
        <span class="text-xl">❌</span>
        <span id="errorText" class="font-semibold"></span>
      </div>
    </div>

    <!-- Results -->
    <div id="resultArea" class="hidden bg-white rounded-2xl shadow-xl border border-gray-200 p-8 mb-6">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-gray-900">✨ Extracted Text</h2>
        <div id="stats" class="text-sm text-gray-600"></div>
      </div>
      
      <div id="resultText" class="bg-gray-50 rounded-lg p-6 max-h-96 overflow-y-auto mb-6 border border-gray-200 whitespace-pre-wrap text-gray-900 leading-relaxed"></div>
      
      <div class="flex gap-4 justify-center">
        <button 
          id="downloadBtn" 
          class="px-6 py-3 bg-primary-600 text-white rounded-lg font-semibold hover:bg-primary-700 transition-colors shadow-lg"
        >
          📥 Download Word Document
        </button>
        <button 
          id="copyBtn" 
          class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg font-semibold hover:bg-gray-300 transition-colors"
        >
          📋 Copy Text
        </button>
      </div>
    </div>

    <!-- Info Section -->
    <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-6">
      <h3 class="text-lg font-bold text-gray-900 mb-4">💡 Tips for Best Results</h3>
      <ul class="space-y-2 text-gray-600">
        <li class="flex items-start gap-2">
          <span class="text-primary-600">•</span>
          <span>Use high-resolution images (300+ DPI) for better accuracy</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-primary-600">•</span>
          <span>Ensure text is clear and not rotated</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-primary-600">•</span>
          <span>Black text on white background works best</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-primary-600">•</span>
          <span>For Tamil text, select "English + Tamil" or "Tamil Only" language option</span>
        </li>
      </ul>
    </div>
  </div>
</div>

<script>
  const uploadArea = document.getElementById('uploadArea');
  const fileInput = document.getElementById('fileInput');
  const processBtn = document.getElementById('processBtn');
  const loading = document.getElementById('loading');
  const error = document.getElementById('error');
  const errorText = document.getElementById('errorText');
  const resultArea = document.getElementById('resultArea');
  const resultText = document.getElementById('resultText');
  const stats = document.getElementById('stats');
  const downloadBtn = document.getElementById('downloadBtn');
  const copyBtn = document.getElementById('copyBtn');
  const fileInfo = document.getElementById('fileInfo');
  const fileName = document.getElementById('fileName');
  const fileSize = document.getElementById('fileSize');
  const langSelect = document.getElementById('langSelect');
  
  let selectedFile = null;
  let downloadFilename = null;
  let extractedText = '';
  
  // Click to upload
  uploadArea.addEventListener('click', () => fileInput.click());
  
  // Drag and drop
  uploadArea.addEventListener('dragover', (e) => {
    e.preventDefault();
    uploadArea.classList.add('border-primary-500', 'bg-blue-100');
  });
  
  uploadArea.addEventListener('dragleave', () => {
    uploadArea.classList.remove('border-primary-500', 'bg-blue-100');
  });
  
  uploadArea.addEventListener('drop', (e) => {
    e.preventDefault();
    uploadArea.classList.remove('border-primary-500', 'bg-blue-100');
    const files = e.dataTransfer.files;
    if (files.length > 0) {
      handleFileSelect(files[0]);
    }
  });
  
  // File selection
  fileInput.addEventListener('change', (e) => {
    if (e.target.files.length > 0) {
      handleFileSelect(e.target.files[0]);
    }
  });
  
  function handleFileSelect(file) {
    selectedFile = file;
    processBtn.disabled = false;
    error.classList.add('hidden');
    resultArea.classList.add('hidden');
    
    const sizeMB = (file.size / 1024 / 1024).toFixed(2);
    fileName.textContent = file.name;
    fileSize.textContent = `(${sizeMB} MB)`;
    fileInfo.classList.remove('hidden');
  }
  
  // Process file
  processBtn.addEventListener('click', async () => {
    if (!selectedFile) return;
    
    const formData = new FormData();
    formData.append('file', selectedFile);
    formData.append('lang', langSelect.value);
    
    loading.classList.remove('hidden');
    processBtn.disabled = true;
    error.classList.add('hidden');
    resultArea.classList.add('hidden');
    
    try {
      const response = await fetch('/api/ocr/upload', {
        method: 'POST',
        body: formData,
        credentials: 'include'
      });
      
      const data = await response.json();
      
      loading.classList.add('hidden');
      
      if (data.error) {
        errorText.textContent = data.error;
        error.classList.remove('hidden');
        processBtn.disabled = false;
      } else {
        extractedText = data.text || data.full_text || '';
        resultText.textContent = extractedText;
        stats.textContent = `${data.char_count || extractedText.length} characters extracted`;
        downloadFilename = data.download_filename;
        resultArea.classList.remove('hidden');
      }
    } catch (err) {
      loading.classList.add('hidden');
      errorText.textContent = err.message || 'Failed to process file. Please try again.';
      error.classList.remove('hidden');
      processBtn.disabled = false;
    }
  });
  
  // Download
  downloadBtn.addEventListener('click', () => {
    if (downloadFilename) {
      window.location.href = `/api/ocr/download/${downloadFilename}`;
    }
  });
  
  // Copy text
  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(extractedText);
      copyBtn.textContent = '✓ Copied!';
      setTimeout(() => {
        copyBtn.textContent = '📋 Copy Text';
      }, 2000);
    } catch (err) {
      // Fallback for older browsers
      const textArea = document.createElement('textarea');
      textArea.value = extractedText;
      document.body.appendChild(textArea);
      textArea.select();
      document.execCommand('copy');
      document.body.removeChild(textArea);
      copyBtn.textContent = '✓ Copied!';
      setTimeout(() => {
        copyBtn.textContent = '📋 Copy Text';
      }, 2000);
    }
  });
</script>

<%- include('../partials/footer') %>


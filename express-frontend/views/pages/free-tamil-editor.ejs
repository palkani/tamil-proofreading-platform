<%- include('../partials/header') %>

<!-- Navigation -->
<%- include('../partials/nav', { active: 'tools', user: user || null }) %>

<div class="min-h-screen bg-gradient-to-b from-blue-50 via-white to-white py-12">
  <div class="max-w-5xl mx-auto px-6">
    <header class="text-center mb-10">
      <div class="inline-block px-4 py-2 bg-primary-100 text-primary-700 rounded-full text-sm font-semibold mb-4">
        Free Tamil Editor
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4">
        Free Tamil Editing & Proofreading Online
      </h1>
      <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
        Paste or type Tamil text and instantly get grammar and spelling improvements. This page is optimized for people searching for
        <strong>free Tamil editing</strong>—no download required.
      </p>
    </header>

    <!-- Editor (reuses home editor UX) -->
    <section class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden">
      <div class="bg-gray-50 border-b border-gray-200 px-6 py-3 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-red-400"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
          <div class="w-3 h-3 rounded-full bg-green-400"></div>
          <span class="ml-2 text-sm font-semibold text-gray-700">Tamil Editor</span>
        </div>
        <span class="text-xs text-gray-500" id="home-char-count">0 / 200 words</span>
      </div>

      <div class="bg-white border-b border-gray-200 px-6 py-2 flex items-center gap-1">
        <button id="home-bold-btn" class="px-3 py-1.5 text-sm font-bold text-gray-700 hover:bg-gray-100 rounded transition" title="Bold (Ctrl+B)">B</button>
        <button id="home-italic-btn" class="px-3 py-1.5 text-sm italic text-gray-700 hover:bg-gray-100 rounded transition" title="Italic (Ctrl+I)">I</button>
        <button id="home-underline-btn" class="px-3 py-1.5 text-sm underline text-gray-700 hover:bg-gray-100 rounded transition" title="Underline (Ctrl+U)">U</button>
      </div>

      <div class="p-8 relative">
        <div 
          id="home-editor" 
          contenteditable="true"
          class="min-h-[420px] text-gray-900 text-xl leading-relaxed focus:outline-none w-full"
          placeholder="Type in English (e.g., vanakkam) or paste Tamil text to edit..."
        ></div>

        <div id="home-autocomplete-dropdown" class="hidden absolute top-24 left-8 right-8 bg-white border-2 border-gray-300 rounded-xl shadow-2xl max-h-80 overflow-y-auto z-50">
          <div class="p-4 space-y-3"></div>
          <div class="px-4 py-3 text-sm text-gray-600 border-t bg-gray-50">Press <strong>Space</strong> to select first option or click any suggestion</div>
        </div>
      </div>
    </section>

    <section class="mt-8 bg-white rounded-2xl shadow-lg border border-gray-200 p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-3">What you can do with this free Tamil editor</h2>
      <ul class="space-y-2 text-gray-700">
        <li><strong>Grammar check:</strong> catch common Tamil grammar issues and improve sentence flow.</li>
        <li><strong>Spell check:</strong> fix spelling mistakes and confusing எழுத்துக்கள் usage.</li>
        <li><strong>Type in Tanglish:</strong> convert English phonetic typing into Tamil as you write.</li>
      </ul>

      <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/workspace" class="px-6 py-3 text-white rounded-full font-semibold text-center shadow-lg hover:shadow-xl transition-all" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 50%, #1e40af 100%);">
          Open Full Workspace
        </a>
        <a href="/tools/ocr" class="px-6 py-3 bg-white border-2 border-gray-300 text-primary-700 rounded-full font-semibold text-center hover:border-primary-600 hover:bg-primary-50 transition-all">
          Tamil OCR (Image → Text)
        </a>
        <a href="/tools/converter" class="px-6 py-3 bg-white border-2 border-gray-300 text-primary-700 rounded-full font-semibold text-center hover:border-primary-600 hover:bg-primary-50 transition-all">
          Document Converter
        </a>
      </div>
    </section>

    <section class="mt-8 bg-white rounded-2xl shadow-lg border border-gray-200 p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4">FAQ (Free Tamil Editing)</h2>
      <div class="space-y-4 text-gray-700">
        <div>
          <h3 class="font-semibold text-gray-900">Is this a free Tamil editing tool?</h3>
          <p>Yes—this page is designed for free Tamil editing and proofreading online.</p>
        </div>
        <div>
          <h3 class="font-semibold text-gray-900">Can I paste Tamil text and correct it?</h3>
          <p>Yes. Paste your Tamil text into the editor and review suggestions to improve grammar and spelling.</p>
        </div>
        <div>
          <h3 class="font-semibold text-gray-900">Can I convert images or PDFs to Tamil text?</h3>
          <p>Yes—use our <a class="text-primary-700 underline" href="/tools/ocr">Tamil OCR tool</a> to extract text from images/PDFs.</p>
        </div>
      </div>
    </section>
  </div>
</div>

<script src="/js/home-editor.js"></script>

<%- include('../partials/footer') %>



<%- include('../partials/header') %>
<style>
  /* Inline correction highlights (matches home.ejs) */
  .home-correction-highlight { border-radius:2px; cursor:pointer; transition:background-color 0.15s; }
  .home-correction-highlight:hover { background-color:rgba(239,68,68,0.10); }
  .hc-grammar  { text-decoration:underline wavy #ef4444; text-underline-offset:4px; text-decoration-thickness:2px; }
  .hc-spelling { text-decoration:underline wavy #f97316; text-underline-offset:4px; text-decoration-thickness:2px; }
  .hc-style    { text-decoration:underline wavy #8b5cf6; text-underline-offset:4px; text-decoration-thickness:2px; }
</style>

<!-- Navigation -->
<%- include('../partials/nav', { active: 'tools', user: user || null }) %>

<div class="min-h-screen bg-gradient-to-b from-blue-50 via-white to-white py-12">
  <div class="max-w-5xl mx-auto px-6">
    <header class="text-center mb-10">
      <div class="inline-block px-4 py-2 bg-primary-100 text-primary-700 rounded-full text-sm font-semibold mb-4">
        Free Tamil Editor
      </div>
      <!-- Fear-led hero (2026-08-24) — replaces the long keyword-first
           title. Kept the SEO-heavy phrasing as the sr-only fallback
           below and in the meta description so organic ranking is
           preserved without wasting the visitor's first-fold. -->
      <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4">
        Catch the mistake before your reader does.
      </h1>
      <span class="sr-only">Free Tamil Editor + Tamil Typing (Tanglish to Tamil) Online — Tamil editor, Tamil typing tool.</span>
      <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
        Free Tamil grammar and spelling check. Nobody else has to see the draft.
      </p>
    </header>

    <!-- Editor (reuses home editor UX) -->
    <section class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden">
      <div class="bg-gray-50 border-b border-gray-200 px-4 sm:px-6 py-3 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="hidden sm:flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-400"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
            <div class="w-3 h-3 rounded-full bg-green-400"></div>
          </div>
          <span class="text-sm font-semibold text-gray-700">Tamil Editor</span>
        </div>
        <span class="text-xs text-gray-500" id="home-char-count">0 / 200 words</span>
      </div>

      <!-- Mode + proofreading toggle (shared ids with home-editor.js) -->
      <div class="bg-white border-b border-gray-200 px-6 py-2 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6">
        <div class="flex items-center gap-3">
          <label for="home-mode-select" class="text-sm text-gray-700">Tamil style:</label>
          <select id="home-mode-select" class="toolbar-select">
            <option value="spoken">Spoken Tamil</option>
            <option value="formal">Written / Formal</option>
            <option value="academic">Academic / Article</option>
          </select>
        </div>
        <div class="flex items-center gap-2">
          <label class="inline-flex items-center gap-2 text-sm text-gray-700 select-none" for="home-proofread-toggle">
            <input id="home-proofread-toggle" type="checkbox" class="rounded border-gray-300 text-primary-600 focus:ring-primary-500" checked />
            <span class="font-medium">AI proofreading</span>
          </label>
        </div>

        <!-- Import / Export buttons -->
        <div class="flex items-center gap-2 sm:ml-auto">
          <button type="button" id="fte-import-btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 hover:border-gray-400 transition" title="Import .pdf, .docx or .txt" onclick="window.docImport && window.docImport.open()">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            <span class="hidden sm:inline">Import</span>
          </button>

          <div class="relative" id="fte-export-wrap">
            <button type="button" id="fte-export-btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 hover:border-gray-400 transition" title="Export to PDF or Word">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              <span class="hidden sm:inline">Export</span>
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div id="fte-export-menu" class="hidden absolute right-0 mt-1 w-44 bg-white border border-gray-200 rounded-lg shadow-lg z-30 py-1">
              <button type="button" class="w-full px-3 py-2 text-left text-sm hover:bg-gray-50 flex items-center gap-2" onclick="window.docExport && window.docExport.exportPdf()">
                <span class="font-medium text-gray-900">Export as PDF</span>
              </button>
              <button type="button" class="w-full px-3 py-2 text-left text-sm hover:bg-gray-50 flex items-center gap-2" onclick="window.docExport && window.docExport.exportDocx()">
                <span class="font-medium text-gray-900">Export as Word</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="p-8 relative">
        <div 
          id="home-editor" 
          contenteditable="true"
          class="min-h-[420px] text-gray-900 text-xl leading-relaxed focus:outline-none w-full"
          placeholder="Type in English (e.g., vanakkam) or paste Tamil text to edit..."
        ></div>

        <!-- Autocomplete Dropdown (Thanglish → Tamil) -->
        <div id="home-autocomplete-dropdown" class="hidden fixed bg-white border border-gray-200 rounded-2xl shadow-2xl max-h-96 overflow-hidden z-50" style="width: 320px;">
          <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
            <div class="text-sm font-semibold text-gray-900">Suggestions</div>
            <button type="button" id="home-autocomplete-close" class="p-1 rounded-lg hover:bg-gray-100 text-gray-500" aria-label="Close suggestions">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18"/>
              </svg>
            </button>
          </div>
          <div id="home-autocomplete-list" class="p-2 max-h-72 overflow-y-auto"></div>
          <div class="px-4 py-3 text-xs text-gray-600 border-t bg-gray-50">
            Press
            <kbd class="mx-1 px-2 py-0.5 rounded-md border border-gray-300 bg-white text-gray-700 font-semibold">Space</kbd>
            to select first option
          </div>
        </div>
      </div>
    </section>

    <section class="mt-8 bg-white rounded-2xl shadow-lg border border-gray-200 p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-3">What you can do with this free Tamil editor</h2>
      <ul class="space-y-2 text-gray-700">
        <li><strong>Grammar check:</strong> catch common Tamil grammar issues and improve sentence flow.</li>
        <li><strong>Spell check:</strong> fix spelling mistakes and confusing எழுத்துக்கள் usage.</li>
        <li><strong>Type in Tanglish:</strong> convert English phonetic typing into Tamil as you write.</li>
      </ul>

      <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/workspace" class="px-6 py-3 text-white rounded-full font-semibold text-center shadow-lg hover:shadow-xl transition-all" style="background: linear-gradient(135deg, #1A2B68 0%, #2979FF 100%);">
          Open Full Workspace
        </a>
        <!-- OCR under maintenance — CTA disabled with badge. Restore
             by swapping <span> back to <a href="/tools/ocr">. -->
        <span aria-disabled="true" title="Tamil OCR is under maintenance — coming back soon"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gray-50 border-2 border-gray-200 text-gray-500 rounded-full font-semibold text-center opacity-70 cursor-not-allowed pointer-events-none">
          Tamil OCR (Image → Text)
          <span class="text-[10px] px-1.5 py-0.5 bg-amber-100 text-amber-800 rounded-full font-semibold uppercase tracking-wider">Coming soon</span>
        </span>
      </div>
    </section>

    <section class="mt-8 bg-white rounded-2xl shadow-lg border border-gray-200 p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4">FAQ (Free Tamil Editing)</h2>
      <div class="space-y-4 text-gray-700">
        <div>
          <h3 class="font-semibold text-gray-900">Is this a free Tamil editing tool?</h3>
          <p>Yes—this page is designed for free Tamil editing and proofreading online.</p>
        </div>
        <div>
          <h3 class="font-semibold text-gray-900">Can I paste Tamil text and correct it?</h3>
          <p>Yes. Paste your Tamil text into the editor and review suggestions to improve grammar and spelling.</p>
        </div>
        <div>
          <h3 class="font-semibold text-gray-900">Can I convert images or PDFs to Tamil text?</h3>
          <p>Our Handwritten Notes into Text tool converts photos of handwritten Tamil into editable text. <span class="text-amber-700 font-medium">(Under maintenance — coming back soon.)</span></p>
        </div>
      </div>
    </section>
  </div>
</div>

<!-- Related reading -->
<section class="py-16 bg-gray-50">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Related reading</h2>
    <div class="grid sm:grid-cols-2 gap-4">
      <a href="/blog/tanglish-to-tamil-typing" class="block p-5 rounded-xl bg-white border border-gray-200 hover:border-indigo-300 hover:shadow-md transition" style="text-decoration:none;">
        <div style="font-size:0.75rem;font-weight:600;color:#6366F1;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Guide</div>
        <h3 class="text-base font-semibold text-gray-900 leading-snug">Tanglish to Tamil Typing — How to Type Tamil Without a Tamil Keyboard</h3>
      </a>
      <a href="/blog/common-tamil-grammar-mistakes" class="block p-5 rounded-xl bg-white border border-gray-200 hover:border-indigo-300 hover:shadow-md transition" style="text-decoration:none;">
        <div style="font-size:0.75rem;font-weight:600;color:#6366F1;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Guide</div>
        <h3 class="text-base font-semibold text-gray-900 leading-snug">10 Common Tamil Grammar Mistakes (And How to Fix Them)</h3>
      </a>
    </div>
  </div>
</section>

<script>
  // Multi-region runner URLs for low latency
  window.TRANSLITERATOR_URLS = {
    'asia': 'https://prooftamil-runner-991187041222.asia-south1.run.app',
    'us': 'https://prooftamil-runner-us-991187041222.us-central1.run.app',
    'default': 'https://prooftamil-runner-991187041222.asia-south1.run.app'
  };
  const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
  const isAsia = tz.includes('Asia') || tz.includes('India') || tz.includes('Singapore') || tz.includes('Hong_Kong');
  window.NEXT_PUBLIC_TRANSLITERATOR_BASE_URL = isAsia ? window.TRANSLITERATOR_URLS.asia : window.TRANSLITERATOR_URLS.us;
</script>
<script src="/js/transliterator-runner.js?v=20260122b"></script>
<script src="/js/transliteration.js?v=20260427a"></script>

<%- include('../partials/header') %>

<style>
  @keyframes gradient-shift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .section-animate {
    animation: fade-in-up 0.8s ease-out forwards;
    opacity: 0;
  }
  
  #home-editor:empty:before {
    content: attr(placeholder);
    color: #9ca3af;
    pointer-events: none;
  }
  
  #home-editor:focus:before {
    content: '';
  }

  /* Home editor toolbar (match Workspace style) */
  .home-toolbar {
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .home-toolbar .toolbar-btn {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    color: #0f172a;
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.10);
    transition: all 140ms ease;
  }
  .home-toolbar .toolbar-btn:hover {
    background: #f8fafc;
    border-color: rgba(79, 70, 229, 0.35);
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
    transform: translateY(-1px);
  }
  .home-toolbar .toolbar-btn.active {
    background: linear-gradient(135deg, rgba(30, 58, 138, 0.10) 0%, rgba(59, 130, 246, 0.12) 50%, rgba(30, 64, 175, 0.10) 100%);
    border-color: rgba(59, 130, 246, 0.45);
  }
  .home-toolbar .toolbar-btn svg {
    stroke: currentColor;
    stroke-width: 2.4;
    fill: none;
  }
  .home-toolbar .toolbar-pill {
    display: inline-flex;
    gap: 6px;
    padding: 6px;
    border-radius: 16px;
    background: rgba(148, 163, 184, 0.12);
    border: 1px solid rgba(15, 23, 42, 0.08);
  }
  .home-toolbar .toolbar-divider {
    width: 1px;
    height: 26px;
    background: rgba(15, 23, 42, 0.14);
    margin: 0 10px;
  }
  .home-toolbar .dropdown-panel {
    border-radius: 14px;
    border: 1px solid rgba(15, 23, 42, 0.12);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.14);
    overflow: hidden;
  }
  .home-toolbar .dropdown-item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    font-size: 14px;
    color: #0f172a;
    background: #ffffff;
    transition: background 120ms ease;
  }
  .home-toolbar .dropdown-item:hover {
    background: rgba(59, 130, 246, 0.08);
  }

  /* Match AI Assistant panel height to the editor card on desktop */
  @media (min-width: 1024px) {
    #home-ai-panel {
      min-height: 650px; /* editor card (~520 editor + header/mode/toolbar) */
    }
  }
</style>

<!-- Navigation (always visible) -->
<%- include('../partials/nav', { active: 'home', user: user || null }) %>

<div class="min-h-screen bg-white">
  <!-- Beta banner -->
  <div class="bg-yellow-50 border-b border-yellow-200">
    <div class="max-w-7xl mx-auto px-6 py-2.5 flex flex-col sm:flex-row sm:items-center sm:justify-center gap-2 text-center">
      <span class="inline-flex items-center justify-center px-2.5 py-1 rounded-full text-xs font-extrabold tracking-wide bg-yellow-400 text-yellow-950">
        BETA
      </span>
      <span class="text-sm text-primary-800">
        We’re in Beta.
      </span>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-blue-50 via-white to-white py-20 md:py-32">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <div class="space-y-8">
        <!-- Main Heading -->
        <h1 class="text-4xl md:text-6xl font-extrabold text-gray-900 leading-tight">
          <span class="bg-gradient-to-r from-primary-700 via-primary-600 to-primary-500 bg-clip-text text-transparent">
            From Idea to Perfect Tamil Content — One Platform
          </span>
          <span class="block mt-3 text-2xl md:text-4xl text-primary-700">All-in-one Tamil Writing Assistant</span>
        </h1>
        
        <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
          Turn your thoughts into clear, natural Tamil blogs and polish your writing with smart Tamil proofreading — all in one place.
        </p>
        
        <!-- Language Badge -->
        <div class="inline-block">
          <span class="px-6 py-2 bg-blue-50 text-primary-700 rounded-full font-semibold text-sm inline-flex items-center justify-center">
            <img src="/images/tamil-logo.svg" alt="Tamil" class="w-6 h-6" width="24" height="24" decoding="async" />
          </span>
        </div>
        
        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center pt-6">
          <% if (user) { %>
            <a href="/workspace" class="px-8 py-4 text-white rounded-full font-semibold text-lg transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 50%, #1e40af 100%);">
              Open Workspace
            </a>
            <a href="/drafts" class="px-8 py-4 bg-white border-2 border-gray-300 text-primary-600 rounded-full font-semibold text-lg hover:border-primary-600 hover:bg-primary-50 transition-all">
              View My Drafts
            </a>
          <% } else { %>
            <a href="/register" class="px-8 py-4 text-white rounded-full font-semibold text-lg transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 50%, #1e40af 100%);">
              Start Tamil Writing — Free Account
            </a>
          <% } %>
        </div>
        
        <!-- Interactive Editor (Only for non-logged-in users) -->
        <% if (!user) { %>
        <div class="mt-16 max-w-6xl mx-auto px-4">
          <!-- Editor + AI assistant aligned side-by-side (desktop) -->
          <div class="grid lg:grid-cols-[1fr_420px] gap-6 items-stretch">
            <!-- Left: Editor + AI Content Writer (below editor) -->
            <div class="flex flex-col gap-6">
            <!-- Editor -->
            <div class="bg-white rounded-2xl shadow-2xl border border-gray-200 overflow-hidden">
              <div class="bg-gray-50 border-b border-gray-200 px-6 py-3 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full bg-red-400"></div>
                  <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                  <div class="w-3 h-3 rounded-full bg-green-400"></div>
                  <span class="ml-2 text-sm font-semibold text-gray-700">Try it now!</span>
                </div>
                <span class="text-xs text-gray-500" id="home-char-count">0 / 200 words</span>
              </div>
              <!-- Mode selector (match Workspace behavior) -->
              <div class="bg-white border-b border-gray-200 px-6 py-2 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6">
                <div class="flex items-center gap-3">
                  <label for="home-mode-select" class="text-sm text-gray-700">Tamil style:</label>
                  <select id="home-mode-select" class="toolbar-select">
                  <option value="spoken">Spoken Tamil</option>
                  <option value="formal">Written / Formal</option>
                  <option value="academic">Academic / Article</option>
                  </select>
                </div>

                <div class="flex items-center gap-2">
                  <label class="inline-flex items-center gap-2 text-sm text-gray-700 select-none" for="home-proofread-toggle">
                    <input id="home-proofread-toggle" type="checkbox" class="rounded border-gray-300 text-primary-600 focus:ring-primary-500" checked />
                    <span class="font-medium">AI proofreading</span>
                  </label>
                  <span class="text-xs text-gray-500">(turn off for pure transliteration/translation only)</span>
                </div>
              </div>
              <!-- Toolbar (same behavior as Workspace; home never saves drafts) -->
              <div class="home-toolbar bg-white border-b border-gray-200 px-6 py-2 flex items-center gap-1 overflow-x-auto">
                <div class="flex items-center gap-1 min-w-max">
                  <div class="toolbar-pill">
                    <button class="toolbar-btn" data-command="undo" title="Undo">
                      <svg class="w-5 h-5" viewBox="0 0 24 24">
                        <path d="M9 14l-4-4 4-4" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M5 10h9a6 6 0 0 1 6 6v1" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <button class="toolbar-btn" data-command="redo" title="Redo">
                      <svg class="w-5 h-5" viewBox="0 0 24 24">
                        <path d="M15 6l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M19 10H10a6 6 0 0 0-6 6v1" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  </div>

                  <div class="toolbar-divider"></div>

                  <div class="relative inline-block">
                    <button class="toolbar-btn" id="home-format-dropdown-btn" title="Text style">
                      <svg class="w-5 h-5" viewBox="0 0 24 24">
                        <path d="M4 5h16" stroke-linecap="round"/>
                        <path d="M9 5v14" stroke-linecap="round"/>
                        <path d="M15 5v14" stroke-linecap="round"/>
                      </svg>
                      <svg class="w-3 h-3 ml-1" viewBox="0 0 20 20" style="stroke-width:2.8">
                        <path d="M6 8l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <div id="home-format-dropdown" class="dropdown-panel hidden absolute left-0 mt-2 w-44 bg-white z-10">
                      <button class="dropdown-item" data-format="p"><span class="font-semibold">Paragraph</span></button>
                      <button class="dropdown-item" data-format="h1"><span class="font-extrabold">Heading 1</span></button>
                      <button class="dropdown-item" data-format="h2"><span class="font-bold">Heading 2</span></button>
                      <button class="dropdown-item" data-format="h3"><span class="font-semibold">Heading 3</span></button>
                    </div>
                  </div>

                  <div class="toolbar-divider"></div>

                  <div class="toolbar-pill">
                    <button class="toolbar-btn" data-command="bold" title="Bold">
                      <svg class="w-5 h-5" viewBox="0 0 24 24">
                        <path d="M7 5h6a4 4 0 0 1 0 8H7V5z" stroke-linejoin="round"/>
                        <path d="M7 13h7a4 4 0 0 1 0 8H7v-8z" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <button class="toolbar-btn" data-command="italic" title="Italic">
                      <svg class="w-5 h-5" viewBox="0 0 24 24">
                        <path d="M19 4h-7" stroke-linecap="round"/>
                        <path d="M12 20H5" stroke-linecap="round"/>
                        <path d="M14 4l-4 16" stroke-linecap="round"/>
                      </svg>
                    </button>
                    <button class="toolbar-btn" data-command="underline" title="Underline">
                      <svg class="w-5 h-5" viewBox="0 0 24 24">
                        <path d="M7 4v6a5 5 0 0 0 10 0V4" stroke-linecap="round"/>
                        <path d="M5 20h14" stroke-linecap="round"/>
                      </svg>
                    </button>
                    <button class="toolbar-btn" data-command="strikeThrough" title="Strikethrough">
                      <svg class="w-5 h-5" viewBox="0 0 24 24">
                        <path d="M4 12h16" stroke-linecap="round"/>
                        <path d="M8 7a4 4 0 0 1 8 0" stroke-linecap="round"/>
                        <path d="M9 17a4 4 0 0 0 6.5 3.1" stroke-linecap="round"/>
                      </svg>
                    </button>
                  </div>

                  <div class="toolbar-divider"></div>

                  <div class="toolbar-pill">
                    <button class="toolbar-btn" data-command="insertUnorderedList" title="Bullet list">
                      <svg class="w-5 h-5" viewBox="0 0 24 24">
                        <path d="M8 6h13" stroke-linecap="round"/>
                        <path d="M8 12h13" stroke-linecap="round"/>
                        <path d="M8 18h13" stroke-linecap="round"/>
                        <path d="M4.5 6h.01" stroke-linecap="round"/>
                        <path d="M4.5 12h.01" stroke-linecap="round"/>
                        <path d="M4.5 18h.01" stroke-linecap="round"/>
                      </svg>
                    </button>
                    <button class="toolbar-btn" data-command="insertOrderedList" title="Numbered list">
                      <svg class="w-5 h-5" viewBox="0 0 24 24">
                        <path d="M9 6h12" stroke-linecap="round"/>
                        <path d="M9 12h12" stroke-linecap="round"/>
                        <path d="M9 18h12" stroke-linecap="round"/>
                        <path d="M4 6h1v4" stroke-linecap="round"/>
                        <path d="M3.5 12h2.5l-2.5 3H6" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M4 18h2" stroke-linecap="round"/>
                      </svg>
                    </button>
                  </div>

                  <div class="toolbar-divider"></div>

                  <div class="relative inline-block">
                    <button class="toolbar-btn" id="home-align-dropdown-btn" title="Alignment">
                      <svg class="w-5 h-5" viewBox="0 0 24 24">
                        <path d="M4 6h16" stroke-linecap="round"/>
                        <path d="M4 10h12" stroke-linecap="round"/>
                        <path d="M4 14h16" stroke-linecap="round"/>
                        <path d="M4 18h12" stroke-linecap="round"/>
                      </svg>
                      <svg class="w-3 h-3 ml-1" viewBox="0 0 20 20" style="stroke-width:2.8">
                        <path d="M6 8l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <div id="home-align-dropdown" class="dropdown-panel hidden absolute left-0 mt-2 w-44 bg-white z-10">
                      <button class="dropdown-item" data-command="justifyLeft"><span class="font-semibold">Align Left</span></button>
                      <button class="dropdown-item" data-command="justifyCenter"><span class="font-semibold">Align Center</span></button>
                      <button class="dropdown-item" data-command="justifyRight"><span class="font-semibold">Align Right</span></button>
                      <button class="dropdown-item" data-command="justifyFull"><span class="font-semibold">Justify</span></button>
                    </div>
                  </div>

                  <div class="toolbar-divider"></div>

                  <button class="toolbar-btn" id="home-insert-link-btn" title="Insert link">
                    <svg class="w-5 h-5" viewBox="0 0 24 24">
                      <path d="M10 13a5 5 0 0 1 0-7l1-1a5 5 0 0 1 7 7l-1 1" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M14 11a5 5 0 0 1 0 7l-1 1a5 5 0 0 1-7-7l1-1" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <button class="toolbar-btn" id="home-search-btn" title="Search">
                    <svg class="w-5 h-5" viewBox="0 0 24 24">
                      <path d="M11 19a8 8 0 1 1 0-16 8 8 0 0 1 0 16z" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M21 21l-4.3-4.3" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>

                  <div class="toolbar-divider"></div>

                  <!-- Translate English to Tamil -->
                  <button class="toolbar-btn bg-primary-50 hover:bg-accent-50 text-primary-700" id="home-translate-english-btn" title="Translate English to Tamil">
                    <svg class="w-5 h-5" viewBox="0 0 24 24">
                      <path d="M4 5h12" stroke-linecap="round"/>
                      <path d="M10 5v14" stroke-linecap="round"/>
                      <path d="M5 9h10" stroke-linecap="round"/>
                      <path d="M16 19l2-6 2 6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span class="ml-1 text-xs font-medium">Translate</span>
                  </button>
                </div>
              </div>
              <div class="flex-1 overflow-auto px-6 py-4 pb-6 relative">
                <div 
                  id="home-editor" 
                  contenteditable="true"
                  class="editor-content bg-white rounded-xl shadow-sm border border-gray-200 min-h-[520px] p-6 tamil-text text-lg text-left focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none w-full"
                  spellcheck="false"
                  placeholder="Type in English (e.g., vanakkam) or paste Tamil text..."
                ></div>
                <!-- Autocomplete Dropdown (Thanglish → Tamil) -->
                <div id="home-autocomplete-dropdown" class="hidden fixed bg-white border border-gray-200 rounded-2xl shadow-2xl max-h-96 overflow-hidden z-50" style="width: 320px;">
                  <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
                    <div class="text-sm font-semibold text-gray-900">Suggestions</div>
                    <button type="button" id="home-autocomplete-close" class="p-1 rounded-lg hover:bg-gray-100 text-gray-500" aria-label="Close suggestions">
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18"/>
                      </svg>
                    </button>
                  </div>
                  <div id="home-autocomplete-list" class="p-2 max-h-72 overflow-y-auto"></div>
                  <div class="px-4 py-3 text-xs text-gray-600 border-t bg-gray-50">
                    Press
                    <kbd class="mx-1 px-2 py-0.5 rounded-md border border-gray-300 bg-white text-gray-700 font-semibold">Space</kbd>
                    to select first option
                  </div>
                </div>
              </div>
            </div>

            <!-- AI Content Writer demo (below editor) -->
            <section class="bg-white rounded-2xl shadow-2xl border border-gray-200 overflow-hidden">
              <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="inline-flex w-9 h-9 items-center justify-center rounded-xl bg-blue-50 text-primary-700 border border-blue-100">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 20h9"/>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>
                    </svg>
                  </span>
                  <div>
                    <div class="text-sm font-semibold text-gray-900">AI Content Writer (Home demo)</div>
                    <div class="text-xs text-gray-600">Generate a 200‑word blog draft instantly.</div>
                  </div>
                </div>
                <a href="/tools/ai-content-writer" class="px-3 py-1.5 rounded-lg bg-primary-50 text-xs font-semibold text-primary-700 hover:bg-primary-100">Open full tool</a>
              </div>

              <div class="p-6">
                <div id="home-writer-container">
                  <div class="space-y-3">
                    <div>
                      <label class="block text-xs font-semibold text-gray-700 mb-1">Prompt</label>
                      <textarea id="home-writer-prompt" class="w-full rounded-xl border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-primary-500" rows="4" placeholder="உதா: பொங்கல் வாழ்த்துக்கள் பற்றி ஒரு சுருக்கமான வலைப்பதிவு..."></textarea>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                      <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Language</label>
                        <select id="home-writer-language" class="w-full rounded-xl border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary-500">
                          <option value="tamil" selected>Tamil</option>
                          <option value="english">English</option>
                          <option value="bilingual">Bilingual</option>
                        </select>
                      </div>
                      <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Tone</label>
                        <select id="home-writer-tone" class="w-full rounded-xl border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary-500">
                          <option value="professional" selected>Professional</option>
                          <option value="casual">Casual</option>
                          <option value="academic">Academic</option>
                          <option value="creative">Creative</option>
                          <option value="persuasive">Persuasive</option>
                        </select>
                      </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                      <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Content Type</label>
                        <select id="home-writer-type" class="w-full rounded-xl border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary-500">
                          <option value="blog" selected>Blog</option>
                          <option value="article">Article</option>
                          <option value="story">Story</option>
                          <option value="essay">Essay</option>
                        </select>
                      </div>
                      <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Word Count</label>
                        <input id="home-writer-word-count" type="number" min="80" max="200" step="20" value="200" class="w-full rounded-xl border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary-500" />
                        <div class="text-[11px] text-gray-500 mt-1">Home demo is capped at 200 words</div>
                      </div>
                    </div>

                    <button type="button" id="home-writer-generate" class="w-full px-4 py-3 rounded-xl bg-primary-600 text-white font-semibold hover:bg-primary-700 transition-colors">
                      Generate
                    </button>

                    <div id="home-writer-status" class="text-sm text-gray-600 hidden"></div>
                    <div id="home-writer-output" class="hidden">
                      <div class="flex items-center justify-between mb-2">
                        <div class="text-xs font-semibold text-gray-700">Generated Content</div>
                        <div class="flex items-center gap-2">
                          <button type="button" id="home-writer-copy" class="px-3 py-1.5 rounded-lg border border-gray-200 bg-white text-xs font-semibold text-gray-700 hover:bg-gray-50">Copy</button>
                          <a href="/tools/ai-content-writer" class="px-3 py-1.5 rounded-lg bg-primary-50 text-xs font-semibold text-primary-700 hover:bg-primary-100">Open full tool</a>
                        </div>
                      </div>
                      <div id="home-writer-output-text" class="rounded-xl border border-gray-200 bg-gray-50 p-3 text-sm text-gray-900 whitespace-pre-wrap"></div>
                    </div>
                  </div>
                </div>
              </div>
            </section>
            </div>

            <!-- AI Assistant panel -->
            <aside id="home-ai-panel" class="bg-white rounded-2xl shadow-2xl border border-gray-200 overflow-hidden lg:sticky lg:top-24 flex flex-col">
              <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="inline-flex w-9 h-9 items-center justify-center rounded-xl bg-purple-50 text-purple-700 border border-purple-100">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 2l1.6 5.2L19 9l-5.4 1.8L12 16l-1.6-5.2L5 9l5.4-1.8L12 2z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 14l.9 2.8L9 18l-3.1 1.2L5 22l-.9-2.8L1 18l3.1-1.2L5 14z"/>
                    </svg>
                  </span>
                  <div class="text-sm font-semibold text-gray-900">AI Assistant</div>

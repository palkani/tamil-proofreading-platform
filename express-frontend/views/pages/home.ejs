                    <span class="voice-lang-toggle-knob"></span>
                  </button>
                  <button type="button" class="voice-mic-btn voice-typing-btn ml-2"
                          onclick="window.voiceTyping && window.voiceTyping.toggle()"
                          title="Voice typing" aria-label="Voice typing" aria-pressed="false">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2a3 3 0 0 1 3 3v6a3 3 0 0 1-6 0V5a3 3 0 0 1 3-3z"/>
                      <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                      <line x1="12" y1="19" x2="12" y2="23"/>
                      <line x1="8" y1="23" x2="16" y2="23"/>
                    </svg>
                  </button>
                </div>
              </div>
              <div class="flex-1 overflow-auto px-4 sm:px-6 py-4 pb-6 relative">
                <div 
                  id="home-editor" 
                  contenteditable="true"
                  class="editor-content bg-white rounded-xl shadow-sm border border-gray-200 min-h-[400px] sm:min-h-[480px] lg:min-h-[520px] p-4 sm:p-6 tamil-text text-base sm:text-lg text-left focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none w-full"
                  spellcheck="false"
                  placeholder="Type in English (e.g., vanakkam) or paste Tamil text..."

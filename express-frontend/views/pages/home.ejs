<!-- All below are deferred so they don't compete with HTML parsing on the
     main thread. `defer` preserves execution order (dependencies in tamilDictionary
     → transliteration → translit-suggest → typeahead → homeEditorAdapter → home-editor
     still resolve in the right order), and they still run before DOMContentLoaded.
     Cuts INP significantly on the anonymous marketing homepage where these ~270KB
     of editor JS are the dominant main-thread cost. -->
<script defer src="/js/transliterator-runner.js?v=20260122b"></script>
<script defer src="/js/tamilDictionary.js?v=20260419a"></script>
<script defer src="/js/transliteration.js?v=20260427a"></script>
<script defer src="/js/translit-suggest.js?v=20260419a"></script>
<script defer src="/js/translit/typeahead.js?v=20260122b"></script>
<script defer src="/js/translit/homeEditorAdapter.js?v=20260122b"></script>
<script defer src="/js/home-editor.js?v=20260421a"></script>

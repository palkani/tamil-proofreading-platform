<%- include('../partials/header') %>

<div class="min-h-screen bg-gray-50">
  <%- include('../partials/nav', { active: 'subscription', user: user }) %>

  <main class="mx-auto w-full max-w-2xl px-5 pb-20 pt-10 sm:px-8">

    <!-- Loading -->
    <div id="sub-loading" class="text-center py-24 text-sm text-gray-400">Loading your plan…</div>

    <!-- Content (hidden until loaded) -->
    <div id="sub-content" class="hidden space-y-4">

      <!-- ── Plan card ─────────────────────────────────────────────── -->
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm px-6 py-5">
        <p class="text-xs font-semibold text-indigo-600 uppercase tracking-wider mb-1">Current Plan</p>
        <div class="flex items-center justify-between gap-3 flex-wrap">
          <h1 id="plan-name" class="text-2xl font-bold text-gray-900"></h1>
          <span id="plan-badge" class="px-3 py-1 rounded-full text-xs font-bold"></span>
        </div>
        <p id="plan-desc" class="text-sm text-gray-500 mt-1.5"></p>
      </div>

      <!-- ── Daily AI Checks ────────────────────────────────────────── -->
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm px-6 py-5">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-sm font-semibold text-gray-700">Daily AI Checks</h2>
          <span id="usage-reset" class="text-xs text-gray-400"></span>
        </div>

        <div class="flex items-baseline gap-1.5 mb-3">
          <span id="usage-used" class="text-3xl font-bold text-gray-900">0</span>
          <span id="usage-limit-label" class="text-base text-gray-400 font-medium"></span>
        </div>

        <div class="w-full h-2.5 bg-gray-100 rounded-full overflow-hidden mb-2">
          <div id="usage-bar" class="h-full rounded-full transition-all duration-700" style="width:0%"></div>
        </div>

        <p id="usage-sub" class="text-xs text-gray-400"></p>
      </div>

      <!-- ── FREE: Upgrade CTA ──────────────────────────────────────── -->
      <div id="upgrade-section" class="hidden rounded-2xl overflow-hidden shadow-sm">
        <!-- Gradient header -->
        <div class="px-6 py-5" style="background:linear-gradient(135deg,#1e3a8a 0%,#3b82f6 100%)">
          <div class="flex items-center gap-2 mb-1">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            <h2 class="text-lg font-bold text-white">Upgrade to ProofTamil Pro</h2>
          </div>
          <p class="text-sm text-white/80">Unlimited AI checks, no caps — ever.</p>
        </div>

        <!-- Feature list + CTA -->
        <div class="bg-white border border-t-0 border-gray-200 px-6 py-5">
          <ul class="space-y-2.5 text-sm text-gray-700 mb-5">
            <li class="flex items-center gap-2.5">
              <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-100 text-indigo-600 flex-shrink-0">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Unlimited words per analysis — no cap
            </li>
            <li class="flex items-center gap-2.5">
              <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-100 text-indigo-600 flex-shrink-0">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Unlimited daily AI checks — no daily limit
            </li>
            <li class="flex items-center gap-2.5">
              <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-100 text-indigo-600 flex-shrink-0">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Deep இலக்கணம், நடை &amp; எழுத்துப்பிழை fixes
            </li>
            <li class="flex items-center gap-2.5">
              <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-100 text-indigo-600 flex-shrink-0">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Voice typing + handwriting OCR
            </li>
            <li class="flex items-center gap-2.5">
              <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-100 text-indigo-600 flex-shrink-0">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              Import .docx, .txt &amp; .pdf files
            </li>
            <li class="flex items-center gap-2.5">
              <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-100 text-indigo-600 flex-shrink-0">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              All your drafts saved &amp; synced across devices
            </li>
          </ul>

          <a href="/pricing"
             class="inline-flex items-center gap-2 px-7 py-3 rounded-full text-white text-sm font-semibold shadow-md hover:shadow-lg hover:scale-105 transition-all"
             style="background:linear-gradient(135deg,#1e3a8a 0%,#3b82f6 100%)">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            View Plans &amp; Pricing
          </a>
        </div>
      </div>

      <!-- ── PRO: plan details + billing ───────────────────────────── -->
      <div id="pro-section" class="hidden space-y-4">

        <!-- Plan details -->
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm px-6 py-5">
          <h2 class="text-sm font-semibold text-gray-700 mb-4">Plan Details</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-sm">
            <div>
              <p class="text-gray-400 text-xs uppercase tracking-wide mb-0.5">Provider</p>
              <p id="sub-provider" class="font-medium text-gray-800">—</p>
            </div>
            <div>
              <p class="text-gray-400 text-xs uppercase tracking-wide mb-0.5">Next renewal</p>
              <p id="sub-renews" class="font-medium text-gray-800">—</p>
            </div>
            <div>
              <p class="text-gray-400 text-xs uppercase tracking-wide mb-0.5">Status</p>
              <p id="sub-status-text" class="font-medium text-gray-800">—</p>
            </div>
          </div>
        </div>

        <!-- Billing history -->
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm px-6 py-5">
          <h2 class="text-sm font-semibold text-gray-700 mb-4">Billing History</h2>
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-gray-100 text-left text-xs text-gray-400 uppercase tracking-wide">
                <th class="pb-3 font-medium">Date</th>
                <th class="pb-3 font-medium">Amount</th>
                <th class="pb-3 font-medium">Status</th>
                <th class="pb-3 font-medium">Method</th>
              </tr>
            </thead>
            <tbody id="billing-history-body">
              <tr>
                <td colspan="4" class="py-6 text-center text-gray-400">No previous payments found.</td>
              </tr>
            </tbody>
          </table>
        </div>

      </div><!-- /pro-section -->

    </div><!-- /sub-content -->

  </main>
</div>

<script>
(function() {
  var loading = document.getElementById('sub-loading');
  var content = document.getElementById('sub-content');

  function formatReset(periodEnd) {
    if (!periodEnd) return '';
    var now = new Date();
    var end = new Date(periodEnd);
    var ms  = end - now;
    if (ms <= 0) return 'Resets soon';
    var totalH = Math.floor(ms / 3600000);
    var m      = Math.floor((ms % 3600000) / 60000);
    if (totalH >= 24) {
      var d = Math.floor(totalH / 24);
      return 'Resets in ' + d + ' day' + (d !== 1 ? 's' : '');
    }
    return 'Resets in ' + totalH + 'h ' + (m < 10 ? '0' : '') + m + 'm';
  }

  Promise.all([
    fetch('/api/v1/billing/me',         { credentials: 'include' }).then(function(r) { return r.ok ? r.json() : null; }).catch(function() { return null; }),
    fetch('/api/v1/suggestion-limits',  { credentials: 'include' }).then(function(r) { return r.ok ? r.json() : null; }).catch(function() { return null; })
  ]).then(function(results) {
    var billingData = results[0];
    var limitsData  = results[1];

    var billing = billingData && billingData.billing;
    var isPro   = !!(billing && billing.has_active_subscription);

    // ── Plan card ──────────────────────────────────────────────────────
    var planName  = document.getElementById('plan-name');
    var planDesc  = document.getElementById('plan-desc');
    var planBadge = document.getElementById('plan-badge');

    var limit = (limitsData && limitsData.limit) || 30;

    if (isPro) {
      var sub      = billing.subscription;
      var planCode = sub && sub.plan_code;
      planName.textContent  = planCode === 'PRO_YEARLY' ? 'ProofTamil Pro — Yearly' : 'ProofTamil Pro — Monthly';
      planDesc.textContent  = 'Unlimited AI proofreading — no word caps, no daily limits.';
      planBadge.textContent = 'Active';
      planBadge.className   = 'px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-700';
    } else {
      planName.textContent  = 'ProofTamil Free';
      planDesc.textContent  = 'Up to ' + limit + ' AI checks per 30-day period.';
      planBadge.textContent = 'Free';
      planBadge.className   = 'px-3 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-600';
    }

    // ── Usage bar ──────────────────────────────────────────────────────
    var used      = (limitsData && limitsData.used)       || 0;
    var remaining = (limitsData && limitsData.remaining)  || (limit - used);
    var periodEnd = limitsData && limitsData.period_end;
    var pct       = limit > 0 ? Math.min(100, Math.round(used / limit * 100)) : 0;

    document.getElementById('usage-used').textContent        = used;
    document.getElementById('usage-limit-label').textContent = 'of ' + limit + ' checks used';
    document.getElementById('usage-reset').textContent       = formatReset(periodEnd);
    document.getElementById('usage-sub').textContent         = remaining + ' check' + (remaining !== 1 ? 's' : '') + ' remaining this period';

    var bar = document.getElementById('usage-bar');
    bar.style.width = pct + '%';
    if (isPro) {
      bar.style.background = 'linear-gradient(90deg,#6366f1,#3b82f6)';
    } else if (pct >= 90) {
      bar.style.background = '#ef4444';
    } else if (pct >= 70) {
      bar.style.background = '#f59e0b';
    } else {
      bar.style.background = 'linear-gradient(90deg,#6366f1,#3b82f6)';
    }

    // ── Upgrade / Pro sections ─────────────────────────────────────────
    if (isPro) {
      document.getElementById('pro-section').classList.remove('hidden');

      var statusVal = (sub && sub.status) || 'active';
      document.getElementById('sub-provider').textContent    = 'Dodo Payments';
      document.getElementById('sub-status-text').textContent = statusVal.charAt(0).toUpperCase() + statusVal.slice(1);

      if (billing.current_period_end) {
        var d = new Date(billing.current_period_end);
        document.getElementById('sub-renews').textContent = d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
      }
    } else {
      document.getElementById('upgrade-section').classList.remove('hidden');
    }

    loading.classList.add('hidden');
    content.classList.remove('hidden');

  }).catch(function() {
    loading.textContent = 'Could not load subscription info. Please refresh the page.';
  });
})();
</script>

<%- include('../partials/footer') %>

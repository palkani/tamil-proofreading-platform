<%- include('../partials/header') %>

<div class="min-h-screen bg-gray-50">
  <%- include('../partials/nav', { active: 'subscription', user: user }) %>

  <main class="mx-auto w-full max-w-3xl px-6 pb-20 pt-10 sm:px-12">

    <!-- Loading -->
    <div id="sub-loading" class="text-center py-24 text-sm text-gray-400">Loading your subscription…</div>

    <!-- ── NOT SUBSCRIBED ── upgrade CTA ───────────────────────── -->
    <div id="sub-upgrade" class="hidden text-center py-10">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-indigo-50 mb-5">
        <svg class="w-8 h-8 text-indigo-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
      </div>
      <h1 class="text-2xl font-bold text-gray-900 mb-2">Get Pro Access</h1>
      <p class="text-gray-500 text-sm mb-8 max-w-xs mx-auto">Unlimited AI proofreading in Tamil — no word caps, no daily limits.</p>

      <ul class="text-left max-w-xs mx-auto space-y-3 mb-10 text-sm text-gray-700">
        <li class="flex items-center gap-3">
          <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-100 text-indigo-700 flex-shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </span>
          Proofread entire articles — no word cap, ever
        </li>
        <li class="flex items-center gap-3">
          <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-100 text-indigo-700 flex-shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </span>
          Unlimited AI checks — no daily cap
        </li>
        <li class="flex items-center gap-3">
          <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-100 text-indigo-700 flex-shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </span>
          Deep இலக்கணம், நடை &amp; எழுத்துப்பிழை fixes
        </li>
        <li class="flex items-center gap-3">
          <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-100 text-indigo-700 flex-shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </span>
          AI rewrites awkward lines in fluent Tamil
        </li>
        <li class="flex items-center gap-3">
          <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-100 text-indigo-700 flex-shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </span>
          Speak Tamil aloud — AI types it for you
        </li>
        <li class="flex items-center gap-3">
          <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-100 text-indigo-700 flex-shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </span>
          Scan handwritten Tamil &amp; convert to digital text
        </li>
        <li class="flex items-center gap-3">
          <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-100 text-indigo-700 flex-shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </span>
          Open .docx, .txt &amp; .pdf files in the editor
        </li>
        <li class="flex items-center gap-3">
          <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-100 text-indigo-700 flex-shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </span>
          Export your work as TXT, DOCX or PDF
        </li>
        <li class="flex items-center gap-3">
          <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-100 text-indigo-700 flex-shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </span>
          Adjust tone: formal, casual or literary style
        </li>
        <li class="flex items-center gap-3">
          <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-100 text-indigo-700 flex-shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </span>
          All your drafts saved &amp; synced across devices
        </li>
      </ul>

      <a href="/pricing"
         class="inline-flex items-center gap-2 px-8 py-3 rounded-full text-white font-semibold shadow-lg hover:shadow-xl hover:scale-[1.02] transition-all"
         style="background: linear-gradient(135deg, #1A2B68 0%, #2979FF 100%);">
        Subscribe to Pro
      </a>
    </div>

    <!-- ── SUBSCRIBED ── plan status + billing history ─────────── -->
    <div id="sub-active" class="hidden space-y-8">

      <!-- Plan card -->
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-8">
        <div class="flex items-center justify-between flex-wrap gap-4">
          <div>
            <p class="text-xs font-semibold text-indigo-600 uppercase tracking-wider mb-1">Current Plan</p>
            <h1 id="sub-plan-name" class="text-2xl font-bold text-gray-900">ProofTamil Pro</h1>
            <p id="sub-plan-period" class="text-sm text-gray-500 mt-1"></p>
          </div>
          <span id="sub-status-badge" class="px-4 py-1.5 rounded-full text-sm font-semibold"></span>
        </div>

        <div class="mt-6 grid grid-cols-2 sm:grid-cols-3 gap-4 text-sm">
          <div>
            <p class="text-gray-400 text-xs uppercase tracking-wide mb-0.5">Provider</p>
            <p id="sub-provider" class="font-medium text-gray-800">—</p>
          </div>
          <div>
            <p class="text-gray-400 text-xs uppercase tracking-wide mb-0.5">Next renewal</p>
            <p id="sub-renews" class="font-medium text-gray-800">—</p>
          </div>
          <div>
            <p class="text-gray-400 text-xs uppercase tracking-wide mb-0.5">Status</p>
            <p id="sub-status-text" class="font-medium text-gray-800">—</p>
          </div>
        </div>
      </div>

      <!-- Billing history -->
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-8">
        <h2 class="text-lg font-bold text-gray-900 mb-6">Billing History</h2>
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-100 text-left text-xs text-gray-400 uppercase tracking-wide">
              <th class="pb-3 font-medium">Date</th>
              <th class="pb-3 font-medium">Amount</th>
              <th class="pb-3 font-medium">Status</th>
              <th class="pb-3 font-medium">Method</th>
            </tr>
          </thead>
          <tbody id="billing-history-body">
            <tr>
              <td colspan="4" class="py-6 text-center text-gray-400">No previous payments found.</td>
            </tr>
          </tbody>
        </table>
      </div>

    </div><!-- /sub-active -->

  </main>
</div>

<script>
(function() {
  var loading  = document.getElementById('sub-loading');
  var upgrade  = document.getElementById('sub-upgrade');
  var active   = document.getElementById('sub-active');

  function show(el) {
    loading.classList.add('hidden');
    upgrade.classList.add('hidden');
    active.classList.add('hidden');
    el.classList.remove('hidden');
  }

  // Fetch user + billing status in parallel
  Promise.all([
    fetch('/api/v1/me', { credentials: 'include' }).then(function(r) { return r.ok ? r.json() : null; }),
    fetch('/api/v1/billing/me', { credentials: 'include' }).then(function(r) { return r.ok ? r.json() : null; })
  ]).then(function(results) {
    var meData      = results[0];
    var billingData = results[1];

    var user    = meData && meData.user;
    var billing = billingData && billingData.billing;
    var isPro   = billing && billing.has_active_subscription;

    if (!isPro) {
      show(upgrade);
      return;
    }

    // Populate plan card
    show(active);

    var sub      = billing.subscription;
    var provider = (billing.provider || '').toLowerCase();

    document.getElementById('sub-plan-name').textContent =
      sub && sub.plan_code ? (sub.plan_code === 'PRO_YEARLY' ? 'ProofTamil Pro — Yearly' : 'ProofTamil Pro — Monthly') : 'ProofTamil Pro';

    var badge = document.getElementById('sub-status-badge');
    var statusVal = (sub && sub.status) || 'active';
    badge.textContent = statusVal.charAt(0).toUpperCase() + statusVal.slice(1);
    badge.className = 'px-4 py-1.5 rounded-full text-sm font-semibold ' +
      (statusVal === 'active' ? 'bg-green-100 text-green-700' :
       statusVal === 'trialing' ? 'bg-blue-100 text-blue-700' :
       'bg-gray-100 text-gray-600');

    document.getElementById('sub-status-text').textContent =
      statusVal.charAt(0).toUpperCase() + statusVal.slice(1);

    document.getElementById('sub-provider').textContent =
      provider === 'razorpay' ? 'Razorpay' : 'Stripe';

    if (billing.current_period_end) {
      var d = new Date(billing.current_period_end);
      document.getElementById('sub-renews').textContent = d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
      document.getElementById('sub-plan-period').textContent = 'Renews on ' + d.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
    }

  }).catch(function() {
    show(upgrade);
  });
})();
</script>

<%- include('../partials/footer') %>

{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build:css",

  "routes": [
    {
      "src": "^/api/v1/auth/google/callback",
      "dest": "/api/index.js"
    },
    {
      "src": "^/api/v1/(.*)",
      "dest": "https://prooftamil-backend-991187041222.asia-south1.run.app/api/v1/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}

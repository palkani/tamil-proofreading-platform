{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "installCommand": "npm install",
  "buildCommand": "npm run build:css",
  "routes": [
    {
      "src": "^/api/v1/auth/google/callback$",
      "dest": "/api/index.js"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/index.js"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/index.js"
    }
  ]
}

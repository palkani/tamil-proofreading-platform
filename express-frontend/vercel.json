{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build:css",
  "regions": ["bom1", "iad1"],
  "headers": [
    {
      "source": "/api/v1/suggest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=120, stale-while-revalidate=300"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=120"
        }
      ]
    },
    {
      "source": "/api/v1/ime/suggest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=120, stale-while-revalidate=300"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=120"
        }
      ]
    },
    {
      "source": "/api/v1/transliterate/suggest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=120, stale-while-revalidate=300"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=120"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/transliterate/suggest",
      "destination": "/api/transliterate/suggest.js"
    },
    {
      "source": "/api/v1/auth/google/callback",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/v1/suggest",
      "destination": "/api/v1/suggest.js"
    },
    {
      "source": "/api/v1/ime/:path*",
      "destination": "https://prooftamil-backend-991187041222.asia-south1.run.app/api/v1/ime/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://prooftamil-backend-991187041222.asia-south1.run.app/api/v1/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/workspace",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/v1/).*)",
      "destination": "/api/index.js"
    }
  ]
}
